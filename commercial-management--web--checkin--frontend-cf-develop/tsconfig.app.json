{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "./src",
      "./config/angular-environments"
    ]
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts",
    "src/global.d.ts",
    "src/decorators.ts"
  ],
  "include": [
    "./src/**/*.ts",
    "./src/**/*.d.ts"
  ],
  "exclude": [
    "./src/test.ts",
    "./src/**/*.spec.ts"
  ]
}