{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PREE Chrome UATb",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "ng-serve-uatb",
            "url": "http://localhost:9006",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/*",
                "/*": "*",
                "/./~/*": "${webRoot}/node_modules/*"
            }
        },
        {
            "name": "PREB Chrome UATd",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "ng-serve-uatd",
            "url": "http://localhost:9006",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/*",
                "/*": "*",
                "/./~/*": "${webRoot}/node_modules/*"
            }
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:9006",
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/*",
                "/*": "*",
                "/./~/*": "${webRoot}/node_modules/*"
            }
        },
        {
            "name": "Attach Edge",
            "type": "msedge",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/*",
                "/*": "*",
                "/./~/*": "${webRoot}/node_modules/*"
            }
        },
        {
            "name": "Attach Chrome",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}",
            "sourceMapPathOverrides": {
                "webpack:/*": "${webRoot}/*",
                "/./*": "${webRoot}/*",
                "/src/*": "${webRoot}/*",
                "/*": "*",
                "/./~/*": "${webRoot}/node_modules/*"
            }
        },

        {
            "name": "Chrome UATD",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "ng-serve-uatd",
            "url": "http://localhost:9006"
        },
        {
            "name": "Edge UATB",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "ng-serve-uatb",
            "url": "http://localhost:9006"
        },
        {
            "name": "Edge UATD",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "ng-serve-uatd",
            "url": "http://localhost:9006"
        },
        {
            "name": "Test debug",
            "type": "chrome",
            "request": "attach",
            "address": "localhost",
            "port": 9333,
            "timeout": 600000,
            "preLaunchTask": "test-debug",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "pathMapping": {
                "/": "${webRoot}",
                "/_karma_webpack_": "${webRoot}",
                "/base/": "${webRoot}/"
            }
        },
        {
            "name": "Chrome Webpack DevServer",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:9006",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "task-uatb"
        }
    ]
}
