{
    // =====================================================
    // EXTENSIÓN: I18N ALLY
    // Configuración para la gestión de literales y traducciones.
    // Sustituye las rutas por las de tu equipo.
    // =====================================================
    "i18n-ally.localesPaths": [
        "C:/path/literales/checkin",
        "C:/path/literales/general"
    ],
    // Las claves de los ficheros de traducción usan estructura anidada.
    // Ejemplo: "checkout.payment.title".
    "i18n-ally.keystyle": "nested",
    // Idioma original desde el que se traducen los textos.
    "i18n-ally.sourceLanguage": "es",
    // Idioma que I18n Ally muestra por defecto.
    "i18n-ally.displayLanguage": "es",
    // Indica que los ficheros están organizados por namespaces.
    "i18n-ally.namespace": true,
    // =====================================================
    // FORMATEO Y ESLINT
    // =====================================================
    // Formatea automáticamente el archivo al guardarlo.
    "editor.formatOnSave": true,
    // ESLint será el formateador predeterminado global.
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    // Permite a ESLint realizar tareas de formateo.
    "eslint.format.enable": true,
    // Ejecuta automáticamente las correcciones de ESLint al guardar.
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always",
        // Elimina imports que no se utilicen.
        "source.removeUnusedImports": "always"
    },
    // Directorios de trabajo para ESLint.
    // "./" representa la raíz del proyecto abierto.
    "eslint.workingDirectories": [
        "./"
    ],
    // =====================================================
    // TYPESCRIPT
    // Usa la versión de TypeScript instalada en el proyecto
    // en lugar de la versión interna de VS Code.
    // =====================================================
    "js/ts.tsdk.path": "./node_modules/typescript/lib",
    // =====================================================
    // EXPLORADOR DE ARCHIVOS
    // Agrupa archivos relacionados debajo de su archivo base.
    // =====================================================
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${basename}.test.ts, ${basename}.spec.ts, ${basename}.a11y.spec.ts, ${basename}.model.ts, ${basename}.scss, ${basename}.css, ${basename}.html",
        "*.js": "${basename}.test.js, ${basename}.test.ts, ${basename}.spec.js, ${basename}.spec.ts, ${basename}.model.ts, ${basename}.scss, ${basename}.css, ${basename}.html"
    },
    // =====================================================
    // FORMATEADORES POR TIPO DE ARCHIVO
    // =====================================================
    // Stylelint formatea ficheros de estilos.
    "[scss]": {
        "editor.defaultFormatter": "stylelint.vscode-stylelint"
    },
    "[css]": {
        "editor.defaultFormatter": "stylelint.vscode-stylelint"
    },
    // ESLint formatea JavaScript y TypeScript.
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    // Formateador nativo de VS Code para JSON.
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    }
}