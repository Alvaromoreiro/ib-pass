                    "beginsPattern": {
                        "regexp": "(.*?)"
                    },
                    "endsPattern": {
                        "regexp": "√ Compiled successfully.|Failed to compile."
                    }
                }
            }
        },
        {
            "label": "ng-serve-uatd",
            "type": "npm",
            "script": "start --env=uatd --ignore_proxy=true",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "(.*?)"
                    },
                    "endsPattern": {
                        "regexp": "√ Compiled successfully.|Failed to compile."
                    }
                }
            }
        },
        {
            "type": "npm",
            "script": "test-watch",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "(.*?)"
                    },
                    "endsPattern": {
