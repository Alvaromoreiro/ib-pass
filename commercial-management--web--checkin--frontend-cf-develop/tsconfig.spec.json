{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDirs": ["./src", "./test"],
    "types": [
      "jasmine", "node", "webpack-env"
    ]
  },
  "files": [
    "./src/polyfills.ts",
    "./test/unit/test.ts",
  ],
  "include": [
    "./src/**/*.spec.ts",
    "./src/**/*.d.ts",
    "./test/helpers/**/*.ts",
    "./test/mocks/**/*.ts",
    "./test/unit/**/*.ts",
    "./test/unit/**/*.spec.ts",
    "./test/unit/**/*.d.ts",
  ]
}
