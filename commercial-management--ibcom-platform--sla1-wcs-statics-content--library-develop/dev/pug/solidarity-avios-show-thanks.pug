extends _general/layout__primary
include _modules/_ibe_tabs-icons
block title
	title!="IBERIA - Partners - Category"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// End wrapper
	section.container
		div.row
			div.col-xs-12
				+m-ibe-breadcrumbs({
					menu: "claim"
				})
		div.row
			div.col-lg-9.col-xs-12.col-lg-push-3
				section.ibe-infocheckin
					header.ibe-infocheckin__header
						h1.title.title__h1.ibe-infocheckin__header-primary!="C&oacute;mo donar Avios"
						h5.title.title__h5.ibe-infocheckin__header-secondary!="Haz que tus Avios marquen la diferencia"
					article.ibe-infocheckin__box.ibe-infocheckin__box--img-big
						figure.ibe-figure
							img.ibe-img(src=globals.imgPath + "/content/antes-de-viajar.png" alt="Antes de viajar")
						div.ibe-infocheckin__box-container
							div.ibe-line-spacing.ibe-line-spacing--large.u-text-right
								a.link.link__regular.link__regular--important.link__regular--arrow-left(href="#" title="Volver")!="Volver"
							div.row
								div.col-xs-12.col-sm-12.col-md-6
									div.ibe-line-spacing.ibe-line-spacing--large
										figure.ibe-figure.ibe-figure--size-250
											img(src=globals.imgPath + "/logos/ong/logo_save_the_children.png", alt="Logo ONG")
										p.paragraph.paragraph__regular
											!="Apoyamos la labor de Save the Children en su proyecto \"Institutos Construyendo Paz\", que enseña herramientas para la vida a los niños de escuelas secundarias de Ciudad de Guatemala. Este programa, que está obteniendo unos resultados muy positivos desde que se inició en 2014, tienen como objetivo llegar a 7.000 niños y adolescentes del país. Si quieres más información visita "
											a.link.link__regular.link__regular--important(href="#" title="Ir a la web de Save The Children")!="savethechildren.es"
								div.col-xs-12.col-sm-12.col-md-6
									article.ibe-card-link.ibe-card-link--border-top-red.ibe-card-link--box-shadow
										.ibe-card-link__container.ibe-card-link__container--tablet-cell.ibe-card-link__container--border-top-red(data-fc-height="0")
											.ibe-card-link__info
												div.ibe-line-spacing.ibe-line-spacing--big
													p.title.title__h5.title--no-padd!="Gracias de corazón"
													p.title__h2.title--red.ibe-card-link__title-text!="Ana Esteban"
												div.ibe-line-spacing.ibe-line-spacing--big
													p.paragraph.paragraph__regular.paragraph__regular--black
														!="Tus 2597 Avios han sido enviados a "
														strong!="Save the Children "
														!=", te hemos enviado un mail de confirmación."
													p.paragraph.paragraph__regular.paragraph__regular--black
														!="Te damos las gracias de nuevo por donar tus Avios a causas que necesitan nuestra ayuda, y por estar con nosotros en el apoyo a personas desfavorecidas. ¡Siganos así!"
														span.ibe-icon-text.icon-satisfaccion_cliente
												div
													button.ibe-button.ibe-button--red.ibe-button--block.ibe-button--smaller(type='button')!="Ver historial de mis Avios"
			div.col-lg-3.col-xs-12.col-lg-pull-9
				+m-lat-menu({
					items: [
						{
							link: "C&oacute;mo funciona Avios",
							title: "Cómo funciona Avios"
						},
						{
							link: "Comprar, regalar y transferir Avios",
							title: "Comprar, regalar y transferir Avios"
						},
						{
							link: "Avios Solidarios",
							title: "Avios Solidarios",
							cssClass: "ibe-lat-menu__item--active"
						},
						{
							link: "Obtener Avios",
							title: "Obtener Avios"
						},
						{
							link: "Utilizar mis Avios",
							title: "Utilizar mis Avios"
						},
						{
							link: "Hoteles, coches y experiencias",
							title: "Hoteles, coches y experiencias"
						},
						{
							link: "Avios no anotados",
							title: "Avios no anotados"
						},
						{
							link: "Qu&eacute; son Puntos Elite",
							title: "Qué son Puntos Elite"
						},
						{
							link: "Obtener Puntos Elite",
							title: "Obtener Puntos Elite"
						}

					]
				})
