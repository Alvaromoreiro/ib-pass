extends _general/layout__primary
include _modules/_ibe_accordion
block title
	title!="IBERIA - Precio Garantizado confirmaci&oacute;n"
block body
	// New header
	+m-header-new({
		"login": true
	})

	// New menu
	+m-menu-new({
		"login": true
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			menu: "claim"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					h2.title.title__h1.title--center.title--paddB-smaller!="Mejor precio garantizado"
