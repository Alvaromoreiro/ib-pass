							p.paragraph.paragraph__regular.paragraph.paragraph__regular--grey Referencia:
							p.ibe-box__price-warranty--box-confirm-ref!="1180005-19742"
							p.paragraph.paragraph__regular.paragraph.paragraph__regular--grey.u-mb-none Tu petición ha sido enviada a iberia.com.
							p.paragraph.paragraph__regular.paragraph.paragraph__regular--grey En las próximas horas nos pondremos en contacto contigo para informarle del resultado de la reclamación.
					button.ibe-button.ibe-button--red.ibe-button--large.ibe-button--bigger.ibe-button--center(type='button') Volver a la página de inicio
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Condiciones Transporte",
								title: "Condiciones Transporte"

							},
							{
								link: "Tu seguridad es lo primero",
								title: "Tu seguridad es lo primero"
							},
							{
								link: "Condiciones Generales del Programa Iberia Plus",
								title: "Condiciones Generales del Programa Iberia Plus"
							},
							{
								link: "Mejor precio garantizado",
								title: "Mejor precio garantizado",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Compromiso de servicio",
								title: "Compromiso de servicio"
							},
							{
								link: "Derechos del pasajero",
								title: "Derechos del pasajero"
							},
							{
								link: "Accesibilidad",
								title: "Accesibilidad"
							},
							{
								link: "Información Legal",
								title: "Información Legal"
							}
