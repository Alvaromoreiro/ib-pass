extends _general/layout__primary
mixin list-page(params)
	- params = params || {};
	ul
		each val in params.items
			li
				a(href=val.href, title="Ir a " + val.title, target="_blank", style="font-size: 16px; color: grey; font-weight: 700; font-family: iberiaheadline")!=val.title
block title
	title!="IBERIA - GUIDELINES"
block body
	h1(class="title title__h1") Guía de estilos de formularios
	.container
		.row
			.col-xs-12
				form(data-valid-form)
