extends _general/layout__primary

include _modules/stopover/_ibe_stopover_top-banner
include _modules/stopover/_ibe_stopover_routes
include _modules/stopover/_ibe_stopover_experience-grid
include _modules/_modals/_ibe-modal-zoom-image
include _modules/stopover/_ibe_stopover_recommendation-card

block title
    title!='IBERIA - Stopover Routes per day'
block body
    // Inicio nuevo header
    +m-header-new({
        "login": false
    })

    // Inicio nuevo menu
    +m-menu-new({
        "login": false
    })
    // End wrapper

    +m-ibe-stopover_top-banner({
        "dataBackground": 'images/modules/stopover/banner-recommended-plans',
        "isSearcher": true,
        "classSearcher" : "ibe-stopover-banner--searcher",
        "type" : "text"
    })
    main.container
        // Main content
        +m-ibe-stopover_routes()
        +m-ibe-stopover_experience-grid({
			"filter" : false,
            "slider" : true
		})
        +m-ibe-stopover_recommendation-card({
			"single" : true
		})
    +m-ibe-modal-zoom-image({url: "images/modules/stopover/img-route1_2.png"})
    +m-footer({
        "full": true  
    })
