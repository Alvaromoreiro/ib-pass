													"collapse": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. In vel velit at orci pellentesque interdum. Quisque fringilla eleifend enim, egestas dignissim risus lobortis at. Nunc porta vitae leo nec aliquam. Suspendisse potenti. Cras arcu lorem, blandit quis venenatis id, semper in dolor. Etiam facilisis mi vitae dolor mollis, eu dapibus erat finibus. Praesent placerat porttitor dui, eu euismod augue tempus a. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum eu mollis lacus. Nam vitae scelerisque nisi. Morbi blandit efficitur lectus a finibus. Donec lacus neque, dictum non placerat a, fermentum vitae diam. Donec non sapien leo. Cras ullamcorper"
												})
												div.ibe-accordion(class="ibe-accordion")
													div
														h4.title__h4.ibe-accordion__header(data-toggle="collapse", data-target="#accordion03", data-outer-click="true")
															a.link(href="#", title="Portátil")!="Port&aacute;til"
														div.ibe-accordion__collapse(id="accordion03" data-toggle="container")
															p.paragraph.paragraph__regular.paragraph__regular--grey!="Descarga Adobe Flash en tu port&aacute;til"
															figure.ibe-tab__figure.ibe-tab__figure--type-2
																img.ibe-tab__image(src=globals.imgPath + "/general/flash.png" alt="Descargar Adobe Flash")
															p.paragraph.paragraph__regular.paragraph__regular--grey!="Si viajas con otro dispositivo, aseg&uacute;rate de tenerlo listo antes de volar."


				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Tienda a bordo",
								title: "Tienda a bordo"
							},
							{
								link: "Tipos de asientos",
								title: "Tipos de asientos"
							},
							{
								link: "Men&uacute; a bordo",
								title: "Menú a bordo"
							},
							{
								link: "Entretenimiento",
								title: "Entretenimiento",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Confort",
								title: "Confort"
							},
							{
								link: "Wifi y GSM",
								title: "Wifi y GSM"
							}
						]
					})
	+m-footer()
