extends _general/layout__primary
block title
	title!="IBERIA - Entretenimiento"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Entretenimiento"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Tus opciones de ocio en el avi&oacute;n"
						article.ibe-infocheckin__box.ibe-infocheckin__box--tab.ibe-infocheckin__box--empty
							div.ibe-tab.ibe-tab--main
								ul.ibe-tab__menu(data-tab="bootstrap-tabdrop" data-tab-text="Otros...")
									li.ibe-tab__menu-item.active
										a.ibe-tab__menu-item__text(href="#tab-1" title="Larga distancia aviones nuevos" data-toggle="tab") Larga distancia
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-2" title="Larga distancia" data-toggle="tab") Media distancia
								.tab-content
									.tab-pane.active(id="tab-1")
										div.ibe-infocheckin__box.ibe-infocheckin__box--medium
											p.paragraph.paragraph__regular.paragraph__regular Vuelos de largo recorrido en los nuevos aviones A330 y A340-600
											figure.ibe-tab__figure.ibe-tab__figure--type-2
												img.ibe-tab__image(src=globals.imgPath + "/content/menu-a-bordo.png" alt="Aceite de oliva")
											h3.title.title__h3.ibe-infocheckin__box-title Elige la diversi&oacute;n
											p.paragraph.paragraph__regular.paragraph__regular--grey Business Club y Turista
											div.ibe-card-distributive
												div.row
													div.col-md-6.col-xs-12
														+m-card-distributive({
															"mainClass": "no-image ibe-card-distributive__card--border-box ibe-card-distributive__card--margin-small",
															"link": {
																"href": "#",
																"title": "Consulta la programación de este mes"
															},
															"image": {
																"init": false
															},
															"title": "Consulta la programaci&oacute;n de este mes",
															"data": "card-distributive-1"
														})
													div.col-md-6.col-xs-12
														+m-card-distributive({
															"mainClass": "no-image ibe-card-distributive__card--border-box ibe-card-distributive__card--margin-small",
															"link": {
																"href": "#",
																"title": "Avance de la programación del próximo mes"
															},
															"image": {
																"init": false
															},
															"title": "Avance de la programaci&oacute;n del pr&oacute;ximo mes",
															"data": "card-distributive-1"
														})
												p.paragraph.paragraph__regular.paragraph__regular--grey!="En el nuevo sistema de entretenimiento, cada mes se incluir&aacute;n 60 peliculas en varios idionmas (ingl&eacute;s, franc&eacute;s, italiano, alem&aacute;n, portugu&eacute;s) que abarcar&aacute;n diversidad de g&eacute;neros, desde la comedia, el drama o la animaci&oacute;n hasta la acci&oacute;n o el suspense, por supuesto sin olvidar el cine espa&ntilde;ol. Adem&aacute;s, estar&aacute;n disponibles hasta 98 opciones entre series de televisi&oacute;n (espa&ntilde;olas e internacionales), documentales y programas de deportes, tecnolog&iacute;a y viajes, entre otros."
										h3.title.title__h3!="Y tambi&eacute;n..."
										div.ibe-infocheckin__boxs-content
											article.ibe-infocheckin__box.ibe-infocheckin__box--medium
												h3.title.title__h3.ibe-infocheckin__box-title!="Juegos"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Dispones de diferentes videojuegos en tu pantalla individual, como los conocidos: ¿Quieres ser millonari?, Bejeweled, Solitario, Poker o juegos para ni&ntilde;os. Adem&aacute;s podr&aacute;s jugar contra tu acompa&ntilde;ante utilizando el modo multijugador en los juegos Hundir la flota, Tres en raya y Ajedrez."
											article.ibe-infocheckin__box.ibe-infocheckin__box--medium
												h3.title.title__h3.ibe-infocheckin__box-title!="C&aacute;mara de cola"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Durante el despegue y el aterrizaje de los aviones A340-600, podr&aacute;s disfrutar de todo el entorno en directo desde la perspectiva de la c&aacute;mara exterior situada en el tim&oacute;n de cola."
											article.ibe-infocheckin__box.ibe-infocheckin__box--medium
												h3.title.title__h3.ibe-infocheckin__box-title!="A tu gusto"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Escoge entre los mejores estrenos internacionales de pel&iacute;culas y gran variedad de m&uacute;sica con la m&aacute;xima calidad digital. Desde tu propia butaca puedes controlar los contenidos de tu pantalla a trav&eacute;s de un men&uacute; sencillo e intuitivo."
										h3.title.title__h3!="Y si viajas en Bussines Plus..."
										div.ibe-infocheckin__boxs-content
											article.ibe-infocheckin__box.ibe-infocheckin__box--medium(data-view-more='parent')
												h3.title.title__h3.ibe-infocheckin__box-title!="Es posible realizar llamadas"
												div.xui-collapse_moreInfo-text-close(data-view-more='container')
													p.paragraph.paragraph__regular.paragraph__regular--grey!="En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente."
													p.paragraph.paragraph__regular.paragraph__regular--grey!="En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente."
												a.link.link__regular.ibe-link-view-more.ibe-link-view-more--more.link__regular--right(href="#" title="Mostrar más" data-view-more='button', data-value="more")!="Leer m&aacute;s"
												a.link.link__regular.ibe-link-view-more.ibe-link-view-more--less.link__regular--right(href="#" title="Ocultar" data-view-more='button', data-value="less")!="Ocultar"
										.row
											.col-xs-12
												h3.title.title__h3!="Mira c&oacute;mo se aplica en vuelos operados por"
												div.ibe-infocheckin__box.ibe-infocheckin__box--small.ibe-infocheckin__box--no-title
													div.ibe-modal_body-logos
														ul.ibe-modal_body-logos_container.clearfix
															li.ibe-modal_body-logos_container-item
																a(href="#" title="Finnair")
																	figure.ibe-modal_body-logos_container-item-figure
																		img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/finnair.png" alt="Logo Finnair")
															li.ibe-modal_body-logos_container-item
																a(href="#" title="British Airways")
																	figure.ibe-modal_body-logos_container-item-figure
																		img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/british_airways.png" alt="Logo British Airways")
															li.ibe-modal_body-logos_container-item
																a(href="#" title="American Airlines")
																	figure.ibe-modal_body-logos_container-item-figure
																		img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")
									.tab-pane(id="tab-2")
										div.ibe-infocheckin__box.ibe-infocheckin__box--medium
											p.paragraph.paragraph__regular.paragraph__regular!="Ahora el entretenimiento a bordo en tu propio dispositivo ("
											a.link.link__regular.link__regular--important(href="#" title="ver requisitos")!="ver requisitos"
											!=")"
											figure.ibe-tab__figure.ibe-tab__figure--type-2
												img.ibe-tab__image(src=globals.imgPath + "/content/media-distancia.png" alt="Viaje media distancia")
											h3.title.title__h3.ibe-infocheckin__box-title Disfruta m&aacute;s de tu viaje
											p.paragraph.paragraph__regular.paragraph__regular--grey Business Club y Turista
											div.ibe-card-distributive
												div.row
													div.col-md-6.col-xs-12
														+m-card-distributive({
															"mainClass": "no-image ibe-card-distributive__card--border-box ibe-card-distributive__card--margin-small",
															"link": {
																"href": "#",
																"title": "Consulta la programación"
															},
															"image": {
																"init": false
															},
															"title": "Consulta la programaci&oacute;n",
															"data": "card-distributive-1"
														})
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Descarga la nueva App Gogo Entertainment en tu dispositivo m&oacute;vil o tablet, ll&eacute;valo a bordo, y podr&aacute;s disfrutar de los &uacute;ltimos estrenos de pel&iacute;culas, series, documentales, e incluso dibujos animados para los m&aacute;s peque&ntilde;os. "
												a.link.link__regular.link__regular--underline.link__regular--grey(href="#" title="Ver requisitos")!="Ver requisitos"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Este sistema de entretenimiento est&aacute; disponible si viajas en nuestros aviones Airbus A-319 en las rutas con Mosc&uacute;, San Petersburgo, Estocolmo, Tel Aviv y Malabo."
										div.ibe-infocheckin__boxs-content
											article.ibe-infocheckin__box.ibe-infocheckin__box--medium
												h3.title.title__h3.ibe-infocheckin__box-title!="Requisitos en tu dispositivo"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Antes de viajar, instala en tu m&oacute;vil o tablet la App Gogo Entertaiment o Adobe Flash en tu port&aacute;til y disfruta del entretenimiento a bordo:"
												div.ibe-modal_body-logos
													ul.ibe-modal_body-logos_container.clearfix
														li.ibe-modal_body-logos_container-item
															a(href="#" title="Finnair")
																figure.ibe-modal_body-logos_container-item-figure
																	img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/app-store.png" alt="Descarga App store")
														li.ibe-modal_body-logos_container-item
															a(href="#" title="British Airways")
																figure.ibe-modal_body-logos_container-item-figure
																	img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/google-play.png" alt="Descargar Play Store")
														li.ibe-modal_body-logos_container-item
															a(href="#" title="American Airlines")
																figure.ibe-modal_body-logos_container-item-figure
																	img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/flash.png" alt="Descarga flash")
												span.paragraph.paragraph__regular.paragraph__regular--grey.paragraph__regular--bold!="Desc&aacute;rgalo antes de subir al avi&oacute;n"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="Recuerda mantener instalada y actualizada la app para ver las pel&iacute;culas y series a bordo siempre que viajes en estos vuelos."

											//- article.ibe-infocheckin__box.ibe-infocheckin__box--medium
											article.ibe-infocheckin__box
												h3.title.title__h3.ibe-infocheckin__box-title!="Adicional si es posible"

												+m-accordion({
													"id": "accordion01",
													"target": "#accordion01",
													"title": {
														"text": "Apple",
														"title": "Apple",
