extends _general/layout__primary
include _modules/_modals/_ibe-modal-advise
include _modules/_modals/_ibe-modal-claim
include _modules/_modals/_ibe-modal-clock
include _modules/_modals/_ibe-modal-class
include _modules/_modals/_ibe-modal-class-nofull-width
include _modules/_modals/_ibe-modal-info-list
include _modules/_modals/_ibe-modal-loading
include _modules/_modals/_ibe-modal-login
include _modules/_modals/_ibe-modal-login--xsmall
include _modules/_modals/_ibe-modal-uno
include _modules/_modals/_ibe-modal-video
include _modules/_modals/_ibe-modal-where
include _modules/_modals/_ibe-modal-no-close
include _modules/_modals/_ibe-modal-login-stopover
include _modules/_modals/_ibe-modal-login-stopover-simple
include _modules/_modals/_ibe-modal-login-stopover-simple-error
include _modules/_modals/_ibe_modal-plan-university-fly
include _modules/_modals/_ibe_modal-plan-university-fly-activated
include _modules/_modals/_ibe-modal-img-stopover
include _modules/_modals/_ibe-modal-discount-h-stopover
include _modules/_modals/_ibe-modal-discount-v-stopover

block title
	title!='IBERIA - Modales'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.container
		// Main content
		div.row
			.col-xs-12
				h1.title.title__h1.title--grey Listado de modales
			.col-xs-6
				.row
					.col-xs-12
						h2.title.title__h2 Respositorio de modales
					div
						a(href="#" title="Modal Advise" data-modal="button" data-modal-view=".fc-dialog-advise" data-css-class="")!="Modal Advise"
					div
						a(href="#" title="Modal con Claim" data-modal="button" data-modal-view=".fc-dialog-claim", data-full-width="true")!="Modal con Claim"
						div
						a(href="#" title="Modal con Reloj" data-modal="button" data-modal-view=".fc-dialog-clock", data-full-width="true")!="Modal con Reloj"
					div
						a(href="#" title="Modal con clase (full width)" data-modal="button" data-modal-view=".fc-dialog-class", data-full-width="true")!="Modal con clase (full width)"
					div
						a(href="#" title="Modal con clase (no full width)" data-modal="button" data-modal-view=".fc-dialog-class-nofull-width")!="Modal con clase (no full width)"
					div
						a(href="#" title="Modal Info List" data-modal="button" data-focusin data-modal-view=".fc-dialog-info-list")!="Modal Info List"
					div
						a(href="#" title="Modal Loading" data-modal="button" data-modal-view=".fc-dialog-loading")!="Modal Loading"
					div
						a(href="#" title="Login" data-modal="button" data-modal-view=".fc-dialog-login")!="Modal Login"
					div
						a(href="#" title="Modal Login xsmall (xs to md)" data-modal="button" data-modal-view=".fc-dialog-login--xsmall")!="Modal Login xsmall (xs to md)"
					div
						a(href="#" title="Modal Video" data-modal="button" data-modal-view=".fc-dialog-video")!="Modal Video"
					div
						a(href="#" title="Modal Video (x3)" data-modal="button" data-modal-view=".fc-dialog-uno")!="Modal Video (x3)"
					div
						a(href="javascript:void(0)" title="Modal con Where" data-modal="button" data-modal-view=".fc-dialog-where")!="Modal con Where"
					div
						a(href="javascript:void(0)" title="Modal no close" data-modal="button" data-modal-view=".fc-dialog-no-close")!="Modal no Close"
					div
						a(href="javascript:void(0)" title="Modal Login Stopover" data-modal="button" data-modal-view=".fc-dialog-login-stopover")!="Modal Login Stopover"
					div
						a(href="javascript:void(0)" title="Modal Login Stopover Simple" data-modal="button" data-modal-view=".fc-dialog-login-stopover-simple")!="Modal Login Stopover Simple"
					div
						a(href="javascript:void(0)" title="Modal Login Stopover Simple with error" data-modal="button" data-modal-view=".fc-dialog-login-stopover-simple-error")!="Modal Login Stopover Simple with Error"
					div
						a(href="javascript:void(0)" title="Modal Plan University Fly" data-modal="button" data-modal-view=".fc-dialog-plan-university-fly")!="Modal Plan University Fly"
					div
						a(href="javascript:void(0)" title="Modal Plan University Fly Activated" data-modal="button" data-modal-view=".fc-dialog-plan-university-fly-activated")!="Modal Plan University Fly Activated"
					div
						a(href="javascript:void(0)" title="Modal Imagen Stopover" data-modal="button" data-modal-view=".fc-dialog-img-stopover")!="Modal Imagen Stopover"
					div
						a(href="javascript:void(0)" title="Modal Aplica descuento h Stopover" data-modal="button" data-modal-view=".fc-discount-h-stopover")!="Modal Aplica descuento h Stopover"
					div
						a(href="javascript:void(0)" title="Modal Aplica descuento v Stopover" data-modal="button" data-modal-view=".fc-discount-v-stopover")!="Modal Aplica descuento v Stopover"


	+m-ibe-modal-advise()
	+m-ibe-modal-claim()
	+m-ibe-modal-clock()
	+m-ibe-modal-class()
	+m-ibe-modal-class-nofull-width()
	+m-ibe-modal-info-list()
	+m-ibe-modal-loading()
	+m-ibe-modal-login()
	+m-ibe-modal-login--xsmall()
	+m-ibe-modal-uno()
	+m-ibe-modal-video()
	+m-ibe-modal-where()
	+m-ibe-modal-no-close()
	+m-ibe-modal-login-stopover()
	+m-ibe-modal-login-stopover-simple()
	+m-ibe-modal-login-stopover-simple-error()
	+m-ibe-modal-plan-university-fly()
	+m-ibe-modal-plan-university-fly-activated()
	+m-ibe-modal-img-stopover()
	+m-ibe-modal-discount-h-stopover()
	+m-ibe-modal-discount-v-stopover()
