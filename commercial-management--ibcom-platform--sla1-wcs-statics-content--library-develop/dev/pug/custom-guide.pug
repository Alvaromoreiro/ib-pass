extends _general/layout__primary
include _modules/_ibe_card-cont-share
block title
	title!="IBERIA - Ficha de actividad"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu 
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-guide
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		div.ibe-search-flights
			div.ibe-search-flights__search
				div.container
					div.row
						div.col-xs-12
							header.ibe-infocheckin__header
								h1.title.title__h1.ibe-infocheckin__header-primary!="Ya puedes visitar Chicago con tu propia guía"
								div.ibe-infocheckin__buttons.ibe-button__same
									button.ibe-button.ibe-button--white.ibe-button--red-border.ibe-button--extra-padding.ibe-button--medium.ibe-button--icon-new.ibe-button--icon-enlace="Copiar enlace"
									button.ibe-button.ibe-button--white.ibe-button--red-border.ibe-button--extra-padding.ibe-button--medium.ibe-button--icon-new.ibe-button--icon-email="Enviar por E-mail"
								
			div.ibe-search-flights__cover.ibe-search-flights__cover--no-search.ibe-search-flights__cover--no-image

			div.ibe-search-flights__search
				div.container
					div.row
						div.col-xs-12.ibe-card-box--md.ibe-card-box--horizontal.ibe-card-box__link
							.ibe-flex.ibe-flex--align-stretch.ibe-flex--gap-double
								+m-card-box({
									"isLink": false,
									"zoom": true,
									"offer": true,
									"type": "body",
									"exampleText": "Te sentirás abrumado al ver grandiosidad de este símbolo.",
									"text":"Te sentirás abrumado al ver la grandiosidad de este símbolo.",
									"image": {
										"src": "/modules/ibe-card-box/1120x360.png",
										"alt": "nombre de la imagen"
									},
									"title": "¿Aún no tienes los vuelos? Empieza ahora tu viaje a Chicago.",
									"price": true
								})
								+m-card-cont-share({
									"share": true,
									"title": "Comparte como ves Chicago, Comparte como ves Chicago",
									"text":"Guarda y comparte el enlace a tu guia personalizada para poder consultarla despues",
								})
	+m-footer()
