extends _general/layout__primary
include _modules/_ibe_tabs-icons
block title
	title!="IBERIA - Menores viajando solos - Confirmación de envio de datos"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})

	// End wrapper
	div.container
		
		div.row
			div.col-xs-12
				section.ibe-infocheckin
					header.ibe-infocheckin__header
						.ibe-infocheckin__header-primary.u-mt-big
							span.ibe-icon-confirm
							span.title.title__h1!="Tu solicitud se ha enviado correctamente"

				section.ibe-box__no-color
					div.ibe-box__no-color-content
						h3.title.title__h3!="Te llamaremos en breve"
						span.paragraph.paragraph__regular.paragraph--big!="Mientras tanto, sería bueno que pensaras en esos "
						span.paragraph.paragraph__regular.paragraph__regular--bold.paragraph--big!="detalles que podrían hacer más agradable el viaje del menor: "
						span.paragraph.paragraph__regular.paragraph--big!="si es la primera vez que vuela o si tiene miedo a volar, si tiene alguna intolerancia, si es tímido o inquieto… Cualquier dato que puedas darnos durante la llamada nos ayudará."

				section.ibe-ckeckin__list.ibe-ckeckin__list--big
					ul.ibe-ckeckin__list-container
						li.ibe-ckeckin__list-item.ibe-ckeckin__list-item--big.ibe-ckeckin__list-item--big-left
							//-button(onclick="window.location.href='http://google.es'", title="Ir a Suscripciones y boletines", class="ibe-checkin__list-link")
							span.ibe-ckeckin__list-box.icon-e_pasaporte
								span.ibe-ckeckin__list-title!="Documentaci&oacute;n"
								span.ibe-ckeckin__list-text!="Según la nacionalidad del menor, y según el destino o el tránsito que vaya a realizar, es posible que necesite ir documentado. "
									a.link.link__regular--underline.link__regular--black!="Inf&oacute;rmate aqu&iacute;."
						li.ibe-ckeckin__list-item.ibe-ckeckin__list-item--big.ibe-ckeckin__list-item--big-right
							a(href="#", title="Ir a centro de ayuda", class="ibe-checkin__list-link")
								span.ibe-ckeckin__list-box.icon-c_restaurante
									span.ibe-ckeckin__list-title!="Menú de niños"
									span.ibe-ckeckin__list-text!="Si es menor de doce años, puedes pedirle un menú especial de niños en los vuelos con servicio de comida."
							
			


	+m-footer({
		"full": true
	})
