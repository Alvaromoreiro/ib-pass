mixin m-link-box(params)
	div.ibe-link-box(data-css="ibe-components/ibe-link-box/ibe-link-box", data-js="ibe-components/ibe-link-box/ibe-link-box", data-ibe-component="true")
		h2(class="title title__h2 u-pb-none")!=params.title
		div.ibe-link-box__list
			each item in params.items
				a.ibe-link-box__link.icon-flecha_1_derecha(data-focusin, href=(item.href !== undefined ? item.href : "#ni"), title="Ir a " + item.text)
					span.ibe-link-box__title(data-fc-height="0", data-dotdotdot-new)!=item.title
					span.ibe-link-box__text(data-dotdotdot-new)!=item.text
