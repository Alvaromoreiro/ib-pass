extends _general/layout__primary
block title
	title!="IBERIA - Tab con calendario"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Tab con calendario"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Tab con calendario"

						div.ibe-tab-box
							div.ibe-tab
								ul.ibe-tab__menu(data-tab="bootstrap-tabdrop" data-tab-text="Otros...")
									li.ibe-tab__menu-item.active
										a.ibe-tab__menu-item__text(href="#tab-1" title="Reserva vuelos" data-toggle="tab")!="Reserva vuelos"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-2" title="Reserva hoteles" data-toggle="tab")!="Reserva hoteles"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-3" title="Oferta con Avios" data-toggle="tab")!="Oferta con Avios"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-4" title="Avios&Money" data-toggle="tab")!="Avios&Money"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-5" title="Transferir Avios" data-toggle="tab")!="Transferir Avios"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-6" title="Upgrading" data-toggle="tab")!="Upgrading"
								.tab-content
									.tab-pane.ibe-tab__container.active(id="tab-1")
										h3.title__h3!="Tus Avios te llevan lejos"
										p.paragraph.paragraph__regular!="Puedes reservar vuelos para ti o para qui&eacute;n quieras a cambio de tus Avios."
										p.paragraph.paragraph__regular!="Aseguramos un m&iacute;nimo de plazas que pueden canjearse por Avios en todos los vuelos del Grupo Iberia (operados por Iberia, Iberia Express e Iberia Regional/Air Nostrum), para facilitar que puedas disfrutar de tus Avios en el vuelo y fechas que m&aacute;s te interesan. En 2016 habr&aacute; m&aacute;s de un mill&oacute;n de plazas para canjear Avios, &iexcl;encuentra la tuya!."
										p.paragraph.paragraph__regular!="Hemos dividido el a&ntilde;o en "
										span.bold!="Temporada Alta y Temporada Baja, con precios en Avios diferentes para que puedas planificar tus vuelos y sacar el mayor partido a tus Avios a partir del 1 de abril. "
										!="Recuerda que los billetes que compres con cargo a Avios antes de esa fecha, mantendr&aacute;n las condiciones del momento de la compra."
										p.paragraph.paragraph__regular!="Lo que ves se&ntilde;alado en rojo son las &eacute;pocas de "
										span.bold!="Temporada Alta "
										!="para utilizar tus Avios en vuelos operados por Iberia. El resto del a&ntilde;o es "
										span.bold!="Temporada Baja. Busca el mejor momento para volar, y aprovecha mejor tus Avios."
										+m-calendar({
											type: "lg"
										})
									.tab-pane.ibe-tab__container(id="tab-2")
									.tab-pane.ibe-tab__container(id="tab-3")
									.tab-pane.ibe-tab__container(id="tab-4")
									.tab-pane.ibe-tab__container(id="tab-5")
									.tab-pane.ibe-tab__container(id="tab-6")
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Prepara tu equipaje",
								title: "Prepara tu equipaje"
							},
							{
								link: "Equipaje de mano",
								title: "Equipaje de mano",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Equipaje facturable",
								title: "Equipaje facturable"
							},
							{
								link: "Equipajes peligrosos",
								title: "Equipajes peligrosos"
							},
							{
								link: "Dispositivos electr&oacute;nicos",
								title: "Dispositivos electrónicos"
							},
							{
								link: "Equipajes especiales",
								title: "Equipajes especiales"
							},
							{
								link: "Equipaje de valor declarado",
								title: "Equipaje de valor declarado"
							},
							{
								link: "Equipaje adicional",
								title: "Equipaje adicional"
							},
							{
								link: "Recomendaciones",
								title: "Recomendaciones"
							}
						]
					})
			div.row
				div.col-xs-12
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Tab con calendario"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Tab con calendario"
						div.ibe-tab-box
							div.ibe-tab
								ul.ibe-tab__menu(data-tab="bootstrap-tabdrop" data-tab-text="Otros...")
									li.ibe-tab__menu-item.active
										a.ibe-tab__menu-item__text(href="#tab-11" title="Reserva vuelos" data-toggle="tab")!="Reserva vuelos"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-21" title="Reserva hoteles" data-toggle="tab")!="Reserva hoteles"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-31" title="Oferta con Avios" data-toggle="tab")!="Oferta con Avios"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-41" title="Avios&Money" data-toggle="tab")!="Avios&Money"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-51" title="Transferir Avios" data-toggle="tab")!="Transferir Avios"
									li.ibe-tab__menu-item
										a.ibe-tab__menu-item__text(href="#tab-61" title="Upgrading" data-toggle="tab")!="Upgrading"
								.tab-content
									.tab-pane.ibe-tab__container.active(id="tab-11")
										h3.title__h3!="Tus Avios te llevan lejos"
										p.paragraph.paragraph__regular!="Puedes reservar vuelos para ti o para qui&eacute;n quieras a cambio de tus Avios."
										p.paragraph.paragraph__regular!="Aseguramos un m&iacute;nimo de plazas que pueden canjearse por Avios en todos los vuelos del Grupo Iberia (operados por Iberia, Iberia Express e Iberia Regional/Air Nostrum), para facilitar que puedas disfrutar de tus Avios en el vuelo y fechas que m&aacute;s te interesan. En 2016 habr&aacute; m&aacute;s de un mill&oacute;n de plazas para canjear Avios, &iexcl;encuentra la tuya!."
										p.paragraph.paragraph__regular!="Hemos dividido el a&ntilde;o en "
										span.bold!="Temporada Alta y Temporada Baja, con precios en Avios diferentes para que puedas planificar tus vuelos y sacar el mayor partido a tus Avios a partir del 1 de abril. "
										!="Recuerda que los billetes que compres con cargo a Avios antes de esa fecha, mantendr&aacute;n las condiciones del momento de la compra."
										p.paragraph.paragraph__regular!="Lo que ves se&ntilde;alado en rojo son las &eacute;pocas de "
										span.bold!="Temporada Alta "
										!="para utilizar tus Avios en vuelos operados por Iberia. El resto del a&ntilde;o es "
										span.bold!="Temporada Baja. Busca el mejor momento para volar, y aprovecha mejor tus Avios."
										+m-calendar({
											type: "xl"
										})
									.tab-pane.ibe-tab__container(id="tab-21")
									.tab-pane.ibe-tab__container(id="tab-31")
									.tab-pane.ibe-tab__container(id="tab-41")
									.tab-pane.ibe-tab__container(id="tab-51")
									.tab-pane.ibe-tab__container(id="tab-61")
