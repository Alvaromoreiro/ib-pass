							.col-xs-12
								.ibe-flights-plus-hotel__box
									+m-card-link({
										"isLink": true,
										"mainClass": "xl",
										"autoHeight": "",
										"title": {
											"name": "Un trato especial en tierra",
											"icon": true
										},
										"image": {
											"src": "/content/grecia.jpg",
											"alt": "Ofeta Grecia"
										},
										"logo": {
											"bool": false
										},
										"typeContent": "description",
										description: {
											title: "El pasajero que nunca vuela a tu lado",
											text: "Siempre dispondr&aacute;s de un asiento libre al lado, as&iacute; consingues un mayor confort y m&aacute;s espacio sobre ti."
										},
										"highlight": false
									})
