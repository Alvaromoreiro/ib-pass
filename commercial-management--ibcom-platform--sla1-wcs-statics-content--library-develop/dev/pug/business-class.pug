extends _general/layout__primary
block title
	title!="IBERIA - Business Class"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
