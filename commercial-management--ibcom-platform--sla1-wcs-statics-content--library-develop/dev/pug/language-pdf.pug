extends _general/layout__primary
block title
	title!="IBERIA - Promo BusinessPlus"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})
	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Language PDF module"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Language PDF module"

					div.row
						div.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"mainClass": "red",
									"cssClass": "",
									"title": {
										"name": "Derechos del pasajero"
									},
								})

					div.row
						div.col-md-6.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"mainClass": "red",
									"title": {
										"name": "Derechos del pasajero"
									},
								})

						div.col-md-6.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"mainClass": "red",
									"title": {
										"name": "Derechos del pasajero"
									}
								})

					div.row
						div.col-md-4.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"heightnumber": "1",
									"mainClass": "red",
									"title": {
										"name": "Derechos del pasajero"
									}
								})
						div.col-md-4.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"mainClass": "red",
									"title": {
										"name": "Derechos del pasajero"
									}
								})
						div.col-md-4.col-xs-12
							.ibe-flights-plus-hotel__box
								+m-language-pdf({
									"mainClass": "red",
									"title": {
										"name": "Derechos del pasajero"
									}
								})
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-language-pdf({
						"mainClass": "red",
						"cssClass": "ibe-language-pdf--left-column",
						"title": {
							"name": "Derechos del pasajero"
						}
					})
			div.row
				div.col-xs-12
					.ibe-flights-plus-hotel__box
						+m-language-pdf({
							"mainClass": "red",
							"cssClass": "ibe-language-pdf--wide",
							"title": {
								"name": "Derechos del pasajero"
							}
						})


	+m-footer()
