extends _general/layout__primary
block title
    title!="IBERIA - Stop Over - Modules Partners"
block body
    +m-header-new({
        "login": false
    })
    // Inicio nuevogul menu
    //- +m-menu-new({
    //- 	"login": false
    //- })
    // End wrapper
    main.ibe-landing-apps
        //- +m-ibe-breadcrumbs({
        //- 	menu: "checkin"
        //- })
        h1.hideAccessible Stop Over - Modules Partners
        .ibe-floatbanner.ibe-floatbanner--left.ibe-floatbanner--white
            .container
                .row
                    .col-xs-12.col-md-6
                        .ibe-floatbanner__background(style="background-image: url('images/content/1000x650.jpg')")
                    .col-xs-12.col-md-6
                        .ibe-floatbanner__content
                            p!="MAD about"
                            p!="THE CITY"
                            p!="Monumentos, museos, eventos... Toda la oferta cultural de la capital, aquí."
                            a(href="#", data-hover="Reserva ya tu hotel").ibe-button.ibe-button--red.ibe-button--small
                                span.ibe-search-flights__cover-box__button Descubrela
        div.ibe-floatbanner.ibe-floatbanner--reverse
            div.ibe-floatbanner__content.ibe-floatbanner__content--white
                 div.container
                    div.row
                        div.col-xl-12
                            p!="MAD about"
                            p!="HOTELS"
                            p!="Si haces noche en Madrid, encuentra el alojamiento que mejor te venga."
                            a(href="#", data-hover="Reserva ya tu hotel").ibe-button.ibe-button--red.ibe-button--small
                                span.ibe-search-flights__cover-box__button Consulta
            div.ibe-floatbanner__content.ibe-floatbanner__img(style="background-image: url('images/content/2000x800.jpg')")
    +m-footer({
    })
