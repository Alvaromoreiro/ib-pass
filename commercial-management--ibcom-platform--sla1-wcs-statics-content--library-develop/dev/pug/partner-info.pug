							div.ibe-modal_body-logos
								ul.ibe-modal_body-logos_container.clearfix
									li.ibe-modal_body-logos_container-item
										a(href="#" title="Finnair")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/finnair.png" alt="Logo Finnair")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="British Airways")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/british_airways.png" alt="Logo British Airways")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="American Airlines")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")
								ul.ibe-modal_body-logos_container.clearfix
									li.ibe-modal_body-logos_container-item
										a(href="#" title="British Airways")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/british_airways.png" alt="Logo British Airways")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="Finnair")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/finnair.png" alt="Logo Finnair")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="American Airlines")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")
								ul.ibe-modal_body-logos_container.clearfix
									li.ibe-modal_body-logos_container-item
										a(href="#" title="American Airlines")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="British Airways")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/british_airways.png" alt="Logo British Airways")
									li.ibe-modal_body-logos_container-item
										a(href="#" title="Finnair")
											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/finnair.png" alt="Logo Finnair")
							.row
								.col-xs-12.col-md-6
									.ibe-infocheckin__boxed(data-fc-minibox-height)
										.row
											.col-md-4.col-xs-12
												figure.ibe-figure.ibe-figure--img-left
													img.ibe-img(src=globals.imgPath + "/general/logo-iberia.png" alt="Iberia")

											.col-md-8.col-xs-12
												h4.title.title__h4.ibe-infocheckin__box-title!="Iberia"

												p.paragraph.paragraph__regular
													a.link.link__regular.link__regular--important.link__regular--double-arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"

												p.paragraph.paragraph__regular!="Desde su fundaci&oacute;n en 1927, m&aacute;s de 800 millones de personas han viajado con el Grupo Iberia. Actualmente, vuela a 119 destinos en 43 pa&iacute;ses, y realiza en torno a 600 vuelos diarios. "
								.col-xs-12.col-md-6
									.ibe-infocheckin__boxed(data-fc-minibox-height)
										.row
											.col-md-4.col-xs-12
												figure.ibe-figure.ibe-figure--img-left
													img.ibe-img(src=globals.imgPath + "/general/logo-iberia-express.png" alt="Iberia Express")

											.col-md-8.col-xs-12
												h4.title.title__h4.ibe-infocheckin__box-title!="Iberia"

