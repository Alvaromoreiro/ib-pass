									"link": {
										"name": "Lorem ipsum"
									},
									"image": {
										"src": "/modules/ibe-card-box/1280x720.png",
										"alt": "Ofeta Disneyland"
									},
									"title": "Lorem ipsum",
									"text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent sollicitudin tortor justo, id tincidunt sapien volutpat non.",
									"priceText": true,
									"price": true
								})
							div.col-md-6.col-sm-6.col-xs-12.ibe-card-box--type-link.ibe-card-box--md
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": false,
									"autoHeight": "ibe-card-box__content--auto-height",
									"link": {
										"name": "Lorem ipsum"
