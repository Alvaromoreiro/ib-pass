extends _general/layout__primary
include _modules/_ibe_ask-us
//- include _modules/_ibe_card-box
block title
	title!="IBERIA - Listado de oficinas"
block body
	//Inicio nuevo header
	+m-header-new({
		"login": false
	})
	//Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	main
		+m-ibe-breadcrumbs({
			"menu": "advSearch"
		})
		section.container
			div.row
				div.col-xl-12
					h1.title.title__h1.title--center.title--grey.title--padding-bottom-short.title--paddT-smaller!="Oficinas de Iberia"
					h2.title.title__h5.title.title__h5--small.title--center.title--p-top-0.title--light.title--p-bottom-24!="Estamos a tu disposici&oacute;n en nuestra amplia red de oficinas."
			div.row
				div.col-xl-9.col-lg-9.col-md-12.col-sm-12.col-xs-12
					p.hideAccessible Oficinas de Iberia
					section.ibe-box-landing
						div.ibe-box-landing__terciary.ibe-box-landing__terciary--office
							div.ibe-box__primary--separator
								h3.title__h3.ibe-card-cont__title.ibe-card-cont__title--black Buscador de oficinas
								.row
									.col-md-6.col-xs-12
										.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="claim-type")
												span.ibe_form__input-text En España
											select(id="claim-type", class="ibe-select ibe_form__input-text", name="claim-type", data-selectmenu="",  data-valid, data-focusin)
												option(value="" disabled) En España
												option(value="Madrid") Madrid
												option(value="Sevilla") Sevilla
												option(value="Barcelona") Barcelona
												option(value="Santiago de compostela") Santiago de compostela
											p.hideAccessible Selector de oficinas en españa
											// p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
									.col-md-6.col-xs-12
										.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop.ibe-form__group--m-t-mobile(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="claim-reason00")
												span.ibe_form__input-text Resto del mundo
											select(id="claim-reason00", class="ibe-select ibe_form__input-text", name="claim-reason00", data-selectmenu="", data-focusin)
												option(value="") Resto del mundo
												option(value="Francia") Francia
												option(value="Alemania") Alemania
												option(value="Portugal") Portugal
											p.hideAccessible Selector de oficinas en el resto del mundo
											// p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
							h3.title__h3.ibe-card-cont__title.ibe-card-cont__title--black Oficinas de Madrid
							.ibe-box__primary--separator
								h4.title__h5.title__h5--small.title__h5--small-pb!="Reservas"
								p.paragraph.paragraph__regular.paragraph__regular--medium.paragraph__regular--bold 901 111 500
							div.ibe-box__primary--separator
								//h4.title__h5.title__h5--small.title__h5--small-pb!="Centro de Iberia Plus"
								p.paragraph.paragraph__regular.paragraph__regular--medium
									span.paragraph.paragraph__regular--bold 901 201 214
									span.paragraph.paragraph__regular--medium 24 horas de lunes a domingo
								p.paragraph.paragraph__regular.paragraph__regular--medium Apdo. Correos 62033
									span.show 28080 MADRID
									span.show S&oacute;lo v&aacute;lido como direcci&oacute;n postal
								p.paragraph.paragraph__regular.paragraph__regular--medium Correo electr&oacute;nico:
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="clasica@iberia.es"
								p.paragraph.paragraph__regular.paragraph__regular--medium
									span.paragraph.paragraph__regular--bold Indicar en el asunto del e-mail el n&uacute;mero de su tarjeta Iberia Plus.
									span.paragraph.paragraph__regular--medium Solo se atender&aacute;n solicitudes en español o ingl&eacute;s.
							div.ibe-box__primary--separator
								h4.title__h5.title__h5--small.title__h5--small-pb!="Madrid, oficinas aeropuerto"
								p.paragraph.paragraph__regular.paragraph__regular--medium Terminal 4, salidas ( vuelos nacionales, Schengen y puente aéreo)
								p.paragraph.paragraph__regular.paragraph__regular--medium Terminal 4S, salidas (vuelos no Schengen y algunos nacionales y Schenhen)
							div
								h4.title__h5.title__h5--small.title__h5--small-pb!="Centro de Atenci&oacute;n Iberia Equipaje"
								p.paragraph.paragraph__regular.paragraph__regular--medium
									span.paragraph.paragraph__regular--bold 901 201 214
									span.paragraph.paragraph__regular--medium 24 horas de lunes a domingo
					section.xs-12.ibe-box-landing__terciary--publi
						article.ibe-infocheckin__box.ibe-infocheckin__box--no-margin.ibe-infocheckin__box--medium.ibe-infocheckin__box--icon(data-view-more='parent')
							figure.ibe-figure
								img.ibe-img(src="images/modules/icons/svgs/informacion_2.svg", alt="imagen informativa")
							h3.title.title__h3.ibe-infocheckin__box-title Es posible realizar llamadas
							div.xui-collapse_moreInfo-text-close(data-view-more='container')
								p.paragraph.paragraph__regular.paragraph__regular--grey En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente.
								p.paragraph.paragraph__regular.paragraph__regular--grey En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente.
								p.paragraph.paragraph__regular.paragraph__regular--grey En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente.
								p.paragraph.paragraph__regular.paragraph__regular--grey En tu asiento dispones de un tel&eacute;fono t&aacute;ctil con el que podr&aacute;s comunicarte con tus compa&ntilde;eros de viaje de manera gratuita o llamar a tierra c&oacute;modamente.
							a.link.link__regular.ibe-link-view-more.ibe-link-view-more--more(href="#", title="Mostrar m&aacute;s", data-view-more='button', data-text-expanded="Ocultar", data-text-collapsed="Leer m&aacute;s", data-value="more", data-focusin)!="Leer m&aacute;s"
						div.row
							div.col-md-6.col-sm-6.col-xs-12.ibe-card-box--type-link.ibe-card-box--md
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": false,
