extends _general/layout__primary
include _modules/stopover/_ibe_stopover_top-banner
include _modules/stopover/_ibe_stopover_experience-grid
include _modules/stopover/_ibe_stopover_discover
include _modules/stopover/_ibe_stopover_carousel-wall-images
include _modules/stopover/_ibe_stopover_recommendation-card
include _modules/stopover/_ibe_stopover_partners
include _modules/stopover/_ibe_stopover_mail

include _modules/_ibe_banner_stopover
include _modules/_ibe_steps_stopover
include _modules/_ibe_discover
include _modules/_ibe_carousel_cards-slider
include _modules/_ibe_carousel_wall-slider
include _modules/_ibe_carousel_imgs-slider
include _modules/_ibe_discover

block title
	title!='IBERIA - Stopover Landing page'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper

	main.ibe-main__footer--without-margin
		// Main content
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})

		+m-ibe-stopover_top-banner({
				"dataBackground": '/images/modules/stopover/bg-stopover-home-header',
				"isSearcher": true,
				"classSearcher" : "ibe-search-collapse-stopover-position__primary",
				"type" : "home",
				"infoBanner" : true
		})
		div.container
			+m-ibe-stopover_experience-grid({
				"filter" : false,
				"slider" : true
			})

		+m-ibe-stopover_discover()
		+m-ibe-stopover_carousel-wall-images()

		div.container
			+m-ibe-stopover_recommendation-card({
				"single" : false
			})
			+m-ibe-stopover_partners()
			+m-ibe-stopover_mail()
		+m-ibe-stopover_top-banner({
			"type" : "actionButtonHome",
		})
	+m-footer({
		"full": true
	})
