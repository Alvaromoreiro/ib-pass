extends _general/layout__primary
block title
	title!="IBERIA - Error Bloqueo Temporal"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	section.container
		div.row
			div.col-xs-12
				section.ibe-infocheckin.u-text-center
					header.ibe-infocheckin__header--separation-top-s.ibe-infocheckin__header--nomargin-bottom
						span.icon-alerta_grave.ibe-infocheckin__icon.ibe-infocheckin__icon--big
						h1.title__h1.title--p-bottom-18 Lo sentimos, acceso restringido
					h2.title--information.title__h4.title__h4--spaced En estos momentos, el acceso al &aacute;rea personal de Iberia Plus para este usuario est&aacute; bloqueado
					p.title--pad-bottom-24.title__h5.title__h5--small.paragraph--big-20.margin-auto El acceso se ha denegado porque se han introducido varias combinaciones incorrectas de número de Iberia Plus y contraseña.
					p.title__h5.title__h5--small.title--pad-bottom-22 Para desbloquear tu cuenta puedes contactar con nosotros llamando al 
							span.title--red 901 222 422
							span  y facilitar este c&oacute;digo:
					.ibe-box-error__code.u-text-center
							span.title__h4 C&oacute;digo de bloqueo:
							.ibe-block-info.talign-center
								.valign-center.positionR
									span.icon-seguridad.title--red.paragraph.paragraph__regular--prize.show.ftl.u-pt-xsmall
									span.title__h2.title--red.title__h2--pad-r10 UB003 - 02
					p.margin-auto.title__h5.title__h5--small.paragraph--big-w
							span.show.u-pt-xsmall Puedes desbloquear tu cuenta volviendo a identificarte con tus datos correctamente pasado un tiempo.
					div.ibe-box-error__buttons--continue
								a.ibe-button.ibe-button--red.ibe-button--small.ibe-button--one-third-container.ibe-button--one-third-continue(href="#", tabindex="0")
									span.ibe-button__txt Continuar
	+m-footer()
