extends _general/layout__primary
block title
	title!="IBERIA - Informaci&oacute;n anticipada sobre Pasajeros"
block body
	+m-ibe-tools()
	+m-header-save({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Informaci&oacute;n anticipada sobre Pasajeros"
						article.ibe-infocheckin__box
							p.paragraph.paragraph__regular.paragraph__regular--grey!="Los gobiernos de determinados pa&iacute;ses exigen a las Compa&ntilde;&iacute;as A&eacute;reas que recopile Informaci&oacute;n espec&iacute;fica de los Pasajeros antes de comenzar el viaje (API, Informaci&oacute;n de Pasajeros Anticipada)."
							p.paragraph.paragraph__regular.paragraph__regular--grey!="En Iberia.com puedes introducir la informaci&oacute;n requerida a trav&eacute;s de "
							a.link.link__regular.link__regular--important(href="#" title="Gestión de reserva")!="Gesti&oacute;n de reserva"
							!=" y ahorrar tiempo en el aeropuerto el d&iacute;a de tu viaje."
							p.paragraph.paragraph__regular.paragraph__regular--grey!="Te recomendamos que prestes m&aacute;xima antenci&oacute;n al cumplimientar los datos para evitar esperas en los Controles Oficiales de Inmigraci&oacute;n"
							p.paragraph.paragraph__regular.paragraph__regular--grey!="Para m&aacute;s informaci&oacute;n de la documentaci&oacute;n exigida por el gobiernos del pa&iacute;s al que vas a viajar, consulta en nuestra p&aacute;gina de "
							a.link.link__regular.link__regular--important(href="#" title="Documentación")!="Documentaci&oacute;n."
							span.title__h6.title--bold!="M&aacute;s informaci&oacute;n sobre los requisitos exigidos por los siguientes pa&iacute;ses:"
							ul.ibe-list.ibe-list--simple
								li.ibe-list__item
									a.link.link__regular.link__regular--important(href="#" title="EE.UU")!="EE.UU"
								li.ibe-list__item
									a.link.link__regular.link__regular--important(href="#" title="España")!="Espa&ntilde;a"
								li.ibe-list__item
									a.link.link__regular.link__regular--important(href="#" title="Reino Unido")!="Reino Unido"
								li.ibe-list__item
									a.link.link__regular.link__regular--important(href="#" title="M&eacute;xico, Cuba y Rep&uacute;blica Dominicana")!="M&eacute;xico, Cuba y Rep&uacute;blica Dominicana"
						h2.title.title__h3!="EE.UU"
						article.ibe-infocheckin__box.ibe-infocheckin__box--no-title
							p.paragraph.paragraph__regular.paragraph__regular--grey!="La legislaci&oacute;n estadounidense exige la siguiente informaci&oacute;n de todos los pasajeros que viajen a o desde EE.UU."
							ul.ibe-list.ibe-list--checked
								li.ibe-list__item.ibe-list__item--correct
									span.title__h6.title--bold!="La informaci&oacute;n del pasaporte, incluyendo:"
									ul.ibe-list.ibe-list--square-o
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="N&uacute;mero de pasaporte"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Pa&iacute;s que emiti&oacute; el pasaporte"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Fecha de caducidad del pasaporte"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Nombre (como aparecen en el pasaporte)"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Apellido"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Sexo"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Fecha de nacimiento"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Nacionalidad"
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="N&uacute;mero de Registro de Extranjeros (Tarjeta de Residencia) tambi&eacute;n tienen que presentarlo aquellos pasajeros que tengan la residencia en EE.UU."
							ul.ibe-list.ibe-list--checked.no-margin
								li.ibe-list__item.ibe-list__item--correct
									span.title__h6.title--bold!="Adem&aacute;s, los pasajeros que vuelen a EE.UU. tendr&aacute;n que presentar la siguiente informaci&oacute;n:"
									ul.ibe-list.ibe-list--square-o
										li.ibe-list__item
											p.paragraph.paragraph__regular.paragraph__regular--grey!="Pa&iacute;s de residencia"

				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Gestiona tu reserva",
								title: "Gestiona tu reserva"
							},
							{
								link: "Informaci&oacute;n de Pasajeros Anticipada (API)",
								title: "Información de Pasajeros Anticipada (API)",
								cssClass: "ibe-lat-menu__item--active"
							}
						]
					})
		div.ibe-dialog.fc-dialog-uno
			div.modal-dialog
				div.modal-content
					div.ibe-modal
						div.modal-header
							h2.title.title__h1.ibe-modal__title-primary="MyBagTag"
							h3.title.ibe-modal__title-secondary!="Imprime tus etiquetas de equipaje"
							.ibe-modal__options
								button.ibe-button--reset.ibe-modal__options-icon.ibe-modal__options-icon--close(type="button" data-dialog="close")
									span.hideAccessible!="Cerrar"
						div.modal-body
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
						div.modal-footer
							button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--modal(title="Aceptar" data-dialog="close")!="Aceptar"
		div.ibe-dialog.fc-dialog-dos
			div.modal-dialog
				div.modal-content
					div.ibe-modal
						div.modal-header
							h2.title.title__h1.ibe-modal__title-primary="MyBagTag BIS"
							h3.title.ibe-modal__title-secondary!="Imprime tus etiquetas de equipaje"
							.ibe-modal__options
								button.ibe-button--reset.ibe-modal__options-icon.ibe-modal__options-icon--close(type="button" data-dialog="close")
									span.hideAccessible!="Cerrar"
						div.modal-body
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
							figure.ibe-modal_figure.ibe-modal_figure--video
								img.ibe-modal_figure-image(src=globals.imgPath + "/general/modal-4.png" alt="Imagen 4")
						div.modal-footer
							button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--modal(title="Aceptar" data-dialog="close")!="Aceptar"

	+m-footer()
