extends _general/layout__primary
block title
	title!="IBERIA - Componente tarjeta"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Componente tarjeta"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Componente tarjeta"

						article.ibe-infocheckin__box.ibe-infocheckin__box--card
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/content/targeta.png" alt="Tarjeta Iberia Plus")
							div.ibe-infocheckin__box-container
								h3.title.title__h3.ibe-infocheckin__box-title!="Empieza a sentirte un viajero especial"
								p.paragraph.paragraph__regular.paragraph__regular--grey!="Solo por darte de alta en el programa Iberia Plus ya tienes ventajas en tus viajes:"
								ul.ibe-list.ibe-list--normal
									li.ibe-list__item!="Acceso a clase superior con tus Avios y servicio telef&oacute;nico 24 horas"
									li.ibe-list__item!="Orden preferente en las listas de espera del aeropuerto"
								button.ibe-button.ibe-button--red.ibe-button--big(type="button")!="Date de alta en Iberia Plus"

						article.ibe-infocheckin__box.ibe-infocheckin__box--card.ibe-infocheckin__box--baggage
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/content/equipaje.png" alt="Tarjeta Iberia Plus")
							div.ibe-infocheckin__box-container
								h3.title.title__h3.ibe-infocheckin__box-title Peso y medidas estándar máximas
								p.paragraph.ibe-prepare-baggage__box-paragraph-sep
									span.ibe-prepare-baggage__features-baggage 23 kg
										span.ibe-prepare-baggage__features-baggage.ibe-prepare-baggage__features-baggage--small (máximo 32 kg)
									span.ibe-prepare-baggage__features-baggage 158 cm
										span.ibe-prepare-baggage__features-baggage.ibe-prepare-baggage__features-baggage--small (alto+ancho+largo)
								p.paragraph.paragraph__regular El peso máximo de cada pieza es de 23 kg y puedes abonar una tarifa fija de sobrepeso hasta un máximo de 32 kg. Para llevar equipaje adicional, puedes contratarlo previamente al hacer la reserva (una primera maleta adicional), posteriormente a través de
									a.link.link__regular.link__regular--important(href='#Casosexcepcionales', title='Ir a excepciones')  Gestión de reservas
									span.paragraph.paragraph__regular  o durante el check-in online si necesitas llevar más equipajeAconsejamos llegar al menos 20 minutos antes de la hora recomendada si llevas equipaje adicional.
								p.paragraph.paragraph__regular Tendrás descuento si lo contratas antes de ir al aeropuerto. Consulta los
									a.link.link__regular.link__regular--important(href='#Casosexcepcionales', title='Ir a excepciones')  aeropuertos disponibles
									span.paragraph.paragraph__regular  para comprar
									a.link.link__regular.link__regular--important(href='#Casosexcepcionales', title='Ir a excepciones')  equipaje adicional
									span.paragraph.paragraph__regular  en
									a.link.link__regular.link__regular--important(href='#urliberia', title='Ir a iberia')  iberia.com.
								p.paragraph.paragraph__regular Existen algunas
									a.link.link__regular.link__regular--important(href='#Casosexcepcionales', title='Ir a excepciones')  excepciones.




				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Prepara tu equipaje",
								title: "Prepara tu equipaje"
							},
							{
								link: "Equipaje de mano",
								title: "Equipaje de mano",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Equipaje facturable",
								title: "Equipaje facturable"
							},
							{
								link: "Equipajes peligrosos",
								title: "Equipajes peligrosos"
							},
							{
								link: "Dispositivos electr&oacute;nicos",
								title: "Dispositivos electrónicos"
							},
							{
								link: "Equipajes especiales",
								title: "Equipajes especiales"
							},
							{
								link: "Equipaje de valor declarado",
								title: "Equipaje de valor declarado"
							},
							{
								link: "Equipaje adicional",
								title: "Equipaje adicional"
							},
							{
								link: "Recomendaciones",
								title: "Recomendaciones"
							}
						]
					})
			div.row
				div.col-xs-12
					section.ibe-infocheckin
						article.ibe-infocheckin__box.ibe-infocheckin__box--card.ibe-infocheckin__box--wide
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/content/targeta.png" alt="Tarjeta Iberia Plus")
							div.ibe-infocheckin__box-container
								h3.title.title__h3.ibe-infocheckin__box-title!="Empieza a sentirte un viajero especial"
								p.paragraph.paragraph__regular.paragraph__regular--grey!="Solo por darte de alta en el programa Iberia Plus ya tienes ventajas en tus viajes:"
								ul.ibe-list.ibe-list--normal
									li.ibe-list__item!="Acceso a clase superior con tus Avios y servicio telef&oacute;nico 24 horas"
									li.ibe-list__item!="Orden preferente en las listas de espera del aeropuerto"
								button.ibe-button.ibe-button--red.ibe-button--big(type="button")!="Date de alta en Iberia Plus"


	+m-footer()
