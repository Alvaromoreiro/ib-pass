extends _general/layout__primary
include _modules/stopover/_ibe_stopover_faqs
include _modules/stopover/_ibe_stopover_top-banner
include _modules/stopover/_ibe_stopover_experience-grid

block title
	title!='IBERIA - Stopover Descubre'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	+m-ibe-stopover_top-banner({
		"dataBackground": 'images/modules/stopover/banner-faqs',
		"isSearcher": true,
		"classSearcher" : "ibe-stopover-banner--searcher",
		"type" : "text"
    })
	main.container
		// Main content
				
		+m-ibe-stopover_faqs()
	main.container
		+m-ibe-stopover_experience-grid({
			"filter" : false,
			"slider" : true
		})
	+m-footer({
		"full": true  
	})