extends _general/layout__primary
block title
	title!="IBERIA - Partners Iberia Plus"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Partners Iberia Plus"

						article.ibe-infocheckin__box
							h3.title__h3.ibe-infocheckin__box-title!="Descripci&oacute;n de empresa"

							.row
								.col-xs-12
									+m-ibe-breadcrumbs({
										"menu": "partners"
									})
							.row
								.col-md-2.col-xs-12
									figure.ibe-figure.ibe-figure--img-left
										img.ibe-img(src=globals.imgPath + "/general/logo-nh-group.png" alt="NH Hotel Group")

								.col-md-10.col-xs-12
									h4.title.title__h4.ibe-infocheckin__box-title!="NH Hotel Group"

									p.paragraph.paragraph__regular
										a.link.link__regular.link__regular--important.link__regular--double-arrow(href="#" title="Ver todos los establecimientos")!="Ver todos los establecimientos"

									p.paragraph.paragraph__regular!="Operamos cerca de 400 hoteles con casi 60.000 habitaciones en 27 paises de Europa, Am&eacute;rica y &Aacute;frica y en destinos tales como Berl&iacute;n, Madrid, Amsterdam, Bruselas, Par&iacute;s, Buenos Aires, Londres, Roma, M&eacute;xico DF, Barcelona, Frankfurt o Nueva York. Nuestros hoteles son reconocidos por su calidad, tanto en servicios como en instalaciones."

									p.paragraph.paragraph__regular.paragraph__regular--grey.bold!="La anotación de Avios se realizar&aacute; en un plazo m&aacute;ximo de 2 semanas"

									h5.title.title__h5.ibe-infocheckin__box-title!="Nuestras marcas"

									div.ibe-tab.ibe-tab--img
										ul.ibe-tab__menu(data-tab="jquery-ui")
											li.ibe-tab__menu-item.active
												a.ibe-tab__menu-item-img(href="#tab1" title="NH Hotels" data-toggle="tab")
													figure.ibe-figure
														img.ibe-img(src=globals.imgPath + "/general/logo-nh-hotels.png" alt="NH Hotels")
											li.ibe-tab__menu-item
												a.ibe-tab__menu-item-img(href="#tab2" title="NH Collection" data-toggle="tab")
													figure.ibe-figure
														img.ibe-img(src=globals.imgPath + "/general/logo-nh-collection.png" alt="NH Collection")
											li.ibe-tab__menu-item
												a.ibe-tab__menu-item-img(href="#tab3" title="NH Hotels" data-toggle="tab")
													figure.ibe-figure
														img.ibe-img(src=globals.imgPath + "/general/logo-nh-hotels.png" alt="NH Hotels")
											li.ibe-tab__menu-item
												a.ibe-tab__menu-item-img(href="#tab4" title="NH Collection" data-toggle="tab")
													figure.ibe-figure
														img.ibe-img(src=globals.imgPath + "/general/logo-nh-collection.png" alt="NH Collection")
										.tab-content
											.tab-pane.ibe-tab__container.ibe-tab__container--img.active(id="tab1")
												h5.title.title__h6.ibe-infocheckin__box-title.bold!="NH HOTELS"
												p.paragraph.paragraph__regular!="Hoteles urbanos de 4 y 3 estrellas para aquellos viajeros que, por ocio o por negocio, buscan una ubicación excelente con la mejor relaci&oacute;n calidad-precio. Habitaciones confortables y funcionales con instalaciones y servicios adecuados a sus necesidades."
												p.paragraph.paragraph__regular!="Con las mejores soluciones en el segmento de reuniones y eventos de empresa. A trav&eacute;s de una atenci&oacute;n cercana y natural, se preocupan para que cada cliente obtenga lo que necesita de su estancia, haciendo que sea una experienza memorable. Somos su referencia en la ciudad."
												p.paragraph.paragraph__regular
													a.link.link__regular.link__regular--important.link__regular--double-arrow(href="#" title="Ver todos los establecimientos")!="Ver todos los establecimientos"

											.tab-pane.ibe-tab__container(id="tab2")
												.row
													.col-xs-12.col-md-6
														p.paragraph.paragraph__regular.paragraph__regular--grey!="En todas las salas se puede encontrar una zona de bar y otra de caf&eacute; donde, permanentemente, los clientes tienen a su disposici&oacute;n una gran variedad de ensaladas, sandwiches, paninis, caf&eacute;s y todo tipo de bebidas. Adem&aacute;s boller&iacute;a variada, pan de leche y pan sueco"
													.col-xs-12.col-md-6
														p.paragraph.paragraph__regular.paragraph__regular--grey!="En todas las salas se puede encontrar una zona de bar y otra de caf&eacute; donde, permanentemente, los clientes tienen a su disposici&oacute;n una gran variedad de ensaladas, sandwiches, paninis, caf&eacute;s y todo tipo de bebidas. Adem&aacute;s boller&iacute;a variada, pan de leche y pan sueco"

											.tab-pane.ibe-tab__container(id="tab3")
												h5.title.title__h6.ibe-infocheckin__box-title.bold!="Un servicio exquisito"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="En todas las salas se puede encontrar una zona de bar y otra de caf&eacute; donde, permanentemente, los clientes tienen a su disposici&oacute;n una gran variedad de ensaladas, sandwiches, paninis, caf&eacute;s y todo tipo de bebidas. Adem&aacute;s boller&iacute;a variada, pan de leche y pan sueco"
												p.paragraph.paragraph__regular.paragraph__regular--grey
													span.bold!="Restaurante Vel&aacute;zquez Bistro: "
													!="Los clientes con vuelos nocturnos a destinos no Schengen tienen a su disposici&oacute;n un restaurante con vistas a las pistas para cenar a la carta"
												p.paragraph.paragraph__regular.paragraph__regular--grey
													span.bold!="Rinc&oacute;n del vino: "
													!="En las salas VIP 'Dal&iacute;' y 'Vel&aacute;zquez' de la T4, Iberia pone a disposici&oacute;n de sus clientes un Rinc&oacute;n del Vino, donde pueden degustar -con el asesoramiento de un sumiller- la bodega que, cada mes, se sirve en la Business Plus de los vuelos de largo radio."

											.tab-pane.ibe-tab__container(id="tab4")
												h5.title.title__h6.ibe-infocheckin__box-title.bold!="Un servicio exquisito"
												p.paragraph.paragraph__regular.paragraph__regular--grey!="En todas las salas se puede encontrar una zona de bar y otra de caf&eacute; donde, permanentemente, los clientes tienen a su disposici&oacute;n una gran variedad de ensaladas, sandwiches, paninis, caf&eacute;s y todo tipo de bebidas. Adem&aacute;s boller&iacute;a variada, pan de leche y pan sueco"
												p.paragraph.paragraph__regular.paragraph__regular--grey
													span.bold!="Restaurante Vel&aacute;zquez Bistro: "
													!="Los clientes con vuelos nocturnos a destinos no Schengen tienen a su disposici&oacute;n un restaurante con vistas a las pistas para cenar a la carta"
												p.paragraph.paragraph__regular.paragraph__regular--grey
													span.bold!="Rinc&oacute;n del vino: "
													!="En las salas VIP 'Dal&iacute;' y 'Vel&aacute;zquez' de la T4, Iberia pone a disposici&oacute;n de sus clientes un Rinc&oacute;n del Vino, donde pueden degustar -con el asesoramiento de un sumiller- la bodega que, cada mes, se sirve en la Business Plus de los vuelos de largo radio."


							.row
								.col-xs-12
									.ibe-toggle-tab.ibe-toggle-tab--separator
										header.ibe-toggle-tab__header
											figure.ibe-fig
												img.ibe-img(src=globals.imgPath + "/content/logo-avios.png" alt="Logo avios")
											ul.nav.nav-tabs.ibe-tab(role="tablist" data-tab="bootstrap-tab")
												li.ibe-tab__item
