										div.ibe-toggle-tab__body
											div.tab-content
												div.tab-pane(id="tab-1" role="tabpanel")
													article.ibe-paper-sheet
														div.ibe-paper-sheet__container
															header.ibe-paper-sheet__header
																h3.title__h1.ibe-paper-sheet__header-title-primary NH Hotel Group
																h4.ibe-paper-sheet__header-title-secondary Nh Hoteles
																div.ibe-paper-sheet__options
																	button.ibe-button--reset.ibe-paper-sheet__options-close(data-tab="close-bootstrap-tab")
																		span.hideAccessible Cerrar
															div.ibe-paper-sheet__body
																h2.title.title__h2 Tabla de obtención de Avios Nh Hoteles
																div.ibe-table-responsive
																	table.ibe-table.ibe-table--border
																		caption.hideAccessible
																		thead.ibe-table__thead
																			tr.ibe-table__thead-tr
																				th.ibe-table__thead-th Hoteles
																				th.ibe-table__thead-th Avios/noche
																		tbody.ibe-table__tbody
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH COLLECTION/NHOW/HESPERIA 5*
																				td.ibe-table__tbody-td 450
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH 3*/ HESPERIA 4*
																				td.ibe-table__tbody-td 350
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH 3*/ HESPERIA 3*
																				td.ibe-table__tbody-td 200
																p.paragraph.paragraph__regular.bold Consulta la lista de hoteles NH incluidos en el Programa Iberia Plus en el 902 115 116.
																p.paragraph.paragraph__regular El titular de la Tarjeta Iberia Plus debe identificarse como tal en el momento de la reserva y registrarse en la recepción del hotel para la Obtención de Avios y ventajas adiciionales. Sólo se concederán Avios con Tarifa Oficial y Corporativa (quedan excluidas tarifas reducidas o promocionales así mismo aquiellas reservas que procedan de agencias de viaje on-line).
																p.paragraph.paragraph__regular!="Para reclamación de operaciones no anotadas en tu cuenta tendrás que gestionar la solicitud de Avios exclusivamente a través del Centro de Atención a titulares de Fidelización en el teéfono +34 91 398 44 37 ( en España 902.454.444) ó en el e-mail "
																a.link.link__regular.link__regular--important(href="#" title="loyalty@nh-hotels.com") loyalty@nh-hotels.com
												div.tab-pane(id="tab-2" role="tabpanel")
													article.ibe-paper-sheet
														div.ibe-paper-sheet__container
															header.ibe-paper-sheet__header
																h3.title__h1.ibe-paper-sheet__header-title-primary NH Hotel Group 2
																h4.ibe-paper-sheet__header-title-secondary Nh Hoteles
																div.ibe-paper-sheet__options
																	button.ibe-button--reset.ibe-paper-sheet__options-close(data-tab="close-bootstrap-tab")
																		span.hideAccessible Cerrar
															div.ibe-paper-sheet__body
																h2.title.title__h2 Tabla de obtención de Avios Nh Hoteles
																div.ibe-table-responsive
																	table.ibe-table.ibe-table--border
																		caption.hideAccessible
																		thead.ibe-table__thead
																			tr.ibe-table__thead-tr
																				th.ibe-table__thead-th Hoteles
																				th.ibe-table__thead-th Avios/noche
																		tbody.ibe-table__tbody
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH COLLECTION/NHOW/HESPERIA 5*
																				td.ibe-table__tbody-td 450
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH 3*/ HESPERIA 4*
																				td.ibe-table__tbody-td 350
																			tr.ibe-table__tbody-tr
																				td.ibe-table__tbody-td NH 3*/ HESPERIA 3*
																				td.ibe-table__tbody-td 200
																p.paragraph.paragraph__regular.bold Consulta la lista de hoteles NH incluidos en el Programa Iberia Plus en el 902 115 116.
																p.paragraph.paragraph__regular El titular de la Tarjeta Iberia Plus debe identificarse como tal en el momento de la reserva y registrarse en la recepción del hotel para la Obtención de Avios y ventajas adiciionales. Sólo se concederán Avios con Tarifa Oficial y Corporativa (quedan excluidas tarifas reducidas o promocionales así mismo aquiellas reservas que procedan de agencias de viaje on-line).
																p.paragraph.paragraph__regular!="Para reclamación de operaciones no anotadas en tu cuenta tendrás que gestionar la solicitud de Avios exclusivamente a través del Centro de Atención a titulares de Fidelización en el teéfono +34 91 398 44 37 ( en España 902.454.444) ó en el e-mail "
																a.link.link__regular.link__regular--important(href="#" title="loyalty@nh-hotels.com") loyalty@nh-hotels.com

				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Prepara tu equipaje",
								title: "Prepara tu equipaje"
							},
							{
								link: "Equipaje de mano",
