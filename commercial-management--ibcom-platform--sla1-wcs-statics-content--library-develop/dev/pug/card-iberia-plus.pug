extends _general/layout__primary
block title
	title!="IBERIA - Comprar, regalar, transferir"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Conoce las tarjetas de Iberia Plus"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Conoce las tarjetas de Iberia Plus"

						article.ibe-infocheckin__box.ibe-infocheckin__box--card-iberia-plus
							div.row
								div.col-md-3.col-sm-6.col-xs-12
									div.ibe-card-iberia-plus.ibe-card-iberia-plus--first(data-card-iberia-plus="auto-height")
										header.ibe-card-iberia-plus__header
											h4.title.title__h4 Tarjeta CL&Aacute;SICA
										div.ibe-card-iberia-plus__body
											figure.ibe-figure
												img.ibe-img(src=globals.imgPath + "/modules/ibe_cards/ibe-card-plus-normal.png" alt="Tarjeta Iberia")
											p.paragraph.paragraph__regular!="Es la tarjeta que recibes s&oacute;lo por darte de alta en el programa Iberia Plus."
										footer.ibe-card-iberia-plus__footer
											a.link.link__regular.link__regular--important(href="#" title="Más información") M&aacute;s informaci&oacute;n

								div.col-md-3.col-sm-6.col-xs-12
									div.ibe-card-iberia-plus.ibe-card-iberia-plus--first(data-card-iberia-plus="auto-height")
										header.ibe-card-iberia-plus__header
											h4.title.title__h4 Tarjeta PLATA
										div.ibe-card-iberia-plus__body
											figure.ibe-figure
												img.ibe-img(src=globals.imgPath + "/modules/ibe_cards/ibe-card-plus-silver.png" alt="Tarjeta Iberia plata")
											p.paragraph.paragraph__regular.bold!="oneworld: Ruby"
											p.paragraph.paragraph__regular!="Se consigue con: "
											span.bold!="1.100"
											!=" Puntos Elite"
											p.paragraph.paragraph__regular
												span.bold!="25"
												!=" Trayectos"
										footer.ibe-card-iberia-plus__footer
											a.link.link__regular.link__regular--important(href="#" title="Más información") M&aacute;s informaci&oacute;n
								div.col-md-3.col-sm-6.col-xs-12
									div.ibe-card-iberia-plus(data-card-iberia-plus="auto-height")
										header.ibe-card-iberia-plus__header
											h4.title.title__h4 Tarjeta ORO
										div.ibe-card-iberia-plus__body
											figure.ibe-figure
												img.ibe-img(src=globals.imgPath + "/modules/ibe_cards/ibe-card-plus-gold.png" alt="Tarjeta Iberia oro")
											p.paragraph.paragraph__regular.bold!="oneworld: Sapphire"
											p.paragraph.paragraph__regular!="Se consigue con: "
											span.bold!="2.250"
											!=" Puntos Elite"
											p.paragraph.paragraph__regular
												span.bold!="50"
												!=" Trayectos"
										footer.ibe-card-iberia-plus__footer
											a.link.link__regular.link__regular--important(href="#" title="Más información") M&aacute;s informaci&oacute;n
								div.col-md-3.col-sm-6.col-xs-12
									div.ibe-card-iberia-plus.ibe-card-iberia-plus--last(data-card-iberia-plus="auto-height")
										header.ibe-card-iberia-plus__header
											h4.title.title__h4 Tarjeta PLATINO
										div.ibe-card-iberia-plus__body
											figure.ibe-figure
												img.ibe-img(src=globals.imgPath + "/modules/ibe_cards/ibe-card-plus-platino.png" alt="Tarjeta Iberia platino")
											p.paragraph.paragraph__regular.bold!="oneworld: Emerald"
											p.paragraph.paragraph__regular!="Se consigue con: "
											span.bold!="6.250"
											!=" Puntos Elite"
										footer.ibe-card-iberia-plus__footer
											a.link.link__regular.link__regular--important(href="#" title="Más información") M&aacute;s informaci&oacute;n
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Prepara tu equipaje",
								title: "Prepara tu equipaje"
							},
							{
								link: "Equipaje de mano",
								title: "Equipaje de mano",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Equipaje facturable",
								title: "Equipaje facturable"
							},
							{
								link: "Equipajes peligrosos",
								title: "Equipajes peligrosos"
							},
							{
								link: "Dispositivos electr&oacute;nicos",
								title: "Dispositivos electrónicos"
							},
							{
								link: "Equipajes especiales",
								title: "Equipajes especiales"
							},
							{
								link: "Equipaje de valor declarado",
								title: "Equipaje de valor declarado"
							},
							{
								link: "Equipaje adicional",
								title: "Equipaje adicional"
							},
							{
								link: "Recomendaciones",
								title: "Recomendaciones"
							}
						]
					})

	+m-footer()
