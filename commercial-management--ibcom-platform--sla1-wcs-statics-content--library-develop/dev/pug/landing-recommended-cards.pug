extends _general/layout__primary

block title
	title!="IBERIA - Home"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "advSearch"
		})

		h1.sr-only Landing vuelos baratos 
		.container
			.row
				.col-xs-12
					.ibe-geo-origin(data-located="false")
						h2.ibe-geo-origin__title
							span.ibe-geo-origin__title-text!="Ofertas de vuelos desde"
							div.ibe-geo-origin__selector
								button.ibe-geo-origin__selector-button(type="button", data-toggle="collapse", data-target="#id-origin-selector", data-focusindata-target="", title="Seleccione el origen", data-close="outsideclick", data-focusin)
									span.ibe-geo-origin__selector-button-text!="Madrid"
									span.ibe-geo-origin__selector-button-icon.icon-caret_abajo
								div.ibe_form.ibe-geo-origin__container.collapse(id="id-origin-selector", data-toggle="container", data-collapse="hide-resize", data-keyboard-close="esc", data-close="outsideclick")
									div.ibe-geo-origin__content
										div.ibe-geo-origin__wrap
											div(class="ibe_form__group ibe_form__group--compact ibe_form__group--button-icon ibe_form__group--content u-text-left")
												label(class="ibe_form__input-label", for="flight_origin")!="Origen"
												input(class="ibe_form__input-text" name="flight_origin" id="flight_origin" type="text" placeholder="Origen" data-autocomplete="cities" spellcheck='false', value="Introduce un origen", data-destination-info="BCN", data-validate="input-origin", data-fligths-collapse-mobile="button", data-autocomplete-no-results="Tralala", data-char-activation="1",  data-target="#geopos-list", data-positioned="fc-geo-positioned")
												p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Debes elegir un origen")
										div.ibe-geo-origin__active
											button.ibe-geo-origin__active-button
												span.ibe-geo-origin__active-button-icon.icon-senalizacion_mapas
												span.ibe-geo-origin__active-button-text(title="Permitir la ubicación")!="Permitir la ubicación"
										div.ibe-geo-origin__autocomplete(id="geopos-list")
										div.ibe-geo-origin__positioned.fc-geo-positioned
											div.ibe-geo-origin__location
												div.ibe-geo-origin__group
													p.ibe-geo-origin__group-title!="Tu ubicación"
													ul.ui-menu.ui-autocomplete
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Barcelona")
																p.ui-menu-item-link__city Barcelona
																span.ui-menu-item-link__country España
												div.ibe-geo-origin__group
													p.ibe-geo-origin__group-title Aeropuertos cercanos
													ul.ui-menu.ui-autocomplete
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Palma de Mallorca")
																p.ui-menu-item-link__city!="Palma de Mallorca"
																span.ui-menu-item-link__country!="245 km, España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Perpignan")
																p.ui-menu-item-link__city!="Perpignan"
																span.ui-menu-item-link__country!="180 km, Francia"
											div.ibe-geo-origin__unlocated
												div.ibe-geo-origin__group
													ul.ui-menu.ui-autocomplete
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Madrid")
																p.ui-menu-item-link__city!="Madrid"
																span.ui-menu-item-link__country!="España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Barcelona")
																p.ui-menu-item-link__city!="Barcelona"
																span.ui-menu-item-link__country!="España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Palma de Mallorca")
																p.ui-menu-item-link__city!="Palma de Mallorca"
																span.ui-menu-item-link__country!="España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Madrid")
																p.ui-menu-item-link__city!="Madrid"
																span.ui-menu-item-link__country!="España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Barcelona")
																p.ui-menu-item-link__city!="Barcelona"
																span.ui-menu-item-link__country!="España"
														li.ui-menu-item
															a.ui-menu-item-link(href="#" title="Palma de Mallorca")
																p.ui-menu-item-link__city!="Palma de Mallorca"
																span.ui-menu-item-link__country!="España"

