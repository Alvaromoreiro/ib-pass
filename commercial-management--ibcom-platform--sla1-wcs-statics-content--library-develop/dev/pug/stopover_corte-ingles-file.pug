    //-             h3.title__h1.title__big.title--center.u-mb-medium!="O reserva ya tu experiencia Personal Shopper a través de nuestro equipo VIP Concierge"
    //-         div.col-xl-12.col-lg-12.col-md-12.ibe-exp-file--small-container
    //-             .div.ibe-exp-file--small-card
    //-                 img(src='images/modules/stopover/castellana.png')
    //-                 span.title__h4.title--red!="marchelina.andritcu@elcorteingles.es"
    //-             .div.ibe-exp-file--small-card.u-mt-medium-mobile.u-mt-medium-xs
    //-                 img(src='images/modules/stopover/serrano_47.png')
    //-                 span.title__h4.title--red!="miriam.delahorra@elcorteingles.es"

    //-Propuesta de estructura por si lo de arriba de integra mal en WCS
    
    div.container.ibe-box-work--mt
        div.row
            div.col-xs-12
                h3.title--stopover.title--stopover-padd.ibe-exp-file__title-secondary!="O reserva ya tu experiencia Personal Shopper a través de nuestro equipo VIP Concierge"
                div.ibe-flex.ibe-flex--space-between.ibe-flex--align-center.ibe-exp-file__column-mobile.ibe-exp-file__column-mobile--gap.ibe-exp-file__column-medium
                    div.ibe-exp-file--small-card
