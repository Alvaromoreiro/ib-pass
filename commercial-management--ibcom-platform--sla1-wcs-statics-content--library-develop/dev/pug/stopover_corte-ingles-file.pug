extends _general/layout__primary
include _modules/_modals/_ibe-modal-login-stopover-simple

block title
    title!='IBERIA - Stopover banner'
block body
    // Inicio nuevo header
    +m-header-new({
        "login": false
    })

    // Inicio nuevo menu
    +m-menu-new({
        "login": false
    })
    // End wrapper
    main
        // Main content

    div.ibe-static-banner.ibe-exp-file--banner-img(data-background='images/modules/stopover/img-call-to-action-conocer-madrid' data-background-format="jpg")
    div.container.ibe-exp-file--card
        div.row
            div.ibe-exp-file__container
                div.ibe-box-work.ibe-exp-file
                    div.ibe-flex.ibe-flex--space-between.ibe-exp-file__header
                        div.ibe-card-guides__footer--icon.ibe-exp-file__arrow-container
                            span.ibe-card-guides__footer-arrow.ibe-exp-file--arrow
                            a.link.link__regular.link__regular--important(href="#" title="Ver ficha")!="Volver a experiencias"
                        div.rectangle-label-event.rectangle-label-event--stopover.rectangle-label-event--stopover-2.positionI.u-mt-small-sm.u-mt-small-xs
                            div.text-label-event__icon.text-label-event__icon--medium
                                p.text-label-event.text-label-event--stopover-2.u-text-left!="Recomendado"
                    div.ibe-exp-file__title!="El Corte Inglés"
                    div.ibe-exp-file__tags-container
                        span.ibe-card-guides__theme.ibe-card-guides__theme--pin.ibe-exp-file--pin!="Compras"
                    div.ibe-flex.ibe-flex--space-between.u-mt-xmedium.ibe-exp-file__info-container
                        div.ibe-flex.ibe-flex__column.col-lg-8.col-md-12.col-sm-12.col-xs-12.no_padding
                            div.ibe-exp-file--subtitle
                                span!="Desde su creación en "
                                span.ibe-box-work__subtitle--bold!="1940, El Corte Inglés "
                                span!="se ha consolidado como un destino de compras de lujo a nivel mundial, cimentando su historia en su vocación de servicio al cliente y, por supuesto, su "
                                span.ibe-box-work__subtitle--bold!="pasión por la moda "
                                span!="Así, sus Luxury Stores son paradas imprescindibles para los amantes de la ropa y los complementos: en las tiendas de El Corte Inglés de Castellana y Serrano 47 podrás encontrar firmas como "
                                span.ibe-box-work__subtitle--bold!="Loewe, Gucci, Prada, Cartier, Givenchy o Balenciaga."
                            div.ibe-exp-file--subtitle-2
                                p.u-mt-smedium!="Ahora, con Hola Madrid podrás disfrutar de ventajas exclusivas reservadas a clientes de Iberia"
                            div.ibe-flex.u-mt-smedium.ibe-exp-file__column-mobile.ibe-exp-file__column-mobile--gap
                                div.ibe-flex.ibe-flex__column.ibe-flex--flex-1-1-0                                        
                                    p.bold.ibe-card-guides__offer-text-bigger.title--red.u-mb-xxsmall!="Business"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="6 Avios/€ gastado"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Tratamiento de belleza facial (previa reserva)"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Experiencia Personal shopper (previa reserva)"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Transfer de ida del hotel (dentro de la M30) a la tienda (Castellana o Serrano)"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Invitación a una comida en nuestro centro para 1 persona (valor 50€)"
                                div.ibe-flex.ibe-flex__column.ibe-flex--flex-1-1-0
                                    p.bold.ibe-card-guides__offer-text-bigger.title--red.u-mb-xxsmall!="Turista Premium"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="5 Avios/€ gastado"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Experiencia Personal shopper (previa reserva)"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Envío de compras al hotel"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Tapa y copa VIP"
                                div.ibe-flex.ibe-flex__column.ibe-flex--flex-1-1-0
                                    p.bold.ibe-card-guides__offer-text-bigger.title--red.u-mb-xxsmall!="Turista"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="4 Avios/€ gastado"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Experiencia Personal shopper (previa reserva)"
                                    div.ibe-flex.title--red.paragraph--big.u-mb-xsmall
                                        span.ibe-card-guides__offer-icon.icon.icon-confirmacion.title--red.bold
                                        span.ibe-exp-file--info-2.u-mt-xxsmall!="Tapa y copa"
                        //- CAJA INICIAR SESION
                        div.ibe-exp-file__info-container__details
                            div.ibe-exp-file--box.title--center
                                div.ibe-exp-file--box-circle!="%"
                                p.title__h5.title__h5--20.ibe-font-color-primary!="Servicios exclusivos"
                                p.paragraph.paragraph__info-flight.ibe-font-color-primary!="Accede a tu reserva de Stopover para poder ver todos los servicios exclusivos"
                                div.ibe-exp-file--box-border.u-mt-small
                                    a.link.link__regular--important.ibe-exp-file--box-link(href="#" title="Ver ficha")!="Iniciar sesión"
                    //- div.ibe-exp-file__button
                    //-     a.ibe-button.ibe-button--red.ibe-button--large-4.ibe-button--iberia-headline.ibe-button--fs-20.ibe-button--w100-mobile!="Ver servicios exclusivos"       
    
    //-Esta parte es posible que se integre mal en WCS/ FIX
