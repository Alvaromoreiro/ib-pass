extends _general/layout__primary
include _modules/_ibe_hero_connections_madrid
include _modules/connections/_ibe_connections_card-50-50
include _modules/connections/_ibe_connections_alert

block body

  +m-hero-madrid()
  section.container
    div.row
      div.col-lg-9.col-xs-12.col-lg-push-3.ibe-lat-menu__list
        +m-ibe-connections_card-50-50({
          "title": "¿Has comprado tus vuelos juntos?",
          "info": "Eso es lo que llamamos vuelos en conexión, y lo consideramos como un único viaje. Por ello nos encargaremos de que tu equipaje facturado llegue a tu destino final sin que tengas que preocuparte por él.",
          "left": true,
          "type": "equipaje-1",
        })

        +m-ibe-connections_alert({
          "boldText": "Si tu destino final es Madrid-Barajas, ",
          "regularText": "deberás dirigirte a la zona de recogida de equipajes ubicada en la T4, planta 0."
        })
        
        +m-ibe-connections_card-50-50({
          "title": "¿Tus vuelos no pertenecen a una misma reserva?",
          "info": "Si has comprado los vuelos de tu viaje de forma independiente, tendrás que encargarte de recoger el equipaje en cada aeropuerto al que llegues y volverlo a facturar para el vuelo siguiente.",
          "right": true,
          "type": "equipaje-2",
        })

        +m-ibe-connections_alert({
          "boldText": "Si haces escala en Madrid, ",
          "regularText": "deberás recoger tu equipaje en la cinta de recogida de equipajes de la planta 0, subir a la zona de Salidas y facturarlo en el mostrador de Iberia."
        })

      div.col-lg-3.col-xs-12.col-lg-pull-9
        +m-lat-menu({
          items: [
            {
              link: "Prepara tu equipaje",
              title: "Prepara tu equipaje"
            },
            {
              link: "Equipaje de mano",
              title: "Equipaje de mano",
              cssClass: "ibe-lat-menu__item--active"
            },
            {
              link: "Equipaje facturable",
              title: "Equipaje facturable"
            },
            {
              link: "Equipajes peligrosos",
              title: "Equipajes peligrosos"
            },
            {
              link: "Dispositivos electr&oacute;nicos",
              title: "Dispositivos electrónicos"
            },
            {
              link: "Equipajes especiales",
              title: "Equipajes especiales"
            },
            {
              link: "Equipaje de valor declarado",
              title: "Equipaje de valor declarado"
            },
            {
              link: "Equipaje adicional",
              title: "Equipaje adicional"
            },
            {
              link: "Recomendaciones",
              title: "Recomendaciones"
            }
          ]
        })
        .ibe-flights-plus-hotel__box
          +m-card-link({
            "isLink": false,
            "mainClass": "sm",
            "autoHeight": "",
            "title": {
              "name": "Club del vino",
              "icon": false
            },
            "image": {
              "src": "/content/disney.jpg",
              "alt": "Ofeta Disneyland"
            },
            "logo": {
              "bool": false
            },
            "typeContent": "description",
            "description": {
              "text": "Vive un viaje a través de los sentidos con una exclusiva selección reservada a clientes Iberia Plus."
            },
            "highlight": false,
            "buttonText": 'Descubre el club del vino'
            })

  +m-footer()
