					button(data-focusin, type="button" class="slick-prev slick-arrow")
						span.hideAccessible Anterior
				div.ibe-search-flights__buttons-slick.ibe-search-flights__buttons-slick--right
					button(data-focusin, type="button" class="slick-next slick-arrow")
						span.hideAccessible Siguiente
				div.ibe-search-flights__search-container.container.hidden-md.hidden-sm.hidden-xs(data-function="data-focus-searcher")
					div.row
						div.col-xs-12
							div.ibe-search-flights__search-box(data-validate-searcher)
								+m-searcher-accordion()
				div.slick-menu.slick-full-window(data-slick="full-window-menu" data-slick-active="0")
