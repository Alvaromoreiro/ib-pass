extends _general/layout__primary

block title
	title!="IBERIA - Home"
block body

	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({  
		"login": false
	})

	// End wrapper 
	main.ibe-home
		h1.hideAccessible Home Iberia
		div.ibe-search-flights
			div.ibe-search-flights__cover.ibe-search-flights__cover--carousel.ibe-search-flights__cover--banner-home.ibe-search-flights__cover--carousel-home
