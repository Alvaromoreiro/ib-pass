extends _general/layout__primary
include _modules/_ibe_tabs-icons
block title
	title!="IBERIA - Partners - Category"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// End wrapper
	section.container
		div.row
			div.col-xs-12
				+m-ibe-breadcrumbs({
					menu: "claim"
				})
		div.row
			div.col-lg-9.col-xs-12.col-lg-push-3 
				section.ibe-infocheckin
					header.ibe-infocheckin__header
						h1.title.title__h1.ibe-infocheckin__header-primary!="C&oacute;mo donar Avios"
						h5.title.title__h5.ibe-infocheckin__header-secondary!="Haz que tus Avios marquen la diferencia"
					article.ibe-infocheckin__box.ibe-infocheckin__box--img-big
						figure.ibe-figure
							img.ibe-img(src=globals.imgPath + "/content/antes-de-viajar.png" alt="Antes de viajar")
						div.ibe-infocheckin__box-container
							div.ibe-line-spacing.ibe-line-spacing--large.u-text-right
								a.link.link__regular.link__regular--important.link__regular--arrow-left(href="#" title="Volver")!="Volver"
							div.row
								div.col-xs-12.col-sm-12.col-md-6
									div.ibe-line-spacing.ibe-line-spacing--large
										figure.ibe-figure.ibe-figure--size-250
											img(src=globals.imgPath + "/logos/ong/logo_save_the_children.png", alt="Logo ONG")
										p.paragraph.paragraph__regular
											!="Apoyamos la labor de Save the Children en su proyecto \"Institutos Construyendo Paz\", que enseña herramientas para la vida a los niños de escuelas secundarias de Ciudad de Guatemala. Este programa, que está obteniendo unos resultados muy positivos desde que se inició en 2014, tienen como objetivo llegar a 7.000 niños y adolescentes del país. Si quieres más información visita "
											a.link.link__regular.link__regular--important(href="#" title="Ir a la web de Save The Children")!="savethechildren.es"
								div.col-xs-12.col-sm-12.col-md-6
									form.ibe_form(action="#")
										fieldset
											legend.hideAccessible!="Formulario para donar"
											div.ibe-line-spacing.ibe-line-spacing--large
												p.title.title__h5.title--no-padd!="Ana Esteban tienes"
												p.title.title__h5.title--no-padd.title--red!="2597 Avios"
											div.ibe-line-spacing
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="ibplus", id="id-ibplus", type="text", placeholder="NÚMERO DE IBERIA PLUS")
													label(class="ibe_form__input-label", for="id-ibplus") NÚMERO DE IBERIA PLUS
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="avios", id="id-avios", type="text", placeholder="AVIOS PARA DONAR")
													label(class="ibe_form__input-label", for="id-avios") AVIOS PARA DONAR
											div
												div.ibe-form__checkbox.ibe-form__checkbox--login-session
													input.ibe-form__checkbox-input(type='checkbox', name='check-ong', id="check-ong")
													label.ibe-form__checkbox-label(for='check-ong')
														span.ibe-form__checkbox-txt.ibe-form__checkbox-txt--size-sm
															!="Si, quiero recibir por email mi certificado de la ONG al finalizar el año, teniendo en cuenta los datos que aparecen en mi "
															strong!="Perfil IbPlus "
															!="(si quieres cambiarlos puedes hacerlo en tu perfil)."
											div.ibe-line-spacing
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="name", id="id-name", type="text", placeholder="NOMBRE")
													label(class="ibe_form__input-label", for="id-name") NOMBRE
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="surname", id="id-surname", type="text", placeholder="APELLIDOS")
													label(class="ibe_form__input-label", for="id-surname") APELLIDOS
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="nif", id="id-nif", type="text", placeholder="NIF/CIF")
													label(class="ibe_form__input-label", for="id-nif") NIF/CIF
												div(class="ibe_form__group fc_form_group ibe_form__group--button-icon")
													label(class="ibe_form__input-label", for="code0565") Destino
													input(class="ibe_form__input-text", name="code0565", id="code0565", type="text", placeholder="Destino")
													button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button")
														span(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades" class="hideAccessible")!="Click para desplegar ciudades"
												div(class="ibe_form__group")
													input(class="ibe_form__input-text", name="cod", id="id-cod", type="text", placeholder="CÓDIGO POSTAL")
													label(class="ibe_form__input-label", for="id-cod") CÓDIGO POSTAL
											div.u-text-right
												button.ibe-button.ibe-button--red.ibe-button--big(type="submit")!="Donar a Save The Children"
			div.col-lg-3.col-xs-12.col-lg-pull-9
				+m-lat-menu({
					items: [
						{
							link: "C&oacute;mo funciona Avios",
							title: "Cómo funciona Avios"
						},
						{
							link: "Comprar, regalar y transferir Avios",
							title: "Comprar, regalar y transferir Avios"
						},
						{
							link: "Avios Solidarios",
							title: "Avios Solidarios",
							cssClass: "ibe-lat-menu__item--active"
						},
						{
							link: "Obtener Avios",
							title: "Obtener Avios"
						},
						{
							link: "Utilizar mis Avios",
							title: "Utilizar mis Avios"
						},
						{
							link: "Hoteles, coches y experiencias",
							title: "Hoteles, coches y experiencias"
						},
						{
							link: "Avios no anotados",
							title: "Avios no anotados"
						},
						{
							link: "Qu&eacute; son Puntos Elite",
							title: "Qué son Puntos Elite"
						},
						{
							link: "Obtener Puntos Elite",
							title: "Obtener Puntos Elite"
						}

					]
				})
