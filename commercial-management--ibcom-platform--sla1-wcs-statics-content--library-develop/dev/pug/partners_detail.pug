									li.ibe-list__item.ibe-list__item--grey
										span.paragraph.paragraph__regular--grey!="Reserva online en www.globalexchange.es"
									li.ibe-list__item.ibe-list__item--grey
										span.paragraph.paragraph__regular--grey!="Obt&eacute;n el doble de Avios con Global Exchange con tu cambio de moneda."
								p.paragraph.paragraph__regular.paragraph__regular--no-margin.paragraph__regular--grey!="El Grupo Global Exchange, es una multinacional especializada en ofrecer el servicio de cambio de moneda, con presencia en 21 países, de los 5 continentes."
								p.paragraph.paragraph__regular.paragraph__regular--no-margin.paragraph__regular--grey!="En España, además a trav&eacute;s de su página web www.globalexchange.es (https://www.globalexchange.es/servicios/puntos-aerolineas) tienen a disposici&oacute;n de los clientes, la posibilidad de adquirir la moneda extranjera c&oacute;modamente en el domicilio. "
								p.paragraph.paragraph__regular.paragraph__regular--no-margin.paragraph__regular--grey!="Además, en operaciones de más de 300 Euros, los clientes acumularán Avios en su tarjeta Iberia Plus. Para más informaci&oacute;n consulta la tabla de obtenci&oacute;n de Avios. "
								p.paragraph.paragraph__regular.paragraph__regular--m-top-30
									Ver tabla de obtenci&oacute;n
								p.paragraph.paragraph__regular
									a.link.link__regular.link__regular--important.link__regular--single-arrow-strong(href="#", title="title") Ver tabla de obtenci&oacute;n

							div.ibe-infocheckin__box-container-bordered
								div.ibe-accordion
									h4.title.title__h4.ibe-accordion__header.ibe-accordion__header--no-border(data-toggle="accordion", data-target="#group_01_accordion_01")
										a.link(href="#" title="¿C&oacute;mo consigo Avios con Avis?")!="&iquest;C&oacute;mo consigo Avios con Avis?"
									div.ibe-accordion__collapse(id="group_01_accordion_01" data-toggle="container" data-steps="collapse")
										div.row
											div.col-xs-12
												div.ib-card-steps-container

													+m-card-steps({
														"title": "Cambio en oficinas",
														"step": "Paso 1",
														"text": "Si cambias en las oficinas: Presenta tu tarjeta al realizar el cambio."

													})
													+m-card-steps({
														"title": "Reservando un coche con Avis",
														"step": "Paso 2",
														"text": "Si cambias online: Introduce tu nº de tarjeta Iberia Plus al finalizar tu pedido Iberia Plus al finalizar tu pedido."
													})
													+m-card-steps({
														"title": "Cambio en oficinas",
														"step": "Paso 1",
														"text": "Si cambias en las oficinas: Presenta tu tarjeta al realizar el cambio."

													})

					div.ibe-dialog.fc-dialog-class
						div.modal-dialog
							div.modal-content
								div.ibe-modal
									header.modal-header
										h2.title.title__h1.ibe-modal__title-primary!="Condiciones AVIS"
										h3.title.ibe-modal__title-secondary!="Lorem ipsum dolor sit amet."
										div.ibe-modal__options
