				div.row
					//div.col-xs-12.hidden-md.hidden-lg.hidden-xl
						figure.ibe-figure
							img.w100(src=globals.imgPath + "/content/chicago.jpg" alt="Foto")
					div.col-xs-12(data-ng-controller="modalcontroller")
						article.ibe-infocheckin__box.ibe-infocheckin__box--img-big
							//div.row
								div.col-xs-12.hidden-xs.hidden-sm
							figure.ibe-figure-nomargin
								img.ibe-img(src=globals.imgPath + "/content/chicago.jpg" alt="Foto")
							div.ibe-infocheckin__box-container-before
								figure.figure-logo-before
									img.image-logo(src=globals.imgPath + "/modules/icons/partners/NH_Hotel_Group_Logo_VER.svg", alt="Logo empresa")
