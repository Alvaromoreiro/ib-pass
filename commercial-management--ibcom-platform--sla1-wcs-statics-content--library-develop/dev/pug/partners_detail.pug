extends _general/layout__primary
include _modules/_ibe_card-steps
block title
	title!="IBERIA - Partners - Detail"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})

	// End wrapper
	section.container
		div.row
			div.col-xs-12
				+m-ibe-breadcrumbs({
					menu: "claim"
				})
		div.row
			div.col-lg-9.col-xs-12.col-lg-push-3
				section.ibe-infocheckin
