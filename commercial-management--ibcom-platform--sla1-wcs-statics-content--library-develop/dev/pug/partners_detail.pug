										div.ibe-modal_body
											p.paragraph.paragraph__regular Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa.
											p.paragraph.paragraph__regular Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa.
											p.paragraph.paragraph__regular Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa quis enim.
											p.paragraph.paragraph__regular Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa quis enim. Donec pede just lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa quis enim. Donec pede justo.


				div.row
					div.col-xs-12
						h2.title.title__h3.title--no-padd Partners que tambi&eacute;n te pueden interesar
				div.row
					div.col-xs-12.col-md-6.ibe-card-box--md.ibe-card-box--type-link
						+m-card-box({
							"isLink": true,
							"zoom": true,
							"text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. In elit tempus commodo mauris tempus commodo mauris massa, congue id eros id, tempus commodo mauris. Lorem ipsum dolor sit amet, consectetur",

							"image": {
								"src": "/modules/ibe-card-box/1280x720.png",
								"alt": "Foto ninas"
							},
							"iconBefore": {
								"src": "/general/logo-iberia.png",
								"alt": "Logo empresa"
							},
							"title": "Reservando un coche con Avis"
						})
					div.col-xs-12.col-md-6.ibe-card-box--md.ibe-card-box--type-link

						+m-card-box({
							"isLink": true,
							"zoom": true,
							"text": "In elit tempus commodo mauris tempus commodo mauris massa, congue id eros id, tempust.",

							"image": {
								"src": "/modules/ibe-card-box/1280x720.png",
								"alt": "Foto ninas"
							},
							"iconBefore": {
								"src": "/general/logo-iberia.png",
								"alt": "Logo empresa"
							},
							"title": "Descubrir más planes de ocio"
						})

			div.col-lg-3.col-xs-12.col-lg-pull-9
				+m-lat-menu({
					items: [
						{
							link: "Partners Iberia Plus",
							title: "Partners Iberia Plus"
						},
						{
							link: "Vuelos",
							title: "Vuelos"
						},
						{
							link: "Hoteles",
							title: "Hoteles"
						},
						{
							link: "Finanzas",
							title: "Finanzas",
							cssClass: "ibe-lat-menu__item--active"
						},
						{
							link: "Ocio y compras",
							title: "Ocio y compras"
						},
						{
							link: "Gasolineras",
							title: "Gasolineras"
						},
						{
							link: "Coches y movilidad",
							title: "Coches y movilidad"
						},
						{
							link: "Gastronom&iacute;a",
							title: "Gastronom&iacute;a"
						}

					]
				})

				.ibe-cart-cont
					div.ibe-card-cont__container.ibe-card-cont__container--medium.hidden-md.hidden-sm.hidden-xs
						form.form-search-partners(action="#" method="post", id="form1")
