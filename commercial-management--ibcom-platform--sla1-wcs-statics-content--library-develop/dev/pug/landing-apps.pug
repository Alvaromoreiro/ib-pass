extends _general/layout__primary
block title
	title!="IBERIA - Landing APPS"
block body
	+m-header-new({
		"login": false
	})

	// Inicio nuevogul menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-landing-apps.ibe-main__footer--without-margin
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		h1.hideAccessible Landing - Iberia Apps
		div(data-skewed).ibe-box-landing--skewed
			section.ibe-box-landing__block--primary
				.container
					.row
						.col-xs-12
							div.ibe-box-landing__container
								h2.ibe-box-landing__title La App Iberia siempre viaja contigo
								p.ibe-box-landing__txt Sabemos que vas volando por la vida, por eso con la App Iberia podr&aacute;s comprar tus billetes y gestionar tus vuelos cuando y donde quieras, c&oacute;moda y r&aacute;pidamente. ¿Te lo contamos? ¡Despegamos!
								div.ibe-box-landing__devices
									button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
									button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
								figure.ibe-box-landing__fig--phone
									img.ibe-box-landing__img(alt="Iphone" src=globals.imgPath + "/content/iphone.png")
				div.ibe-box-landing__aux
			section.ibe-box-landing__block--secondary
				.container
					.row
						.col-xs-12.col-md-7.col-lg-7
							div.ibe-box-landing__container
								p.ibe-box-landing__pretitle Reserva y compra c&oacute;modamente
								h2.ibe-box-landing__title Encuentra tu vuelo
								p.ibe-box-landing__txt Todas estas opciones, en tu m&oacute;vil: elegir destino entre m&aacute;s de cien; escoger la tarifa que prefieras; encontrar siempre precios competitivos; realizar tus pagos en las plataformas m&aacute;s seguras; disfrutar de promociones especiales... Y si te registras en Iberia Plus, adem&aacute;s acceder&aacute;s a tus datos directamente y acumular&aacute;s Avios en cada compra.
								div.ibe-box-landing__devices.hidden-xs.hidden-sm
									button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
									button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
						.col-xs-12.col-md-5.col-lg-5
							div(data-theta-carousel='right')
								div.ibe-box-landing__slick-item
									figure.ibe-box-landing__figure
										img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step1-apps-flights.jpg")
								div.ibe-box-landing__slick-item
									figure.ibe-box-landing__figure
										img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step2-apps-flights.jpg")
								div.ibe-box-landing__slick-item
									figure.ibe-box-landing__figure
										img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step3-apps-flights.jpg")
								div.ibe-box-landing__slick-item
									figure.ibe-box-landing__figure
										img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step4-apps-flights.jpg")
							ul(data-theta-carousel='bullets').ibe-box-landing__slick-list.hidden-xs
								li.ibe-box-landing__slick-bullet
									button.ibe-box-landing__slick-button
								li.ibe-box-landing__slick-bullet
									button.ibe-box-landing__slick-button
								li.ibe-box-landing__slick-bullet
									button.ibe-box-landing__slick-button
								li.ibe-box-landing__slick-bullet
									button.ibe-box-landing__slick-button
							div.ibe-box-landing__devices.hidden-xl.hidden-l.hidden-md
								button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
								button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
			section.ibe-box-landing__block--terciary
				.container
					.row
						.col-xs-12
							.ibe-box-landing__container--box
								.col-xs-12.col-md-5.col-lg-6.col-xl-5.hidden-xs.hidden-sm
									div.ibe-box-landing__container--phone
										figure.ibe-box-landing__fig.ibe-box-landing__fig--gif-animate
											img#checkingif(data-gifanimated alt="Check-in Demo" rel:auto_play="0" rel:rubbable="0" src=globals.imgPath + "/content/iconos/animated/demo_checkin_iberia.gif")
								.col-xs-12.col-md-7.col-lg-6.col-xl-7
									div.ibe-box-landing__container
										p.ibe-box-landing__pretitle Sin esperas, con calma
										h2.ibe-box-landing__title Check-in
										p.ibe-box-landing__txt Obt&eacute;n tu tarjeta de embarque o la de tus acompa&ntilde;antes en cualquier parte. Evita colas en el aeropuerto. Desc&aacute;rgate tu billete y ll&eacute;valo en formato digital; as&iacute; podr&aacute;s verlo incluso sin conexi&oacute;n a internet.
										div.ibe-box-landing__devices
											button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
											button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
								.col-xs-12.visible-xs.visible-sm
									figure.ibe-box-landing__fig
										img.ibe-box-landing__img(alt="Check-in Estatico" src=globals.imgPath + "/content/iconos/animated/checkin-static.png")
						.ibe-box-landing__aux
			section.ibe-box-landing__block--quaternary
				.ibe-box-landing__container--aux
					.ibe-box-landing__aux
					.container
						.row
							.col-xs-12.col-md-7.col-lg-6
								div.ibe-box-landing__container
									p.ibe-box-landing__pretitle Tu reserva, a tu medida
									h2.ibe-box-landing__title Gesti&oacute;n de reservas
									p.ibe-box-landing__txt Chequea los datos de tus vuelos y haz las modificaciones que quieras: selecciona o cambia tu asiento, a&ntilde;ade una maleta, contrata un seguro… Y controla tu reserva desde tu m&oacute;vil.
									figure.ibe-box-landing__fig.visible-sm
										img.ibe-box-landing__img(alt="Gesti&oacute;n de reservas" src=globals.imgPath + "/content/booking-management-sm-small.png")
									figure.ibe-box-landing__fig.visible-xs
										img.ibe-box-landing__img(alt="Gesti&oacute;n de reservas" src=globals.imgPath + "/content/booking-management-xs-small.png")
									div.ibe-box-landing__devices
										button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
										button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
							.col-xs-12.col-md-5.col-lg-6.hidden-xs.hidden-sm
								div(data-img-anim).ibe-box-landing__animation--box
									figure.ibe-box-landing__animation--static-mobile
										img.ibe-box-landing__img(alt="Check-in Estatico" src=globals.imgPath + "/content/static-mobile-small.png")
									figure.ibe-box-landing__animation--item01
										img.ibe-box-landing__img(alt="Check-in Estatico" src=globals.imgPath + "/content/mobile-item01-small.png")
									figure.ibe-box-landing__animation--item02
										img.ibe-box-landing__img(alt="Check-in Estatico" src=globals.imgPath + "/content/mobile-item02-small.png")
				.ibe-box-landing__aux--mobile.visible-sm.visible-xs
				.ibe-box-landing__aux--extension.visible-sm.visible-xs
			section.ibe-box-landing__block--quinary
				.ibe-box-landing__container--box
					.container
						.row
							.col-xs-12.col-md-push-6.col-md-6
								div.ibe-box-landing__container
									p.ibe-box-landing__pretitle Tienes mucho que disfrutar
									h2.ibe-box-landing__title &Aacute;rea privada
									p.ibe-box-landing__txt Consulta tu saldo y movimientos directamente y cuando quieras, acumula Avios con cada compra y, si te registras en Iberia Plus, podr&aacute;s disfrutar de beneficios en Iberia y muchas otras marcas.
									div.ibe-box-landing__devices.hidden-sm.hidden-xs
										button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
										button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
							.col-xs-12.col-md-pull-6.col-md-6
								div(data-theta-carousel='left')
									div.ibe-box-landing__slick-item
										figure.ibe-box-landing__figure
											img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step1-apps-private-area.jpg")
									div.ibe-box-landing__slick-item
										figure.ibe-box-landing__figure
											img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step2-apps-private-area.jpg")
									div.ibe-box-landing__slick-item
										figure.ibe-box-landing__figure
											img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/step3-apps-private-area.jpg")
								ul(data-theta-carousel='bullets').ibe-box-landing__slick-list.hidden-xs
									li.ibe-box-landing__slick-bullet
										button.ibe-box-landing__slick-button
									li.ibe-box-landing__slick-bullet
										button.ibe-box-landing__slick-button
									li.ibe-box-landing__slick-bullet
										button.ibe-box-landing__slick-button
							.col-xs-12.visible-sm.visible-xs
								div.ibe-box-landing__devices
									button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
									button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
					.ibe-box-landing__aux--bg01.hidden-xs.hidden-sm
					.ibe-box-landing__aux--bg02.hidden-xs.hidden-sm
				.ibe-box-landing__aux.hidden-xs.hidden-sm
			section.ibe-box-landing__block--sextenary
				.container
					.row
						.col-xs-12.col-md-7.col-lg-7
							div.ibe-box-landing__container
								p.ibe-box-landing__pretitle Informaci&oacute;n siempre a mano
								h2.ibe-box-landing__title Flight status
								p.ibe-box-landing__txt Consulta el estado de tu vuelo: horarios, cambios de &uacute;ltima hora, informaci&oacute;n en tiempo real de tu reserva…, o de la reserva de otros.
								figure.ibe-box-landing__fig--twice-phone.visible-sm.visible-xs
									img.ibe-box-landing__img(alt="Gesti&oacute;n de reservas" src=globals.imgPath + "/content/group-6.png")
								div.ibe-box-landing__devices
									button.ibe-box-landing__link.ibe-box-landing__link--ios(title="Descarga en la app store", data-skewed="ios", style="background-image: url('images/content/ios-app.svg')")
									button.ibe-box-landing__link.ibe-box-landing__link--android(title="Descarga en google play", data-skewed="android", style="background-image: url('images/content/google-app.svg')")
						.col-xs-12.col-md-5.col-lg-5.hidden-xs.hidden-sm
							figure.ibe-box-landing__fig--twice-phone
								img.ibe-box-landing__img(alt="Check-in Estatico" src=globals.imgPath + "/content/group-9.png")
			section.ibe-box-landing__block--septenary.hidden-xs.hidden-sm(data-device)
				.container
					.row
						.col-md-5.col-lg-6
							.ibe-box-landing__container--qr
								p.ibe-box-landing__txt.ibe-box-landing__txt--qr QR Code
								div.ibe-box-landing__qr
									figure.ibe-box-landing__fig
										img.ibe-box-landing__img(alt="QR Code" src=globals.imgPath + "/content/qr-example.png")
								p.ibe-box-landing__txt.ibe-box-landing__txt--qr Scanning
						.col-md-7.col-lg-6
							div.ibe-box-landing__container
								p.ibe-box-landing__pretitle f&aacute;cil y r&aacute;pido
								h2.ibe-box-landing__title App Iberia: ¡desc&aacute;rgatela ya!
								p.ibe-box-landing__txt Ahora que sabes todo lo que te ofrece la App Iberia, empieza a disfrutarlo cuanto antes. Simplemente escanea este c&oacute;digo y acceder&aacute;s a sus ventajas inmediatamente.
	+m-footer({
		"full": true
	})
