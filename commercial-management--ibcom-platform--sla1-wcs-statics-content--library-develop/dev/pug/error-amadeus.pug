extends _general/layout__primary
block title
	title!="IBERIA - Error Amadeus"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	section.container
		div.row
			div.col-xs-12
				section.ibe-infocheckin
					header.ibe-infocheckin__header.ibe-infocheckin__header--separation-top
						.ibe-line-spacing
							h1.title.title__h1.ibe-infocheckin__header-primary Lo sentimos, no podemos mostrarte los vuelos
						h2.title.title__h3 Por favor, vuelve a realizar la b&uacute;squeda
				div.ibe-search-flights
					div.ibe-search-flights__search
						div.row
							div.col-xs-12
								div.ibe-search-flights__search-box
									+m-searcher-responsive()
				a.link.link__regular.bold(href="#", title="Volver a la Home") Volver a la Home
	+m-footer()
