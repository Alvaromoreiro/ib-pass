extends _general/layout__primary
include _modules/_ibe_searcher-flight-status-numflight
block title
	title!="IBERIA - Imagen texto tabla"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		//- div.ibe-search-flights
		//- 	div.ibe-search-flights__search
		//- 		div.container
		//- 			div.row
		//- 				div.col-xs-12
		//- 					header.ibe-infocheckin__header
		//- 						h1.title.title__h1.ibe-infocheckin__header-primary!="Consulta tu menú a bordo"
		//- 	div.ibe-search-flights__cover.ibe-search-flights__cover--no-search
		//- 		figure.ibe-search-flights__cover-fig
		//- 			img.ibe-search-flights__cover-img(src="images/content/paris.jpg" alt="Undeground París")
		//- 		div.container
		//- 			div.row
		//- 				div.col-xs-12
		//- 					a.ibe-search-flights__cover-box.ibe-search-flights__cover-box--center(href="#" title="Los destinos más interesantes")
		//- 						div.row
		//- 							div.col-xs-12
		//- 								h2.title.title__h2
		//- 									span.title--bold!="Menú a Bordo. " 
		//- 									!="Visualiza el menú que disfrutarás a bordo"
		
		section.container
			.row
				.col-lg-9.col-xs-12.col-lg-push-3
					.ibe-infocheckin__header
						h1.title.title__h1.ibe-infocheckin__header-primary!="Tu próximo viaje"
					section
						p!="BUSCADOR AQUI"
					.ibe-box-work.ibe-box-work--margin
						.ibe-box-work__header
							.ibe-box-work__title!="¿C&oacute;mo funciona?"
						.ibe-box-work__body
							ul.ibe-box-work__list
								li.ibe-box-work__item
									figure.ibe-box-work__item-figure
										img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-1.png" alt="Selecciona número de vuelo")
									//- p.ibe-box-work__item-number!="1."
									.ibe-box-work__item-text
										p.ibe-box-work__item-title 
											span.ibe-box-work__item-number!="1. "
											!="Selecciona el número de vuelo"
										p.ibe-box-work__item-description!="Recuerda que el servicio está disponible solo para vuelos operados por Iberia."
								li.ibe-box-work__item
									figure.ibe-box-work__item-figure
										img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-2.png" alt="Selecciona fecha de tu vuelo")
									.ibe-box-work__item-text
										p.ibe-box-work__item-title
											span.ibe-box-work__item-number!="2. "
											!="Selecciona la fecha de tu vuelo"
										p.ibe-box-work__item-description!="Si tienes más de un vuelo, podrás acceder individualmente a cada uno, o verlos todos a través de "
											a(class="ibe-box-work__item-link", href="#ni", title="Gestiona tu reserva")!="Gestiona tu Reserva."
								li.ibe-box-work__item
									figure.ibe-box-work__item-figure
										img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-3.png" alt="Selecciona tipo de cabina")
									.ibe-box-work__item-text
										p.ibe-box-work__item-title
											span.ibe-box-work__item-number!="3. "
											!="Selecciona el tipo de cabina"
										p.ibe-box-work__item-description!="Recuerda que solo podremos mostrar los menús que estén incluidos en la tarifa."		
					.ibe-infocheckin__header.u-text-left
						h2.title.title__h2.ibe-infocheckin__header-primary.u-text-left!="A la Carta:"
					div.ibe-card-box--lg.ibe-card-box--normal.ibe-card-box--highlight
						+m-card-box({
							"isLink": false,
							"zoom": true,
							"exampleText": "example",
							"dotdotdot": false,
							"description": "Nuestro mejor secreto: la elaboración",
							"image": {
								"src": "/modules/ibe-card-box/960x720.png",
								"alt": "Oferta Disneyland"
							},
							"title": "Business Plus"
						})
					div.ibe-card-box--lg.ibe-card-box--normal
						+m-card-box({
							"isLink": false,
							"zoom": true,
							"exampleText": "example",
							"bigText": true,
							"image": {
								"src": "/modules/ibe-card-box/960x720.png",
								"alt": "Oferta Disneyland"
							},
							"title": "Turista Premium"
						})
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Prepara tu equipaje",
								title: "Prepara tu equipaje"
							},
							{
								link: "Equipaje de mano",
								title: "Equipaje de mano",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Equipaje facturable",
								title: "Equipaje facturable"
							},
							{
								link: "Equipajes peligrosos",
								title: "Equipajes peligrosos"
							},
							{
								link: "Dispositivos electr&oacute;nicos",
								title: "Dispositivos electrónicos"
							},
							{
								link: "Equipajes especiales",
								title: "Equipajes especiales"
							},
							{
								link: "Equipaje de valor declarado",
								title: "Equipaje de valor declarado"
							},
							{
								link: "Equipaje adicional",
								title: "Equipaje adicional"
							},
							{
								link: "Recomendaciones",
								title: "Recomendaciones"
							}
						]
					})
					.ibe-flights-plus-hotel__box
						+m-card-link({
								"isLink": false,
								"mainClass": "sm",
								"autoHeight": "",
								"title": {
									"name": "Club del vino",
									"icon": false
								},
								"image": {
									"src": "/content/disney.jpg",
									"alt": "Ofeta Disneyland"
								},
								"logo": {
									"bool": false
								},
								"typeContent": "description",
								"description": {
									"text": "Vive un viaje a través de los sentidos con una exclusiva selección reservada a clientes Iberia Plus."
								},
								"highlight": false,
								"buttonText": 'Descubre el club del vino'
							})

	+m-footer()
