extends _general/layout__primary

block title
	title!='IBERIA - Landing Universia'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	+m-ibe-breadcrumbs({
		menu: "advSearch"
	})
	// End wrapper
	main
		// Main content
		section.ibe-universia-header.ibe-universia-header__title
			h1.title__h1!="Plan University&Fly, siempre un buen plan"
		section.ibe-universia-searcher 
			h3.ibe-universia-searcher__title!="Vuelo"
			div.ibe_form__group.fc_form_group.ibe_form__group--button-icon 
				label.ibe_form__input-label(for="code0566")!="¿A donde vas?"
				input.ibe_form__input-text(name="code0566" id="code0566" type="text" placeholder="¿A donde vas?")
				button.ibe_form__input-button-high.icon-buscar(type="button")
		section.ibe-universia-banner.ibe-static-banner.ibe-static-banner--left
			picture.ibe-universia-banner__background-image
				source(media="(min-width: 1280px)" srcset="images/modules/universia/50_life-iberia.png")
				source(media="(min-width: 1024px) and (max-width: 1279px)" srcset="images/modules/universia/50_life-iberia-1024px.png")
				source(media="(min-width: 768px) and (max-width: 1023px)" srcset="images/modules/universia/50_life-iberia-768px.png")
				source(media="(min-width: 480px) and (max-width: 767px)" srcset="images/modules/universia/50_life-iberia-600px.png")
				img.ibe-universia-banner__img(src="images/modules/universia/50_life-iberia.png" alt="Banner Universia")
			div.ibe-universia-banner-info-box
				p.ibe-universia-banner-info-box__text.title__h5.ibe-card-link--red!="Iberia y Universia te traen sus descuentos exclusivos. "
					a(href="https://registro-iberia.iberia.com/?language=es&origin=MX&partner=SUN" title="Registro Iberia" class="ibe-card-link__title")!="Regístrate "
					!="o "
					a(href="http://ibcwcsdes1.ib/mx/iberiaplus/registrese/&partner=SUN" title="Inicio sesión Iberia" class="ibe-card-link__title")!="Inicia sesión "
					!="en Iberia Plus y comienza a disfrutarlos."
			div.ibe-universia-banner-discount
				div.ibe-universia-banner-discount__border
					h2.ibe-universia-banner-discount__title.title__h1!="-10%"
					p.ibe-universia-banner-discount__text.paragraph--icons-info!="Tarifas más económicas y tarifas más flexibles"
			div.ibe-universia-banner-options
				div.ibe-universia-banner-options__content
					ul.ibe-universia-banner-options__list.row
						li.ibe-universia-banner-options__list-content.col-lg-4.col-md-4.col-sm-6.col-xs-12
							div.ibe-universia-banner-options__border.ibe-flex__column.ibe-flex--align-start
								p.ibe-universia-banner-options__title.icon-calendario!="Busca tu vuelo"
								p.ibe-universia-banner-options__text!="Lorem ipsum dolor sit amet, consectetur adipiscing elit." 
						li.ibe-universia-banner-options__list-content.col-lg-4.col-md-4.col-sm-6.col-xs-12
							div.ibe-universia-banner-options__border.ibe-flex__column.ibe-flex--align-start
								p.ibe-universia-banner-options__title.icon-carrito_compra!="Elige tu tarifa"
								p.ibe-universia-banner-options__text!="Lorem ipsum dolor sit amet, consectetur adipiscing elit." 
						li.ibe-universia-banner-options__list-content.col-lg-4.col-md-4.col-sm-6.col-xs-12
							div.ibe-universia-banner-options__border.ibe-flex__column.ibe-flex--align-start
								p.ibe-universia-banner-options__title.icon-avion_ida!="Vuela"
								p.ibe-universia-banner-options__text!="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
					div.ibe-universia-banner-options__link
						a.ibe-box-location__extra-info.link.link__regular--advertise.title__h6(href="#" title="Ver condiciones generales" tabindex="0")!="Ver condiciones generales"
		section.ibe-universia-box-logos
			div.ibe-universia-box-logos__container
				h3.ibe-universia-box-logos__title.title__h5!="Ventajas como estas, para socios como tú."
				ul.ibe-universia-box-logos__content.clearfix
					li.ibe-universia-box-logos__items
						figure.ibe-universia-box-logos__figure
							img.ibe-universia-box-logos__img(src=globals.imgPath + "/modules/universia/ibplus-card-oro.png" alt="Ib Plus card oro")
					li.ibe-universia-box-logos__items
						figure.ibe-universia-box-logos__figure
							img.ibe-universia-box-logos__img(src=globals.imgPath + "/modules/universia/ibplus-card-plata.png" alt="Ib Plus Card Plata")
					li.ibe-universia-box-logos__items
						figure.ibe-universia-box-logos__figure
							img.ibe-universia-box-logos__img(src=globals.imgPath + "/modules/universia/conilhospeda.png" alt="Conil Hospeda")
					li.ibe-universia-box-logos__items
						figure.ibe-universia-box-logos__figure
							img.ibe-universia-box-logos__img(src=globals.imgPath + "/modules/universia/logo-promerica.png" alt="Logo Promerica")
		div.container
			div.row
				div.col-xs-12.ibe-universia-second-section
					section.ibe-universia-steps.ibe-box-work
						.ibe-box-work__header
							h2.ibe-box-work__title!="¿Cómo funciona el Plan?"
						div.ibe-universia-steps__container
							div.ibe-box-work__item
								figure.ibe-box-work__item-figure
									img.ibe-box-work__item-img(src=globals.imgPath + "/modules/universia/step-1.png" alt="Selecciona número de vuelo")
								.ibe-box-work__item-text.ibe-box-work__item-text-regular
									div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-flex
										p.ibe-box-work__item-number-regular!="1. "
										div
											p.title__h5--small.title--grey.title--bold!="Actívalo"
											p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Regístrate o lógate desde esta página (landing page) en Iberia Plus para activar el plan University & Fly."
							div.ibe-box-work__item
								figure.ibe-box-work__item-figure
									img.ibe-box-work__item-img(src=globals.imgPath + "/modules/universia/step-2.png" alt="Selecciona número de vuelo")
								.ibe-box-work__item-text.ibe-box-work__item-text-regular
									div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
										p.ibe-box-work__item-number-regular!="2. "
										div
											p.title__h5--small.title--grey.title--bold!="Disfruta de los beneficios"
											p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Accede directamente a la web de Iberia para buscar tus vuelos y beneficiarte de los descuentos."
							div.ibe-box-work__item
								figure.ibe-box-work__item-figure
									img.ibe-box-work__item-img(src=globals.imgPath + "/modules/universia/step-3.png" alt="Selecciona tipo de cabina")
								.ibe-box-work__item-text.ibe-box-work__item-text-regular
									div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
										p.ibe-box-work__item-number-regular!="3. "
										div
											p.title__h5--small.title--grey.title--bold!="Renuévalo"
											p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Transcurrido un año desde la fecha de activación, debes volver a logarte desde la app de tu universidad, para seguir disfrutando de los beneficios."
					section.ibe-universia-general-conditions
						div.ibe-universia-general-conditions__container.ibe-infocheckin__box.ibe-infocheckin__box--medium
							h3.ibe-universia-general-conditions__title.title.title__h3.title__h3--second!="Condiciones generales"
							ul.ibe-universia-general-conditions__content-list
								li.ibe-universia-general-conditions__list.title__h6
									span!="Los precios indicados durante el proceso de reserva, incluyen el descuento indicado y pueden tener una ligera variación con el precio final (+/-1€)." 
								li.ibe-universia-general-conditions__list.title__h6
									span!="El descuento es válido para vuelos con salida desde Ciudad de México, operados por Iberia, Iberia Express e Iberia Regional Air Nostrum. No es válido en vuelos IB4XXX, IB5XXX, o IB7XXX)." 
								li.ibe-universia-general-conditions__list.title__h6
									span!="En los billetes de ida y vuelta, sólo se permiten trayectos con salida y regreso desde la misma ciudad, no es posible realizar paradas en diferentes ciudades." 
								li.ibe-universia-general-conditions__list.title__h6
									span!="El descuento se aplica únicamente sobre el importe de la tarifa. Esta información está desglosada en el proceso de compra Desglose de precios. Las tasas e impuestos no tienen descuento." 
								li.ibe-universia-general-conditions__list.title__h6
									span.title__h6.title--bold!="IMPORTANTE: " 
									span!="La búsqueda de disponibilidad, reserva y compra, debe realizarse sólo desde esta página."
					section.ibe-universia-sustainability.ibe-infocheckin__box--img-big
						figure.ibe-universia-sustainability__figure
							img.ibe-universia-sustainability__img(src=globals.imgPath + "/modules/universia/university&fly_sostenibilidad.png" alt="Antes de viajar")
						div.ibe-universia-sustainability__container 
							h2.title__h2.link.link__regular--advertise!="Comprometidos con la sostenibilidad"
							div.ibe-universia-sustainability__content-text
								p.title__h4.link.link__regular--advertise!="Somos conscientes de nuestro impacto ambiental, por eso nuestros esfuerzos están puestos en no tener que elegir entre viajar o cuidar el planeta. Nuestro objetivo es ambicioso: alcanzar la neutralidad climática en 2050."
							a.ibe-box-location__extra-info.link.link__regular--advertise.paragraph__regular--small(href="#" title="Asi avanzamos" tabindex="0")!="Asi avanzamos hacia un futuro mejor"
	+m-footer({
		"full": true  
	})