extends _general/layout__primary
include _modules/stopover/_ibe_stopover_discover_v2

block title
	title!="IBERIA - Landing Stop Over"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})
	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-stopover.ibe-main__footer--without-margin
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})

		+m-ibe-stopover_discover_v2({
			"dataBackground": "images/modules/icons/background_discover_so.jpg",
			"logo": "images/modules/icons/DQ_Logo_horitonzal-.png",
			"logoAlt": "Discover Qatar",
			"title": "Doha, mucho más que una escala",
			"subtitle": "Quédate unos días para descubrirla. Contrata Stopover y obtendrás descuentos en alojamiento y actividades para un máximo de 4 días.",
			"features": [
				{
					icon: "images/modules/icons/mask_discover.png",
					title: "Oferta cultural",
					description: "Vive el espíritu de Doha a través de sus museos, villas y zocos."
				},
				{
					icon: "images/modules/icons/food_discover.png",
					title: "Gastronomía",
					description: "Descubre una experiencia intensa, variada y auténtica."
				},
				{
					icon: "images/modules/icons/shop_discover.png",
					title: "Aventuras",
					description: "Doha ofrece opciones para todos los bolsillos."
				}
			],
			"buttonText": "Descubre Stopover Doha"
		})

	+m-footer({
		"full": true
	})

