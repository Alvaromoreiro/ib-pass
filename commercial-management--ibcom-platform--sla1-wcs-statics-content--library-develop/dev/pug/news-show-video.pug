extends _general/layout__primary
block title
	title!="IBERIA - Noticias y novedades - Detalle video"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-xs-12
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Novedades y noticias"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Te contamos todo lo que pasa en Iberia.com"
						div.row
							div.col-lg-12.col-md-12.col-ms-12.col-xs-12
								article.ibe-infocheckin__box.ibe-infocheckin__box--img-news
									a.ibe-vid-banner(href="#", title="Ir al video", data-focusin)
										figure.ibe-vid-banner__fig
											img.ibe-vid-banner__img(src=globals.imgPath+"/general/save_the_children.png" alt="Save the Children")
									div.ibe-infocheckin__box-container
										div.ibe-article-new
											.ibe-article-new__date.ibe-float-elements
												span.paragraph.paragraph__regular.ibe-float-elements__to-left.no_margin.ibe-data-date(data-date-short="18/12/18", data-date-large="18 de diciembre 2018")
												a(href="#", title="Ver todas las noticias").link.link__regular.link__regular--important.link__regular--arrow-left.ibe-article-new__back.ibe-float-elements__to-right!="Ver todas las noticias"
											.ibe-article-new__header
												h3.title__h1.ibe-article-new__header-title Iberia con Save the Children
												h4.title__h6.title--light.ibe-article-new__header-subtitle Iberia se suma a la labor de Save the Children
											.ibe-article-new__description
												p.paragraph.paragraph__regular.paragraph__regular--no-margin Iberia se suma a la labor de Save the Children apoyando su programa &quot;Atenci&oacute;n psicosocial a ni&ntilde;os v&iacute;ctimas de la violencia en escuelas secundarias de Ciudad de Guatemala&quot;.
												p.paragraph.paragraph__regular.paragraph__regular--no-margin T&uacute; tambi&eacute;n puedes unirte a esa iniciativa realizando una donaci&oacute;n y conseguir que m&aacute;s j&oacute;venes de 12 a 19 a&ntilde;os reciban la atenci&oacute;n que necesitan. Adem&aacute;s, si eres cliente de Iberia Plus y contribuyes con una donaci&oacute;n, podr&aacute;s participar en el sorteo para viajar a Guatemala con un acompa&ntilde;andte y conocer en persona el trabajo tan importante que Save the Children est&aacute; haciendo.
												p.paragraph.paragraph__regular.paragraph__regular--no-margin Haz tu donaci&oacute;n y conoce nuestro programa de atenci&oacute;n psicosocial en Guatemala.

											.ibe-article-new__footer.ibe-float-elements.ibe-float-elements--xs-block
												.ibe-float-elements__to-right
													button.ibe-button.ibe-button--red.ibe-button--big Quiero participar
												.ibe-float-elements__to-left
													a(href="#", title="Ir a bases del concurso", tabindex="0").link.link__regular.link__regular--underline.ibe-float-elements__align-middle Bases del concurso
								ul.row
									li.col-lg-3.col-md-6.col-xs-12.ibe-card-box--xs.ibe-card-box--normal
										+m-card-box({
											"isLink": true,
											"zoom": true,
											"text":"Y desde hoy, viajar con ellas en Iberia, es más barato.",
											"autoHeight": "ibe-card-box__content--auto-height",
											"titleAutoHeight": "ibe-card-box__title--auto-height",
											"link": {
												"content": "Lorem ipsum a quam liberi"
											},
											"image": {
												"src": "/modules/ibe-card-box/foto.png",
												"alt": "Foto ninas"
											},
											"title": "Las bicicletas son para el verano",
											"date": "18 diciembre 2017"
										})
									li.col-lg-3.col-md-6.col-xs-12.ibe-card-box--xs.ibe-card-box--normal
										+m-card-box({
											"isLink": true,
											"zoom": true,
											"video":true,
											"text":"Iberia incorpora la Turista Premium en 37 aviones de su flota de largo radio.",
											"autoHeight": "ibe-card-box__content--auto-height",
											"titleAutoHeight": "ibe-card-box__title--auto-height",
											"link": {
												"content": "Lorem ipsum a quam liberi"
											},
											"image": {
												"src": "/modules/ibe-card-box/foto2.png",
												"alt": "Foto ninas"
											},
											"title": "Nueva clase Turista Premium",
											"date": "18 diciembre 2017"
										})

									li.col-lg-3.col-md-6.col-xs-12.ibe-card-box--xs.ibe-card-box--normal
										+m-card-box({
											"isLink": true,
											"zoom": true,
											"text":"Iberia se suma a la labor de Save the Children.",
											"autoHeight": "ibe-card-box__content--auto-height",
											"titleAutoHeight": "ibe-card-box__title--auto-height",
											"link": {
												"content": "Lorem ipsum a quam liberi"
											},
											"image": {
												"src": "/modules/ibe-card-box/foto3.png",
												"alt": "Foto ninas"
											},
											"title": "I+D en Iberia",
											"date": "18 diciembre 2017"
										})
									li.col-lg-3.col-md-6.col-xs-12.ibe-card-box--xs.ibe-card-box--normal
										+m-card-box({
											"isLink": true,
											"zoom": true,
											"text":"American Express entregará un Premio Especial Iberia a uno de los 10 finalistas en la gala final.",
											"autoHeight": "ibe-card-box__content--auto-height",
											"titleAutoHeight": "ibe-card-box__title--auto-height",
											"link": {
												"content": "Lorem ipsum a quam liberi"
											},
											"image": {
												"src": "/modules/ibe-card-box/foto4.png",
												"alt": "Foto ninas"
											},
											"title": "#BlogueroGold 2016",
											"date": "18 diciembre 2017"
										})
	+m-footer()
