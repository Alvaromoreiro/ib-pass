extends _general/layout__primary
include _modules/_ibe_card-steps
include _modules/connections/_ibe_connections_alert

block title
	title!="IBERIA - Repositorio Iberia"
block body
	// End wrapper
	section.container.ibe-repository
		//- MENU PRINCIPAL DEL REPOSITORIO
		nav(class="ibe-lat-menu")
			ul.ibe-lat-menu__list
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#form-input" title="Inputs formulario") Inputs formulario
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#form-select" title="Selects formulario") Selects formulario
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#list" title="Listados") Listados
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#table" title="Tablas") Tablas
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#accordions" title="Accordion") Accordion
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#selectorCiudades" title="Selector") Selector Ciudades
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#avisos" title="Mensajes de aviso") Mensajes de aviso
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#leer_mas" title="Leer más") Leer m&aacute;s
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#filtros" title="Filtros") Filtros
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#cards" title="Cards") Cards
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#tabs" title="Tabs") Tabs
				li.ibe-lat-menu__item
					a.ibe-lat-menu__link(href="#search_fly" title="Buscador de vuelos") Buscador de vuelos
		//- CONTENIDO PRINCIPAL DEL REPOSITORIO
		div.col-lg-12.col-md-12.col-sm-12.col-xs-12(class="ibe-repository__content")
			//- COMPONENTES FORMULARIO (INPUTS)
			article(id="form-input", class="ibe_form")
				div.row
					.col-xs-12
						h1.title.title__h1.title--grey Componentes formulario (INPUTS)
				div.row.ibe-repository__article
					div.col-xs-12
						h3.title.title__h3 Input sin mensaje:
						div(class="ibe_form__group fc_form_group")
							label(class="ibe_form__input-label", for="code01") C&oacute;digo de reserva o Nº de billete
							input(class="ibe_form__input-text", name="code01", id="code01", type="text", placeholder="Código de reserva o Nº de billete")
					div.col-xs-12
						h3.title.title__h3 Input con mensaje info no clicable
						div(class="ibe_form__group fc_form_group")
							label(class="ibe_form__input-label", for="code02") C&oacute;digo de reserva o Nº de billete
							input(class="ibe_form__input-text", name="code02", id="code02", type="text", placeholder="Código de reserva o Nº de billete")
							p(class="ibe_form__msg-info") Mensaje de informaci&oacute;n

					div.col-xs-12
						h3.title.title__h3 Input sin mensaje:
						div(class="ibe_form__group fc_form_group")
							label(class="ibe_form__input-label", for="code10") C&oacute;digo de reserva o Nº de billete
							input(class="ibe_form__input-text ibe-form__validate--error", name="code10", id="code10", type="text", placeholder="Código de reserva o Nº de billete")
							
					div.col-xs-12
						h3.title.title__h3 Input con mensaje Error
						div(class="ibe_form__group fc_form_group ibe_form__group--error ")
							label(class="ibe_form__input-label", for="code03") C&oacute;digo de reserva o Nº de billete
							input(class="ibe_form__input-text ibe-form__validate--error", name="code03", id="code03", type="text", placeholder="Código de reserva o Nº de billete")
							p(class="ibe_form__msg-info") Mensaje de informaci&oacute;n
					div.col-xs-12
						h3.title.title__h3 TextArea sin mensaje
						div(class="ibe_form__group fc_form_group")
							textarea.ibe_form__textarea(rows="7", placeholder="Comentarios (opcional). Máximo 1500 caracteres", data-textarea, id="textarea1", title="Comentarios extra")
							div(data-textarea-text).paragraph.paragraph__regular.paragraph__regular--f-right
					div.col-xs-12
						h3.title.title__h3 TextArea con mensaje Error
						div(class="ibe_form__group fc_form_group ibe_form__group--error ")
							textarea.ibe_form__textarea.ibe-form__validate--error(rows="7", placeholder="Comentarios (opcional). Máximo 1500 caracteres", data-textarea, id="textarea2", title="Comentarios extra")
							div(data-textarea-text).paragraph.paragraph__regular.paragraph__regular--f-right
							p(class="ibe_form__msg-info") Mensaje de informaci&oacute;n
					div.col-xs-12
						h3.title.title__h3 Input con mensaje info clicable
						div(class="ibe_form__group fc_form_group")
							label(class="ibe_form__input-label", for="code04") C&oacute;digo de reserva
							input(class="ibe_form__input-text", name="code04", id="code04", type="text", placeholder="Código de reserva")
							p(class="ibe_form__msg-info")
								a.ibe_form__msg-link(href="#") &iquest;D&oacute;nde los encuentro?
					div.col-xs-12
						h3.title.title__h3 Input con boton (icono)
						div(class="ibe_form__group fc_form_group ibe_form__group--button-icon")
							label(class="ibe_form__input-label", for="code0565") Lugar de destino
							input(class="ibe_form__input-text", name="code0565", id="code0565", type="text", placeholder="Lugar de destino")
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button")
								span(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades" class="hideAccessible")!="Click para desplegar ciudades"
					div.col-xs-12
						h3.title.title__h3 Input con boton (icono)
						div(class="ibe_form__group fc_form_group ibe_form__group--button-icon")
							label(class="ibe_form__input-label", for="code1111") Lugar de destino
							input(class="ibe_form__input-text", name="code1111", id="code1111", type="text", placeholder="Contraseña")
							button.ibe_form__input-button.icon-pass-hidden(data-showhide, data-text-show="Mostrar contraseña", data-text-hide="Ocultar contraseña" type="button")
								span(class="hideAccessible")!="Mostrar contraseña"
					div.col-xs-12
						h3.title.title__h3 Input con botón
						div(class="ibe_form__group fc_form_group ibe_form__group--button-icon")
							label(class="ibe_form__input-label", for="code0566") Encuentra tu destino
							input(class="ibe_form__input-text", name="code0566", id="code0566", type="text", placeholder="Encuentra tu destino")
							button.ibe_form__input-button-high.icon-buscar(type="button")
								span(data-toggle-status="true" data-status-open="Click para plegar destinos" data-status-close="Click para desplegar destinos" class="hideAccessible")!="Click para desplegar destinos"
					div.col-xs-12
						h3.title.title__h3 Input compartido con icono en medio
						div(class="ibe_form__group ibe_form__group--half")
							div.ibe_form__group-half.icon-caret_derecha
								label.hideAccessible(for="code05") Fecha ida
								input.ibe_form__input-text(name="code05", id="code05", type="text", placeholder="Fecha ida")
							div.ibe_form__group-half
								label.hideAccessible(for="code06") Fecha vuelta
								input.ibe_form__input-text(name="code06", id="code06", type="text", placeholder="Fecha vuelta")
					div.col-xs-12
						div(class="ibe_form__group ibe_form__group--half")
							h3.title.title__h3 Rango de fechas
							div.ibe_form__group.ibe_form__group--half
								div.ibe_form__group-half.icon-caret_derecha
									label.ibe_form__input-label.hideAccessible(for="flight_round_date") Fecha ida
									input.ibe_form__input-text.ibe_form__input-text--stop-animation.pointer(name="flight_round_date", id="flight_round_date", type="text", placeholder="Fecha ida" data-toggle="collapse" data-target="#searcher-calendar-1" data-cal="start" data-placeholder="placeholder" readonly)
									+m-searcher-calendar({
										id: "searcher-calendar-1",
										type: "fly",
										when: "start",
										number: "1"
									})
								div.ibe_form__group-half
									label.ibe_form__input-label.hideAccessible(for="flight_return_date") Fecha vuelta
									input.ibe_form__input-text.ibe_form__input-text--stop-animation.pointer(name="flight_return_date", id="flight_return_date", type="text", placeholder="Fecha vuelta" data-toggle="collapse" data-target="#searcher-calendar-2" data-cal="end" data-placeholder="placeholder" readonly)
									+m-searcher-calendar({
										id: "searcher-calendar-2",
										type: "fly",
										when: "end",
										number: "2"
									})

					div.col-xs-12
						h3.title.title__h3 Input con icono no clicable (readonly)
						div(class="ibe_form__group ibe_form__group--icon icon-caret_abajo")
							label.hideAccessible(class="ibe_form__input-label", for="code07") C&oacute;digo de reserva
							input(class="ibe_form__input-text ibe_form__input-text--stop-animation", name="code07", id="code07", type="text", placeholder="Código de reserva" value="Código de reserva" readonly)
						h3.title.title__h3 Input con icono rojo
						.ibe_form__group.fc_form_group.ibe_form__group--button-icon.ibe_form__group--separated.ibe_form__group--nomargintop
							label.ibe_form__input-label(for='code12') C&oacute;odigo de reserva
							input(class="ibe_form__input-text", name="code12", id="code12", type="text", placeholder="C&oacute;digo de reserva")
							p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-informacion_2.ibe_form__input-button--red(type='button' data-tooltipGeneric title="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi in consectetur orci. Lorem ipsum dolor sit amet.")
								span.hideAccessible(data-toggle-status='true', data-status-open='Click para info', data-status-close='Click para info') Click para m&aacute;s informaci&oacute;n
						h3.title.title__h3 Input disabled
						.ibe_form__group.fc_form_group.ibe_form__group--button-icon.ibe_form__group--separated.ibe_form__group--nomargintop
							label.ibe_form__input-label(for='code112') Nombre
							input(class="ibe_form__input-text ibe_form__group--disabled", disabled, name="code112", id="code112", type="text",  placeholder="Nombre")
							
			
			//- COMPONENTES FORMULARIO (SELECT, CHECK, RADIO)
			article(id="form-select")
				div.row
					.col-xs-12
						h1.title.title__h1.title--grey Componentes formulario (SELECT, CHECK, RADIO)
				div.row.ibe-repository__article
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3
							strike Select
							| (Deprecated)
						.ibe_form__select
							//- select(id="ejemplo01", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-ng-model="resultSelect", data-selectize='simple')
							select(id="ejemplo01", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-selectize='simple')
								option(value="") Elige un ejemplo
								option(value="01") Ejemplo 01
								option(value="02") Ejemplo 02
								option(value="03") Ejemplo 03
								option(value="04") Ejemplo 04
								option(value="05") Ejemplo 05
								option(value="06") Ejemplo 06
							label.ibe_form__selectize-label.hideAccessible(for="ejemplo01")!="Elige un ejemplo"
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Selectize multiples select
						.ibe_form__selectize-multi
							label.ibe_form__input-label!="Fecha de caducidad"
							.ibe_form__selectize-multi__selectors
								label.hideAccessible(for="dia") Dias
								select(class="ibe_form__selectize", name="dia", data-selectize='simple', id="dia")
									option(value="") Dia
									option(value="01") 01
									option(value="02") 02
									option(value="03") 03
									option(value="04") 04
									option(value="05") 05
								label.hideAccessible(for="mes") mes
								select(class="ibe_form__selectize", name="mes", data-selectize='simple', id="mes")
									option(value="") Mes
									option(value="01") 01
									option(value="02") 02
									option(value="03") 03
									option(value="04") 04
									option(value="05") 05
								label.hideAccessible(for="anio") anio
								select(class="ibe_form__selectize ibe_form__selectize--year", name="anio", data-selectize='simple', id="anio")
									option(value="") Año
									option(value="1989") 1989
									option(value="1990") 1990
									option(value="1991") 1991
									option(value="1992") 1992
									option(value="1993") 1993
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select con label
						.ibe_form__select.ibe_form__select--label
							//- select(id="ejemplo03", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-ng-model="resultSelect", data-selectize='simple')
							select(id="ejemplo03", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-selectize='simple')
								option(value="") Elige un ejemplo
								option(value="01") Ejemplo 01
								option(value="02") Ejemplo 02
								option(value="03") Ejemplo 03
								option(value="04") Ejemplo 04
								option(value="05") Ejemplo 05
								option(value="06") Ejemplo 06
							label.ibe_form__selectize-label(for="ejemplo03") Elige una opcion
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select (mensaje error)
						.ibe_form__select.ibe_form__group.ibe_form__group--error
							//- select(id="ejemplo02", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-ng-model="resultSelect", data-selectize='simple')
							select(id="ejemplo02", class="ibe_form__selectize", name="ejemplo01", data-ibe-selectize, data-selectize='simple')
								option(value="") Elige un ejemplo
								option(value="01") Ejemplo 01
								option(value="02") Ejemplo 02
								option(value="03") Ejemplo 03
								option(value="04") Ejemplo 04
								option(value="05") Ejemplo 05
								option(value="06") Ejemplo 06
							label.ibe_form__selectize-label.hideAccessible(for="ejemplo02")!="Elige un ejemplo"
							p(class="ibe_form__msg-info") Mensaje de informaci&oacute;n

					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select normal nuevo
						.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe-form__group--m-mobile.ibe_form__group--nomargintop
							label.ibe_form__selectize--label(for="residencia")
								span.ibe_form__input-text Residencia:
							select(id="residencia", class="ibe-select ibe_form__input-text", name="residencia", data-selectmenu="")
								option(value="Residencia") Residencia
								option(value="NUMEROSA1") No residente
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select Label nuevo
						.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop.ibe-form__group--m-mobile(data-selectmenu_claim)
							label.ibe_form__selectize--label(for="tarifa")
								span.ibe_form__input-text Tarifa:
							select(id="tarifa", class="ibe-select ibe_form__input-text", name="tarifa", data-selectmenu="")
								option(value="") Tarifa
								option(value="Más económica") M&aacute;s econ&oacute;mica
								option(value="Turista Premium") Turista Premium
								option(value="Business Class") Business Class
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select Label nuevo con opción seleccionada
						.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop.ibe-form__group--m-mobile(data-selectmenu_claim)
							label.ibe_form__selectize--label.ibe_form__selectize--label02(for="opcion")
								span.ibe_form__input-text.ibe_form__input-text--selectnew Opcion:
							select(id="opcion", class="ibe-select ibe_form__input-text", name="opcion", data-selectmenu="")
								option(value="") Opcion
								option(value="1", selected) Opción 1
								option(value="2") Opción 2
								option(value="3") Opción 3
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select nuevo label con Autocomplete
						.ibe_form__group--select-edit
							label.ibe_form__selectize--label.title(for="country")!="Destino preferido"
							select(id="country", class="ibe-select", name="country", data-selectmenu-edit)
								option(value="") Destino preferido
								option(value="00") Madrid
								option(value="01") Bruselas
								option(value="02") Santiago de Compostela
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Select nuevo sin label con Autocomplete
						.ibe_form__group--select-edit.ibe_form__group--hide-label
							label.ibe_form__selectize--label(for="country2")!="Destino preferido"
							select(id="country2", class="ibe-select", name="country", data-selectmenu-edit)
								option(value="") Destino preferido
								option(value="00") Madrid
								option(value="01") Bruselas
								option(value="02") Santiago de Compostela
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Check
						.ibe-form__checkbox
							input.ibe-form__checkbox-input(type="checkbox" id="ejemplo_check01" name="ejemplo_check01" checked)
							label.ibe-form__checkbox-label(for="ejemplo_check01")
								span He le&iacute;do y acepto la politica sobre
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Check (mensaje error)
						.ibe-form__checkbox.ibe-form__checkbox--error
							input.ibe-form__checkbox-input(type="checkbox" id="ejemplo_check02" name="ejemplo_check02")
							label.ibe-form__checkbox-label(for="ejemplo_check02")
								span He le&iacute;do y acepto la politica sobre
							p(class="ibe_form__msg-info") Mensaje de informaci&oacute;n
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Radio Button
						.ibe_form__radio
							input(type="radio", name="radios1", id="ejemplo_radio01", class="ibe_form__radio-input")
							label(for="ejemplo_radio01", class="ibe_form__radio-text") He le&iacute;do y acepto la politica sobre

					div.col-md-6.col-sm-12.col-xs-12
			//- COMPONENTES LISTAS
			article(id="list")
				div.row
					.col-xs-12
						h1.title.title__h1.title--grey Listados
				div.row.ibe-repository__article
					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (normal)
						ul.ibe-list.ibe-list--normal
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 4
					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (normal smaller)
						ul.ibe-list.ibe-list--normal
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 4

					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (Square-o)
						ul.ibe-list.ibe-list--square-o
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 4
				div.row.ibe-repository__article
					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (checked)
						ul.ibe-list.ibe-list--checked
							li.ibe-list__item.ibe-list__item--correct
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item.ibe-list__item--correct
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item.ibe-list__item--incorrect
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item.ibe-list__item--incorrect
								p.paragraph.paragraph__regular Item 4
					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (numbers)
						ul.ibe-list.ibe-list--numbers
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item
								p.paragraph.paragraph__regular Item 4
					div.col-md-4.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (numbers smaller)
						ul.ibe-list.ibe-list--numbers
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 1
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 2
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 3
							li.ibe-list__item.ibe-list__item--smaller-padding
								p.paragraph.paragraph__regular Item 4			
				div.row.ibe-repository__article
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (simple)
						ul.ibe-list.ibe-list--simple
							li.ibe-list__item
								a.link.link__regular.link__regular--important(href="#" title="Item 1") Item 1
							li.ibe-list__item
								a.link.link__regular.link__regular--important(href="#" title="Item 2") Item 2
							li.ibe-list__item
								a.link.link__regular.link__regular--important(href="#" title="Item 3") Item 3
							li.ibe-list__item
								a.link.link__regular.link__regular--important(href="#" title="Item 4") Item 4
					div.col-md-6.col-sm-12.col-xs-12
						h3.title.title__h3 Lista (links)
