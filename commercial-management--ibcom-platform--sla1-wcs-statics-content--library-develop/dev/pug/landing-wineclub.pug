extends _general/layout__primary
block title
	title!="WineClub"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-guide
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		div.container
			div.row
				div.col-xs-12
					h1.title.title__h1.title--center WineClub
				div.col-xs-12
					article.ibe-floatbanner.ibe-floatbanner--right.ibe-floatbanner--mb
						.ibe-floatbanner__background.ibe-floatbanner__background--full(style="background-image: url('images/modules/wineclub/img-no-valida.png')")
						.col-xs-12.col-md-6.ibe-floatbanner__content.ibe-floatbanner__content--bg-full.col-md-push-7
							div.ibe-floatbanner__content-box
								h2.ibe-floatbanner__content--title-v2 Descubre Bodega Iberia
								p.ibe-floatbanner__content--cite "Es de agradecer el esfuerzo por permitirnos seguir disfrutando de una selección tan cuidada ahora también en casa"
								p.ibe-floatbanner__content--subtext Thomas Vintenberg
								a(href="#" title="Bodega Iberia" class="ibe-button ibe-button--red ibe-button--big ibe-button--block ibe-button--inline-block") Bodega Iberia
		article.ibe-infocheckin__box.ibe-infocheckin__box--carousel.ibe-infocheckin__box--carousel-full
			div.container
				div.row
					div.col-xs-12
						div.row
							div.col-xs-10
								h3.title.title__h3.ibe-infocheckin__box-title Bodegas ubicadas en las regiones vitivinícolas más prestigiosas de España
							div.col-xs-2.align-right
								a.link.link__regular.link__regular--small.link__regular--important.link__regular--box-title(href="#" title="Ver todas las bodegas")
									span.ibe-box-links__icon.ibe-box-links__icon--default.icon-mas_2
									span.hideAccessible!="Ver todos las bodegas "
						div.ibe-carousel(data-slick="more-wines")
							div.ibe-carousel__img
								article.ibe-wall-articles
									a.ibe-wall-articles__container(href="#" title="Biagorri")
										figure.ibe-wall-articles__cont-img
											img(alt="Imagen 1" src=globals.imgPath + "/modules/wineclub/biagorri-img.png")
									a.ibe-wall-articles__link(href="#" title="Biagorri")
										h3.ibe-wall-articles__title.ibe-wall-articles__title--block.ibe-wall-articles__title--special Biagorri
										span.ibe-wall-articles__detail.ibe-wall-articles__detail--block.ibe-wall-articles__detail--primary.ibe-wall-articles__detail--special D.O.Ca RIOJA (Alavesa)
										span.ibe-wall-articles__detail.ibe-wall-articles__detail--block.ibe-wall-articles__detail--subtext Maceración Carbónica, Blanco Fermentado en Barrica, Crianza, Reserva, Belus, Garnacha, De Garage, B70
							div.ibe-carousel__img
								article.ibe-wall-articles
									a.ibe-wall-articles__container(href="#" title="R&G Rolland Galarreta")
										figure.ibe-wall-articles__cont-img
											img(alt="Imagen 1" src=globals.imgPath + "/modules/wineclub/r-g-rolland-galarreta-img.png")
