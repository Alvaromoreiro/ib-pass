extends _general/layout__primary
block title
	title!="IBERIA - Parners Carousel"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Parners Carousel"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Parners Carousel"

					article.ibe-infocheckin__box
						div.ibe-carousel(data-slick='carrousel' data-slick-params='{"dots":true}')
							div
								a(href="#" title="partner ejemplo")
									figure.hidden-xs.ibe-figure
										img.ibe-img(src=globals.imgPath + "/content/Horizontal-970x250.jpg" alt="partner ejemplo")
									figure.hidden-sm.hidden-md.hidden-lg.hidden-xl.ibe-figure
										img.ibe-img(src=globals.imgPath + "/content/VERTICAL-240x480.jpg" alt="partner ejemplo")
							div
								a(href="#" title="partner ejemplo")
