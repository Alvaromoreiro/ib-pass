										span(aria-hidden="true").ibe-table__tbody-text.ibe-table__tbody-text--price 400€
								tr.ibe-table__tbody-tr
									td.ibe-table__tbody-td
										a(href="javascript:void(0)", data-city="AGP", title="al buscador", data-table-click, class="ibe-table__tbody-td--link")
											span.hideAccessible Buscar un vuelo de Málaga a Roma desde 42€.
										span(aria-hidden="true").ibe-table__tbody-text Málaga
