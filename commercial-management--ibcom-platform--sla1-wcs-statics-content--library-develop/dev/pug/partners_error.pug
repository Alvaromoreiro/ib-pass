extends _general/layout__primary
include _modules/_ibe_tabs-icons
block title
	title!="IBERIA - Partners - No found Partners"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})

	// End wrapper
	section.container
		div.row
			div.col-xs-12
				+m-ibe-breadcrumbs({
					menu: "claim"
				})
		div.row
			div.col-lg-9.col-xs-12.col-lg-push-3
				section.ibe-infocheckin
					header.ibe-infocheckin__header
						h1.title.title__h1.ibe-infocheckin__header-primary!="Motor"
						h5.title.title__h5.ibe-infocheckin__header-secondary!="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean euismod bibendum laoreet."

				div.row
					div.col-xs-12
						figure.ibe-figure-top
							img.w100(src=globals.imgPath + "/content/nuestras-historias.png" alt="Foto")

				///////// lineas para mostrar error para integracion en WCS /////////////////
				div.row
					.col-xs-12
						div.ibe-infocheckin__box.ibe-infocheckin__box--error
							p.paragraph.paragraph--big.paragraph--center.paragraph__regular--m-bottom-30 En este momento no tenemos partners asociados
							a.ibe-button.ibe-button--red.ibe-button--large.ibe-button--large-plus.pull-center(href="#nogo", title!="Lorem ipsum") Ir a Partner Iberia Plus
				/////////////////////// Fin codigo de error /////////////////////////////////////


			div.col-lg-3.col-xs-12.col-lg-pull-9
				+m-lat-menu({
					items: [
						{
							link: "Partners Iberia Plus",
							title: "Partners Iberia Plus"
						},
						{
							link: "Vuelos",
							title: "Vuelos"
						},
						{
							link: "Hoteles",
							title: "Hoteles"
						},
						{
							link: "Finanzas",
							title: "Finanzas",
							cssClass: "ibe-lat-menu__item--active"
						},
						{
							link: "Ocio y compras",
							title: "Ocio y compras"
						},
						{
							link: "Gasolineras",
							title: "Gasolineras"
						},
						{
							link: "Coches y movilidad",
							title: "Coches y movilidad"
						},
						{
							link: "Gastronom&iacute;a",
							title: "Gastronom&iacute;a"
						}

					]
				})

				.ibe-cart-cont
					div.ibe-card-cont__container.ibe-card-cont__container--medium.hidden-md.hidden-sm.hidden-xs
						form.form-search-partners(action="#" method="post", id="form1")
							fieldset
								legend.title__h5.title--no-paddT Buscador de Partners
								.row
									.col-xl-12
										.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="clase_mercado")
												span.ibe_form__input-text Mercado
											select(required, id="clase_mercado", class="ibe-select ibe_form__input-text", name="clase_mercado", data-selectmenu="")
												option(value="") Mercado
												option(value="dni") Todos los mercados
												option(value="carnet") Carn&eacute; Nacional de Identidad
												option(value="pasaporte") Pasaporte
												option(value="tarjeta") Tarjeta Residente en Espa&ntilde;a
											p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
									.col-xl-12
										.ibe_form__group.ibe_form__group--separated.fc_form_group.ibe__form__group--select.ibe_form__group--select-new(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="clase_catego")
												span.ibe_form__input-text Categor&iacute;a
											select(required, id="clase_catego", class="ibe-select ibe_form__input-text", name="clase_catego", data-selectmenu="")
												option(value="") Categor&iacute;a
												option(value="dni") DNI espa&ntilde;ol (incl.letra)
												option(value="carnet") Carn&eacute; Nacional de Identidad
												option(value="pasaporte") Pasaporte
												option(value="tarjeta") Tarjeta Residente en Espa&ntilde;a
											p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")

									.col-xl-12.col-lg-12.col-md-6.col-sm-12.col-xs-12
										button.ibe-button.ibe-button--red.ibe-button--block.ibe-button--smaller(type='button') Buscar


	+m-footer()
