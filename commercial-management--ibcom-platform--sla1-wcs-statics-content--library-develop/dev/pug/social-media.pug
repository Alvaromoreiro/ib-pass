						div.ibe-box-contrast__header
							h3.ibe-box-contrast__title!="Google +"
							span.ibe-box-contrast__icon.icon-social_googleplus
						div.ibe-box-contrast__body
							p.ibe-box-contrast__description!="Forma parte de nuestro c&iacute;rculo. Aquí encontrar&aacute;s nuestras &uacute;ltimas novedades y contenidos."
						div.ibe-box-contrast__footer
							a.link.link__regular.link__regular--important(href="#" title="Iberia en Google+")!="Iberia en Google +"
				div.ibe-carousel-social-media__slide
