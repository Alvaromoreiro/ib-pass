extends _general/layout__primary
block title
	title!="IBERIA - Equipaje de mano"
block body
	+m-ibe-cookies()
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-infocheckin
						header.ibe-infocheckin__header
							h1.title.title__h1.ibe-infocheckin__header-primary!="Equipaje de mano"
							h2.title.title__h5.ibe-infocheckin__header-secondary!="Son los bultos que pueden viajar contigo en la cabina del avi&oacute;n"

						article.ibe-infocheckin__box
							h3.title.title__h3.ibe-infocheckin__box-title!="Puedes llevar una maleta de cabina y un accesorio personal."
							p.paragraph.paragraph__regular!="Si viajas sin equipaje de mano, acceder&aacute;s antes al avi&oacute;n (en vuelos operados por Iberia con origen Europa, excepto Londres)."
							p.paragraph.paragraph__regular!="Dada la capacidad limitada en la cabina del avi&oacute;n, eventualmente en vuelos de alta ocupaci&oacute;n, algunos equipajes de mano podr&iacute;an ser retirados para su carga en la bodega del avi&oacute;n sin ning&uacute;n coste. Si tu equipaje de mano est&aacute; fuera de normas deber&aacute; viajar en bodega con un posible cargo adicional."

						article.ibe-infocheckin__box
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/general/equipaje_mano_max.jpg" alt="Equipaje de mano")
							h3.title.title__h6.ibe-infocheckin__box-title.bold!="Check-in Online"
							p.paragraph.paragraph__regular.paragraph__regular--p3!="56 cm x 45 cm x 25 cm"
							p.paragraph.paragraph__regular!="Asa, bolsillos y ruedas incluidas. Deber&aacute;s facturar el equipaje si supera estas dimensiones. La maleta debe caber en el medidor de equipaje del aeropuerto y has de poder levantarla e introducirla en los compartimentos superiores del avi&oacute;n sin ayuda."
							p.paragraph.paragraph__regular!="Existen algunas "
							a.link.link__regular.link__regular--important(href="#" title="Excepciones")!="Excepciones"

						article.ibe-infocheckin__box
							h3.title.title__h3.ibe-infocheckin__box-title!="Vuelos del Grupo Iberia (Iberia, Iberia Express e Iberia Regional Air Nostrum)"
							div.ibe-modal__forbid.ibe-modal__forbid--no-icon
