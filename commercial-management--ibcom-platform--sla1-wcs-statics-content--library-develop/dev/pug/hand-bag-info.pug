										p.paragraph.paragraph__regular
											a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"
								.col-lg-4.col-sm-12.border
									.ibe-box-divided__content
										h4.title.title__h4(data-fc-box-title-height)!="Equipajes especiales"
										p.paragraph.paragraph__regular(data-fc-box-height)!="Puedes llevar en el avi&oacute;n equipos de esqu&iacute;, golf, surf, bicicletas, sillas de ruedas, armas de fuego, instrumentos musicales…"
										p.paragraph.paragraph__regular
											a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"
								.col-lg-4.col-sm-12
									.ibe-box-divided__content.no-border
										h4.title.title__h4(data-fc-box-title-height)!="Exceso de equipaje"
										p.paragraph.paragraph__regular(data-fc-box-height)!="A partir de los 23 Kg. Y hasta un m&aacute;ximo de 32 kg. Se aplicar&aacute; un cargo de sobrepeso de 60&euro; por pieza. Con excepciones para los clientes Iberia Plus."
										p.paragraph.paragraph__regular
											a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"



