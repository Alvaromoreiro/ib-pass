										span.ibe-modal__forbid-des!="1 maleta de cabina"
									div.col-xs-12.col-lg-6.ibe-modal__forbid-item
										figure.ibe-fig
											img.ibe-img(src=globals.imgPath + "/modules/icons/bag-icon.png" alt="1 maleta")
										span.ibe-modal__forbid-tit!="Business Class / Club - Corto / Medio Radio"
										span.ibe-modal__forbid-des!="1 maleta de cabina"


							p.paragraph.paragraph__regular.paragraph__regular--grey!="Recuerda que adem&aacute;s podr&aacute;s llevar un accesorio personal adicional"

						article.ibe-infocheckin__box
							p.paragraph.paragraph__regular.paragraph__regular--grey!="Los aviones de Iberia Regional Air Nostrum son m&aacute;s peque&ntilde;os, por lo que podr&iacute;a haber alguna limitaci&oacute;n para poderlo llevar contigo en la cabina. En ese caso, tu equipaje volar&iacute;a en bodega y se te entregar&iacute;a a pie de avi&oacute;n en destino."
							p.paragraph.paragraph__regular.paragraph__regular--grey!="Dada la capacidad limitada en la cabina del avi&oacute;n, eventualmente en vuelos de alta ocupaci&oacute;n, algunos equipajes de mano podr&iacute;an ser retirados para su carga en la bodega del avi&oacute;n sin ning&uacute;n coste"

						article.ibe-infocheckin__box.ibe-infocheckin__box--icon
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/modules/icons/big-bag-icon.png" alt="Accesorio Personal")
							h4.title.title__h4.ibe-infocheckin__box-title!="Accesorio personal"
							p.paragraph.paragraph__regular.paragraph--icon!="Se permite un &uacute;nico accesorio personal adem&aacute;s de la maleta de cabina. Dicho accesorio puede ser uno de los que se relacionan a continuaci&oacute;n: Malet&iacute;n o bolso de se&ntilde;ora o cartera peque&ntilde;a u ordenador port&aacute;til. Adem&aacute;s, si viaja con un beb&eacute; se permitir&aacute; un bolso para beb&eacute; con su comida, bebida y art&iacute;culos necesarios para el vuelo."
							p.paragraph.paragraph__regular
								a.link.link__regular.link__regular--important.link__regular--right.link__regular--arrow(href="#" title="Ver dispositivos")!="Ver dispositivos"

						article.ibe-infocheckin__box.ibe-infocheckin__box--icon
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/modules/icons/laptop-icon.png" alt="Dispositivos electrónicos")
							h4.title.title__h4.ibe-infocheckin__box-title!="Dispositivos electr&oacute;nicos"
							p.paragraph.paragraph__regular.paragraph--icon!="Puedes llevar conectados, siempre durante el vuelo, tu ordenador personal, agenda electr&oacute;nica, reproductor de m&uacute;sica y el m&oacute;vil (en modo avi&oacute;n)."
							p.paragraph.paragraph__regular
								a.link.link__regular.link__regular--important.link__regular--right.link__regular--arrow(href="#" title="Ver dispositivos")!="Ver dispositivos"

						article.ibe-infocheckin__box.ibe-infocheckin__box--icon
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/modules/icons/liquid-icon.png" alt="Normas sobre líquidos")
							h4.title.title__h4.ibe-infocheckin__box-title!="Normas sobre l&iacute;quidos"
							p.paragraph.paragraph__regular.paragraph--icon!="Est&aacute;n permitidas cantidades en envases de 100 ml. dentro de una bolsa de pl&aacute;stico transparente con cierre adhesivo o cremallera cuya capacidad m&aacute;xima es 1 litro."
							p.paragraph.paragraph__regular
								a.link.link__regular.link__regular--important.link__regular--right.link__regular--arrow(href="#" title="Ver dispositivos")!="Ver dispositivos"

						article.ibe-infocheckin__box.ibe-infocheckin__box--icon
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/modules/icons/forbid-icon.png" alt="Artñiculos prohibidos")
							h4.title.title__h4.ibe-infocheckin__box-title!="Art&iacute;culos prohibidos"
							p.paragraph.paragraph__regular.paragraph--icon!="Aquellos que son peligrosos por su naturaleza qu&iacute;mica como explosivos, t&oacute;xicos y radiactivos. Y por su forma, armas blancas y de fuego, aristas, herramientas, etc."
							p.paragraph.paragraph__regular
								a.link.link__regular.link__regular--important.link__regular--right.link__regular--arrow(href="#" title="Ver dispositivos")!="Ver dispositivos"

						article.ibe-infocheckin__box
							h3.title.title__h3.ibe-infocheckin__box-title!="Casos Excepcionales"

							+m-accordion({
								"id": "fly_other_1",
								"target": "#fly_other_1",
								"title": {
									"text": "Vuelos con otras compa&ntilde;&iacute;as",
									"title": "Vuelos con otras compañías",
									"href": "#"
								},
								"collapse": "Haz el Check-in online en Iberia.com en 5 sencillos pasos, s&oacute;lo necesitas un ordenador o tablet con conexi&oacute;n a internet. Si tienes un Smartphone puedes acceder a iberia.mobi o descargarte las aplicaciones para iPhone, Android o Blackberry."
							})
							+m-accordion({
								"id": "fly_other_2",
								"target": "#fly_other_2",
								"title": {
									"text": "Vuela a o desde Londres",
									"title": "Vuela a o desde Londres",
									"href": "#"
								},
								"collapse": "Haz el Check-in online en Iberia.com en 5 sencillos pasos, s&oacute;lo necesitas un ordenador o tablet con conexi&oacute;n a internet. Si tienes un Smartphone puedes acceder a iberia.mobi o descargarte las aplicaciones para iPhone, Android o Blackberry."
							})

						article.ibe-infocheckin__box.ibe-infocheckin__box--red
							figure.ibe-figure
								img.ibe-img(src=globals.imgPath + "/general/red-bag-bkg.png" alt="Recuerda")
							h4.title.title__h4.icon-flecha_1_derecha!="Y recuerda"
							ul.ibe-list
								li.ibe-list__item
									span.ibe-list__text!="Bulto m&aacute;ximo 56x45x25 cm."
								li.ibe-list__item
									span.ibe-list__text!="Si superas el est&aacute;ndar debes facturar."
								li.ibe-list__item
									span.ibe-list__text!="1 litro como m&aacute;ximo en l&iacute;quidos embotellados."
								li.ibe-list__item
									span.ibe-list__text!="Puedes conectar tus dispositivos electr&oacute;nicos."
								li.ibe-list__item
									span.ibe-list__text!="No lleves objetos peligrosos contigo."

						h3.title.title__h3!="Mira c&oacute;mo se aplica en vuelos operados por"
						div.ibe-infocheckin__box.ibe-infocheckin__box--small.ibe-infocheckin__box--no-title
							div.ibe-modal_body-logos
								ul.ibe-modal_body-logos_container.clearfix
