										figure.ibe-fig
											img.ibe-img(src=globals.imgPath + "/modules/icons/bag-icon.png" alt="1 maleta")
										span.ibe-modal__forbid-tit!="Turista"
										span.ibe-modal__forbid-des!="1 maleta de cabina"
									div.col-xs-12.col-lg-3.ibe-modal__forbid-item
										figure.ibe-fig
											img.ibe-img(src=globals.imgPath + "/modules/icons/bag-icon.png" alt="1 maleta")
										span.ibe-modal__forbid-tit!="Business Class / Club - Corto / Medio Radio"
										span.ibe-modal__forbid-des!="1 maleta de cabina"
									div.col-xs-12.col-lg-3.ibe-modal__forbid-item
										figure.ibe-fig
											img.ibe-img(src=globals.imgPath + "/modules/icons/double-bag-icon.png" alt="2 maletas")
										span.ibe-modal__forbid-tit!="Business Plus Largo Radio"
										span.ibe-modal__forbid-des!="2 maletas de cabina."
									div.col-xs-12.col-lg-3.ibe-modal__forbid-item
										figure.ibe-fig
											img.ibe-img(src=globals.imgPath + "/modules/icons/double-bag-icon.png" alt="2 maletas")
