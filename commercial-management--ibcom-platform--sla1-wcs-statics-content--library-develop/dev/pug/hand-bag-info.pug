											figure.ibe-modal_body-logos_container-item-figure
												img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")

						h3.title.title__h3!="Puede que te interese adem&aacute;s"
						div.ibe-box-divided
							.row
								.col-lg-4.col-sm-12
									.ibe-box-divided__content
										h4.title.title__h4(data-fc-box-title-height)!="Equipaje facturable"
