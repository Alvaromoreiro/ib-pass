extends _general/layout__primary
include _modules/_ibe_tabs-icons
block title
	title!="IBERIA - Partners - Category"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// End wrapper
	section.container
		div.row
			div.col-xs-12
				+m-ibe-breadcrumbs({
					menu: "claim"
				})
		div.row
			div.col-lg-9.col-xs-12.col-lg-push-3
				section.ibe-infocheckin
					header.ibe-infocheckin__header
						h1.title.title__h1.ibe-infocheckin__header-primary!="C&oacute;mo donar Avios"
						h5.title.title__h5.ibe-infocheckin__header-secondary!="Haz que tus Avios marquen la diferencia"
					article.ibe-infocheckin__box.ibe-infocheckin__box--img-big
						figure.ibe-figure
							img.ibe-img(src=globals.imgPath + "/content/antes-de-viajar.png" alt="Antes de viajar")
						div.ibe-infocheckin__box-container.ibe-infocheckin__box-container--p-medium
							div.ibe-line-spacing.ibe-line-spacing--large
								strong.paragraph.paragraph__regular!="¿Sabes cuántas miles de personas necesitan volar cada día para recibir asistencia médica, ayudar en proyectos de ONGs o por otras razones humanitarias y no pueden permitírselo?"
								p.paragraph.paragraph__regular!="A través de la campaña de Avios solidarios puedes donar tus Avios a quién más los necesita. Consulta a que ONGs puedes donar tus puntos y obtén más información sobre ellas."
								p.paragraph.paragraph__regular!="¡Corre! Puedes ayudar a muchísimas persones simplemente donando unos AVIOS."
							div.ibe-line-spacing.ibe-line-spacing--large
								+m-tabs-icons({
									items:
										[
											{
												"src": "/logos/ong/logo_unicef.png",
												"alt": "Logo",
												"title": "UNICEF",
												"text": "Iberia, Unicef y Amadeus renovamos en 2018 nuestro convenio de colaboración por tres años más. El principal objetivo del acuerdo, que está basado en microdonativos, es recaudar fondos para apoyar proyectos de vacunación y prevenir enfermedades como el sarampión, la polio o la tos ferina. El proyecto, que se lanzó en 2013, permite a los clientes de Iberia realizar donaciones de entre 3 y 20 euros cuando compran un billete en la página web de la compañía. En sus cinco años de vigencia se han recaudado más de 943.000 euros, que han contribuido a financiar campañas de vacunación infantil contra la polio en Chad, la difteria, la tosferina y el tétanos en Angola, o la rubeola, el sarampión y las paperas en Cuba. En conjunto, más de un millón de niños han sido vacunados en estas campañas."
											},
											{
												"src": "/logos/ong/logo_save_the_children.png",
												"alt": "Logo",
												"title": "Save the children",
												"text": "Apoyamos la labor de Save the Children en su proyecto “Institutos Construyendo Paz”, que enseña herramientas para la vida a los niños de escuelas secundarias de Ciudad de Guatemala. Este programa, que está obteniendo unos resultados muy positivos desde que se inició en 2014, tiene como objetivo llegar a 7.000 niños y adolescentes del país.",
												"active": true
											},
											{
												"src": "/logos/ong/logo_fundacion_integra.png",
												"alt": "Logo",
												"title": "Fundación Integra",
												"text": "Iberia forma parte del patronato de Fundación Integra para apoyar a mujeres víctimas de violencia de género y fomentar su integración laboral. Desde el año 2016, ofrecemos oportunidades de trabajo a este colectivo vulnerable. Asimismo, realizamos acciones de voluntariado impartiendo talleres de formación a personas en exclusión y mujeres víctimas de violencia de género, y desarrollamos campañas de sensibilización social. Mujeres directivas de Iberia participan en el programa “Leadership for a job”, iniciativa que busca aprovechar el conocimiento y experiencia de directivos de empresas para ponerlos al servicio de personas en severa exclusión social para que consigan un trabajo que pueda cambiar sus vidas. Además, en 2018, Fundación Integra nos hizo entrega de la Mención Especial de Recursos Humanos, como reconocimiento a los esfuerzos de la compañía en apoyo de las personas en riesgo de exclusión.",
											},
											{
												"src": "/logos/ong/logo_make_a_wish.jpg",
												"alt": "Logo",
												"title": "Make a wish",
												"text": "Colaboramos desde 2001 como transportista oficial con Make a Wish Spain, una organización dedicada a conceder deseos a los niños que padecen algún tipo de enfermedad grave, enriqueciendo sus vidas a través de experiencias únicas e inolvidables que les ayuden a superar emociones negativas, como el miedo, la angustia o la soledad. En este tiempo hemos contribuido a cumplir los sueños de más de 280 niños."
											},
											{
												"src": "/logos/ong/logo_juegaterapia.png",
												"alt": "Logo",
												"title": "Juegaterapia",
												"text": "Desde 2016 hemos vendido en nuestros aviones más de 3.600 muñecos baby pelones para apoyar la lucha contra el cáncer infantil dentro y fuera de España, en el marco de la actividad de la Fundación Juegaterapia, que ayuda a los niños enfermos con proyectos lúdicos en hospitales y financia investigaciones oncológicas.",
											},
											{
												"src": "/logos/ong/logo_tierra_de_hombres.png",
												"alt": "Logo",
												"title": "Tierra de hombres",
												"text": "En el ámbito de la salud luchan para ofrecer un acceso a los cuidados básicos a todos los niños y niñas, en algún lugar o comunidad que se encuentren. Además, a través del programa de salud Atenciones Médicas Especializadas (A.M.E.), Fundación Tierra de Hombres busca la mejora sanitaria de los recursos propios de cada país a través de la prevención, el tratamiento y la educación para la salud. La Fundación se encarga de organizar el traslado a Europa (Suiza, España) de menores con patologías graves pero curables, pertenecientes a familias de escasos recursos. Y dan gran importancia a informar y sensibilizar a la sociedad y formar a niños, niñas y jóvenes en el respeto a los Derechos Humanos y, sobre todo, en los Derechos de la Infancia."
											}
										]
								})
							div.u-text-right
								button.ibe-button.ibe-button--red.ibe-button--big!="Accede o registrate en Iberia Plus para donar Avios"
			div.col-lg-3.col-xs-12.col-lg-pull-9
				+m-lat-menu({
					items: [
						{
							link: "C&oacute;mo funciona Avios",
							title: "Cómo funciona Avios"
						},
						{
							link: "Comprar, regalar y transferir Avios",
							title: "Comprar, regalar y transferir Avios"
						},
						{
							link: "Avios Solidarios",
							title: "Avios Solidarios",
							cssClass: "ibe-lat-menu__item--active"
						},
						{
							link: "Obtener Avios",
							title: "Obtener Avios"
						},
						{
							link: "Utilizar mis Avios",
							title: "Utilizar mis Avios"
						},
						{
							link: "Hoteles, coches y experiencias",
							title: "Hoteles, coches y experiencias"
						},
						{
							link: "Avios no anotados",
							title: "Avios no anotados"
						},
						{
							link: "Qu&eacute; son Puntos Elite",
							title: "Qué son Puntos Elite"
						},
						{
							link: "Obtener Puntos Elite",
							title: "Obtener Puntos Elite"
						}

					]
				})
