extends _general/layout__primary
include _modules/stopover-tabs/_ibe_stopover-tabs_home-steps
include _modules/stopover-tabs/_ibe_stopover-tabs_home-discover
include _modules/stopover-tabs/_ibe_stopover-tabs_home-carousel-wall-images
include _modules/stopover-tabs/_ibe_stopover-tabs_partners
include _modules/stopover-tabs/_ibe_stopover-tabs_home-email
include _modules/stopover-tabs/_ibe_stopover-tabs_experience-grid
include _modules/stopover-tabs/_ibe_stopover-tabs_recommendation-card
include _modules/stopover-tabs/_ibe_stopover-tabs_home-out-section
include _modules/stopover-tabs/_ibe_stopover-tabs_experiences-out-section
include _modules/stopover-tabs/_ibe_stopover-tabs_home-slide-banner

include _modules/stopover-tabs/_ibe_stopover-tabs_experiences-filters
include _modules/stopover-tabs/_ibe_stopover-tabs_plans-filters
include _modules/stopover-tabs/_ibe_stopover-tabs_plans
include _modules/stopover-tabs/_ibe_stopover-tabs_top-banner
include _modules/stopover-tabs/_ibe_stopover-tabs_faqs
include _modules/stopover-tabs/_ibe_stopover-tabs_faqs-out-section

include _modules/_modals/_ibe_modal-home-stopover
include _modules/stopover-tabs/_ibe_stopover-tabs_search-collapse
include _modules/_ibe_switch
include _modules/_ibe_choose-city-new

block title
	title!='IBERIA - Stopover Experiences Landing'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	+m-ibe-modal-home-stopover
	// End wrapper
	main.ibe-main__footer--without-margin
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		+m-ibe-stopover-tabs_home-slide-banner({})
		//- +m-ibe-stopover_top-banner({
		//- 		"dataBackground": '/images/modules/stopover/bg-stopover-home-header',
		//- 		"isSearcher": true,
		//- 		"classSearcher" : "ibe-search-collapse-stopover-position__primary",
		//- 		"type" : "home",				
		//- })
		
		div.col-xs-12.ibe-stopover-tabs-banner__searcher
			+m-ibe-stopover-tabs_search-collapse({stopover: true})
	div.ibe-stopover-tabs-container-margin
		div.container.ibe-stopover-tabs-container
			section.ibe-stopover-tabs
				article.ibe-infocheckin__box--tab.ibe-infocheckin__box--empty.ibe-infocheckin__box--overflow
					div.ibe-tab.ibe-tab--main
						ul.ibe-tab__menu.tabs-section
							li.ibe-tab__menu-item.tab-item.active(id="tab-home" onclick="clickHomeTab()")
								a.ibe-tab__menu-item__text.tab-content-stopover.icon-inicio(href="#tab-1", title="Inicio", data-toggle="tab") Inicio
							li.ibe-tab__menu-item.tab-item(id="tab-exp" onclick="clickExperiencesTab()")
								a.ibe-tab__menu-item__text.tab-content-stopover.icon-descuento-2(href="#tab-2", title="Experiencias" data-toggle="tab") Experiencias
							li.ibe-tab__menu-item.tab-item(id="tab-plans" onclick="clickPlansTab()")
								a.ibe-tab__menu-item__text.tab-content-stopover.icon-senalizacion_mapas(href="#tab-3" title="Planes" data-toggle="tab") Planes
							li.ibe-tab__menu-item.tab-item(id="tab-asks" onclick="clickFaqsTab()")
								a.ibe-tab__menu-item__text.tab-content-stopover.icon-ayuda_2(href="#tab-4" title="Preguntas frecuentes" data-toggle="tab") Preguntas frecuentes
						.tab-content
							script.
								function clickHomeTab(){
									let homeOutSection = document.getElementById("home-out-section");
									let experiencesOutSection = document.getElementById("experiences-out-section");
									homeOutSection.classList.add('ibe-stopover-tabs--home-add-section');
									homeOutSection.classList.remove('ibe-stopover-tabs--home-remove-section');									
									experiencesOutSection.classList.remove('ibe-stopover-tabs--experiences-add-section');
									experiencesOutSection.classList.add('ibe-stopover-tabs--experiences-remove-section');
								}
								function clickExperiencesTab(){
									let homeOutSection = document.getElementById("home-out-section");
									let experiencesOutSection = document.getElementById("experiences-out-section");
									let faqsOutSection = document.getElementById("faqs-out-section");
									homeOutSection.classList.remove('ibe-stopover-tabs--home-add-section');
									homeOutSection.classList.add('ibe-stopover-tabs--home-remove-section');									
									experiencesOutSection.classList.add('ibe-stopover-tabs--experiences-add-section');
									experiencesOutSection.classList.remove('ibe-stopover-tabs--experiences-remove-section');
									faqsOutSection.classList.remove('ibe-stopover-tabs--faqs-add-section');
									faqsOutSection.classList.add('ibe-stopover-tabs--faqs-remove-section');
								}
								function clickPlansTab(){
									let homeOutSection = document.getElementById("home-out-section");
									let experiencesOutSection = document.getElementById("experiences-out-section");
									let faqsOutSection = document.getElementById("faqs-out-section");
									homeOutSection.classList.remove('ibe-stopover-tabs--home-add-section');
									homeOutSection.classList.add('ibe-stopover-tabs--home-remove-section');									
									experiencesOutSection.classList.add('ibe-stopover-tabs--experiences-remove-section');
									experiencesOutSection.classList.remove('ibe-stopover-tabs--experiences-add-section');
									faqsOutSection.classList.remove('ibe-stopover-tabs--faqs-add-section');
									faqsOutSection.classList.add('ibe-stopover-tabs--faqs-remove-section');
								}
								function clickFaqsTab() {
									let homeOutSection = document.getElementById("home-out-section");
									let experiencesOutSection = document.getElementById("experiences-out-section");
									let faqsOutSection = document.getElementById("faqs-out-section");
									homeOutSection.classList.remove('ibe-stopover-tabs--home-add-section');
									homeOutSection.classList.add('ibe-stopover-tabs--home-remove-section');									
									experiencesOutSection.classList.add('ibe-stopover-tabs--experiences-remove-section');
									experiencesOutSection.classList.remove('ibe-stopover-tabs--experiences-add-section');
									faqsOutSection.classList.remove('ibe-stopover-tabs--faqs-remove-section');
									faqsOutSection.classList.add('ibe-stopover-tabs--faqs-add-section');
								}
							.tab-pane.ibe-tab__container.ibe-tab__container--img.active(id="tab-1" data-function="radiobuttons-tabs")
								+m-ibe-stopover-tabs_home-steps()
							.tab-pane.ibe-tab__container.ibe-tab__container--img(id="tab-2" data-function="radiobuttons-tabs")
								+m-ibe-stopover-tabs_experiences-filters()
							.tab-pane.ibe-tab__container.ibe-tab__container--img(id="tab-3" data-function="radiobuttons-tabs")
								+m-ibe-stopover-tabs_plans-filters()
								+m-ibe-stopover-tabs_plans()
							.tab-pane.ibe-tab__container.ibe-tab__container--img(id="tab-4" data-function="radiobuttons-tabs")
								+m-ibe-stopover-tabs_faqs()
	+m-stopover-tabs_home-out-section()
	+m-stopover-tabs_experiences-out-section()
	+m-stopover-tabs_faqs-out-section()
	+m-footer({
		"full": true
	})


