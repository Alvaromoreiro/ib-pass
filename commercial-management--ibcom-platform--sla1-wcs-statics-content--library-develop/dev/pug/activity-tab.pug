extends _general/layout__primary
block title
	title!="IBERIA - Ficha de actividad"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu 
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-guide
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		div.ibe-search-flights
			div.ibe-search-flights__search
				div.container
					div.row
						div.col-xs-12
							header.ibe-infocheckin__header
								h1.title.title__h1.ibe-infocheckin__header-primary!="The Underground"
								h2.title.title__h5.ibe-infocheckin__header-secondary!="Estas en la gu&iacute;a de Chicago"
			div.ibe-search-flights__cover.ibe-search-flights__cover--no-search
				figure.ibe-search-flights__cover-fig
					img.ibe-search-flights__cover-img(src="images/content/underground.jpg" alt="Undeground Chicago")
				div.container
					div.row
						div.col-xs-12
							div.ibe-search-flights__cover-box.ibe-search-flights__cover-box--alpha
								div.ibe-search-flights__cover-header-container
									div.ibe-search-flights__cover-cont-button.ibe-search-flights__cover-cont-button--left
										a.ibe-button.ibe-button--red.ibe-button--small.ibe-button--arrow.ibe-button--arrow-left(href="#" title="Ir al plan anterior")
											span.ibe-search-flights__cover-cont-button-text!="Plan anterior"
									div.ibe-search-flights__cover-cont-title.text-center
										a.title-linked.title__h3(href="#" title="Añadir Chicago a tu guía")!="Añadir a tu guía"
									div.ibe-search-flights__cover-cont-button.ibe-search-flights__cover-cont-button--right
										a.ibe-button.ibe-button--red.ibe-button--small.ibe-button--arrow.ibe-button--arrow-right(href="#" title="Ir al plan siguiente")
											span.ibe-search-flights__cover-cont-button-text!="Plan siguiente"
		div.container
			div.row
				div.col-xs-12
					p.paragraph.paragraph__regular.ibe-guide__header-description Chicago duerme poco y a veces. The underground (www.theundergroundchicago.es) es el lugar de moda por excelencia donde podr&aacute;s encontrar caras conocidas en la lista o bailar al son de la m&uacute;sica de disc-jockeys muy prestigiosos. En este club donde no son extra&ntilde;as las fiestas privadas, como no pod&iacute;a ser de otra manera, las botellas de las marcas m&aacute;s conocidas est&aacute;n sobre las mesas de los reservados. Dise&ntilde;ado como un escondite militar con mapas que se iluminan colgados de las paredes, a partir de medianoche los camareros ofrecen peque&ntilde;os bocadillos para asentar un poco el est&oacute;mago despu&eacute;s de tantas copas. Situado en West Illinois Street, abre los jueves, viernes, s&aacute;bados y domingos a las diez de la noche.
			div.row
				div.col-xs-12
					div.ibe-google-map
						iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d39970.77517168159!2d-87.67070489680842!3d41.87466744387668!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x880e2c3cd0f4cbed%3A0xafe0a6ad09c0c000!2sChicago%2C+Illinois%2C+EE.+UU.!5e0!3m2!1ses!2ses!4v1481713557888" width="800" height="600" frameborder="0" style="border:0" allowfullscreen)
			div.row
				div.col-xs-12
					div.ibe-search-flights.ibe-section-bottom-small
						div.ibe-search-flights__search-box
							//+m-searcher()
			div.row
				div.col-xs-12
					h2.title.title__h3 Otras actividades
						a.link.link__regular.link__regular--important.link__regular--to-right.link__regular--arrow-left(href="#" title="Volver a Chicago") Volver a Chicago
			ul.row.ibe-card-container
				li.col-lg-3.col-md-6.col-sm-6.col-xs-6.ibe-card.ibe-card--col-sm-2
					+m-card-guides({
						"guide": {
							"group": "0",
							"type": "body"
						},
						"img": {
							"src": globals.imgPath + "/modules/ibe_travel-guides/big-1.png",
							"alt": "Puente de Michigan"
						},
						"title": "Puente de Michigan",
						"info": "Te sentir&aacute;s abrumado al ver la gradiosidad de este s&iacute;mbolo de la ciudad",
						"link": {
							"href": "#",
							"title": "Añadir a tu guía",
							"text": "A&ntilde;adir a tu gu&iacute;a"
						}
					})
				li.col-lg-3.col-md-6.col-sm-6.col-xs-6.ibe-card.ibe-card--col-sm-2
					+m-card-guides({
						"guide": {
							"group": "0",
							"type": "body"
						},
						"img": {
							"src": globals.imgPath + "/modules/ibe_travel-guides/big-2.png",
							"alt": "Alquila un kayak"
						},
						"title": "Alquila un kayak",
						"info": "Esta es una actividad muy divertida, segura y sana. Despl&aacute;zate tu mismo por el r&iacute;o y vive la aventura.",
						"link": {
							"href": "#",
							"title": "Añadir a tu guía",
							"text": "A&ntilde;adir a tu gu&iacute;a"
						}
					})
				li.col-lg-3.col-md-6.col-sm-6.col-xs-6.ibe-card.ibe-card--col-sm-2
					+m-card-guides({
						"guide": {
							"group": "0",
							"type": "body"
						},
						"img": {
							"src": globals.imgPath + "/modules/ibe_travel-guides/big-3.png",
							"alt": "Water taxi"
						},
						"title": "Water taxi",
						"info": "&iquest;Te imaginas coger un taxi por el agua? en Chicago todo es posible, incluso coger un taxi por el agua.",
						"link": {
							"href": "#",
							"title": "Añadir a tu guía",
							"text": "A&ntilde;adir a tu gu&iacute;a"
						}
					})
				li.col-lg-3.col-md-6.col-sm-6.col-xs-6.ibe-card.ibe-card--col-sm-2
					+m-card-guides({
						"guide": {
							"group": "0",
							"type": "body"
						},
						"img": {
							"src": globals.imgPath + "/modules/ibe_travel-guides/big-4.png",
							"alt": "Paseo por el río"
						},
						"title": "Paseo por el r&iacute;o",
						"info": "Disfruta de las vistas por la ciudad en un paseo por el r&iacute;o. Otra manera de conocer Chicago.",
						"link": {
							"href": "#",
							"title": "Añadir a tu guía",
							"text": "A&ntilde;adir a tu gu&iacute;a"
						}
					})
			ul.row
				.col-xs-12
					.ibe-banner(data-text-md="BANNER 728x90" data-text-sm="BANNER 300x250")
						span.hideAccessible Banner
	+m-footer()
