extends _general/layout__primary
block title
	title!="IBERIA - Detalle del plan versión 2"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-guide
		div.container
			div.row
				div.col-xs-12
					div.ibe-infocheckin__menu.ibe-infocheckin__menu--plan
						div.ibe-infocheckin__menu-scroll
							ul.ibe-infocheckin__menu-wrapper.ibe-infocheckin__menu-wrapper--menu.ibe-infocheckin__menu-wrapper--menu-responsive
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon.ibe-infocheckin__menu-item--icon-responsive
									a.link.link__regular(href="#" title="Ver más" data-inforcheckin="unlock")
										span.hideAccessible!="Ver m&aacute;s"
							div.ibe-infocheckin__menu-container
								ul.ibe-infocheckin__menu-wrapper.ibe-infocheckin__menu-wrapper--menu(data-inforcheckin="menu" role="navigation" aria-label="Usted esta aquí:")
									li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon.ibe-infocheckin__menu-item--icon-home
										a.link.link__regular.icon-inicio(href="#" title="Home")
											span.hideAccessible!="Home"
									li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--txt
										a.link.link02.link__regular(href="#" title="Tus guías de viaje")!="Tus gu&iacute;as de viaje"
									li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--txt.xui-infocheckin__menu-blocked
										span.link.link02.link__regular!="Gu&iacute;a de Chicago"
							ul.ibe-infocheckin__menu-wrapper.ibe-infocheckin__menu-wrapper--social
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon.ibe-infocheckin__menu-item--icon-share
									a.link.link__regular.icon-compartir(href="#" title="Compartir" data-toggle="popover" data-placement="bottom")
										span(data-toggle-status="true" data-status-open="Click para ocultar redes sociales" data-status-close="Click para mostrar redes sociales" class="hideAccessible")!="Click para mostrar redes sociales"
									div.hidden(data-function="ibe-popover-content" id="tooltip-social-media")
										ul.ibe-infocheckin__menu-wrapper.ibe-infocheckin__menu-wrapper--social-tooltip
											li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-facebook
												a.link.link__regular(href="#" title="Ir a Facebook")
													span.hideAccessible!="Facebook"
											li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-twitter
												a.link.link__regular(href="#", title="Ir a Twitter")
													span.hideAccessible!="Twitter"
											li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-linkedin
												a.link.link__regular(href="#" title="Ir a LinkedIn")
													span.hideAccessible!="LinkedIn"
											li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-google
												a.link.link__regular(href="#" title="Ir a Google +")
													span.hideAccessible!="Google +"
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-facebook
									a.link.link__regular(href="#" title="Ir a Facebook")
										span.hideAccessible!="Facebook"
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-twitter
									a.link.link__regular(href="#", title="Ir a Twitter")
										span.hideAccessible!="Twitter"
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-linkedin
									a.link.link__regular(href="#" title="Ir a LinkedIn")
										span.hideAccessible!="LinkedIn"
								li.ibe-infocheckin__menu-item.ibe-infocheckin__menu-item--icon-google
									a.link.link__regular(href="#" title="Ir a Google +")
										span.hideAccessible!="Google +"
		div.container(data-guide="header")
			div.row
				div.col-xl-9.col-lg-8.col-md-12.col-sm-12.col-xs-12
					.ibe-plan__header
						.ibe-plan__title.ibe-plan__title--type02
							h1.title__h1 The Underground
							span(class="ibe-card-guides__theme ibe-card-guides__theme--orange") Ocio
						a(href="#", title="Eliminar plan", class="link link__regular ibe-plan__link--remove") Eliminar plan




	+m-footer()
