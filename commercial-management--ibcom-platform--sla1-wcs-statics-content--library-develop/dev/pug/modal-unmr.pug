extends _general/layout__primary
include _modules/_modals/_ibe-modal-unmr
include _modules/_modals/_ibe-modal-unmr-terms

block title
	title!="IBERIA - Modal UNMR - Servicio Acompañamiento de Menores"

block body
	+m-header-new({
		"login": false
	})
	+m-menu-new({
		"login": false
	})

	main.container
		div.row
			.col-xs-12
				h1.title.title__h1.title--grey!="Modal UNMR &mdash; Servicio de Acompañamiento de Menores"

		div.row
			.col-xs-12
				h2.title.title__h2!="Estados"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>1 menor</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 1 menor" data-modal="button" data-modal-view=".fc-dialog-unmr-1")!="Abrir &mdash; 1 menor"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>2 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 2 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-2")!="Abrir &mdash; 2 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>3 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 3 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-3")!="Abrir &mdash; 3 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>4 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 4 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-4")!="Abrir &mdash; 4 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>5 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 5 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-5")!="Abrir &mdash; 5 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>6 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 6 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-6")!="Abrir &mdash; 6 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>7 menores</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 7 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-7")!="Abrir &mdash; 7 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>8 menores (máximo)</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR 8 menores" data-modal="button" data-modal-view=".fc-dialog-unmr-8")!="Abrir &mdash; 8 menores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>Estados de error</strong>"
				div
					a(href="javascript:void(0)" title="Modal UNMR errores" data-modal="button" data-modal-view=".fc-dialog-unmr-error")!="Abrir &mdash; Errores"

			.col-xs-12.col-sm-6.col-md-3
				p.paragraph.paragraph__regular!="<strong>Términos y condiciones</strong>"
				div
					a(href="javascript:void(0)" title="Modal términos y condiciones UNMR" data-modal="button" data-modal-view=".fc-dialog-unmr-terms")!="Abrir &mdash; Términos y condiciones"

	//- Modales — se instancian fuera del container, al final del body
	+m-ibe-modal-unmr({ "minors": 1, "id": "fc-dialog-unmr-1" })
	+m-ibe-modal-unmr({ "minors": 2, "id": "fc-dialog-unmr-2" })
	+m-ibe-modal-unmr({ "minors": 3, "id": "fc-dialog-unmr-3" })
	+m-ibe-modal-unmr({ "minors": 4, "id": "fc-dialog-unmr-4" })
	+m-ibe-modal-unmr({ "minors": 5, "id": "fc-dialog-unmr-5" })
	+m-ibe-modal-unmr({ "minors": 6, "id": "fc-dialog-unmr-6" })
	+m-ibe-modal-unmr({ "minors": 7, "id": "fc-dialog-unmr-7" })
	+m-ibe-modal-unmr({ "minors": 8, "id": "fc-dialog-unmr-8" })
	+m-ibe-modal-unmr-error()
	+m-ibe-modal-unmr-terms()

	+m-footer({
		"full": true
	})
