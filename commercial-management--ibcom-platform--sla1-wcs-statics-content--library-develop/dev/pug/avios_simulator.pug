extends _general/layout__primary

block title
    title!='IBERIA - Simulador de avios'
block body
    body.ibe-background__body
    // Inicio nuevo header
    +m-header-new({
        "login": false
    })

    // Inicio nuevo menu
    +m-menu-new({
        "login": false
    })
    // End wrapper
    <!-- BANNER -->
    div.ibe-avios-simulator-banner
        div.ibe-avios-simulator-banner__background
            <!-- IMAGEN CALCULADORA -->
            picture.ibe-avios-simulator-banner__img-container
                source(media="(min-width: 480px)", srcset="/wcs/imagenes/simulador_avios/ilustración_Lotalty_Simulador_Avios.png")
                source(media="(max-width: 479px)", srcset="/wcs/imagenes/simulador_avios/Ilustracion_portada_xs.png")
                img(src="/wcs/imagenes/simulador_avios/ilustración_Lotalty_Simulador_Avios.png" title="Calculadora de Avios" alt="Calculadora de Avios")
            div.container
                div.row
                    div.col-xs-12
                        div.ibe-avios-simulator-banner__container-content
                            h1.ibe-avios-simulator-banner__title.title__h1 ¿Cuántos Avios podrías obtener en tu día a día?
                            p.ibe-avios-simulator-banner__sub-title Introduce tus gastos y descubre cuántos Avios podrías ganar, siempre que te registres en Iberia Plus.
                            button.ibe-avios-simulator-banner__button.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container Regístrate enIberia Plus
    <!-- END BANNER -->
    main.container
        // Main content
        div.container
            div.row
                div.col-xs-12
                    div.ibe-avios-simulator-container.ibe-avios-simulator-container--white
                        section.ibe-avios-simulator-expenses
                        section.ibe-avios-simulator-benefits
                            h2.title.title__h2.ibe-avios-simulator-benefits__title ¿Qué podrías hacer con tus Avios?
                            ul.row.ibe-card-container.ibe-card-container--mb-none
                                li.col-lg-4.col-md-4.col-sm-12.col-xs-12
                                    +m-card-guides({
                                        "pClass": "ibe-ellipsis-5",
                                        "guide": {
                                            "group": "0",
                                            "type": "body"
                                        },
                                        "img": {
                                            "src": globals.imgPath + "/modules/ibe_simulador_avios/image_cards_avios.png",
                                            "alt": "Botellas Cair Pedón Aguilera"
                                        },
                                        "title": "Botellas Cair Pedón Aguilera",
                                        "info": "Lorem ipsum dolor sit amet.",
                                        "link": {
                                            "href": "#",
                                            "title": "Más información",
                                            "text": "Más información"
                                        }
                                    })
                                li.col-lg-4.col-md-4.col-sm-12.col-xs-12
                                    +m-card-guides({
                                        "pClass": "ibe-ellipsis-5",
                                        "guide": {
                                            "group": "0",
                                            "type": "body"
                                        },
                                        "img": {
                                            "src": globals.imgPath + "/modules/ibe_simulador_avios/image_cards_avios.png",
                                            "alt": "Botellas Cair Pedón Aguilera"
                                        },
                                        "title": "Botellas Cair Pedón Aguilera",
                                        "info": "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
                                        "link": {
                                            "href": "#",
                                            "title": "Más información",
                                            "text": "Más información"
                                        }
                                    })
                                li.col-lg-4.col-md-4.col-sm-12.col-xs-12
                                    +m-card-guides({
                                        "pClass": "ibe-ellipsis-5",
                                        "guide": {
                                            "group": "0",
                                            "type": "body"
                                        },
                                        "img": {
                                            "src": globals.imgPath + "/modules/ibe_simulador_avios/image_cards_avios.png",
                                            "alt": "Botellas Cair Pedón Aguilera"
                                        },
                                        "title": "Botellas Cair Pedón Aguilera",
                                        "info": "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
                                        "link": {
                                            "href": "#",
                                            "title": "Más información",
                                            "text": "Más información"
                                        }
                                    })
                        div.ibe-avios-simulator-benefits__button-content 
                            a.ibe-avios-simulator-benefits__button.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container.icon-recargar(href="#", tabindex="0")
                                span.ibe-avios-simulator-benefits__button-txt Mostrar otras
            //- out avios simulator component
            div.row
                div.col-xs-12
                    section.ibe-avios-simulator-benefits 
                        h2.title.title__h2.ibe-avios-simulator-benefits__title(style="text-align: center;") ¿Qué podrías hacer con tus Avios?
                        ul.row.ibe-card-container.ibe-card-container--mb-none
                            li.col-lg-4.col-md-6.col-sm-12.col-xs-12.u-pb-normal
                                div.ibe-flights-plus-hotel__box.ibe-flights-plus-hotel__box--new
                                    a.ibe-card-link.ibe-card-link--box-shadow-dark(href="https://www.iberia.com/es/iberiaplus/disfrutar-avios/", title="Ir a vuelos con Avios")
                                        div.ibe-card-link__container.ibe-card-link__container--full-height
                                            figure.ibe-card-link__background.ibe-card-link__background--full-width
                                                img.ibe-card-link__background-img(src="/wcs/imagenes/destinos/city_holidays_nyc.jpg", alt="Nueva York")
                                            div.ibe-card-link__info.ibe-card-link__info--no-footer.u-ml-none-md 
                                                h3.title__h3.ibe-card-link__title.ibe-card-link__title--icon Nueva York
                                                p.paragraph.paragraph__regular La ciudad por excelencia.
                                                p.paragraph.paragraph__regular desde
                                                p.paragraph.paragraph__regular
                                                    span.paragraph--highlight 34.000 Avios
                            li.col-lg-4.col-md-6.col-sm-12.col-xs-12.u-pb-normal
                                div.ibe-flights-plus-hotel__box.ibe-flights-plus-hotel__box--new
                                    a.ibe-card-link.ibe-card-link--box-shadow-dark(href="https://www.iberia.com/es/es/club-del-vino/", title="Ir al Club del vino")
                                        div.ibe-card-link__container.ibe-card-link__container--full-height
                                            figure.ibe-card-link__background.ibe-card-link__background--full-width
                                                img.ibe-card-link__background-img(src="/wcs/imagenes/experiencia_iberia/a_bordo/menu_a_bordo/bodega_online.jpg", alt="Vino")
                                            div.ibe-card-link__info.ibe-card-link__info--no-footer.u-ml-none-md 
                                                h3.title__h3.ibe-card-link__title.ibe-card-link__title--icon Club del vino
                                                p.paragraph.paragraph__regular Consigue los vinos de las D. O. más prestigiosas de España.
                                                p.paragraph.paragraph__regular desde
                                                p.paragraph.paragraph__regular 
                                                    span.paragraph--highlight 1.025 Avios
                            li.col-lg-4.col-md-6.col-sm-12.col-xs-12.u-pb-normal
                                div.ibe-flights-plus-hotel__box.ibe-flights-plus-hotel__box--new
                                    a.ibe-card-link.ibe-card-link--box-shadow-dark(href="https://www.iberia.com/es/iberiaplus/disfrutar-avios/", title="Ir a vuelos con Avios")
                                        div.ibe-card-link__container.ibe-card-link__container--full-height
                                            figure.ibe-card-link__background.ibe-card-link__background--full-width
                                                img.ibe-card-link__background-img(src="/wcs/imagenes/destinos/city_holidays_ibz.jpg", alt="Ibiza")
                                            div.ibe-card-link__info.ibe-card-link__info--no-footer.u-ml-none-md 
                                                h3.title__h3.ibe-card-link__title.ibe-card-link__title--icon Ibiza
                                                p.paragraph.paragraph__regular Date un respiro y escápate a las playas con más encanto.
                                                p.paragraph.paragraph__regular desde
                                                p.paragraph.paragraph__regular
                                                    span.paragraph--highlight 9.000 Avios
            //- end out avios simulator component
            div.row
                div.col-xs-12
                    section.ibe-avios-simulator-getting-avios-two-card
                        h2.ibe-avios-simulator-getting-avios-two-card__title.title.title__h2 Empieza a conseguir Avios
                        div.row
                            div.col-xs-12.col-md-6
                                div.ibe-flights-plus-hotel__box
                                    +m-card-link({
                                        "isLink": true,
                                        "mainClass": "md",
                                        "pClass": "ibe-ellipsis-5",
                                        "autoHeight": "ibe-card-link--auto-height",
                                        "title": {
                                            "name": "Compras en Iberia Plus Store",
                                            "icon": true
                                        },
                                        "image": {
                                            "src": "/modules/ibe_simulador_avios/image_get_avios_1.png",
                                            "alt": "Ofeta Grecia"
                                        },
                                        "logo": {
                                            "bool": false
                                        },
                                        "typeContent": "description",
                                        description: {
                                            text: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut et massa mi. Aliquam in hendrerit urna. Pellentesque sit amet sapien fringilla, mattis ligula consectetur, ultrices mauris. Maecenas vitae mattis tellus."
                                        },
                                        "highlight": false
                                    })
                            div.ibe-avios-simulator-getting-avios-two-card__img.col-xs-12.col-md-6
                                div.ibe-flights-plus-hotel__box
                                    +m-card-link({
                                        "isLink": true,
                                        "mainClass": "md",
                                        "pClass": "ibe-ellipsis-5",
                                        "autoHeight": "ibe-card-link--auto-height",
                                        "title": {
                                            "name": "Acumula Avios con las compañías asociadas",
                                            "icon": true
                                        },
                                        "image": {
                                            "src": "/modules/ibe_simulador_avios/image_get_avios_2.png",
                                            "alt": "Ofeta Grecia"
                                        },
                                        "logo": {
                                            "bool": false
                                        },
                                        "typeContent": "description",
                                        description: {
                                            text: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut et massa mi. Aliquam in hendrerit urna. Pellentesque sit amet sapien fringilla, mattis ligula consectetur, ultrices mauris. Maecenas vitae mattis tellus."
                                        },
                                        "highlight": false
                                    })
                div.col-xs-12
                    section.ibe-avios-simulator-getting-avios-one-card
                        h2.ibe-avios-simulator-getting-avios-one-card__title.title.title__h2 Tus Avios se convierten en lo que tú quieras
                        div.row
                            div.col-xs-12
                                div.ibe-flights-plus-hotel__box
                                    +m-card-link({
                                        "isLink": true,
                                        "mainClass": "xl",
                                        "pClass": "ibe-ellipsis-5",
                                        "autoHeight": "",
                                        "title": {
                                            "name": "Avios&Money. Reserva ahora; es rápido y fácil",
                                            "icon": true
                                        },
                                        "image": {
                                            "src": "/modules/ibe_simulador_avios/image_get_avios_3.png",
                                            "alt": "Ofeta Grecia"
                                        },
                                        "logo": {
                                            "bool": false
                                        },
                                        "typeContent": "description",
                                        description: {
                                            text: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut et massa mi. Aliquam in hendrerit urna. Pellentesque sit amet sapien fringilla, mattis ligula consectetur, ultrices mauris. Maecenas vitae mattis tellus."
                                        },
                                        "highlight": false
                                    })

    +m-footer({
        "full": true  
    })
