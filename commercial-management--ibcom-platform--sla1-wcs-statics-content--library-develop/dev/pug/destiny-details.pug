extends _general/layout__primary
include _modules/_modals/_ibe-modal-advise
block title
	title!="IBERIA - Guías de Chicago!!!!!!!"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-guide
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		div.container(data-guide="header")
			div.row
				div.col-xs-12
					h1.title.title__h1.title--center Gu&iacute;a de Chicago
			div.row
				div.col-xl-9.col-lg-8.col-md-12.col-sm-12.col-xs-12
					div.row.ibe-guide__header
						div.col-md-12.col-sm-12.col-xs-12
							div.ibe-guide__header-vid(data-guide="figure")
								+m-vid-banner({
									img: "/content/chicago.jpg",
									title: "Chicago",
									modal: ".fc-dialog-uno",
								})
					h2.title.title__h3.title--padding-top Jazz entre rascacielos 2
					div
						a(href="#" title="Modal Advise" data-modal="button" data-modal-view=".fc-dialog-advise" data-css-class="")!="Abrir Modal detalle"
					+m-ibe-modal-advise(
						{
							"detail": true,
							"img": {
								"src": globals.imgPath + "/modules/ibe_travel-guides/big-1.png",
								"alt": "Conocer la historia del Puente de Michigan"
							},
							"title": "Conocer la historia de la ciudad de un vistazo en el Puente de Michigan",
							"theme": "Ocio",
						}
					)
					div.ibe-collapse_moreInfo(data-view-more='parent')
						div.xui-collapse_moreInfo-text-close.xui-collapse_moreInfo-text-close--mobile(data-view-more='container')
							p.paragraph.paragraph__regular.ibe-guide__header-description.ibe-guide__header-description--left Lo primero que pensamos cuando hablamos de Chicago es, &quot;Michael Jordan y rascacielos&quot;, pero Chicago no es solo granito y deporte. En Chicago, la segunda m&aacute;s grande de EEUU despu&eacute;s de Nueva York, disfrutar&aacute;s del ambiente y la m&uacute;sica m&aacute;s variopinta; es una parada obligada el tomarte un cocktail en uno de sus muchos clubs de jazz, al m&aacute;s puro estilo Al Capone en los a&ntilde;os 20. Viaja en su red de trenes: saldr&aacute;s fascinado despu&eacute;s de recorrer todos los barrios de Chicago a trav&eacute;s de este medio de transporte, que fusiona lo tradicional y lo contempor&aacute;neo mientras viajas entre m&aacute;s de 1.000 &quot;edificios altos&quot;. Una vez vistos los rascacielos desde abajo, &iquest;te atreves a visitar el rescacielos m&aacute;s alto de todo EEUU? Exacto, Willis Tower es adem&aacute;s el cuarto edificio m&aacute;s alto del mundo, y se encuentra en Chicago. Deja el v&eacute;rtigo en casa y disfruta al m&aacute;ximo.
						a.hidden-xl.hidden-lg.hidden-md.link.link__regular.link__regular--red.ibe-link-view-more.ibe-link-view-more--more(href="#" title="Mostrar más" data-view-more='button', data-text-expanded="Ocultar" data-text-collapsed="Leer más") Leer m&aacute;s
