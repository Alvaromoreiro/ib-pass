mixin m-ibe-modal-info-list(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-info-list
						div.modal-dialog
							div.modal-content
								div.ibe-modal.ibe-modal--content-centered
									header.modal-header
										h2.title.title__h1.ibe-modal__title-primary!="Oficinas en USA "
										div.ibe-modal__options
											button(type="button" data-dialog="close" data-focusin class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
												span.hideAccessible!="Cerrar"
									div.modal-body
										div.hideAccessible Esta tabla muestra informaci&oacute;n sobre Oficinas en USA
										div.ibe-modal_body
