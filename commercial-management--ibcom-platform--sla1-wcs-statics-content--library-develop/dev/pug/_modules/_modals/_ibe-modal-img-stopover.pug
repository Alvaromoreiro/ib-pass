mixin m-ibe-modal-img-stopover(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-img-stopover
		div.modal-dialog
			div.modal-content
				div.ibe-modal
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary.title--stopover-modal!="¿Donde recoger tu tarjeta transporte?"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal_body
							p.paragraph--stopover-modal-img Aeropuerto Madrid Barajas T4 llegadas
							li.paragraph--stopover-modal-img-secondary Tu recogida de equipaje será en la planta 0 de la T4 de Madrid Barajas. Allí encontrarás el punto de información de Stopover para recoger tu pack de bienvenida, que incluye tu tarjeta de transporte gratuita
							img(src=globals.imgPath + "/modules/stopover/modal-gates.png" alt="Selecciona número de vuelo")
							div.ibe-modal__img-button-stopover-div
								button.ibe-button.ibe-button--red.ibe-button--min-1.ibe-button--iberia-headline.ibe-button--fs-16.ibe-modal__img-button-stopover(type="button")!="Aceptar"