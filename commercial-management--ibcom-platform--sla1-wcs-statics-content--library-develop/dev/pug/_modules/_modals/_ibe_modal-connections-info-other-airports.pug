mixin m-ibe-modal-connections-info-other-airports(params)
    - params = params || {};
    div.ibe-dialog.fc-dialog-connections-info-other-airports
        div.modal-dialog.modal-dialog-universia
            div.modal-content
                div.ibe-modal.modal-universia
                    header.modal-header.modal-header-universia
                        span.modal-header-icon.icon-despegue
                        h2.title--universia-modal.paragraph__regular--m-top-16!="Dallas Fort Worth International Airport (DFW)"
                        div.ibe-modal__options
                            button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
                                span.hideAccessible!="Cerrar"
                    div.modal-body
                        p.paragraph.paragraph__regular.paragraph--center
                            span.paragraph__regular--bold!="Conexión dentro de EE.UU. "
                            span!="Deberás pasar el control de pasaporte en el aeropuerto de DFW. Además, tendrás que retirar tus maletas de la cinta de equipajes para pasar la aduana, y entregarlas en el mostrador de la compañía con la que continúes el viaje."
                        p.paragraph.paragraph__regular.paragraph--center
                            span.paragraph__regular--bold!="Conexión con otro destino internacional (NO EE.UU.). "
                            span!="La normativa estadounidense requiere que los viajeros dispongan de toda la documentación necesaria al llegar a Estados Unidos, aunque este NO sea su destino final. Recuerda que no tendrás que recoger tu equipaje hasta entonces."
                        div.ibe-modal_body
                            a.ibe-modal_body--button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block(type="button" data-dialog="close")!="Aceptar"