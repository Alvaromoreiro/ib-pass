mixin m-ibe-modal-plan-university-fly(params)
    - params = params || {};
    div.ibe-dialog.fc-dialog-plan-university-fly
        div.modal-dialog.modal-dialog-universia
            div.modal-content
                div.ibe-modal.modal-universia
                    header.modal-header.modal-header-universia
                        span.modal-header-icon-information
                        h2.title--universia-modal.paragraph__regular--m-top-16!="Recuerda: ya tienes un Plan University&Fly"
                        p.paragraph--universia-modal!="Ahora elige tu vuelo y viaja al mejor precio."
                        div.ibe-modal__options
                            button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
                                span.hideAccessible!="Cerrar"
                    div.modal-body
                        div.ibe-modal_body.ibe-modal_body--universia
                            a.ibe-modal_body--button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block(type="button")!="Buscar vuelos"
                            div.paragraph.paragraph__regular.paragraph__regular--separator-link-universia.text-center
                                a.link.link__regular.link__regular--font-universia.link__regular--underline(href="#" title="Recuérdame las ventajas de mi Plan")!="Recuérdame las ventajas de mi Plan"
