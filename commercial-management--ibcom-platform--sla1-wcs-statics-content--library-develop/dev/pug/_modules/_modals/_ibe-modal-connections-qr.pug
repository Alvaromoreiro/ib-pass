mixin m-ibe-modal-connections-qr(params)
    div.ibe-dialog.fc-dialog-connections-qr
        div.modal-dialog.modal-dialog-universia
            div.modal-content
                div.ibe-modal
                    header.modal-header.modal-header-universia
                        figure.ibe-flex.ibe-flex--flex-center
                            picture 
                                img(src="images/modules/connections/madrid/madrid_modal_logo.png", alt="")
                        h2.title.title__h1.title--center.title--red!="Todo sobre tus conexiones, en la App de Iberia"
                        div.ibe-modal__options
                            button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
                                span.hideAccessible!="Cerrar"
                    div.modal-body
                        div
                            p.paragraph.paragraph--center.paragraph__regular.paragraph__regular--grey Nuestra App te ofrecerá información actualizada sobre nuestros vuelos en conexión.
                            p.paragraph.paragraph--center.paragraph__regular.paragraph__regular--grey Si aún no la tienes, descárgatela haciendo una foto a este QR con tu móvil.
                            figure.ibe-flex.ibe-flex--flex-center
                                picture 
                                    img(src="images/modules/connections/madrid/madrid_modal_qr.png", alt="")
                            a.ibe-modal_body--button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block.u-mt(type="button")!="Aceptar"
