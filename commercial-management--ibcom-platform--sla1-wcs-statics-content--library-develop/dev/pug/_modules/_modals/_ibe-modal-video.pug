mixin m-ibe-modal-video(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-video
		div.modal-dialog
			div.modal-content
				div.ibe-modal.ibe-modal--content-centered
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary!="Modal con video "
						h3.title.ibe-modal__title-secondary!="Identif&iacute;cate con tu n&uacute;mero de Iberia Plus y tu PIN para continuar"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal_body
							iframe(width="560" height="315" src="https://www.youtube.com/embed/t3Zxf_ykiyw" frameborder="0" allowfullscreen)
					footer(class="ibe-modal__footer u-text-right u-mt")
						button(class="ibe-button ibe-button--red" type="button" data-dialog="close") Aceptar
