mixin m-ibe-modal-unmr-terms()
	div.ibe-dialog.fc-dialog-unmr-terms
		div.modal-dialog.modal-dialog-unmr.modal-dialog-unmr--terms(role="dialog" aria-modal="true" aria-labelledby="unmr-terms-title")
			div.modal-content
				div.ibe-modal.ibe-modal-unmr.ibe-modal-unmr--terms
					header.modal-header
						div.ibe-modal-unmr__header-content
							h4.ibe-modal-unmr__title.ibe-modal-unmr__title--terms(id="unmr-terms-title" tabindex="-1")!="Servicio de Acompañamiento de menores"
					div.modal-body.ibe-modal-unmr__body.ibe-modal-unmr__body--terms(tabindex="0" role="region" aria-labelledby="unmr-terms-title")
						div.ibe-modal-unmr__terms-description
							p.paragraph.paragraph__regular!="El firmante (padre, madre o tutor) en calidad de responsable legal del menor sin acompañar (UM) citado en este documento, confirma haber efectuado los trámites necesarios para que dicho menor sea acompañado en la salida del aeropuerto de origen y recogido en el aeropuerto de llegada por las personas aquí indicadas."
							p.paragraph.paragraph__regular!="Eximo a IBERIA de cualquier responsabilidad distinta a la derivada de la legislación aplicable, incluyendo las acciones derivadas de la aplicación de la ley de seguridad aérea, o que no esté contenida en las condiciones generales de transporte de la compañía."
							p.paragraph.paragraph__regular!="El firmante está de acuerdo con lo expresado anteriormente y solicita el transporte del citado menor, garantizando que la información aquí recogida es verdadera."
					//- Botón de cierre como último hijo del DOM (ver nota en m-ibe-modal-unmr).
					button.ibe-button--reset.ibe-modal__options-icon.ibe-modal__options-icon--close(type="button" data-dialog="close" aria-label="Cerrar ventana")
