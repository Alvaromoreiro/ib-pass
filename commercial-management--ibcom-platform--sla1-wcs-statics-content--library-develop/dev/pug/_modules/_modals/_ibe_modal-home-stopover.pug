mixin m-ibe-modal-home-stopover(params)
    div.ibe-dialog.fc-dialog-video.ibe-stopover-tabs-banner-modal-video.ibe-stopover-tabs-banner-modal-video-hidden(id="stopover-video-modal")
        div.modal-dialog.ibe-stopover-tabs-banner-modal-video--content
            div.modal-content
                div.ibe-modal.ibe-modal--content-centered
                    header.modal-header
                        figure.ibe-stopover-tabs--modal-logo
                            img(src="images/modules/stopover-tabs/logo_stopover-video2.png", alt="")
                        div.ibe-modal__options
                            button(type="button" data-dialog="close" onclick="closeStopoverModal1()" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
                                span.hideAccessible!="Cerrar"
                                div
                                script.
                                    function closeStopoverModal1(){
                                        let videoModal = document.getElementById("stopover-video-modal");
                                        videoModal.classList.add('ibe-stopover-tabs-banner-modal-video-hidden');
                                        videoModal.classList.remove('ibe-stopover-tabs-banner-modal-video');
                                    }
                    div.modal-body
                        h3.title.ibe-modal__title-secondary!="Aprovecha tu escala descubriendo Madrid"
                        div.ibe-modal_body
                            iframe(width="560" height="315" src="https://www.youtube.com/embed/t3Zxf_ykiyw" frameborder="0" allowfullscreen)
                    footer(class="ibe-modal__footer u-text-right u-mt")
                        button(class="ibe-button ibe-button--red" type="button" onclick="closeStopoverModal2()" data-dialog="close") Aceptar
                        div
                            script.
                                function closeStopoverModal2(){
                                    let videoModal = document.getElementById("stopover-video-modal");
                                    videoModal.classList.add('ibe-stopover-tabs-banner-modal-video-hidden');
                                    videoModal.classList.remove('ibe-stopover-tabs-banner-modal-video');
                                }
