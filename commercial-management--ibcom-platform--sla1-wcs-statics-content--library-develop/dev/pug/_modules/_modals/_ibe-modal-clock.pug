mixin m-ibe-modal-clock(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-clock
		div.modal-dialog.modal-dialog
			div.modal-content
				div.ibe-modal.ibe-modal.ibe-modal--clock
					div.modal-header.modal-header--p-bottom-28
						h2.title.title__h1.ibe-modal__title-primary="¿Aún no te has decidido?"
						.ibe-modal__options.ibe-modal__options--claim
							button.ibe-button--reset.ibe-modal__options-icon.ibe-modal__options-icon--close(type="button" data-dialog="close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						.row
							.col-md-6.col-xs-12
								div.ibe-box-clock
									p.ibe-box-clock--title!="TU SESIÓN VA A EXPIRAR EN:"
									div.ibe-box-clock--icon
										span.ibe-box-clock--text!="1 min 23 seg"
							.col-md-6.col-xs-12
								p.paragraph.paragraph__regular.paragraph__regular--modal-clock.paragraph__regular--m-top-30!='Por favor, pulsa en el bot&oacute;n " Mantener sesión " para permanecer conectado.'
								
					div.modal-footer.modal-footer--left
						button.ibe-button.ibe-button--red.ibe-button--smaller.ibe-button--morelarge.ibe-button--right.ibe-button--modal(type='button' title="Cancelar" data-dialog="close") Mantener sesi&oacute;n
						button.ibe-button.ibe-button--reset.ibe-button--link02.ibe-button--modal(type='button' title="Continuar" data-dialog="close") Ir a la p&aacute;gina principal
