mixin m-ibe-modal-discount-v-stopover(params)
	- params = params || {};
	div.ibe-dialog.fc-discount-v-stopover
		div.modal-dialog
			div.modal-content
				div.ibe-modal
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary.title--stopover-modal!="¿Cómo aplico mi código descuento?"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal_body.ibe-modal__stopover--discount-v
							div.ibe-modal__stopover--discount-v-container
								div.ibe-modal__stopover--discount-v-number 1.
								div.ibe-modal__stopover--discount-v-img-col
									img(src=globals.imgPath + "/modules/stopover/modal-discount-2.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-v-img
									div.ibe-modal__stopover--discount-v-txt-container
										span.ibe-modal__stopover--discount-v-txt Clica en en link que te dirige a la web de 
										span.ibe-modal__stopover--discount-v-txt-bold Tour guiado por el Museo del Prado.
							div.ibe-modal__stopover--discount-v-container
								div.ibe-modal__stopover--discount-v-number 2.
								div.ibe-modal__stopover--discount-v-img-col
									img(src=globals.imgPath + "/modules/stopover/modal-discount-3.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-v-img
									div.ibe-modal__stopover--discount-v-txt-container
										span.ibe-modal__stopover--discount-v-txt Una vez has escogido fecha y te encuentres
										span.ibe-modal__stopover--discount-v-txt-bold en el proceso de pago debes seleccionar el numero de asistentes al tour.
							div.ibe-modal__stopover--discount-v-container
								div.ibe-modal__stopover--discount-v-number 3.
								div.ibe-modal__stopover--discount-v-img-col
									img(src=globals.imgPath + "/modules/stopover/modal-discount-2.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-v-img
									div.ibe-modal__stopover--discount-v-txt-container
										span.ibe-modal__stopover--discount-v-txt Tecer texto que aparece 
										span.ibe-modal__stopover--discount-v-txt-bold para las imágenes.
							div.ibe-modal__stopover--discount-v-button
								button.ibe-button.ibe-button--red.ibe-button--min-1.ibe-button--iberia-headline.ibe-button--fs-16.ibe-modal__img-button-stopover(type="button")!="Aceptar"