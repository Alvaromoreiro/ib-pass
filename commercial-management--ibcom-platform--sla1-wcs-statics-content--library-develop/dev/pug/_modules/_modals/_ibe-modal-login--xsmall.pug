mixin m-ibe-modal-login--xsmall(params)
	- params = params || {};
	div.ibe-dialog.ibe-dialog--login.fc-dialog-login--xsmall(data-dialog="modal")
		div.modal-dialog.modal-dialog--xsmall
			div.modal-content
				.ibe-modal
					.modal-header
						h2.title.title__h1.ibe-modal__title-primary.ibe-login__title Acceso a Iberia Plus
						h3.title.title__h4.ibe-modal__title-primary--h4.ibe-login__text Inicia sesi&oacute;n para ver promociones exclusivas y utilizar tus Avios
						.ibe-modal__options
							button.ibe-button--reset.ibe-modal__options-icon.ibe-modal__options-icon--close(data-modal-view='defaultModal', data-dialog='close', type='button')
								span.hideAccessible Cerrar
					.modal-body
						.ibe-login
							.ibe-login__box
								form.ibe_form(method="post", action="#ni")
									fieldset.ibe-form__fieldset
										div(class="ibe_form__group no_marginTop")
											input(class="ibe_form__input-text", name="id_number3", id="id_number3", type="text", placeholder="N&uacute;mero de Iberia Plus")
											label(class="ibe_form__input-label", for="id_number3") N&uacute;mero de Iberia Plus
										div(class="ibe_form__group")
											input(class="ibe_form__input-text", name="id_pin3", id="id_pin3", type="text", placeholder="PIN")
											label(class="ibe_form__input-label", for="id_pin3") PIN
										p.ibe-login__forget
											a.link.link__regular(href="#" title="¿Has olvidado tu PIN?")!="&iquest;Has olvidado tu pin?"
										.ibe-form__checkbox.ibe-form__checkbox--login-session
											input.ibe-form__checkbox-input(type='checkbox', name='session-check-modal', id="session-check-modal")
											label.ibe-form__checkbox-label.ibe-form__checkbox-label--m-bottom-18.ibe-form__checkbox-label--session(for='session-check-modal')
												span.ibe-form__checkbox-label--text02.ibe-form__checkbox-label--text02-login-sessionxs No cerrar sesi&oacute;n
										button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block(type="button")!="Entrar"
										p.paragraph.paragraph__regular.paragraph__regular--separator.text-center!="o"
										button.ibe-button.ibe-button--facebook.ibe-button--big.ibe-button--block(type="button")!="Entrar con Facebook"
										button.ibe-button.ibe-button--linkedin.ibe-button--big.ibe-button--block(type="button")!="Entrar con Linkedin"
										p.paragraph.paragraph__regular.paragraph__regular--border-top.text-center
											span.iberia-plus-connect__link-register!="&iquest;No eres de Iberia Plus? "
											a.link.link__regular.link__regular--important(href="" title="Reg&iacute;strate")!="Reg&iacute;strate"
