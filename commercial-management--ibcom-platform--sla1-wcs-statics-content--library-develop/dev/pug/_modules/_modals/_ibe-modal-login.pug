mixin m-ibe-modal-login(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-login
		div.modal-dialog
			div.modal-content
				div.ibe-modal.ibe-modal--content-centered
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary!="Hoteles con Avios"
						h3.title.ibe-modal__title-secondary!="Identif&iacute;cate con tu n&uacute;mero de Iberia Plus y tu PIN para continuar"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal_body.ibe-modal_body--content-centered
							div(class="ibe_form__group")
								input(class="ibe_form__input-text", name="number", id="number", type="text", placeholder="Número de Iberia Plus")
								label(class="ibe_form__input-label", for="number") N&uacute;mero de Iberia Plus
							div(class="ibe_form__group")
								input(class="ibe_form__input-text", name="pin", id="pin", type="text", placeholder="PIN")
								label(class="ibe_form__input-label", for="pin") PIN
							p.paragraph.paragraph__regular.text-right
								a.link.link__regular(href="#" title="¿Has olvidado tu PIN?")!="&iquest;Has olvidado tu pin?"
							button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block(type="button")!="Entrar"
							p.paragraph.paragraph__regular.paragraph__regular--separator.text-center!="o"
							button.ibe-button.ibe-button--facebook.ibe-button--big.ibe-button--block(type="button")!="Entrar con Facebook"
							button.ibe-button.ibe-button--linkedin.ibe-button--big.ibe-button--block(type="button")!="Entrar con Linkedin"
							p.paragraph.paragraph__regular.paragraph__regular--border-top.text-center
								span!="&iquest;No eres de Iberia Plus? "
								a.link.link__regular.link__regular--important(href="" title="Regístrate")!="Reg&iacute;strate"
