mixin m-ibe-modal-discount-h-stopover(params)
	- params = params || {};
	div.ibe-dialog.fc-discount-h-stopover
		div.modal-dialog.ibe-modal__stopover--discount-h-container
			div.modal-content
				div.ibe-modal
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary.title--stopover-modal!="¿Cómo aplico mi código descuento?"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal__stopover--discount-h
							div.ibe-modal__stopover--discount-h-column
								div.ibe-modal__stopover--discount-h-number 1.
								div.ibe-modal__stopover--discount-h-img-container
									img(src=globals.imgPath + "/modules/stopover/modal-discount-h.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-h-img
									div.ibe-modal__stopover--discount-h-txt-container
										span.ibe-modal__stopover--discount-h-txt Clica en en link que te dirige a la web de 
										span.ibe-modal__stopover--discount-h-txt-bold Tuk Tuk Tuk.								
							div.ibe-modal__stopover--discount-h-column
								div.ibe-modal__stopover--discount-h-number 2.
								div.ibe-modal__stopover--discount-h-img-container
									img(src=globals.imgPath + "/modules/stopover/modal-discount-h.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-h-img
									div.ibe-modal__stopover--discount-h-txt-container
										span.ibe-modal__stopover--discount-h-txt Una vez en la página de TukTukTuk, 
										span.ibe-modal__stopover--discount-h-txt-bold selecciona la fecha y hora 
										span.ibe-modal__stopover--discount-h-txt que quieres disfrutar del tour.
							div.ibe-modal__stopover--discount-h-column
								div.ibe-modal__stopover--discount-h-number 3.
								div.ibe-modal__stopover--discount-h-img-container
									img(src=globals.imgPath + "/modules/stopover/modal-discount-h.png" alt="Selecciona número de vuelo").ibe-modal__stopover--discount-h-img
									div.ibe-modal__stopover--discount-h-txt-container
										span.ibe-modal__stopover--discount-h-txt-bold En el 1º paso del proceso de compra  
										span.ibe-modal__stopover--discount-h-txt encontrarás el campo para introducir el código de descuento
						li.paragraph--stopover-modal-img-secondary.ibe-modal__stopover--discount-h-li Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed qu
						div.ibe-modal__stopover--discount-h-button
							button.ibe-button.ibe-button--red.ibe-button--min-1.ibe-button--iberia-headline.ibe-button--fs-16.ibe-modal__img-button-stopover(type="button")!="Aceptar"