mixin m-ibe-modal-login-stopover(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-login-stopover.ibe_inputs
		div.modal-dialog.modal-dialog--stopover
			div.modal-content
				div.ibe-modal
					header.modal-header.modal-header--no-border
						h2.title.title__h1.ibe-modal__title-primary.title--center.title__big!="¿Ya tienes tu "
							span.paragraph--red.paragraph--bold.title__big!=" Stopover?"
						h3.ibe-modal_subtitle!="Accede a tu reserva de Stopover para poder ver los códigos de descuentos"
						div.ibe-modal__options
							button(type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body.modal-body--flex
						div.ibe-modal_body.ibe-modal_body--stopover.ibe-modal_body--p-right
							h4.ibe-modal_body-title.ibe-modal_body-title--level3-sec!="Accede con tus datos de vuelo"
							div(class="ibe_form__group ibe_form__group--error")
								input(class="ibe_form__input-text", name="lastName", id="lastName", type="text", placeholder="Apellido del pasajero")
								label(class="ibe_form__input-label", for="lastName") Apellido del pasajero
							div(class="ibe_form__group ibe_form__group--error")
								input(class="ibe_form__input-text", name="bookingNumber", id="bookingNumber", type="text", placeholder="Código de reserva")
								label(class="ibe_form__input-label", for="bookingNumber") Código de reserva
							p.paragraph.paragraph__regular.paragraph__regular--mt-22.text-right
								a.link.link__regular.link__regular--underline(href="#" title="¿Qué es el código de reserva?")!="&iquest;Qué es el código de reserva?"
							button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block.ibe-modal__button-stopover(type="button")!="Gestiona tu reserva"

						p.paragraph.paragraph__regular.paragraph__regular--separator.paragraph__regular--separator-big.separator-hide.text-center!="O"

						div.ibe-modal_body.ibe-modal_body--stopover.ibe-modal_body--p-left.ibe-modal_body--b-left
							h4.ibe-modal_body-title.ibe-modal_body-title--level3-sec!="Accede con tu email o nº de Iberia Plus"
							div(class="ibe_form__group ibe_form__group--icon")
								input(class="ibe_form__input-text", name="number", id="number", type="text", placeholder="E-mail o nº de Iberia Plus")
								label(class="ibe_form__input-label", for="number") E-mail o nº de Iberia Plus
							div(class="ibe_form__group fc_form_group ibe_form__group--button-icon")
								label(class="ibe_form__input-label", for="code1111") Contraseña
								input(class="ibe_form__input-text", name="code1111", id="code1111", type="password", placeholder="Contraseña")
								button.ibe_form__input-button.icon-pass-hidden(data-showhide, data-text-show="Mostrar contraseña", data-text-hide="Ocultar contraseña" type="button")
									span(class="hideAccessible")!="Mostrar contraseña"

							p.paragraph.paragraph__regular.paragraph__regular--mt-22.text-right
								a.link.link__regular.link__regular--underline(href="#" title="¿Has olvidado tu contraseña?")!="&iquest;Has olvidado tu contraseña?"
							button.ibe-button.ibe-button--red.ibe-button--big.ibe-button--block.ibe-modal__button-stopover(type="button")!="Iniciar sesión"
							p.paragraph.paragraph__regular.paragraph__regular--separator.paragraph__regular--separator-big.text-center!="O"
							div.ibe_form__social
								button.ibe-button.ibe-button--google.ibe-button--big.ibe-button--block(type="button")!="Entrar con Google"
								button.ibe-button.ibe-button--facebook.ibe-button--facebook-2.ibe-button--big.ibe-button--block(type="button")!="Entrar con Facebook"
