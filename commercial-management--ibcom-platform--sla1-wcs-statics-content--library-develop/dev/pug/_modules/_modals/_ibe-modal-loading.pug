mixin m-ibe-modal-loading(params)
	- params = params || {};
	div.ibe-dialog.fc-dialog-loading
		div.modal-dialog.modal-loading.modal-loading--small
			div.modal-content
				div.ibe-modal.ibe-modal--content-centered
					div.modal-body
						.ibe-modal__loading
							figure.ibe-modal__loading-fig
								img.ibe-modal__loading-img(src='images/modules/loading/ico_cargando.gif', alt='MOD_WAITING')
							span.title.title__h5.ibe-modal__loading-title Espere un momento
