mixin m-menu-icons(params)
	div.ibe-menu-icons
		div.ibe-menu-icons__box
			ul.ibe-menu-icons__list
				each item in params.items
					li.ibe-menu-icons__item(class=(item.first!=undefined?"first-element":""))
						a(href="#", title=(item.link!=undefined?"":item.title), class=(item.iconClass!=undefined?item.iconClass:"") + (item.active!=undefined?" active":""))
							p.text!=item.title 
					

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	