mixin m-hero-other()
  header.ibe-connections-hero(data-image='otros')
    div.ibe-connections-hero__container
      h1.ibe-connections-hero__container-title Escalas en otros aeropuertos
      p.ibe-connections-hero__container-description En Iberia volamos a diferentes destinos nacionales e internacionales. Consulta el estado de nuestras principales escalas más allá de Madrid. 
  p.ibe-connections-description En Iberia volamos a diferentes destinos nacioales e internacionales. Consulta el estado de nuestras principales escalas más allá de Madrid. 
