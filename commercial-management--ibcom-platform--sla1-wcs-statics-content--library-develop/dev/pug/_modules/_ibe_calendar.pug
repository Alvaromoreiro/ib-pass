                                    tr
                                        th LU
                                        th MA
                                        th MI
                                        th JU
                                        th VI
                                        th SA
                                        th DO
                                tbody
                                    tr
                                        td.disabled 27
                                        td.disabled 28
                                        td.disabled 29
                                        td.disabled 30
                                        td.disabled 31
                                        td 1
                                        td 2
                                    tr
                                        td.leyend-x 3
