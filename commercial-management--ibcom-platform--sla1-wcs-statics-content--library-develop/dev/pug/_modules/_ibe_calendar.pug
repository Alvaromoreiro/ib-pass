                                        td 5
                                        td 6
                                        td 7
                                        td 8
                                        td 9
                                    tr
                                        td 10
                                        td 11
                                        td 12
                                        td.leyend-z
                                            a(href="#", title="Día 27", data-tooltip="bootstrap") 13
                                                div.hidden(data-tooltip="content")
