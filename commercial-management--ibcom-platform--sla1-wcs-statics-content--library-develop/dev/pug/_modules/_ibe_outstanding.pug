mixin m-outstanding-yellow(params)
     ul.ibe-outstanding-list
        each item, index in params.items 
            li.ibe-outstanding-item(class=item.changeColor!=undefined?"ibe-outstanding-item--ofdt":"")
                div.ibe_cug-yellow-space
                    span.ibe-outstanding-item__title(class=item.icon)!=item.title
                    div.ibe-outstanding-item__text-container(class=item.ellipsis!=undefined?"ibe-outstanding-item__text-container--ofdt":"" , data-dotdotdot="collapse-text")
                        span.ibe-outstanding-item__text!=item.text 
