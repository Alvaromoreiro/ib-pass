mixin m-card-distributive(params)
    if(params.text)
        a.ibe-card-distributive__card(class="ibe-card-distributive__card--"+params.mainClass+" "+params.borderClass href=params.link.href title=params.link.title data-resize=params.data)
            if(params.image.init)
                figure.ibe-card-distributive__fig
                    img.ibe-card-distributive__img(src=globals.imgPath+params.image.src alt=params.image.alt)
            div.ibe-card-distributive__header
                span.title.title__h3(data-dotdotdot="collapse-text")!=params.title
            div.ibe-card-distributive__content
                each parr in params.text
                    p.paragraph.paragraph__regular!=parr.p
    else
        a.ibe-card-distributive__card(class="ibe-card-distributive__card--"+params.mainClass+" "+params.borderClass href=params.link.href title=params.link.title data-resize=params.data)
            if(params.image.init)
                figure.ibe-card-distributive__fig
                    img.ibe-card-distributive__img(src=globals.imgPath+params.image.src alt=params.image.alt)
            div.ibe-card-distributive__header
                span.title.title__h4(data-dotdotdot="collapse-text")!=params.title
