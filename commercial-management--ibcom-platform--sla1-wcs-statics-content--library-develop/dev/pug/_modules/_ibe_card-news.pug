mixin m-card-news(params)
    a(href="#", title=params.link_title, class=params.class)
        .ibe-card-link__container
            figure.ibe-card-link__background
                img.ibe-card-link__background-img(src=globals.imgPath+params.image.src alt=params.image.alt)
            .ibe-card-link__info
                h3.title__h3.ibe-card-link__title.ibe-card-link__title--icon!=params.title
                p.paragraph.paragraph__regular(data-dotdotdot='dotdotdot')!=params.description
            .ibe-card-link__footer
                span.ibe-font-color-primary!=params.date