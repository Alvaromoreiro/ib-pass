include ./_ibe_grid-card-generator

mixin m-grid()
	div.ibe-grid.ibe-grid--pb-0
		div.container
			div.row
				div.col-xs-12
					div.ibe-grid__content
						ul.row.ibe-card-container(data-filter="container" data-show-more="grid-01" data-show-more-init="12" data-show-more-init-mobile="5" data-show-more-number="12" data-show-more-number-mobile="5")
							+m-grid-card-generator(58)
			div
				a.ibe-button.ibe-button--red.ibe-button--large-3.ibe-button--fs-20.ibe-button--iberia-headline.pull-center.u-mt-medium(type="button" data-show-more-button="grid-01") Ver todas las experiencias