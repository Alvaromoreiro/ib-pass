mixin m-my-guides-list(params)
    div.ibe-my-guides
        div.ibe-my-guides__open
            button.ibe-my-guides__open-button.icon-guia(data-content="23" data-guide="open-modal" aria-expanded="false")
                span.ibe-my-guides__open-button__txt Mis gu&iacute;as
        div.ibe-my-guides__overlay(data-guide="modal" aria-expanded="false")
            div.ibe-my-guides__box(data-guide="modal-box")
                button.ibe-my-guides__box-close.icon-flecha_1_derecha(data-guide="close-modal")
                    span.hideAccessible Haz click para ocultar mis gu&iacute;as
                button.ibe-my-guides__box-close-responsive(data-guide="close-modal")
                    span.hideAccessible Haz click para ocultar mis gu&iacute;as
                div.ibe-my-guides__box-container
                    header.ibe-my-guides__header
                        div.ibe-my-guides__header-logo.icon-perfil_login
                            span.hideAccessible!="Logotipo del usuario"
                        span.title.title__h1.ibe-my-guides__header-title Mis gu&iacute;as
                        span.ibe-my-guides__header-subtitle usuario an&oacute;nimo

                    ul.ibe-ordered-list
                        li.ibe-ordered-list__item
                            span.ibe-ordered-list__item-txt(data-content="1") Los planes que a&ntilde;adas se mostrar&aacute;n aqu&iacute;
                            div.row
                                div.col-xs-offset-2.col-xs-8
                                    div.ibe-card-guides
                                        figure.ibe-card-guides__image
                                            img(src=globals.imgPath+"/content/grecia.jpg" alt="Puente de Michigan")
                                        div.ibe-card-guides__header
                                            span.title.title__h3 Puente de Michigan
                                        div.ibe-card-guides__info
                                            p.paragraph.paragraph__regular.paragraph__regular--grey Te sentir&aacute;s abrumado al ver la gradiosidad de este s&iacute;mbolo de la ciudad
                                        div.ibe-card-guides__footer
                                            a.link.link__regular.link__regular--important(href="#" title="Añadir a tu guía") A&ntilde;adir a tu gu&iacute;a
                        li.ibe-ordered-list__item
                            span.ibe-ordered-list__item-txt(data-content="2") Puedes visualizarlos e incluso bajarlos en pdf
                        li.ibe-ordered-list__item
                            span.ibe-ordered-list__item-txt(data-content="3") Inicia sesi&oacute;n y guarda tus gu&iacute;as para siempre