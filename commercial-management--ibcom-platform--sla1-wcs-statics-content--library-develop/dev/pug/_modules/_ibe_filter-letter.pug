			ul.ibe-filter-letter__result
				each item in params.items
					li.ibe-filter-letter__result-item
						a.link.link__regular(href="#" title=item.title data-filter-result=item.letter, data-destination-info=(item.info!==undefined?item.info:""), data-country=item.country)!=item.name
