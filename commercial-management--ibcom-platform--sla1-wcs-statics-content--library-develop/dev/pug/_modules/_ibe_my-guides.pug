mixin m-my-guides(params)
    div.ibe-my-guides
        div.ibe-my-guides__open
            button.ibe-my-guides__open-button.icon-guia(data-content="23" data-guide="open-modal" aria-expanded="false")
                span.ibe-my-guides__open-button__txt Mis gu&iacute;as
        div.ibe-my-guides__overlay(data-guide="modal" aria-expanded="false")
            div.ibe-my-guides__box(data-guide="modal-box")
                button.ibe-my-guides__box-close.icon-flecha_1_derecha(data-guide="close-modal")
                    span.hideAccessible Haz click para ocultar mis gu&iacute;as
                button.ibe-my-guides__box-close-responsive(data-guide="close-modal")
                    span.hideAccessible Haz click para ocultar mis gu&iacute;as
                div.ibe-my-guides__box-container
                    header.ibe-my-guides__header
                        div.ibe-my-guides__header-logo.icon-perfil_login
                            span.hideAccessible!="Logotipo del usuario"
                        span.title.title__h1.ibe-my-guides__header-title Mis gu&iacute;as
                        span.ibe-my-guides__header-subtitle usuario an&oacute;nimo
                    ul.ibe-my-guides__list
                        li.ibe-my-guides__list-item
                            div.ibe-paper-sheet
                                div.ibe-paper-sheet__container.ibe-paper-sheet__container--medium
                                    header.ibe-paper-sheet__header.ibe-paper-sheet__header--no-border
                                        div.ibe-paper-sheet__profile
                                            figure.ibe-paper-sheet__profile-logo
                                                img(src=globals.imgPath+"/content/grecia.jpg" alt="Logo Chicago")
                                            span.title.title__h2.ibe-paper-sheet__profile-title Chicago
                                            span.ibe-paper-sheet__profile-subtitle 34 planes
                                    div.ibe-paper-sheet__body
                                        div.row
                                            div.col-lg-4.col-md-4.col-sm-6.col-xs-6.col-pad-right-xs
                                                div.ibe-card-guides.ibe-card-guides--xs(data-card-guides="group-0" data-type="header")
                                                    figure.ibe-card-guides__image
                                                        img(src=globals.imgPath+"/content/grecia.jpg" alt="Puente de Michigan")
                                                    div.ibe-card-guides__header
                                                        span.title.title__h3 Puente de Michigan
                                            div.col-lg-4.col-md-4.col-sm-6.col-xs-6
                                                div.ibe-card-guides.ibe-card-guides--xs(data-card-guides="group-0" data-type="header")
                                                    figure.ibe-card-guides__image
                                                        img(src=globals.imgPath+"/content/grecia.jpg" alt="Alguila un kayak")
                                                    div.ibe-card-guides__header
                                                        span.title.title__h3 Alquila un kayak
                                            div.col-md-4.hidden-sm.hidden-xs
                                                div.ibe-card-guides.ibe-card-guides--xs(data-card-guides="group-0" data-type="header")
                                                    figure.ibe-card-guides__image
                                                        img(src=globals.imgPath+"/content/grecia.jpg" alt="Water taxi")
                                                    div.ibe-card-guides__header
                                                        span.title.title__h3 Water taxi
                                    footer.ibe-paper-sheet__footer
                                        div.row
                                            div.col-md-push-6.col-md-6.col-sm-12.col-xs-12
                                                button.ibe-button.ibe-button--block.ibe-button--big.ibe-button--red Abre tu gu&iacute;a de viaje
                                            div.col-md-pull-6.col-md-6.col-sm-12.col-xs-12
                                                button.ibe-button.ibe-button--block.ibe-button--icon-to-left.ibe-button--big.ibe-button--grey.icon-descargar_pdf Descarga tu gu&iacute;a en PDF
