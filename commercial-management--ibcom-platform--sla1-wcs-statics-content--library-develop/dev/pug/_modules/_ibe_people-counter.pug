mixin m-people-counter(params)
	div.ibe-people-counter(id=params.id data-toggle="container" class=params.cssClass data-close="outsideclick", data-keyboard-close="esc")
		ul.ibe-people-counter__list(data-id=params.data)
			li.ibe-people-counter__list-item.fc-people-counter-important
				span.ibe-people-counter__counter.ibe-people-counter__counter--none(data-people-counter="counter",data-people-type='senior')!="0"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="Senior"
					span.ibe-people-counter__people-subtitle!="M&aacute;s de 65 a&ntilde;os"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="Solo puedes reservar vuelos para un m&aacute;ximo de 9 pasajeros."
				div.ibe-people-counter__message.ibe-people-counter__message--senior
					p.ibe-people-counter__message-text!="Añade tu billete de senior en el 901 201 214."
			li.ibe-people-counter__list-item.fc-people-counter-important
				span.ibe-people-counter__counter.ibe-people-counter__counter--plus(data-people-counter="counter",data-people-type='adult')!="1"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="Adultos"
					span.ibe-people-counter__people-subtitle!="24 a 64 a&ntilde;os"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="Solo puedes reservar vuelos para un m&aacute;ximo de 9 pasajeros."
			li.ibe-people-counter__list-item.fc-people-counter-important
				span.ibe-people-counter__counter.ibe-people-counter__counter--none(data-people-counter="counter",data-people-type='young')!="0"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="J&oacute;venes"
					span.ibe-people-counter__people-subtitle!="12 a 23 a&ntilde;os"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="Solo puedes reservar vuelos para un m&aacute;ximo de 9 pasajeros."
				div.ibe-people-counter__message.ibe-people-counter__message--young
					p.ibe-people-counter__message-text!="Añade tu billete de Joven en el 901 201 214."
			li.ibe-people-counter__list-item.fc-people-counter-important
				span.ibe-people-counter__counter.ibe-people-counter__counter--none(data-people-counter="counter", data-people-type='teenager')!="0"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="Adolescente"
					span.ibe-people-counter__people-subtitle!="12 a 23 a&ntilde;os - USA"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="Solo puedes reservar vuelos para un m&aacute;ximo de 9 pasajeros."
				div.ibe-people-counter__message.ibe-people-counter__message--teenager
					p.ibe-people-counter__message-text!="Añade tu billete de adolescente en el 901 201 214."
			li.ibe-people-counter__list-item.fc-people-counter-children
				span.ibe-people-counter__counter.ibe-people-counter__counter--none(data-people-counter="counter",data-people-type='children')!="0"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="Ni&ntilde;os"
					span.ibe-people-counter__people-subtitle!="2 a 11 a&ntilde;os"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="Solo puedes reservar vuelos para un m&aacute;ximo de 9 pasajeros."
						span.ibe-message-tooltip__content.ibe-message-tooltip__content--children-alone-limit!="[SEEK_021] Los menores no acompa&ntilde;ados tienen un m&aacute;ximo de 8."
				div.ibe-people-counter__ages(data-min-ages="2", data-max-ages="17")
					div.ibe_form__selectize-multi
						label.ibe_form__input-label!="Edad de los ni&ntilde;os"
						div.ibe_form__selectize-multi__selectors
				div.ibe-people-counter__message.ibe-people-counter__message--children-alone
					p.ibe-people-counter__message-text!="Menores no Acompa&ntilde;ados. Reserva para Menores de 5 a 12 a&ntilde;os viajando solos. El servicio de acompa&ntilde;amiento es obligatorio e incluye un cargo adicional. Reserva para Menores de 12 a 17 a&ntilde;os viajando solos. Puedes realizar la reserva como adulto si decides que viaje solo o puedes contratar nuestro servicio de acompa&ntilde;amiento. Si deseas solicitar una reserva para un menor con servicio de acompa&ntilde;amiento puedes continuar. Si deseas reservar para otro tipo de pasajero vuelve al formulario de b&uacute;squeda y modifica los criterios."
				div.ibe-people-counter__message.ibe-people-counter__message--children
					p.ibe-people-counter__message-text!="Un adulto puede viajar con un m&aacute;ximo de 2 menores de 5 a&ntilde;os (1 beb&eacute; y un ni&ntilde;o o 2 ni&ntilde;os). Si el tercer ni&ntilde;o (o siguientes) es mayor de 5 a&ntilde;os puedes continuar. Para m&aacute;s informaci&oacute;n consulta a Serviberia en el tel&eacute;fono 901 111 500 o con tu centro de Servicios Iberia Plus si es una reserva con Avios."
			li.ibe-people-counter__list-item.fc-people-counter-babies
				span.ibe-people-counter__counter.ibe-people-counter__counter--none(data-people-counter="counter",data-people-type='babies')!="0"
				div.ibe-people-counter__people
					span.ibe-people-counter__people-title!="Beb&eacute;s"
					span.ibe-people-counter__people-subtitle!="Menos de 2 a&ntilde;os"
				div.ibe-people-counter__buttons
					button.ibe-people-counter__buttons-less(type="button" data-focusin data-people-counter-button="less")!="-"
					button.ibe-people-counter__buttons-more(type="button" data-focusin data-people-counter-button="more")!="+"
					.ibe-message-tooltip
						button.ibe-message-tooltip__button-close.icon-cerrar(type='button')
							span.hideAccessible Cerrar ventana tooltip
						span.ibe-message-tooltip__title!="Informaci&oacute;n"
						span.ibe-message-tooltip__content!="El n&uacute;mero de beb&eacute;s no puede ser mayor que el de adultos."
				div.ibe-people-counter__message.ibe-people-counter__message--avios-babies
					p.ibe-people-counter__message-text!="Añade tu billete de bebé en el 901 201 214."
				//-div.ibe-people-counter__message.ibe-people-counter__message--plus
					p.ibe-people-counter__message-text!="El n&uacute;mero de beb&eacute;s debe ser igual o menor que el de adultos"
		//-footer.ibe-people-counter__footer
			button.ibe-button.ibe-button--red.ibe-button--block(type="button" data-toggle="close-collapse")!="Guardar"
