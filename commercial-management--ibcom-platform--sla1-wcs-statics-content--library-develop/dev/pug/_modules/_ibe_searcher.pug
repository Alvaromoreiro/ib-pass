				ul.ibe-tab__menu
					if(params.tab1 != false)
						li.ibe-tab__menu-item
							a.link.link__regular(href="#tab-searcher-1" title="Vuelo" data-active="1")!="VUELOS"
					if(params.tab2 != false)
						li.ibe-tab__menu-item
							a.link.link__regular(href="#tab-searcher-2" title="Vuelo+Hotel" data-active="0")!="VUELO+HOTEL"
					if(params.tab3 != false)
						li.ibe-tab__menu-item
							a.link.link__regular(href="#tab-searcher-3" title="Vuelo+Coche" data-active="2")!="VUELO+COCHE"
					if(params.tab4 != false)
						li.ibe-tab__menu-item
							a.link.link__regular(href="http://www.google.es" target="_blank" title="Ir a ")!="HOTEL"
					if(params.tab5 != false)
						li.ibe-tab__menu-item
							a.link.link__regular(href="http://www.google.es" target="_blank" title="Ir a ")!="COCHE"
