mixin m-ibe-bob_opinions()
    div.ibe-carousel-cards
        div.ibe-bob--opinions
            div.ibe-box-work__header
                h3.title--stopover.ibe-bob--opi-cards-title
                    span ¿Que opinan nuestros clientes?
            article
                div.ibe-carousel(data-slick='cards-slider-bob')
                    div.col-lg-4.col-md-4.col-sm-12.col-xs-12.ibe-card
                        +m-bob-opinions-cards({
                            "id": "1476391160540",
                            "guide": {
                                "group": "0",
                                "type": "body",
                                "cssClass": "ibe-card-guides--bob"
                            },
                            "info": "Super rápido y eficientes! de seguro es un servicio que vale la pena pagar!",
