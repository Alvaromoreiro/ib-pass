mixin m-ibe-bob_valorations()
    div.ibe-bob--valorations-icon
        ul.row.ibe-bob--valorations-row
            li.col-lg-4.col-md-6.col-sm-12.col-xs-12
                div.ibe-bob--valorations-icon-section
                    img(src=globals.imgPath + "/modules/icons/bag.png" alt="oferta cultural", class="ibe-bob--valorations-icon-img") 
                    p.ibe-bob--valorations-icon-title.ibe-wine-club__icon-banner--icon-col-title!="+50,000"                                   
                    p.ibe-bob--valorations-icon-txt!="Maletas transportadas"
            li.col-lg-4.col-md-6.col-sm-12.col-xs-12
                div.ibe-bob--valorations-icon-section
                    img(src=globals.imgPath + "/modules/icons/star.png" alt="oferta gastronomica", class="ibe-bob--valorations-icon-img")
                    p.ibe-bob--valorations-icon-title.ibe-wine-club__icon-banner--icon-col-title!="4,9/5"
                    p.ibe-bob--valorations-icon-txt!="Valoración de nuestros Clientes"
            li.col-lg-4.col-md-6.col-sm-12.col-xs-12
                div.ibe-bob--valorations-icon-section
                    img(src=globals.imgPath + "/modules/icons/check.png" alt="compras y ocio", class="ibe-bob--valorations-icon-img")
                    p.ibe-bob--valorations-icon-title.ibe-wine-club__icon-banner--icon-col-title!="96%"
                    p.ibe-bob--valorations-icon-txt!="Entregas satisfactorias"