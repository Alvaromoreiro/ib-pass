mixin m-ibe-bob_banner(params)
    div(data-background=params.dataBackground class=params.classBanner)
        div.ibe-bob--banner-background
        div.ibe-bob--banner-text-container.container
            p.ibe-bob--banner-text Recogemos tus maletas, las facturamos y las enviamos a tu destino
            div.ibe-button.u-mt-medium.ibe-bob--banner-button Reservar