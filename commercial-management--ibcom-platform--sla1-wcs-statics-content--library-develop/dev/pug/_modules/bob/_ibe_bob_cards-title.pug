mixin m-ibe-bob_cards-title()
    div.ibe-bob--cards-title
        p.ibe-bob--cards-title--title!="Viaja ligero y reduce las esperas"
        div.ibe-bob--cards-title--info!="Si tienes un vuelo con salida desde Madrid, facturamos y transportamos tu equipaje a destino; así viajarás más ligero y reducirás tu tiempo de espera en el aeropuerto."