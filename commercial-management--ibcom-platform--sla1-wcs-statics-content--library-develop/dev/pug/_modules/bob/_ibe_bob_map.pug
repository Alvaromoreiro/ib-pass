mixin m-ibe-bob_map()
    div.ibe-bob--map
        div.ibe-bob--map--text
            p.ibe-bob--map--title.link.link__regular--important!="¿Dónde operamos?"
            div.ibe-bob--map--info!="De momento solo operamos en el aeropuerto de Madrid-Barajas, pero pronto ampliaremos nuestro servicio a otros aeropuertos nacionales e internacionales."
        div.ibe-bob--map--img-container
            a.ibe-bob--map--img