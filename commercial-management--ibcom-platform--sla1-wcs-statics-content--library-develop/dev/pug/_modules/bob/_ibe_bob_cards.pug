mixin m-ibe-bob_cards(params)
    div.ibe-bob--cards
        div.ibe-bob--cards--container
            if (params.left && params.type === '1')
                a.ibe-bob--cards--img.ibe-bob--cards--img1
            if (params.left && params.type === '2')
                a.ibe-bob--cards--img.ibe-bob--cards--img2
            if (params.left && params.type === '3')
                a.ibe-bob--cards--img.ibe-bob--cards--img3
            if (params.left && params.type === '4')
                a.ibe-bob--cards--img.ibe-bob--cards--img4
            div.ibe-bob--cards--text
                div.ibe-bob--cards--text-title
                    p.link.link__regular--important!=params.title
                div.ibe-bob--cards--text-info!=params.info
            if (params.right && params.type === '1')
                a.ibe-bob--cards--img.ibe-bob--cards--img1
            if (params.right && params.type === '2')
                a.ibe-bob--cards--img.ibe-bob--cards--img2
            if (params.right && params.type === '3')
                a.ibe-bob--cards--img.ibe-bob--cards--img3
            if (params.right && params.type === '4')
                a.ibe-bob--cards--img.ibe-bob--cards--img4
