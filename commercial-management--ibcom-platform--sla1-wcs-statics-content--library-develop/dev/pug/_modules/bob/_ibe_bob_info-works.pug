mixin m-ibe-bob_info-works()
    div(data-skewed).ibe-box-landing--skewed.ibe-bob--info-works.ibe-bob--info-works-flex
        section.ibe-box-landing__block--secondary.ibe-bob--info-works-section.ibe-bob--info-works-flex
            .ibe-bob--info-works-flex
                .row.ibe-bob--info-works-row.ibe-bob--info-works-flex
                    .col-xs-12.col-md-12.col-lg-6.col-xl-6.ibe-bob--info-works-flex.ibe-bob--info-works-carousel-area
                        div.ibe-bob--info-works-carousel(data-theta-carousel='bob')
                            div.ibe-box-landing__slick-item
                                figure.ibe-box-landing__figure
                                    img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/bob-photo1.png")
                            div.ibe-box-landing__slick-item
                                figure.ibe-box-landing__figure
                                    img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/bob-photo2.png")
                            div.ibe-box-landing__slick-item
                                    figure.ibe-box-landing__figure
                                        img.ibe-box-landing__img(alt="App Store" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src=globals.imgPath + "/content/slick-apps/bob-photo3.png")
                        ul(data-theta-carousel='bullets').ibe-box-landing__slick-list.hidden-xs.ibe-bob--info-works-bullets
                            li.ibe-box-landing__slick-bullet
                                button.ibe-box-landing__slick-button
                            li.ibe-box-landing__slick-bullet
                                button.ibe-box-landing__slick-button
                            li.ibe-box-landing__slick-bullet
                                button.ibe-box-landing__slick-button
                    .col-xs-12.col-md-12.col-lg-5.col-xl-5.ibe-bob--info-works-txt-section
