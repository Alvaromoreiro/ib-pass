mixin m-float-banner(params)
    div.ibe-floatbanner(class=params.align!=undefined?"ibe-floatbanner--"+params.align:"ibe-floatbanner--right", class=params.color!=undefined?"ibe-floatbanner--"+params.color:"ibe-floatbanner--grey")
        div.container.u-mt-big
            div.row
                //-div.ibe-floatbanner__background(class=params.imgRight==true?"ibe-floatbanner__background--right":"", style="background-image: url('"+params.img+"')", data-floatbackground=params.img)
                div.ibe-floatbanner__background(class=params.imgRight==true?"ibe-floatbanner__background--right":"", data-floatbackground=params.img, role="img", aria-label="poner exto aqui")
                div.col-xs-12.col-md-6.ibe-floatbanner__content(class=params.align=='right'?"col-md-push-6":"")
                    div.ibe-floatbanner__content-box
                        .ibe-floatbanner__content--pretitle!="MAD about"
                        .ibe-floatbanner__content--title!=params.title
                        .ibe-floatbanner__content--text(data-dotdotdot="collapse-text")!=params.text
                        a(href="#", data-hover="Reserva ya tu hotel", data-focusin).ibe-floatbanner__content--button
                            span.ibe-search-flights__cover-box__button Desc&uacute;brela
