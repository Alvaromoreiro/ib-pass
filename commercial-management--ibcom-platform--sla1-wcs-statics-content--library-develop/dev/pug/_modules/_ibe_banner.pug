mixin m-banner()
	.ibe-banner-new(data-background="./images/content/banner_new/fondo")
		.ibe-banner-new__container
			.container
				.row
					.col-xs-12
						h2.hideAccessible Mad about Madrid
						figure.ibe-banner-new__fig--txt(aria-hidden="true")
							//- picture
							//- 	//-source(media="(min-width: 480px)", srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==", data-src="./images/content/banner_new/text.svg")
							//- 	//-source(media="(min-width: 0px)", srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==", data-src="./images/content/banner_new/text.svg")
							//- 	source(media="(min-width: 0px)", srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==", data-src="./images/content/banner_new/text.svg")
							img( src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==", data-src="./images/content/banner_new/text.svg", class="ibe-banner-new__img--txt css-js", alt="Empapate de sol")
						p.ibe-banner-new__txt Si vienes de Sudamérica a Europa, te encantará parar en Madrid. Con el StopOver de Iberia podrás pasar unos días en  sin cambios en tu tarifa, y vivir la locura de nuestra capital.
						h3.ibe-banner-new__title ¿Cuál es tu trayecto?
						+m-search-collapse({stopover: false}) 

