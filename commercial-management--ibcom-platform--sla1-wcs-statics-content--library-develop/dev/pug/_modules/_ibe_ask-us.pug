mixin m-ask-us(params)
	-    params = params || "";
	div.ibe-card-cont
		div.ibe-card-cont__container.ibe-card-cont__container--grey2.ibe-card-cont__container--no-border-top.ibe-card-cont__container--small(class=(params.search==false?"ibe-card-cont__container--no-search":""))
			h2.title__h2.ibe-card-cont__title.ibe-card-cont__title--black.ibe-card-cont__title--with-border Preg&uacute;ntanos
			div.ibe-card-cont__alinear
				div
					div.ibe-card-cont__alinear--blocks
						h3.ibe-card-cont__alinear--blocks_title Contacto
						div.ibe-card-cont--icon.icon-mensajes
							p.paragraph.paragraph__regular.paragraph__regular--medium.paragraph--red clasica@iberia.es
							p.paragraph.paragraph__regular.paragraph__regular--medium!="Indica en el asunto tu n&uacute;mero de Iberia Plus (para clientes Iberia Plus. Regístrate "
								a.link.link__regular--red(href="#", title="Ir a Serviberia" , data-focusin)!="ahora"
								span!=")."
						div.ibe-card-cont--icon.icon-posicion_correcta
							p.paragraph.paragraph__regular.paragraph__regular--medium.paragraph__regular--bold 901 111 500
							p.paragraph.paragraph__regular.paragraph__regular--medium.paragraph--red
								a(href="#", title="Ir a Serviberia", class="link link__regular link__regular--important" , data-focusin)!="Consulta tel&eacute;fonos en otros países"
					div.ibe-card-cont__alinear--blocks
						h3.ibe-card-cont__alinear--blocks_title En redes sociales
						div.ibe-card-cont--icon.icon-social_twitter
							a(href="#", title="title", data-focusin, class="ibe-list__item--link")
								p.paragraph.paragraph__regular.paragraph__regular--medium.link.link__regular--black @iberia
						div.ibe-card-cont--icon.icon-social_facebook
							a(href="#", title="title", data-focusin, class="ibe-list__item--link")
								p.paragraph.paragraph__regular.paragraph__regular--medium.link.link__regular--black www.facebook.com/iberia
						p.paragraph.paragraph__regular.paragraph__regular--medium.ibe-menu-new__link--icon-desktop.paragraph--red
							a(href="#", title="title", data-focusin, class="link link__regular link__regular--important")!="Iberia en las redes sociales"
				if(params.search != false)
					div(class=(params.search==true?"ibe-card-cont__alinear--blocks ibe-card-cont__alinear--blocks__no-border":""))
						form.form-search-office(action="#" method="post" id="form1")
							fieldset
								legend.ibe-card-cont__alinear--blocks_title Buscador de oficinas
								.row
									.col-xl-12
										.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="clase_mercado")
												span.ibe_form__input-text Mercado
											select(required, id="clase_mercado", class="ibe-select ibe_form__input-text", name="clase_mercado", data-selectmenu="")
												option(value="") Mercado
												option(value="dni") Todos los mercados
												option(value="carnet") Carn&eacute; Nacional de Identidad
												option(value="pasaporte") Pasaporte
												option(value="tarjeta") Tarjeta Residente en Espa&ntilde;a
											p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
									.col-xl-12
										.ibe_form__group.ibe_form__group--separated.fc_form_group.ibe__form__group--select.ibe_form__group--select-new(data-selectmenu_claim)
											label.ibe_form__selectize--label(for="clase_catego")
												span.ibe_form__input-text Categor&iacute;a
											select(required, id="clase_catego", class="ibe-select ibe_form__input-text", name="clase_catego", data-selectmenu="")
												option(value="") Categor&iacute;a
												option(value="dni") DNI espa&ntilde;ol (incl.letra)
												option(value="carnet") Carn&eacute; Nacional de Identidad
												option(value="pasaporte") Pasaporte
												option(value="tarjeta") Tarjeta Residente en Espa&ntilde;a
											p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
										.ibe_form__group
											button.ibe-button.ibe-button--red.ibe-button--block.ibe-button--smaller(type='button')!="Buscar"
