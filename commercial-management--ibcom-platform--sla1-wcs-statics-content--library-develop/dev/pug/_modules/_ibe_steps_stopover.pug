mixin m-ibe-steps-stopover()
	div.ibe-box-work.ibe-box-work--margin.ibe-steps-stopover
		.ibe-box-work__header
			.ibe-box-work__title--45.ibe-box-work__title--black!="¿Qu&eacute; es "
				span.ibe-box-work__title--45="Hola Madrid?"
			.ibe-box-work__subtitle.paragraph__regular--m-bottom-30
				span.ibe-box-work__subtitle--bold!="Stopover Hola Madrid "
				span!="es la parada en tu viaje que te permitirá visitar Madrid de la mano de Iberia. Te ofrecemos una serie de experiencias para conocer la capital durante los días que selecciones: eventos, gastronomía, transporte, turismo y mucho más. "
				p.ibe-box-work__subtitle--bold!="¿Quieres saber cómo funciona?"

		div.ibe-carousel(data-slick='steps')
			div.ibe-box-work__item
				figure.ibe-box-work__item-figure
					img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-1.png" alt="Selecciona número de vuelo")
				.ibe-box-work__item-text.ibe-box-work__item-text-regular
					div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
						p.ibe-box-work__item-number-regular!="1. "
						div
							p.title--grey.title--bold!="Busca un trayecto con parada en Madrid"
							p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Comprueba que tu ruta incluye la escala en Madrid."
			div.ibe-box-work__item
				figure.ibe-box-work__item-figure
					img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-2.png" alt="Selecciona fecha de tu vuelo")
				.ibe-box-work__item-text.ibe-box-work__item-text-regular
					div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
						p.ibe-box-work__item-number-regular!="2. "
						div
							p.title--grey.title--bold!="Selecciona el número de noches"
							p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Elige cuántas noches vas a estar en Madrid. Puedes escoger hasta 6."
			div.ibe-box-work__item
				figure.ibe-box-work__item-figure
					img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-3.png" alt="Selecciona tipo de cabina")
				.ibe-box-work__item-text.ibe-box-work__item-text-regular
					div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
						p.ibe-box-work__item-number-regular!="3. "
						div
							p.title--grey.title--bold!="Elige un vuelo y haz tu reserva"
							p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Reserva tu billete. Podrás hacer tu parada en Madrid a la ida o a la vuelta de tu viaje."		
			div.ibe-box-work__item
				figure.ibe-box-work__item-figure
					img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-3.png" alt="Selecciona tipo de cabina")
				.ibe-box-work__item-text.ibe-box-work__item-text-regular
					div.ibe-box-work__item-title.ibe-box-work__item-title--font-20.ibe-box-work__item-title--m-t-16.ibe-flex
						p.ibe-box-work__item-number-regular!="4. "
						div
							p.title--grey.title--bold!="Aprovecha nuestras ofertas exclusivas"
							p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Conseguirás acceso a regalos, descuentos y experiencias vip. ¡Sólo por ser cliente!"		

