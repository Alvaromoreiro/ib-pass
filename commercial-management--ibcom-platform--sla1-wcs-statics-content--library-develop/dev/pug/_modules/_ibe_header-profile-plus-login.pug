										//- 	p.ibe-header-new__logged-txt.hidden-xs.hidden-sm.hidden-md!="Autorizador"
										//- else if(params.zero=== false)
										//- 	p.ibe-header-new__logged-txt.hidden-xs.hidden-sm.hidden-md!="123.739&nbsp;"
