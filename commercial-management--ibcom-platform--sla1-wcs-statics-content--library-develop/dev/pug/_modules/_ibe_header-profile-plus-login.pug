												span.hideAccessible Cerrar
										form.ibe_form(method="post", action="#ni", data-valid-form)
											fieldset.ibe-form__fieldset
												legend.ibe-login__title.hidden-lg.hidden-xl Acceso a Iberia Plus
												p.ibe-login__text.hidden-lg.hidden-xl Inicia sesi&oacute;n para ver promociones exclusivas y utilizar tus Avios
												div(class="ibe_form__group no_marginTop")
													input(class="ibe_form__input-text", name="id_number2", id="id_number2", type="text", placeholder="N&uacute;mero de Iberia Plus", required, data-validator="ibePlus" )
