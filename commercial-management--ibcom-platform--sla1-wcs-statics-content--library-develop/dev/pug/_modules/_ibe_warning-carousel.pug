mixin m-warning-carousel(params)
	div.ibe-carousel--warnings
		h4.title__h4.sr-only!=params.title
		div.container
			div.row
				div.col-xs-12
					div.ibe-carousel(data-slick='warnings' data-slick-params='{"arrows":true,"dots":false,"infinite": false}')
						div.ibe-carousel--warnings__slide
							div.ibe-carousel--warnings__slide-col
								span.ibe-carousel--warnings__icon.hidden-sm.hidden-xs.icon-alertas_2
								p.ibe-text.ibe-carousel--warnings__text
									span.ibe-carousel--warnings__title!="COVID19."
									a.ibe-link.ibe-link__carousel(href="#", title="Consulta las restricciones y normativas de los países antes de comenzar tu viaje.")!="Consulta las restricciones y normativas de los países antes de comenzar tu viaje."
							div.ibe-carousel--warnings__slide-col.hidden-xs
								span.ibe-carousel--warnings__indicator!="1"
								span.ibe-carousel--warnings__indicator-separator!="/"
								span.ibe-carousel--warnings__indicator!="2"
						div.ibe-carousel--warnings__slide
							div.ibe-carousel--warnings__slide-col
								span.ibe-carousel--warnings__icon.hidden-sm.hidden-xs.icon-alertas_2
								p.ibe-text.ibe-carousel--warnings__text
									span.ibe-carousel--warnings__title!="SIN COVID19"
									span!="Texto 2"
							div.ibe-carousel--warnings__slide-col.hidden-xs
								span.ibe-carousel--warnings__indicator!="2"
								span.ibe-carousel--warnings__indicator-separator!="/"
								span.ibe-carousel--warnings__indicator!="2"
