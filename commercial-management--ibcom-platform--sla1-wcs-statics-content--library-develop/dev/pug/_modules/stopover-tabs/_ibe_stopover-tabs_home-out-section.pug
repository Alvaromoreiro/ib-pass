mixin m-stopover-tabs_home-out-section()
	div(id="home-out-section")
			div.container.ibe-stopover-tabs-container
				+m-ibe-stopover-tabs_experience-grid({
					"filter" : false,
					"slider" : true
				})

			+m-ibe-stopover-tabs_home-discover()
			+m-ibe-stopover-tabs_home-carousel-wall-images()
			div.container.ibe-stopover-tabs-container
				+m-ibe-stopover-tabs_recommendation-card({
					"single" : false
				})
				+m-ibe-stopover-tabs_partners()
				+m-ibe-stopover-tabs_home-email()
			+m-ibe-stopover-tabs_top-banner({
				"type" : "actionButtonHome",
			})