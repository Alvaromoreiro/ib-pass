mixin m-ibe-stopover-tabs_home-discover()
	div.ibe-static-banner.ibe-static-banner--m-t.ibe-static-banner--bg-position(style="background-image: url('images/modules/stopover/bg-home-descubre.jpg')")
		div.container
			div.row
				div.col-xs-12
					div.ibe-static-banner__content
						div.ibe-static-banner__title-section
							p.ibe-static-banner__title  Descubre la magia de Madrid 
							p.ibe-static-banner__subtitle Este Stopover no es una escala: es una oportunidad para vivir la ciudad.
						ul.row
							li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature
								img(src=globals.imgPath + "/modules/icons/Subtracticon_ocio.png" alt="oferta cultural", class="ibe-static-banner__feature-img")
								div.ibe-flex__column.ibe-flex--align-start
									p.ibe-static-banner__feature-title Oferta cultural
									p.ibe-static-banner__feature-description Disfruta de la amplia oferta de eventos culturales de Madrid
							li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature
								img(src=globals.imgPath + "/modules/icons/Subtracticon_food.png" alt="oferta gastronomica", class="ibe-static-banner__feature-img")
								div.ibe-flex__column.ibe-flex--align-start
									p.ibe-static-banner__feature-title Gastronomía
									p.ibe-static-banner__feature-description Descubre los mejores restaurantes al mejor precio
							li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature
								img(src=globals.imgPath + "/modules/icons/Subtracticon_shopping.png" alt="compras y ocio", class="ibe-static-banner__feature-img")
								div.ibe-flex__column.ibe-flex--align-start
									p.ibe-static-banner__feature-title Compras y ocio
									p.ibe-static-banner__feature-description Encuentra las primeras marcas a tu disposición
