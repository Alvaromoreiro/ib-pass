mixin m-stopover-tabs_experiences-out-section()
    div.ibe-stopover-tabs--experiences-filter-section.ibe-stopover-tabs--experiences-remove-section(id="experiences-out-section")
        +m-ibe-stopover-tabs_experience-grid({
            "filter" : false,
            "slider" : false
        })
        +m-ibe-stopover-tabs_recommendation-card({
            "single" : true
        })
        +m-ibe-stopover-tabs_partners()
        +m-ibe-stopover-tabs_top-banner({
            "type" : "actionButton",
            "classBanner" : "ibe-static-banner__stopover"
        })