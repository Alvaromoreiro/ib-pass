                                button.ibe-avios-simulator-banner__button.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container.icon-play.ibe-stopover-tabs-banner-video-button-icon.ibe-stopover-tabs-banner-video-button(onclick="openStopoverModal()")
                                    span.ibe-stopover-tabs-banner-video-button-text Cómo reservar tu Stopover
                                script.
                                    function openStopoverModal() {
                                        let videoModal = document.getElementById("stopover-video-modal");
                                        videoModal.classList.add('ibe-stopover-tabs-banner-modal-video');
                                        videoModal.classList.remove('ibe-stopover-tabs-banner-modal-video-hidden');									
                                        }
