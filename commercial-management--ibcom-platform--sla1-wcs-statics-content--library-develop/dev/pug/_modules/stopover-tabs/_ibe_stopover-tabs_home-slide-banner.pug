mixin m-ibe-stopover-tabs_home-slide-banner()
    div.ibe-search-flights__cover.ibe-search-flights__cover--no-search.ibe-search-flights__cover--carousel.ibe-stopover-tabs_home-slide-banner
        button(type="button" class="slick-prev slick-arrow")
            span.hideAccessible Anterior
        button(type="button" class="slick-next slick-arrow")
            span.hideAccessible Siguiente
        div.slick-full-window(data-slick="full-window")
            
            div
                div.ibe-stopover-tabs-banner.ibe-stopover-tabs-banner-img1
                    div.ibe-stopover-tabs-banner__img-container
                        img(src="../../images/modules/stopover/img-home-header-rotate.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--top")
                        img(src="../../images/modules/stopover/img-home-header-ilustracion-madrid.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--bottom")
            div
                div.ibe-stopover-tabs-banner-nostop.ibe-stopover-tabs-banner-img2
            div
                div.ibe-stopover-tabs-banner-nostop.ibe-stopover-tabs-banner-img3
            div
                div.ibe-stopover-tabs-banner-nostop.ibe-stopover-tabs-banner-img4
            
        div.slick-menu(data-slick="full-window-menu")
            div
                a(href="#" title="home" data-focusin)
                    div.row
                        div.ibe-stopover-tabs-container-margin
                            div.col-xs-12.ibe-stopover-tabs-banner__content
                                figure.ibe-stopover-tabs-banner__logo
                                    img(src="images/modules/stopover-tabs/logo_stopover2.png", alt="")
                                div.ibe-stopover-tabs-banner__info-section
                                    h2.ibe-stopover-tabs-banner__title!="Descubre la ciudad sin coste adicional en tu vuelo"
                                    div.ibe-stopover-tabs-banner__subtitle!="Si vas a viajar, aprovecha y haz una parada en Madrid. Disfruta de promociones y descuentos en todo tipo de experiencias sin pagar más por tu billete."
