mixin m-accordion(params)
    div.ibe-accordion
        div
            h4.title__h4.ibe-accordion__header(data-toggle="accordion", data-target=params.target, data-outer-click="true")
                a.link(href=params.title.href, title=params.title.title)!=params.title.text
            div.ibe-accordion__collapse(id=params.id data-toggle="container")
                p.paragraph.paragraph__regular!=params.collapse
