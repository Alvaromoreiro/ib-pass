mixin m-vid-banner(params)
	a.ibe-vid-banner(href="#", title=params.title data-modal="button" data-modal-view=params.modal)
		figure.ibe-vid-banner__fig
			img.ibe-vid-banner__img(src=globals.imgPath + params.img alt=params.title)
		if (params.text)
			span.ibe-vid-banner__text(class=params.textClass)!=params.text
