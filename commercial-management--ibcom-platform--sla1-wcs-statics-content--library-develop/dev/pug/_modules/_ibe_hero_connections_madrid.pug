mixin m-hero-madrid()
  header.ibe-connections-hero(data-image='madrid')
    div.ibe-connections-hero__container
      h1.ibe-connections-hero__container-title Conexiones en la terminal 4 de Madrid
      p.ibe-connections-hero__container-description.ibe-connections-hero__container-description-madrid Planifica tu conexión en el edificio T4 y T4 Satélite (T4S).
      
