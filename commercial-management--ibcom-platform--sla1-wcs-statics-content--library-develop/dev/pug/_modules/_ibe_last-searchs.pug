mixin m-last-searchs(params)
	div.ibe-last-searchs
		button.ibe-last-searchs__trigger(title=params.title data-toggle="collapse" data-target=params.id)
			span.ibe-last-searchs__trigger-icon.icon-flexibilidad-icon
			span.ibe-last-searchs__trigger-text()!="Últimas búsquedas"
		div.ibe-last-searchs__container(id="last-searchs-1" data-toggle="container" class="" data-close="outsideclick", data-keyboard-close="esc")
			div.ibe-last-searchs__container-box
				h3.ibe-last-searchs__title!=params.title
				button.ibe-last-searchs__button-close(data-toggle="collapse" data-target=params.id)
					span.sr-only!="Cerrar"
					span.icon-cerrar
				ul.ibe-last-searchs__list
					li.ibe-last-searchs__list-item.ibe-last-searchs__info
						span.ibe-last-searchs__info-travel
							span.ibe-last-searchs__info-travel-city Madrid (MAD)
							span.ibe-last-searchs__info-travel-city Santiago de compostela (SQC)
						span.ibe-last-searchs__info-dates
							span.ibe-last-searchs__info-dates-gone 31/03/21
							span.ibe-last-searchs__info-dates-return 14/04/21
						span.ibe-last-searchs__info.ibe-last-searchs__info-passengers
							span.icon-persona
							span.ibe-last-searchs__info-passengers-account x4
					li.ibe-last-searchs__list-item
						span.ibe-last-searchs__info-travel
							span.ibe-last-searchs__info-travel-city Madrid (MAD)
							span.ibe-last-searchs__info-travel-city París (PAR)
						span.ibe-last-searchs__info.ibe-last-searchs__info-dates
							span.ibe-last-searchs__info-dates-gone 31/03/21
							span.ibe-last-searchs__info-dates-return 14/04/21
						span.ibe-last-searchs__info.ibe-last-searchs__info-passengers
							span.icon-persona
							span.ibe-last-searchs__info-passengers-account x4
					li.ibe-last-searchs__list-item
						span.ibe-last-searchs__info-travel
							span.ibe-last-searchs__info-travel-city Madrid (MAD)
							span.ibe-last-searchs__info-travel-city París (PAR)
						span.ibe-last-searchs__info.ibe-last-searchs__info-dates
							span.ibe-last-searchs__info-dates-gone 31/03/21
							span.ibe-last-searchs__info-dates-return 14/04/21
						span.ibe-last-searchs__info.ibe-last-searchs__info-passengers
							span.icon-persona
							span.ibe-last-searchs__info-passengers-account x4
				div.ibe-last-searchs__all
					a.ibe-last-searchs__all-link(class="link link__regular link__regular--important" href="#" title="Ver todas")!="Ver todas"
