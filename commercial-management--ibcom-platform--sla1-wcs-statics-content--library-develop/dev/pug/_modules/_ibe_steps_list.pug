mixin m-ibe-steps-list()
  section.container
    .row
      .col-xs-12
        .ibe-infocheckin__header
        section
        .ibe-box-work.ibe-box-work--margin
          .ibe-box-work__header
            .ibe-box-work__title--45.ibe-box-work__title--black!="¿Qu&eacute; es "
              span.ibe-box-work__title--45="Hola Madrid?"
            .ibe-box-work__subtitle.ibe-box-work__subtitle--bold.paragraph__regular--m-bottom-30!="Stopover Hola Madrid "
              span.ibe-box-work__subtitle!="es la parada en tu viaje que te permitirá visitar Madrid de la mano de Iberia. Te ofrecemos una serie de experiencias para conocer la capital durante los días que selecciones: eventos, gastronomía, transporte, turismo y mucho más. "
              span.ibe-box-work__subtitle.ibe-box-work__subtitle--bold!="¿Quieres saber cómo funciona?"
          .ibe-box-work__body
            ul.ibe-box-work__list
              li.ibe-box-work__item
                figure.ibe-box-work__item-figure
                  img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-1.png" alt="Selecciona número de vuelo")
                .ibe-box-work__item-text
                  p.ibe-box-work__item-title.ibe-box-work__item-title--font-20 
                    span.ibe-box-work__item-number!="1. "
                    !="Busca un trayecto con parada en Madrid"
                  p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Comprueba que tu ruta incluye la escala en Madrid."
              li.ibe-box-work__item
                figure.ibe-box-work__item-figure
                  img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-2.png" alt="Selecciona fecha de tu vuelo")
                .ibe-box-work__item-text
                  p.ibe-box-work__item-title.ibe-box-work__item-title--font-20
                    span.ibe-box-work__item-number!="2. "
                    !="Selecciona el número de noches"
                  p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Elige cuántas noches vas a estar en Madrid. Puedes escoger hasta 6."
              li.ibe-box-work__item
                figure.ibe-box-work__item-figure
                  img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-3.png" alt="Selecciona tipo de cabina")
                .ibe-box-work__item-text
                  p.ibe-box-work__item-title.ibe-box-work__item-title--font-20
                    span.ibe-box-work__item-number!="3. "
                    !="Elige un vuelo y haz tu reserva"
                  p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Reserva tu billete. Podrás hacer tu parada en Madrid a la ida o a la vuelta de tu viaje."		
              li.ibe-box-work__item
                figure.ibe-box-work__item-figure
                  img.ibe-box-work__item-img(src=globals.imgPath + "/modules/ibe-box-work/paso-3.png" alt="Selecciona tipo de cabina")
                .ibe-box-work__item-text
                  p.ibe-box-work__item-title.ibe-box-work__item-title--font-20
                    span.ibe-box-work__item-number!="4. "
                    !="Aprovecha nuestras ofertas exclusivas"
                  p.ibe-box-work__item-description.ibe-box-work__item-description--grey!="Conseguirás acceso a regalos, descuentos y experiencias vip. ¡Sólo por ser cliente!"		
