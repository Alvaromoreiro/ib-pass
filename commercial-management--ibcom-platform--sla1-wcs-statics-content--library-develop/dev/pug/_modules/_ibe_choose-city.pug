							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="E" data-filter-letter="E")!="E"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="F" data-filter-letter="F")!="F"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="G" data-filter-letter="G")!="G"
							li.ibe-filter-letter__menu-item
