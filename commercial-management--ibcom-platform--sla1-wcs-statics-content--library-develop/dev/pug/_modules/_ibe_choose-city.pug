							div.ioslist(data-function="city-list")
						div(id=params.tab_3.href data-tab-cities="mobile")
							div.ioslist(data-function="city-list")
						div(id=params.tab_4.href data-tab-cities="mobile")
							div.ioslist(data-function="city-list")
						div(id=params.tab_5.href data-tab-cities="mobile")
							div.ioslist(data-function="city-list")
