mixin m-choose-city(params)
	if (params.format === "desktop")
		div.ibe-choose-city(id=params.id, class=params.class, data-choose-city=params.dataType, data-toggle="container", data-city-list="collapse", data-collapse="hide-resize", data-keyboard-close="esc", data-close="outsideclick")
			div.ibe-tab(data-tab="jquery-ui")
				ul.ibe-tab__menu
					if (params.tab_1 !== undefined)
						li.ibe-tab__menu-item
							a.link.link__regular(href="#" + params.tab_1.href, title=params.tab_1.title)!=params.tab_1.name
						li.ibe-tab__menu-item
							a.link.link__regular(href="#" + params.tab_2.href, title=params.tab_2.title)!=params.tab_2.name
						li.ibe-tab__menu-item
							a.link.link__regular(href="#" + params.tab_3.href, title=params.tab_3.title)!=params.tab_3.name
						li.ibe-tab__menu-item
							a.link.link__regular(href="#" + params.tab_4.href, title=params.tab_4.title)!=params.tab_4.name
						li.ibe-tab__menu-item
							a.link.link__regular(href="#" + params.tab_5.href, title=params.tab_5.title)!=params.tab_5.name
				div.ibe-tab__container(data-cities-list)
					div.ibe-filter-letter__header
						ul.ibe-filter-letter__menu
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="Todos" data-filter-letter="all")!="Todos"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="A" data-filter-letter="A")!="A"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="B" data-filter-letter="B")!="B"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="C" data-filter-letter="C")!="C"
