							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="J" data-filter-letter="J")!="J"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="K" data-filter-letter="K")!="K"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="L" data-filter-letter="L")!="L"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="M" data-filter-letter="M")!="M"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="N" data-filter-letter="N")!="N"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="Ñ" data-filter-letter="Ñ")!="Ñ"
