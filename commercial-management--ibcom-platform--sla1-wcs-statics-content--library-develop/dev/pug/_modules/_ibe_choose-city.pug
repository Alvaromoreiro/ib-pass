								a.link.link__regular(href="#" title="Z" data-filter-letter="Z")!="Z"
					if (params.tab_1 !== undefined)
						div(id=params.tab_1.href data-tab-cities="desktop")
							+m-filter-letter-new()
						div(id=params.tab_2.href data-tab-cities="desktop")
							+m-filter-letter-new()
						div(id=params.tab_3.href data-tab-cities="desktop")
							+m-filter-letter-new()
						div(id=params.tab_4.href data-tab-cities="desktop")
							+m-filter-letter-new()
						div(id=params.tab_5.href data-tab-cities="desktop")
							+m-filter-letter-new()
	else
		div.ibe-choose-city.ibe-choose-city--mobile(class=params.class, id=params.id, data-toggle="container", data-city-list="collapse", data-collapse="hide-resize", data-close=(params.dataClose != undefined ? "outsideclick" : ""))
			div.ibe-tab(data-tab="jquery-ui")
				header.ibe-tab__scroll
					ul.ibe-tab__menu
						if (params.tab_1 !== undefined)
							li.ibe-tab__menu-item
								a.link.link__regular(href="#" + params.tab_1.href, title=params.tab_1.title)!=params.tab_1.name
							li.ibe-tab__menu-item
