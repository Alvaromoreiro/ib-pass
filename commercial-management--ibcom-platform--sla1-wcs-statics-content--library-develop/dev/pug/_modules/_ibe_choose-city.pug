							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="R" data-filter-letter="R")!="R"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="S" data-filter-letter="S")!="S"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="T" data-filter-letter="T")!="T"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="U" data-filter-letter="U")!="U"
							li.ibe-filter-letter__menu-item
								a.link.link__regular(href="#" title="V" data-filter-letter="V")!="V"
