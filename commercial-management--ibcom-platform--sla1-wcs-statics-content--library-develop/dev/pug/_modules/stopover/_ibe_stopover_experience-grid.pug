											li.ibe-filter__main-item
												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="Transporte" name="Transporte" value="Transporte" data-info="Transporte" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="Transporte") Transporte
											li.ibe-filter__main-item
