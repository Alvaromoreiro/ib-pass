												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="Otros" name="Otros" value="Otros" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="Otros") Otros									
