mixin m-ibe-stopover_experience-grid(params)
		if(params.filter)
			section(data-function="filter-stopoverpartner")
				div.container
					div.row
						div.col-xs-12
							section.ibe-box-work--mt
								header.ibe-infocheckin__header
									h1.title--stopover
										span.title--red.title--bold Experiencias y planes 
										span en Madrid
							form.ibe_form
								fieldset.ibe_form__fieldset
									div.ibe-one-option.ibe-one-option--stopover
										ul.ibe-one-option__list
											li.ibe-one-option__list-item
												a(href="#" title="TODOS" data-show-hide="hide" data-info="avoidCheckbox" data-show-hide-target="#filter" aria-expanded="true" class="ibe-one-option__list-item__text ibe-one-option__list-item__text--fs-18") TODOS
											li.ibe-one-option__list-item.active
												a(href="#" title="FILTRAR" data-show-hide="show" data-info="activeCheckbox" data-show-hide-target="#filter" aria-expanded="true" class="ibe-one-option__list-item__text ibe-one-option__list-item__text--fs-18") FILTRAR
							
									div.ibe-filter(id="filter")
										ul.ibe-filter__main
											li.ibe-filter__main-item
												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="filter-Alojamiento" name="filter-Alojamiento" value="Alojamiento" data-info="Alojamiento" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="filter-Alojamiento") Alojamiento
											li.ibe-filter__main-item
												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="Museos" name="Museos" value="Museos" data-info="Museos" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="Museos") Museos
											li.ibe-filter__main-item
												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="Ocio" name="Ocio" value="Ocio" data-info="Ocio" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="Ocio") Ocio
											li.ibe-filter__main-item
												input.ibe-filter__check.ibe-filter__check--dark(type="checkbox" id="Gastronomía" name="Gastronomía" value="Gastronomía" data-info="Gastronomía" checked)
												label.ibe-filter__label.ibe-filter__label--dark.ibe-filter__label--fs-13(for="Gastronomía") Gastronomía
											li.ibe-filter__main-item
