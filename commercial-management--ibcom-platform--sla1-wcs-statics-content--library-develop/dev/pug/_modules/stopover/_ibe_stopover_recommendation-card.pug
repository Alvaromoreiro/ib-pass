mixin m-ibe-stopover_recommendation-card(params)
   div.container
        h3.title--stopover.title--stopover-separation ¿Necesitas
            span.title--red.title--bold  recomendación
            span  para tus planes?
        div.row
            if (!params.single)
                div.col-xs-12.col-md-6.ibe-flights-plus-hotel__stopover
                    +m-card-link({
                        "isLink": false,
                        "promo": true,
                        "flex": true,
                        "cssClass": "ibe-card-link--stopover",
                        "pClass": "ibe-ellipsis-4",
                        "mainClass": "md",
                        "title": {
                            "name": "Qué hacer en Madrid",
                        },
                        "image": {
                            "src": "/modules/stopover/img-adrian_Cano.png",
                            "alt": "Planes recomendados"
                        },
                        "logo": {
                            "bool": false
                        },
                        "description": {
                                "text": "¿No tienes claro qué planes son los mejores para aprovechar tu estancia en la capital? Te recomendamos la combinación de planes perfecta para aventureros como tú."
                            },
                        "buttonText": "Ver planes recomendados",
                        "highlight": false,
                    })
                div.ibe-card-link--stopover-card-type-2.col-xs-12.col-md-6.ibe-flights-plus-hotel__stopover
                    +m-card-link({
                        "isLink": false,
                        "promo": true,
                        "flex": true,
                        "cssClass": "ibe-card-link--stopover",
                        "pClass": "ibe-ellipsis-4",
                        "mainClass": "md",
                        "title": {
                            "name": "¿A&uacute;n tienes dudas?",
                        },
                        "image": {
                            "src": "/modules/stopover/img-dudas-faqs-col1.jpg",
                            "alt": "Preguntas frecuentes"
                        },
                        "logo": {
                            "bool": false
                        },
                        "description": {
                                "text": "Si todavía no tienes claro como funciona Stopover Hola Madrid o necesitas más información. Visita nuestra sección de preguntas frecuentes."
                            },
                        "buttonText": "Ver preguntas frecuentes",
                        "highlight": false,
                    })
            if (params.single)
                div.col-lg-12.col-xl-12
                        +m-card-link({
                            "isLink": false,
                            "promo": true,
                            "flex": true,
                            "cssClass": "ibe-card-link--stopover-faqs",
                            "autoHeight": "",
                            "title": {
                                "name": "¿A&uacute;n tienes dudas?",
                            },
                            "image": {
                                "src": "/modules/stopover/img-dudas-faqs-col1.jpg",
                                "alt": "Preguntas frecuentes"
                            },
                            "logo": {
                                "bool": false
                            },
                            "description": {
                                    "text": "Si todavía no tienes claro como funciona Stopover Hola Madrid o necesitas más información. Visita nuestra sección de preguntas frecuentes."
                                },
                            "buttonText": "Ver preguntas frecuentes",
                            "highlight": false,
                        })