

mixin m-ibe-stopover_top-banner(params)
        if (params.type === "empty")
            div.ibe-static-banner.ibe-exp-file--banner-img(data-background=params.dataBackground)
        if (params.type === "home")
            div.ibe-banner-stopover(data-background=params.dataBackground)
                div.ibe-banner-stopover__img-container
                    img(src="../../images/modules/stopover/img-home-header-rotate.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--top")
                    img(src="../../images/modules/stopover/img-home-header-ilustracion-madrid.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--bottom")
                div.ibe-banner-stopover__container
                    .container
                        .row
                            .col-xs-12
                                figure.ibe-banner-stopover__logo
                                    img(src="images/modules/stopover/logo_stopover.png", alt="")
                                h2.ibe-banner-stopover__title!="Aprovecha tu escala descubriendo Madrid"
                                div.ibe-banner-stopover__subtitle!="¿Tu vuelo tiene una escala en Madrid? Te ofrecemos una serie de planes y descuentos exclusivos para que disfrutes al máximo la capital. "
                                    span.bold="Elige tu trayecto"
        if (params.type === "action")
            div.ibe-static-banner.ibe-static-banner--discover.ibe-stopover-banner--expfile-img(data-background=params.dataBackground, class=params.classBanner)
                div.container
                        div.row
                            div.col-xs-12
                                div.ibe-static-banner__title-section--no-margin.ibe-static-banner__title-section--discover
                                    p.ibe-static-banner__title!="¿Te apetece conocer Madrid?"
                                    p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-22!="No dudes en reservar tu StopOver ahora"
                                div.ibe-static-banner__title-section--searcher
        if (params.type === "actionButton")
            div.ibe-static-banner.ibe-static-banner--m-t(data-background='images/modules/stopover/img-call-to-action-conocer-madrid' class=params.classBanner)
                div.row
                    div.col-xs-12
                        div.ibe-static-banner__title-section--no-margin.ibe-static-banner__stopover--text
                            p.ibe-static-banner__title ¿Te apetece conocer Madrid? 
                            p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-22 No dudes en reservar tu Stopover ahora
                                a.ibe-button.ibe-button--red.ibe-button--large-3.pull-center.u-mt-medium.ibe-button--iberia-headline.ibe-button--fs-20 Quiero hacer Stopover
        if (params.type === "actionButtonHome")
            div.ibe-static-banner.ibe-static-banner--m-t(data-background='images/modules/stopover/img-call-to-action-conocer-madrid' class=params.classBanner)
                div.row
                    div.col-xs-12
                            div.ibe-static-banner__content--middle
                                div.ibe-static-banner__title-section--no-margin
                                    p.ibe-static-banner__title ¿Te apetece conocer Madrid?
                                    p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-22 No dudes en reservar tu Stopover ahora
                                        a.fc-searcher-detector.ibe-button.ibe-button--red.ibe-button--large-3.pull-center.u-mt-medium.ibe-button--iberia-headline.ibe-button--fs-20(href="#StopOver" id="doStopOver") Quiero hacer Stopover
        
        if (params.type === "text")
            div.ibe-static-banner.ibe-static-banner--left.ibe-static-banner--experiences.ibe-static-banner--bg-position-2(data-background=params.dataBackground)
                div.container
                    div.row
                        div.col-xs-12.col-lg-6
                            div.ibe-static-banner__title-section--no-margin
                                p.ibe-static-banner__title Vive Madrid desde dentro conociendo los mejores planes
                                p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-24 Pasea por sus calles, visita los barrios más emblemáticos y disfruta de las mejores ofertas de ocio y actividades para disfrutar en Madrid
        
        if (params.isSearcher)
            div.container
                div.row
                    div.col-xs-12(class=params.classSearcher)
                        +m-search-collapse({stopover: true})
                        if (params.infoBanner)
                            +m-ibe-steps-stopover()
