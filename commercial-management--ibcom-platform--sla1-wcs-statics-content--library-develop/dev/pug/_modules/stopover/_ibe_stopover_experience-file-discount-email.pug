mixin m-ibe-stopover-experience-file-discount(params)
        div.row(id="st-experience-file")
            div.ibe-exp-file__container
                div.ibe-box-work.ibe-exp-file
                    div.ibe-flex.ibe-flex--space-between.ibe-exp-file__header
                        div.ibe-card-guides__footer--icon.ibe-exp-file__arrow-container
                            span.ibe-card-guides__footer-arrow.ibe-exp-file--arrow
                            a.link.link__regular.link__regular--important(href="#" title="Ver ficha")!="Volver a experiencias"
                        if(params.recommend)
                            div.rectangle-label-event.rectangle-label-event--stopover.rectangle-label-event--stopover-2.positionI.u-mt-small-sm.u-mt-small-xs
                                div.text-label-event__icon.text-label-event__icon--medium
                                    p.text-label-event.text-label-event--stopover-2.u-text-left!="Recomendado"
                        if(params.ibplus)
                            div.rectangle-label-event.rectangle-label-event--stopover-ibplus.rectangle-label-event--stopover-2.positionI.u-mt-small-sm.u-mt-small-xs
                                div.text-label-event__icon-ibplus.text-label-event__icon--medium
                                    p.text-label-event.text-label-event--stopover-2.u-text-left.text-label-event--stopover-ibplus!="Iberia Plus"
                    div.ibe-exp-file__title!="Museo Nacional Thyssen-Bornemisza"
                    div.ibe-exp-file__tags-container
                        span.ibe-card-guides__theme.ibe-card-guides__theme--pin.ibe-exp-file--pin!="Museos"                        
                    div.ibe-flex.ibe-flex--space-between.u-mt-xmedium.ibe-exp-file__info-container
                        div.ibe-flex.ibe-flex__column.col-lg-8.col-md-12.col-sm-12.col-xs-12.no_padding
                            div.ibe-exp-file--subtitle
                                span!="Disfruta del Thyssen con Stopover Hola Madrid. Te llevarás un "
                                span.ibe-box-work__subtitle--bold!="10% de descuento en la entrada; 10 % en tu audioguia"
                                span!=", y sin esperas. ¡Así se disfruta más el arte!"

                                p!="Paséate por el arte del siglo XIII al XX. Descubrirás cerca de mil obras, incluyendo exclusivas colecciones que no podrás ver en ningún otro lugar. Accesible, dinámico y abierto a todos; visita su colección permanente y sus exposiciones temporales, actividades didácticas, cursos, concursos, conciertos, talleres, cine, teatro… Un sinfín de propuestas para un sinfín de públicos."
                          

                            div.ibe-flex__row.ibe-flex--align-strech.u-mt-smedium.ibe-exp-file__column-mobile.ibe-exp-file__column-mobile--gap-32
                                div.ibe-flex.ibe-flex--space-between.ibe-flex__column
                                    div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
                                        span.ibe-card-guides__offer-icon.icon.icon-reloj
                                        p.bold.ibe-card-guides__offer-text-bigger!="Duración estimada"
                                    span.ibe-exp-file--info.u-mt-small!="48h"
                                div.ibe-flex.ibe-flex--space-between.ibe-flex__column
                                    div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
                                        img.ibe-card-guides__offer-icon(src="../images/content/icono_estrella_roja.png")
                                        p.bold.ibe-card-guides__offer-text-bigger!="Promoción"
                                    span.ibe-exp-file--info.u-mt-small!="Transporte gratuito durante 2 días"
                                div.ibe-flex.ibe-flex--space-between.ibe-flex__column
                                    div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
                                        img.ibe-card-guides__offer-icon(src="../images/content/euro.png")
                                        p.bold.ibe-card-guides__offer-text-bigger!="Precio"
                                    span.ibe-exp-file--info.u-mt-small!="Gratuito"

                        //- CAJA CODIGO DESCUENTO EMAIL
                        div.ibe-exp-file__info-container__details
                            div.ibe-exp-file--box.ibe-exp-file--box-email.title--center
                                div.ibe-exp-file--box-circle!="%"
                                p.title__h5.title__h5--20.ibe-font-color-primary!="Cómo obtener tu descuento"
                                p.paragraph.paragraph__info-flight.ibe-exp-file--box-text!="Envía un e-mail y solicitalo"
                                div.ibe-exp-file--box-border.u-mt-small
                                    h1.title--red.ibe-exp-file--box-code-email(title="customerservice@galeriacsegsegseganalejas.com")!="customerservice@galeriacegsegsegsganalejas.com"
                                    span.paragraph.paragraph__info-flight.ibe-exp-file--box-text.ibe-exp-file--box-text--italic.ibe-exp-file--box-text--secondary!="Copiar código"
                                div.u-mt-small
                                    a.link.link__regular--important.ibe-exp-file--box-link.ibe-exp-file__info-transport--text(href="#" title="Cómo aplico mi código de descuento")!="Cómo aplico mi código de descuento"
                            div.ibe-exp-file__button
                                a.ibe-button.ibe-button--red.ibe-button--large-4.ibe-button--iberia-headline.ibe-button--fs-20.ibe-button--w100-mobile!="Comprar entradas"