mixin m-ibe-stopover_experience-location()
    div.row(id="st-experience-location")
        div.col-xs-12
            section.ibe-box-work--mt
                header.ibe-location-header
                    h1.ibe-location-header__title!="Información de"
                        span.title--red.title--bold!=" contacto y localización"
                article.ibe-box-location
                    div.ibe-box-location__map
                        img(src=globals.imgPath + "/modules/stopover/Madrid-mapa.png", alt="mapa de Madrid")
                    div.ibe-box-location__info
                        div.ibe_form__group--flex-bonos.title--pad-bottom-24
                            a(href="#" class="ibe-cheap-flights__icon icon-senalizacion_mapas")
                            div
                                p.u-mb-xsmall.bold!="Localización"
                                a(href="#" class="link link__regular--black ibe-box-location__text")!="P.º del Prado, 8, 28014 Madrid"
                        div.ibe_form__group--flex-bonos.title--pad-bottom-24
                            a(href="#" class="ibe-cheap-flights__icon icon-inicio")
                            div
                                p.u-mb-xsmall.bold!="Web"
                                a(href="https://www.museothyssen.org" class="link link__regular--black ibe-box-location__extra-info")!="www.museothyssen.org"
                        div.ibe_form__group--flex-bonos.title--pad-bottom-24
                            a(href="#" class="ibe-cheap-flights__icon icon-ayuda_2")
                            div
                                p.u-mb-xsmall.bold!="Ayuda"
                                a(href="mailto:cavthyssen@museothyssen.org" class="link link__regular--black ibe-box-location__extra-info ibe-box-location__extra-info--email")!="cavthyssen@museothyssen.org"
                        div.ibe_form__group--flex-bonos.title--pad-bottom-24
                            a(href="#" class="ibe-cheap-flights__icon icon-movil")
                            div
                                p.u-mb-xsmall.bold!="Teléfono"
                                a(href="#" class="link link__regular--black ibe-box-location__extra-info")!="+ 34 917 911 370"