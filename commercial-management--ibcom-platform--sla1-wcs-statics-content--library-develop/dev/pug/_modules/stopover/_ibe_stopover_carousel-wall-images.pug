						a(href="#" title="Otros")
							figure.ibe-wall-articles__cont-img--gradient
								img(alt="Imagen 8" src=globals.imgPath + "/modules/stopover/img-home-categorias-otros.jpg")
								p.ibe-wall-articles__title--stopover.ibe-wall-articles__title--absolute Otros
			a.ibe-button.ibe-button--red.ibe-button--large-3.pull-center.u-mt-medium.ibe-button--iberia-headline.ibe-button--fs-20 Ver todas las categorías
		

