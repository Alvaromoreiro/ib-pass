mixin m-ibe-stopover_carousel-wall-images()
	div.container
		article.ibe-wall-articles--stopover
			h3.title--stopover Conoce los 
				span.title--red.title--bold mejores planes 
				span para tu parada en Madrid
			div.ibe-wall-carousel(data-slick='wall-slider')
				div
					div.ibe-wall-articles__container--stopover
						a(href="#" title="Alojamiento")
							figure.ibe-wall-articles__cont-img--gradient
								img(alt="Imagen 1" src=globals.imgPath + "/modules/stopover/img-home-categorias-alojamientos.jpg")
								p.ibe-wall-articles__title--stopover.ibe-wall-articles__title--absolute Alojamiento
				div
					div.ibe-wall-articles__container--stopover
						a(href="#" title="Museos")
							figure.ibe-wall-articles__cont-img--gradient
								img(alt="Imagen 2" src=globals.imgPath + "/modules/stopover/img-home-categorias-museos.jpg")
								p.ibe-wall-articles__title--stopover.ibe-wall-articles__title--absolute Museos
				div
					div.ibe-wall-articles__container--stopover
						a(href="#" title="Gastronomía")
							figure.ibe-wall-articles__cont-img--gradient
								img(alt="Imagen 3" src=globals.imgPath + "/modules/stopover/img-home-categorias-gastronomia.jpg")
								p.ibe-wall-articles__title--stopover.ibe-wall-articles__title--absolute Gastronomía
				div
					div.ibe-wall-articles__container--stopover
