mixin m-ibe-stopover_experience-gallery()
    div.row(id="st-experience-gallery")
        div.col-xs-12
            section.ibe-box-work--mt
                header.ibe-box-work__header
                    h1.title--stopover.title--stopover-pb!="Experiencia en "
                        span.title--red.title--bold!=" imágenes"
                article(data-box-gallery="true" data-images-show="3" data-images-show-mobile="1")
                    .ibe-gallery-carousel(data-gallery="experiences")
                        .ibe-gallery-carousel__main.ibe-gallery-carousel__main--flex
                            a.ibe-gallery-carousel__link.ibe-gallery-carousel__link--main(href="#" title="MUSEO THYSSEN" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                figure.ibe-gallery-carousel__figure
                                    img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/stopover/museo-thyssen.png" title="MUSEO THYSSEN" alt="Museo Thyssen")
                            ul.ibe-gallery-carousel__side
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/stopover/thyssen-redes-sociales.png" title="Lorem ipsum 2" alt="Airbus A330-200 lateral")
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/stopover/museo-interior.png" title="Lorem ipsum 3" alt="Airbus A330-200 lateral")
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/stopover/Museo-Thyssen-Exterior.png" title="Lorem ipsum 4" alt="Airbus A330-200 lateral")
                                        span(data-number="+ 5 Fotos").ibe-gallery-carousel__number N&uacute;mero de fotos adicionales
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/antes-de-viajar.png" title="Lorem ipsum 3" alt="Airbus A330-200 lateral")
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/antes-de-viajar2.png" title="Lorem ipsum 2" alt="Airbus A330-200 lateral")
                                li.ibe-gallery-carousel__row
                                    a.ibe-gallery-carousel__link(href="#" title="Airbus A330-200 lateral" data-modal="button" data-modal-view=".fc-image-gallery" data-gallery="experiences")
                                        figure.ibe-gallery-carousel__figure
                                            img.ibe-gallery-carousel__img(src=globals.imgPath + "/content/antes-de-viajar3.png" title="Lorem ipsum 2" alt="Airbus A330-200 lateral")
    div.ibe-dialog.ibe-image-gallery.fc-image-gallery
        div.modal-dialog
            div.modal-content
                div.ibe-image-gallery__container
                    div.ibe-image-gallery-slider.ibe-image-gallery-slider--stopover(data-slick="image-gallery")
                div.ibe-image-gallery__container-thumbs
                    div.ibe-image-gallery__container-legend
                        span.ibe-image-gallery__container-legend-current!="1"
                        span!="/"
                        span.ibe-image-gallery__container-legend-count!="12"
                        span.ibe-image-gallery__container-legend-text!="Museo Thyssen exposition"
                    div.ibe-image-gallery-slider.ibe-image-gallery-slider--thumbs.ibe-image-gallery-slider--stopover(data-slick="image-gallery-thumbs")
                button.ibe-button.ibe-button--close-modal(type="button" data-dialog="close")