mixin m-ibe-stopover_other-experiences()
	div.ibe-carousel-cards 
		div.ibe-box-work__header
			h3.title--stopover
				span.title--red.title--bold Otras experiencias 
				span que también te pueden gustar
			p.ibe-box-work__item-description.ibe-box-work__item-description--grey.ibe-box-work__item-description--centered
		article
			div.ibe-carousel(data-slick='cards-slider')
				div.col-lg-4.col-md-4.col-sm-12.col-xs-12.ibe-card
					+m-card-guides-type({
						"id": "1476391160540",
