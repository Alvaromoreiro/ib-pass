mixin m-ibe-stopover-experience-file-no-offer(params)
	div.row(id="st-experience-file-no-offer")
		div.ibe-exp-file__container
			div.ibe-box-work.ibe-exp-file
				div.ibe-flex.ibe-flex--space-between.ibe-exp-file__header
					div.ibe-card-guides__footer--icon.ibe-exp-file__arrow-container
						span.ibe-card-guides__footer-arrow.ibe-exp-file--arrow
						a.link.link__regular.link__regular--important(href="#" title="Ver ficha")!="Volver a experiencias"
					if(params.recommend)
						div.rectangle-label-event.rectangle-label-event--stopover.rectangle-label-event--stopover-2.positionI.u-mt-small-sm.u-mt-small-xs
							div.text-label-event__icon.text-label-event__icon--medium
								p.text-label-event.text-label-event--stopover-2.u-text-left!="Recomendado"
					if(params.ibplus)
						div.rectangle-label-event.rectangle-label-event--stopover-ibplus.rectangle-label-event--stopover-2.positionI.u-mt-small-sm.u-mt-small-xs
							div.text-label-event__icon-ibplus.text-label-event__icon--medium
								p.text-label-event.text-label-event--stopover-2.u-text-left.text-label-event--stopover-ibplus!="Iberia Plus"
				div.ibe-exp-file__title!="Tarjeta Transporte Pública"
				div.ibe-exp-file__tags-container
					span.ibe-card-guides__theme.ibe-card-guides__theme--pin.ibe-exp-file--pin!="Transporte"                        
				div.ibe-flex.ibe-flex--space-between.u-mt-xmedium.ibe-exp-file__info-container
					div.ibe-flex.ibe-flex__column.col-lg-12.col-md-12.col-sm-12.col-xs-12.no_padding
						div.ibe-exp-file--subtitle
							p!="Con la red de transporte público de Madrid podrás descubrir la capital de muchas maneras: metro, metro ligero, autobuses urbanos, interurbanos y autobuses de otros municipios."
							p.u-mt-smedium!= "Y ahora además podrás hacerlo gratis: Hola Madrid te regala una tarjeta turística gratis durante 2 días, y podrás recargarla pasado ese tiempo. No te quedes sin la tuya y sácale el máximo partido a Madrid…, con Hola Madrid."                                  
							p.u-mt-smedium!="La tarjeta turística gratuita se puede recoger en:"
								ul.ibe-list--circle__item
									li!="En el stand de Stopover Hola Madrid a tu llegada al aeropuerto de MAD  o en el mostrador de Atención al Cliente situados ambos en la Terminal 4 en la sala de recogida de equipajes en llegadas."
							p.u-mt-smedium!="La tarjeta se puede cargar en:"
								ul.ibe-list--circle__item
									li!="Máquinas automáticas instaladas en las Estaciones de Metro de Madrid."
									li!="Máquinas automáticas instaladas en las Estaciones de Metro Ligero (ML1, ML2 y ML3)."
									li!="Intercambiadores de Transportes."                                      
									li!="Máquinas automáticas instaladas en las Estaciones de Cercanías."                                      
									li!="Estancos y otros puntos de venta autorizados."                                      
							p.u-mt-smedium!="Tarifas una vez vencidos los 2 días de uso:"
							p.u-mt-smedium!="Esta tabla muestra información sobre Las tarifas de la tarjeta turística"
							div.ibe-flex__row.ibe-flex--space-evenly
								div.ibe-flex__column
									p!="1 día"
									p!="8,40€"
								div.ibe-flex__column
									p!="2 días"
									p!="14,20€"
								div.ibe-flex__column
									p!="3 días"
									p!="18,40€"
								div.ibe-flex__column
									p!="4 días"
									p!="22,60€"
								div.ibe-flex__column
									p!="5 días"
									p!="26,80€"
								div.ibe-flex__column
									p!="6 días"
									p!="35,40€"
							p.u-mt-smedium!="* Esta tarjeta tiene carácter personal y permite efectuar un número ilimitado de desplazamientos en el conjunto de servicios de transporte regular de viajeros que operan en el interior de la zona elegida, con las excepciones que se indiquen. Los niños menores de 11 años tienen un descuento del 50% en la adquisición del título Turístico."
						div.ibe-exp-file--subtitle-2.col-xl-6.col-lg-6.col-md-12.col-sm-12.col-xs-12.no_padding
							p.u-mt-smedium!="Disfruta de una visita libre a las exposiciones con una tapa gastronómica"
						div.ibe-flex__row.ibe-flex--align-strech.u-mt-smedium.ibe-exp-file__column-mobile.ibe-exp-file__column-mobile--gap-32
							div.ibe-flex.ibe-flex--space-between.ibe-flex__column
								div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
									span.ibe-card-guides__offer-icon.icon.icon-reloj
									p.bold.ibe-card-guides__offer-text-bigger!="Duración estimada"
								span.ibe-exp-file--info.u-mt-small!="48h"
							div.ibe-flex.ibe-flex--space-between.ibe-flex__column
								div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
									img.ibe-card-guides__offer-icon(src="../images/content/icono_estrella_roja.png")
									p.bold.ibe-card-guides__offer-text-bigger!="Promoción"
								span.ibe-exp-file--info.u-mt-small!="Transporte gratuito durante 2 días"
							div.ibe-flex.ibe-flex--space-between.ibe-flex__column
								div.ibe-flex.ibe-flex--align-center.title--red.paragraph--big
									img.ibe-card-guides__offer-icon(src="../images/content/euro.png")
									p.bold.ibe-card-guides__offer-text-bigger!="Precio"
								span.ibe-exp-file--info.u-mt-small!="Gratuito"
				div.ibe-exp-file__button.ibe-exp-file__button--bottom-section
					a.ibe-button.ibe-button--red.ibe-button--large-4.ibe-button--iberia-headline.ibe-button--fs-20.ibe-exp-file__button--bottom!="Comprar entradas"