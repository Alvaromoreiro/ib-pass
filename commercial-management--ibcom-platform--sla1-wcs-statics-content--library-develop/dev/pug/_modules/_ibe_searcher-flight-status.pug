mixin m-searcher-flight-status(params)
	form.ibe_form(data-valid-form action="#" method="post")
		fieldset.ibe-tab__container-desktop
			legend.hideAccessible!="Estado de vuelos"
			.ibe-searcher__row.ibe-searcher__row--no-padding.ibe-searcher__row--no-margin.ibe-searcher__row--flightstatus-routes
				.ibe-searcher__col.ibe-searcher__col--big
					div(class="ibe_form__group ibe_form__group--button-icon fc_form_group", data-hidden-button="true")
						label(class="ibe_form__input-label", for="flight_origin")!="Origen"
						input(class="ibe_form__input-text", name="flight_origin", id="flight_origin", type="text", placeholder="Origen", data-autocomplete="airports" spellcheck='false', value="Madrid (MAD)", data-destination-info="ES|MAD|Madrid", data-validate="input-origin", required )
						p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Debes elegir un origen")
						p.ibe_form__msg-info.hidden(data-validate="equal", data-validate-text="El origen no puede ser igual que el destino")
						div.hidden-xs.hidden-sm.hidden-md
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button" data-toggle="collapse" data-target="#id-tab-collapse-as00" data-close="outsideclick")
								span.hideAccessible(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades")!="Click para desplegar ciudades"
							+m-choose-city-new({
								"class": "ibe-choose-city--origin",
								"format": "desktop",
								"id": "id-tab-collapse-as00",
								"dataClose": true
							})
						div.hidden-lg.hidden-xl
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button" data-toggle="collapse" data-target="#m-id-tab-collapse-as00" data-close="outsideclick")
								span.hideAccessible(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades")!="Click para desplegar ciudades"
							+m-choose-city-new({
								"class": "ibe-choose-city--origin",
								"format": "responsive",
								"id": "m-id-tab-collapse-as00",
								"dataClose": true
							})

				.ibe-searcher__col.ibe-searcher__col--big
					div(class="ibe_form__group ibe_form__group--button-icon fc_form_group", data-hidden-button="true")
						label(class="ibe_form__input-label", for="flight_destiny")!="Destino"
						input(class="ibe_form__input-text", name="flight_destiny", id="flight_destiny", type="text", placeholder="Destino" data-autocomplete="airports" spellcheck='false', data-validate="input-destiny", required)
						p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Debes elegir un destino")
						p.ibe_form__msg-info.hidden(data-validate="equal", data-validate-text="El destino no puede ser igual que el origen")
						div.hidden-xs.hidden-sm.hidden-md
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button" data-toggle="collapse" data-target="#id-tab-collapse-as01" data-close="outsideclick")
								span.hideAccessible(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades")!="Click para desplegar ciudades"
							+m-choose-city-new({
								"class": "ibe-choose-city--destination",
								"format": "desktop",
								"id": "id-tab-collapse-as01",
								"dataClose": true
							})
						div.hidden-lg.hidden-xl
							button.ibe_form__input-button.ibe_form__input-button--medium.icon-senalizacion_mapas(type="button" data-toggle="collapse" data-target="#m-id-tab-collapse-as01" data-close="outsideclick")
								span.hideAccessible(data-toggle-status="true" data-status-open="Click para plegar ciudades" data-status-close="Click para desplegar ciudades")!="Click para desplegar ciudades"
							+m-choose-city-new({
								"class": "ibe-choose-city--destination",
								"format": "responsive",
								"dataClose": true,
								"id": "m-id-tab-collapse-as01"
							})
				.ibe-searcher__col.ibe-searcher__col--medium
					.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new(data-selectmenu_claim)
						label.ibe_form__selectize--label(for="airline")
							span.ibe_form__input-text Compañía Aérea
						select(id="airline", class="ibe-select ibe_form__input-text", name="airline", data-selectmenu,  required)
							option(value="") Compañia Aérea
							option(value="IB") Iberia
							option(value="I2") Iberia Express
							option(value="YW") Air nostrum
							option(value="BA") British Airways
						p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")

				.ibe-searcher__col.ibe-searcher__col--small
					.ibe_form__group.fc_form_group.ibe-datepicker-general
						label.ibe_form__input-label(for='form_calendar', autocomplete="off") Fecha
						input.ibe_form__input-text.pointer(name='form_calendar', id="form_calendar", autocomplete="off", type='text', placeholder='DD/MM/YYYY', data-format='DD/MM/YYYY', data-toggle='collapse', data-target='#calendar-form', data-cal='claim', data-placeholder='placeholder', data-close='outsideclick', data-validator='date', data-validator-range='range-custom', data-range-min="7", data-range-max="3", required)
						button.ibe_form__input-button.ibe_form__input-button--medium.icon.icon-calendario(type='button', data-toggle='collapse', data-target='#calendar-form', data-close='outsideclick')
							span.hideAccessible(data-toggle-status='true', data-status-open='Click para plegar calendario', data-status-close='Click para desplegar calendario') Click para desplegar calendario
						+m-searcher-calendar-simple({
							className: "ibe-searcher__calendar--start ibe-searcher__calendar--right ibe-searcher__calendar--claim",
							id: "calendar-form",
							number: "form-1",
							claims: true
						})
						p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
						p.ibe_form__msg-info.hidden(data-validate="valid", data-validate-text="El formato no es válido")
						p.ibe_form__msg-info.hidden(data-validate="range-min", data-validate-text="La fecha seleccionada no puede superar 7 dias antes de la actual")
						p.ibe_form__msg-info.hidden(data-validate="range-max", data-validate-text="La fecha seleccionada no puede superar 3 dias despues de la actual")

				.ibe-searcher__col.ibe-searcher__col--button-type-2
					.ibe_form__group.ibe_form__group--button-icon.fc_form_group
						button.ibe-search-flights__search-button.ibe-button.ibe-button--red.ibe-button--xbig.ibe-button--block.ibe-button--icon(type="submit",data-validate="origin-destiny")
							span.ibe-button__text!="Buscar"
							span.hideAccessible!="Buscar"
							span.ibe-button__icon.icon-buscar
