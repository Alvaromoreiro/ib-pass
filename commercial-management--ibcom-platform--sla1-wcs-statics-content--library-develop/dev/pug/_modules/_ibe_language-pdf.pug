mixin m-language-pdf(params)
	article.ibe-language-pdf(class="ibe-language-pdf--" + params.mainClass + (params.cssClass!=undefined?" "+params.cssClass:""))
		.ibe-language-pdf__container
			.ibe-language-pdf__info
				h3.title__h3.ibe-language-pdf__title!=params.title.name
				p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Versi&oacute;n imprimible en PDF."
				p.ibe-language-pdf__available.paragraph.paragraph__regular.paragraph.paragraph__regular--inline!="Idiomas disponibles:"
				ul.ibe-language-pdf__list
					li.ibe-language-pdf__list-item
						a.link.link__regular(class=(params.linkClass!=undefined?params.linkClass:"") href="#" title="Español")!="Espa&ntilde;ol"
					li.ibe-language-pdf__list-item
						a.link.link__regular(class=(params.linkClass!=undefined?params.linkClass:"") href="#" title="Ingles")!="Ingles"
					li.ibe-language-pdf__list-item
						a.link.link__regular(class=(params.linkClass!=undefined?params.linkClass:"") href="#" title="Italiano")!="Italiano"
