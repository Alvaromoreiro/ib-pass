mixin m-card-cont-share(params)
	if(params.share)
		article.ibe-card-box(class=(params.autoHeight != undefined ? params.autoHeight : ""))
			div.ibe-card-box__container
				div.ibe-card-box__content
					div.ibe-card-box__text
						h3.ibe-card-cont-share__title.ibe-card-cont-share__title--red.ibe-card-cont-share__title--big.ibe-card-cont-share__title--icon.ibe-card-cont-share__title--icon-share!=params.title
						p.ibe-card-box__paragraph--paragraph-ellipsi!=params.text
						input(type="text" placeholder="https://www.iberia.com/web/guide" class="ibe-card-cont-share__url")
						div.ibe-card-cont-share__buttons-group
							button.ibe-button.ibe-button--red.ibe-button.ibe-button--w100.ibe-button--medium.ibe-button--icon-new.ibe-button--icon-enlace!="Copiar enlace"
							button.ibe-button.ibe-button--red.ibe-button.ibe-button--w100.ibe-button--medium.ibe-button--icon-new.ibe-button--icon-email!="Enviar por E-mail"
						
						button.ibe-card-cont-share__button--social.ibe-button.ibe-button--transparent.ibe-button--no-border.ibe-button--medium.ibe-button--icon.ibe-button--icon-whatsapp!="Compartir por whassApp"
