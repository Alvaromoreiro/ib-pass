mixin m-ibe-wine-club_fall-in-love(params)
    div.ibe-wine-club__fall-in-love
        +m-ibe-wine-club_info-section({
            "showSubtitle": true,
            "title": "Enamórate de España.",
            "subtitle": "Pasea por nuestra cultura…",
            "info": "Explora los rincones más especiales y descubre las bodegas más prestigiosas; vive experiencias en torno a tus dos pasiones: el vino y los viajes."
        })
        +m-ibe-wine-club_carousel()
        div.ibe-wine-club__fall-in-love--container-button
            a.ibe-button.ibe-button--red.ibe-button--large-3.ibe-button--iberia-headline.ibe-button--fs-20.pull-center.u-mt-medium.ibe-wine-club__fall-in-love--button Ver todas las experiencias