mixin m-ibe-wine-club_banner(params)
    div.container.ibe-wine-club__banner
        div.ibe-wine-club__banner--title Te damos la bienvenida al Club del Vino Iberia
        div.ibe-wine-club__banner--subtitle Seleccionamos los más reputados vinos al mejor precio, en exclusiva para ti. Y además, te ofrecemos experiencias gastronómicas premiadas con estrella Michelín, enoturismo, packs especiales y mucho más.
    div.ibe-wine-club__banner--img(data-background=params.dataBackground)
        div.row
            div.col-xs-12
                div.ibe-static-banner__title-section--no-margin.ibe-wine-club__banner--img-text
                    p.ibe-static-banner__subtitle.ibe-wine-club__banner--img-text-title Una selección de los mejores vinos, a un precio exclusivo
                    a.ibe-button.ibe-button--red.ibe-button--large-3.pull-center.u-mt-medium.ibe-button--iberia-headline.ibe-wine-club__banner--img-btn Accede al club del vino