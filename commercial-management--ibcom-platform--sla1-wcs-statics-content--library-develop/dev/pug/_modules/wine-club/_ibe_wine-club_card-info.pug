mixin m-ibe-wine-club_card-info()
    div.ibe-wine-club__card-info
        +m-ibe-wine-club_info-section({
            "showSubtitle": true,
            "title": "Expaña a través del paladar...",
            "subtitle": "Experiencias gastronómicas Araex Grands",
            "info": "Asiste a fantásticas veladas con los chefs de las nueve D. O. más prestigiosas de España."
        })

        div.ibe-wine-club__card-info--container         
            a.ibe-wine-club__card-info--img
            div.ibe-wine-club__card-info--text
                div.ibe-wine-club__card-info--text-title
                    a.link.link__regular--important(href="javascript:void(0)")!="Experiencias Gourmet con maridaje estelar."
                div.ibe-wine-club__card-info--text-subtitle!="Embárcate en un viaje sin igual con nuestras Experiencias Gourmet, seleccionadas en prestigiosos restaurantes."
                div.ibe-wine-club__card-info--text-info!="Nuestros exclusivos packs de gastronomía y maridaje te mostrarán la perfecta fusión entre alta cocina y exquisitos vinos. Deleita tus sentidos y descubre la verdadera definición del lujo gastronómico con nosotros."
        div.ibe-wine-club__card-info--footer-img!="*Imagen:Visita Bodega PradoRey"
        a.ibe-button.ibe-wine-club__card-info--button!="Ver todas las experiencias"