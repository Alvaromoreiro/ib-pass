mixin m-ibe-wine-club_icon-banner()
    div.ibe-wine-club__icon-banner
        +m-ibe-wine-club_info-section({
            "showSubtitle": true,
            "title": "Encuentra tu vino perfecto",
            "subtitle": "Transforma cada ocasión en una celebración",
            "info": "Desde robustos tintos hasta elegantes blancos, cada etiqueta cuenta una fascinante historia que compartiremos contigo."
        })
        div.ibe-wine-club__icon-banner--img
            div.row
                div.ibe-wine-club__icon-banner--container
                    ul.row.ibe-wine-club__icon-banner--container--ul
                        li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature.ibe-wine-club__icon-banner--container--li
                            img(src=globals.imgPath + "/modules/icons/vino.png" alt="oferta cultural", class="ibe-static-banner__feature-img")
                            div.ibe-flex__column.ibe-flex--align-start
                                div.ibe-wine-club__icon-banner--icon-col-title-area         
                                    p.ibe-wine-club__icon-banner--icon-col-title!="Nuestras"
                                    p.ibe-wine-club__icon-banner--icon-col-title!="selecciones"                                   
                                p.ibe-wine-club__icon-banner--icon-col-info!="In jeder Lieferung liegt der Schlüssel zur Entdeckung neuer Aromen."
                                button.ibe-wine-club__icon-banner--icon-col-button!="Ir a la tienda"
                        li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature.ibe-wine-club__icon-banner--container--li
                            img(src=globals.imgPath + "/modules/icons/vip.png" alt="oferta gastronomica", class="ibe-static-banner__feature-img")
                            div.ibe-flex__column.ibe-flex--align-start
                                div.ibe-wine-club__icon-banner--icon-col-title-area    
                                    p.ibe-wine-club__icon-banner--icon-col-title!="Salas "
                                    p.ibe-wine-club__icon-banner--icon-col-title!="Vip Madrid"
                                p.ibe-wine-club__icon-banner--icon-col-info!="Entdecken Sie unsere exklusive Auswahl an Weinen beim Entspannen."
                                button.ibe-wine-club__icon-banner--icon-col-button!="Accede a las experiencias"
                        li.col-lg-4.col-md-12.col-sm-12.col-xs-12.ibe-static-banner__feature.ibe-wine-club__icon-banner--container--li
                            img(src=globals.imgPath + "/modules/icons/avion.png" alt="compras y ocio", class="ibe-static-banner__feature-img")
                            div.ibe-flex__column.ibe-flex--align-start
                                div.ibe-wine-club__icon-banner--icon-col-title-area  
                                    p.ibe-wine-club__icon-banner--icon-col-title!="Selección"
                                    p.ibe-wine-club__icon-banner--icon-col-title!="Business"
                                p.ibe-wine-club__icon-banner--icon-col-info!="Entdecken Sie Luxus in jedem Schluck: ausgewählte Weine für ein unvergleichliches Erlebnis."
                                button.ibe-wine-club__icon-banner--icon-col-button!="Ver las secciones"