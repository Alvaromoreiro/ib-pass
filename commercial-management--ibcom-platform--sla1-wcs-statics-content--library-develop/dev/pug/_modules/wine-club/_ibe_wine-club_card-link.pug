mixin m-ibe-wine-club_card-link()
    div.ibe-wine-club__card-link
        +m-ibe-wine-club_info-section({
            "showSubtitle": false,
            "title": "¿Y por qué un Club del Vino Iberia?",
            "info": "Porque cada sorbo es un viaje y cada botella cuenta una historia única. Descubre el arte de la enología con nuestra exquisita selección de vinos de las mejores bodegas, sumérgete en experiencias gastronómicas inolvidables y embárcate en una aventura apasionante a través del fascinante mundo del enoturismo."
        })
        ul.row.ibe-card-container(data-show-more="guides-0" data-show-more-init="3")
            li.col-xl-4.col-lg-4.col-md-4.col-sm-12.col-xs-12.ibe-card.ibe-wine-club__card-link--modifier
                div.ibe-wine-club__card-link--card(data-type="body")
                    a(href="#")
                        figure.ibe-wine-club__card-link--card-img
                            img(src= globals.imgPath + "/modules/wineclub/encuentra-vino.png", alt="Encuentra tu vino")
                    div.ibe-wine-club__card-link--card-text
                        div.ibe-wine-club__card-link--card-title
                            a(href="javascript:void(0)" title="Encuentra tu vino perfecto" class="link link__regular link__regular--unformatted")
                                span.ibe-wine-club__card-link--card-title-text!="Encuentra tu vino perfecto"
                            p.ibe-wine-club__card-link--card-subtitle
                                span.ibe-wine-club__card-link--card-subtitle-text-bold!="Vinos especialmente seleccionados "
                                span.ibe-wine-club__card-link--card-subtitle-text!="de reconocidas bodegas y regiones vitivinícolas de España."
                    div.ibe-wine-club__card-link--card-link
                        a.link.ibe-wine-club__card-link--card-link-text(href="#", title="Saber más")!="Saber mas"
            li.col-xl-4.col-lg-4.col-md-4.col-sm-12.col-xs-12.ibe-card.ibe-wine-club__card-link--modifier
                div.ibe-wine-club__card-link--card(data-type="body")
                    a(href="#")
                        figure.ibe-wine-club__card-link--card-img
                            img(src= globals.imgPath + "/modules/wineclub/paquetes-gastronomicos.png", alt="Paquetes gastronomicos")
                    div.ibe-wine-club__card-link--card-text
                        div.ibe-wine-club__card-link--card-title
                            a(href="javascript:void(0)" title="Paquetes gastronomicos" class="link link__regular link__regular--unformatted")
                                span.ibe-wine-club__card-link--card-title-text!="Paquetes gastronómicos"
                            p.ibe-wine-club__card-link--card-subtitle
                                span.ibe-wine-club__card-link--card-subtitle-text!="Disfruta de un maridaje perfecto: "
                                span.ibe-wine-club__card-link--card-subtitle-text-bold!="Alta cocina con el mejor vino. "
                    div.ibe-wine-club__card-link--card-link
                        a.link.ibe-wine-club__card-link--card-link-text(href="#", title="Saber más")!="Saber mas"
            li.col-xl-4.col-lg-4.col-md-4.col-sm-12.col-xs-12.ibe-card.ibe-wine-club__card-link--modifier
                div.ibe-wine-club__card-link--card(data-type="body")
                    a(href="#")
                        figure.ibe-wine-club__card-link--card-img
                            img(src= globals.imgPath + "/modules/wineclub/experiencias-enoturisticas.png", alt="Experiencias enoturísticas")
                    div.ibe-wine-club__card-link--card-text
                        div.ibe-wine-club__card-link--card-title
                            a(href="javascript:void(0)" title="Experiencias enoturísticas" class="link link__regular link__regular--unformatted")
                                span.ibe-wine-club__card-link--card-title-text!="Experiencias enoturísticas"
                            p.ibe-wine-club__card-link--card-subtitle
                                span.ibe-wine-club__card-link--card-subtitle-text!="Explora los rincones más especiales y "
                                span.ibe-wine-club__card-link--card-subtitle-text-bold!="vive experiencias en torno a tus pasiones: el vino y los viajar."
                    div.ibe-wine-club__card-link--card-link
                        a.link.ibe-wine-club__card-link--card-link-text(href="#", title="Saber más")!="Saber mas"