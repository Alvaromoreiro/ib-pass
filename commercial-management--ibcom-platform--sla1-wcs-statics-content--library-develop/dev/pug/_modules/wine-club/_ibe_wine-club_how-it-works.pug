mixin m-ibe-wine-club_how-it-works(params)
    div.ibe-wine-club__how-it-works
        h3.ibe-wine-club__how-it-works--title!="¿Cómo funciona?"
        div.ibe-wine-club__how-it-works--guided-steps
            div.ibe-wine-club__how-it-works--step
                span.ibe-wine-club__how-it-works--step__icon.icon-portatil 
                div.ibe-wine-club__how-it-works--step__title
                    span.ibe-wine-club__how-it-works--step__icon--mobile.icon-portatil 
                    span.ibe-wine-club__how-it-works--step__title--text.ibe-ellipsis-1!="1. Accede al Club"
                span.ibe-wine-club__how-it-works--step__description!="Crea tu cuenta en clubdelvinoiberia.com o accede con tu usuario de Iberia.com"
            div.ibe-wine-club__how-it-works--step
                span.ibe-wine-club__how-it-works--step__icon.icon-avios-solidarios
                div.ibe-wine-club__how-it-works--step__title
                    span.ibe-wine-club__how-it-works--step__icon--mobile.icon-avios-solidarios
                    span.ibe-wine-club__how-it-works--step__title--text.ibe-ellipsis-1!="2. Descubre y disfruta"
                span.ibe-wine-club__how-it-works--step__description!="Ponemos a tu alcance una amplia variedad de vinos y experiencias cuidadosamente seleccionadas para ti."
            div.ibe-wine-club__how-it-works--step
                span.ibe-wine-club__how-it-works--step__icon.icon-idiomas_web
                div.ibe-wine-club__how-it-works--step__title
                    span.ibe-wine-club__how-it-works--step__icon--mobile.icon-idiomas_web
                    span.ibe-wine-club__how-it-works--step__title--text.ibe-ellipsis-1!="3. Canjea y obtén Avios"
                span.ibe-wine-club__how-it-works--step__description!="Si eres Iberia Plus, podrás utilizar tus Avios para pagar. Y a su vez podrás acumular los Avios generados en cada compra."
        span.ibe-wine-club__how-it-works--disclaimer!="*Estés donde estés. Entregamos en España, Portugal, Italia, Reino Unido, Francia y Alemania."
