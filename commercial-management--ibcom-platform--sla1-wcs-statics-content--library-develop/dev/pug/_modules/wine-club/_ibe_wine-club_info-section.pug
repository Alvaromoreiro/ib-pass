
mixin m-ibe-wine-club_info-section(params)
    div.ibe-wine-club__info-section--text
        div.ibe-wine-club__info-section--text-title!=params.title
        if(params.showSubtitle)
            div.ibe-wine-club__info-section--text-subtitle!=params.subtitle
        div.ibe-wine-club__info-section--text-info!=params.info