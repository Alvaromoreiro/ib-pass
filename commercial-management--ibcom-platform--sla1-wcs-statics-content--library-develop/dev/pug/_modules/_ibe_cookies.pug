mixin m-ibe-cookies(params)
    .ibe-cookies
        .container
            .row
                a.ibe-cookies__close(href="#" title="Cerrar cookies" data-cookies='close')
                    span.hideAccessible!="Cerrar"
                .col-md-9
                    p.paragraph.paragraph__regular--line125!="Utilizamos cookies propias y de terceros para mejorar tu experiencia y nuestros servicios. Si contin&uacute;as navegando consideramos que aceptas su uso. Puedes obtener m&aacute;s informaci&oacute;n en nuestra "
                        a.link.link__regular.link__regular--important(href="#" title="Políticas de cookies")!="Pol&iacute;tica de cookies"
                .col-md-3
                    button.ibe-button.ibe-button--red.ibe-button--small(data-cookies='close')!="Aceptar"