mixin m-footer(params)
	-	params = params || "";
	footer.ibe-footer(class=(params.full === true ? " ibe-footer--full" : ""))
		.container
			.row
				.col-xs-12
					.ibe-footer__main
						.ibe-footer__main-container
							.ibe-footer__main-container--content
								nav.row
									div.ibe-accordion
										.col-md-3
											div.ibe-footer__main-container-social
												h2(data-toggle="accordion", data-target="#group_01_footer_01").ibe-footer-title
													a.link.hidden-xl.hidden-lg.hidden-md(href="#")!="En la red"
													span.hidden-sm.hidden-xs!="En la red"
												div(id="group_01_footer_01" data-toggle="container").ibe-footer__collapse
													ul.ibe-footer__main-container-list
														li.ibe-footer__main-container-item
															a.ibe-footer-link.ibe-footer-link--icon-social(href="#" title="Iberia Joven")
																figure.ibe-footer-icon-social
																	img.ibe-footer-icon-social-img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/modules/ibe_footer/ico_iberia_joven.png", alt="Iberia Joven")
																span.ibe-footer-icon-social-text!="Iberia Joven"
														li.ibe-footer__main-container-item
															a.ibe-footer-link.ibe-footer-link--icon-social(href="#" title="Iberia en las Redes Sociales")
																figure.ibe-footer-icon-social
																	img.ibe-footer-icon-social-img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/modules/ibe_footer/ico_rrss.png", alt="Iberia en las Redes Sociales")
																span.ibe-footer-icon-social-text!="Iberia en las Redes Sociales"
														li.ibe-footer__main-container-item
															a.ibe-footer-link.ibe-footer-link--icon-social(href="#" title="Tu opinión")
																figure.ibe-footer-icon-social
																	img.ibe-footer-icon-social-img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/modules/ibe_footer/ico_bubble.png", alt="Tu opinión")
																span.ibe-footer-icon-social-text!="Tu opini&oacute;n"
										.col-md-3
											div
												h2(data-toggle="accordion", data-target="#group_01_footer_02").ibe-footer-title
													a.link.hidden-xl.hidden-lg.hidden-md(href="#")!="De tu inter&eacute;s"
													span.hidden-sm.hidden-xs!="De tu inter&eacute;s"
												div(id="group_01_footer_02", data-toggle="container").ibe-footer__collapse
													ul.ibe-footer__main-container-list
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Guías de destino")!="Gu&iacute;as de destino"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Estado de vuelos")!="Estado de vuelos"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Búsqueda de equipaje")!="B&uacute;squeda de equipaje"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Mapa del sitio")!="Mapa del sitio"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Calcula tu huella CO2")!="Calcula tu huella CO2"
										.col-md-3
											div
												h2(data-toggle="accordion", data-target="#group_01_footer_03", class="").ibe-footer-title
													a.link.hidden-xl.hidden-lg.hidden-md(href="#")!="Iberia es m&aacute;s"
													span.hidden-sm.hidden-xs!="Iberia es m&aacute;s"
												div(id="group_01_footer_03", data-toggle="container").ibe-footer__collapse
													ul.ibe-footer__main-container-list
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Noticias y novedades")!="Noticias y novedades"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Grupo Iberia")!="Grupo Iberia"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Iberia Empleo")!="Iberia Empleo"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Accionistas e Inversores")!="Accionistas e Inversores"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="m.iberia.com")!="m.iberia.com"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="British Airways")!="British Airways"
										.col-md-3
											div
												h2(data-toggle="accordion", data-target="#group_01_footer_04").ibe-footer-title
													a.link.hidden-xl.hidden-lg.hidden-md(href="#")!="Transparencia"
													span.hidden-sm.hidden-xs!="Transparencia"
												div(id="group_01_footer_04", data-toggle="container").ibe-footer__collapse
													ul.ibe-footer__main-container-list
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Condiciones Transporte")!="Condiciones Transporte"
														//li.ibe-footer__main-container-item
														//	a.ibe-footer-link(href="#" title="Tu seguridad es lo primero")!="Tu seguridad es lo primero"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Mejor precio garantizado")!="Mejor precio garantizado"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Compromiso de servicio")!="Compromiso de servicio"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Derechos del pasajero")!="Derechos del pasajero"
														li.ibe-footer__main-container-item
															a.ibe-footer-link(href="#" title="Información Legal")!="Informaci&oacute;n Legal"
						.ibe-footer__main-container.ibe-footer__main-container--second
							.ibe-footer__main-container--content.ibe-footer-container--new
								.row
									.col-xs-12.col-md-4.col-lg-3
										p.ibe-footer-phone-text!="Venta telef&oacute;nica de billetes"
										a(href="#ni", class="ibe-footer-phone"+(params.telephoneLarge!=undefined?" ibe-footer-phone--largue":""))!=(params.telephone!=undefined?params.telephone:"901 111 501")
										//- if params.repit
										//- 	each val in [1,2,3]
										//- 		span(class="ibe-footer-phone"+(params.telephoneLarge!=undefined?" ibe-footer-phone--largue":""))!=(params.telephone!=undefined?params.telephone:"901 111 501")
										//- if params.repit
										//- 	- var n = 0
										//- 		while n === n++
										//- 		span(class="ibe-footer-phone"+(params.telephoneLarge!=undefined?" ibe-footer-phone--largue":""))!=(params.telephone!=undefined?params.telephone:"901 111 501")

										//- each item in params.telephone
										//- 	span(class="ibe-footer-phone"+(params.telephoneLarge!=undefined?" ibe-footer-phone--largue":""))!=(params.telephone!=undefined?params.telephone:"901 111 501")
										//- 		if item.active == true
										//- 			if i == 1
										//- 				- pActive = (100/totalItems)/2;
										//- 			else if i == totalItems
										//- 				- pActive = (100/totalItems)*i;
										//- 			else
										//- 				- pActive = (100/totalItems)*i-(100/totalItems)/2;
										//- 		a(href="#",class="brb-listItemText"+(item.cssClass!=undefined?" "+item.cssClass:""), title=(item.title!=undefined?item.title:item.content))
										//- 			span.number!=(item.number!=undefined?item.number:i)+ " "
										//- 			- i++
										//- 			!=item.content
									.col-xs-12.col-md-7.col-lg-9
										ul.ibe-footer__main-container-list
											li.ibe-footer__main-container-item
												a.ibe-footer-link(href="#" title="Ir a Accesibilidad")!="Accesibilidad - Servicio e información 1-800-994-0704 / accessibility@Iberia.com"
											li.ibe-footer__main-container-item
												a.ibe-footer-link(href="#" title="Ir a Plan de Servicio")!="CSP - Plan de Servicio al Cliente"
											li.ibe-footer__main-container-item
												a.ibe-footer-link(href="#" title="Ir a plan de Contingencia")!="TARMAC - Plan de Contingencia para los Retrasos prolongados en pista"
											li.ibe-footer__main-container-item
												a.ibe-footer-link(href="#" title="Ir a General Rules")!="IB General Rules & Tariff Canada"

								div.ibe-footer__logo-aniversario--box
									figure.ibe-footer__logo-aniversario
										img.ibe-footer__logo-aniversario--img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/modules/ibe_footer/iberia-90-aniversario-es.png", alt="90 aniversario")
						.ibe-footer__main-container.ibe-footer__main-container--third
							.ibe-footer__main-container--content
								.row
									.col-xs-6.col-md-6
										p!="&copy; Iberia 2016"
									.col-xs-6.col-md-6
										figure.ibe-footer__logo-iberia
											if(params.emergency)
												img.ibe-footer__logo-iberia-img(alt="Logo Iberia" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/general/logo_iberia_black.svg")
											else
												img.ibe-footer__logo-iberia-img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7", data-src=globals.imgPath+"/modules/ibe_footer/iberia-logo-footer.png", alt="Iberia")
					.ibe-footer__responsive
						a.ibe-footer__responsive-home.ibe-link(href="#" title="Volver a la home")!="Volver a la home"
