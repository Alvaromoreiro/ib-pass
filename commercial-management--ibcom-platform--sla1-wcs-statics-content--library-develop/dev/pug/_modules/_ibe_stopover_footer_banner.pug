mixin m-ibe-stopover-footer-banner()
	div.ibe-static-banner.ibe-static-banner--m-t.ibe-static-banner__stopover(data-background='images/modules/stopover/img-call-to-action-conocer-madrid')
		div.row
			div.col-xs-12
				div.ibe-static-banner__title-section--no-margin.ibe-static-banner__stopover--text
					p.ibe-static-banner__title ¿Te apetece conocer Madrid? 
					p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-22 No dudes en reservar tu Stopover ahora
					a.ibe-button.ibe-button--red.ibe-button--large-3.pull-center.u-mt-medium.ibe-button--iberia-headline.ibe-button--fs-20 Quiero hacer Stopover