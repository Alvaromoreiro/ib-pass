mixin m-searcher-calendar(params)
    if (params.type == "fly")
        if (params.when == "start")
            div.ibe-toggle.ibe-searcher__calendar.ibe-searcher__calendar--start(id=params.id data-toggle="container", data-close="outsideclick")
                div.ibe-searcher__calendar-header
                    .ibe-form__checkbox 
                        input.ibe-form__checkbox-input(type="checkbox" id="flexible"+params.number name="flexible"+params.number value="flexible"+params.number)
                        label.ibe-form__checkbox-label(for="flexible"+params.number, data-control="check")
                            span!="Mis fechas son flexibles"
                    span.ibe-searcher__calendar-current!="Hoy : 6 de Junio, 2016"
                div(data-function="cal-start", data-language="es", data-maxrange=(params.datamaxrange!=undefined?params.datamaxrange:"361"), data-format=(params.dataformat!=undefined?params.dataformat:"dd/mm/yy"), data-firstday="1", data-hour-restriction=(params.datahourrestriction!=undefined?params.datahourrestriction:null))
        else
            div.ibe-toggle.ibe-searcher__calendar.ibe-searcher__calendar--end(id=params.id data-toggle="container", data-close="outsideclick")
                div.ibe-searcher__calendar-header
                    .ibe-form__checkbox
                        input.ibe-form__checkbox-input(type="checkbox" id="flexible"+params.number name="flexible"+params.number value="flexible"+params.number)
                        label.ibe-form__checkbox-label(for="flexible"+params.number, data-control="check") 
                            span!="Mis fechas son flexibles"
                    span.ibe-searcher__calendar-current!="Hoy : 6 de Junio, 2016"
                div.ibe-searcher__calendar-end(data-function="cal-end", data-language="es", data-maxrange=(params.datamaxrange!=undefined?params.datamaxrange:"361"), data-format=(params.dataformat!=undefined?params.dataformat:"dd/mm/yy"), data-firstday="0", data-hour-restriction=(params.datahourrestriction!=undefined?params.datahourrestriction:null))
    else
        if (params.when == "start")
