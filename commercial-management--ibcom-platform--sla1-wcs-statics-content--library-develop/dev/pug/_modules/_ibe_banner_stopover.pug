mixin m-banner-stopover(params)
	div.ibe-banner-stopover(data-background="/images/modules/stopover/bg-stopover-home-header")
		div.ibe-banner-stopover__img-container
			img(src="../../images/modules/stopover/img-home-header-rotate.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--top")
			img(src="../../images/modules/stopover/img-home-header-ilustracion-madrid.png", alt="", class="ibe-banner-stopover__back-img ibe-banner-stopover__back-img--bottom")
		div.ibe-banner-stopover__container
			.container
				.row
					.col-xs-12
						figure.ibe-banner-stopover__logo
							img(src="images/modules/stopover/logo_stopover.png", alt="")
						h2.ibe-banner-stopover__title!="Aprovecha tu escala descubriendo Madrid"
						div.ibe-banner-stopover__subtitle!="¿Tu vuelo tiene una escala en Madrid? Te ofrecemos una serie de planes y descuentos exclusivos para que disfrutes al máximo la capital. "
							span.bold="Elige tu trayecto"
