mixin m-ibe_stopover_banner_collapsed-searcher()
  div.ibe-static-banner.ibe-static-banner--left.ibe-static-banner--experiences.ibe-static-banner--bg-position-2(data-background='images/modules/stopover/bg-experiencias-header')
      div.container
          div.row
              div.col-xs-12.col-lg-6.ibe-static-banner__container
                  div.ibe-static-banner__title-section--no-margin
                      p.ibe-static-banner__title.ibe-static-banner__title--plans Planes recomendados para tu parada en Madrid
                      p.ibe-static-banner__subtitle.ibe-static-banner__subtitle--fs-24.ibe-static-banner__subtitle--plans Hay tantas cosas que hacer en la ciudad que queremos ponértelo fácil. Nuestros expertos en viajes te recomiendan un planning a tu gusto.
  div.ibe-flex.ibe-flex--flex-center.ibe-flex--align-end.ibe-stopover-banner--searcher
      .ibe-search-collapse__item.ibe-search-collapse__item--input.ibe-stopover-banner--input.u-mr-none
          .ibe_form__group.fc_form_group.ibe_form__group--button-icon
              label(for="flight_origin_stop" class="ibe_form__input-label ibe-search-compact__searcher-text ibe-search-compact__searcher-text--mobile") ¿Quieres hacer stopover?
              input.ibe_form__input-text.ui-autocomplete-input(type="text", id="flight_origin_stop",
              data-focusin, data-autocomplete="cities", data-toggle-element,
              data-validate="input-origin", required, name="stop_origin", style="height: 60px")
              p.ibe_form__msg-info.hidden(data-validate="exist", data-validate-text="Este campo es obligatorio")
              p.ibe_form__msg-info.hidden(data-validate="valid", data-validate-text="El formato no es válido")
      button.ibe-search-collapse__item.ibe-search-collapse__item--button-b.ibe-stopover-banner--button(type='button', data-focusin="data-focusin")!="Buscar"
