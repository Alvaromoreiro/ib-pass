mixin m-banner-layers(params)
	a.ibe-banner-link(data-type-trip, data-table-destination=params.type)
		div.ibe-banner-layers(data-city="BIO", data-table-click)
			div.ibe-banner-layers--box(class=params.typeClass!=undefined?" ibe-banner-layers--"+params.typeClass:"")
				div.container
					div.row
						div.col-xs-12
							p.ibe-banner-layers--box-advise
								span!="Solo hasta el 30 de Septiembre"
							figure.ibe-banner-layers--box-logo
								img.ibe-banner-layers--box-image(src="images/general/310B5951-2D22-4F2F-84CD-46E56C7A7402.png", alt="")
							figure.ibe-banner-layers--box-logo-small
								img.ibe-banner-layers--box-image-small(src="images/general/BB88B791-9D9D-4DE7-B5C3-BECC7242DCBB.png", alt="")
							//-span.ibe-banner-layers--box-logo-foot!="Vuela a precios increíbles" 	
							h2.ibe-banner-layers--box-title!="Vuela directo a Roma"
								span.title--block!="desde Madrid por muy poco"
							h2.ibe-banner-layers--box-title.ibe-banner-layers--box-title-yellow!="Vuela directo a Roma"
								span.title--block!="desde Madrid por muy poco"	
							span.ibe-banner-layers--box-subtitle!="Vuela a precios increíbles y no te pierdas esta gran oportunidad."
							span.ibe-banner-layers--box-city!="Roma"
							span.ibe-banner-layers--box-type!="Ida y vuelta desde"
							div.ibe-banner-layers--box-price
								span.ibe-banner-layers--box-current-before.ibe-banner-layers--box-current-big!="COP"
								span.ibe-current!="1,252,589"
									span.ibe-banner-layers--box-current!="€"
							div.ibe-banner-layers--box-price-double
								span.ibe-banner-layers--box-current-before!="USD"	
								span.ibe-banner-layers--box-price-double-price1!="123"
									span.ibe-banner-layers--box-current!="€"
								span.ibe-banner-layers--box-current-before!="COP"
								span.ibe-banner-layers--box-price-double-price2!="12.612.111"	
									span.ibe-banner-layers--box-current!="€"
								
							span.ibe-link__carousel!="RESERVA YA TU VUELO"
							figure.ibe-banner-layers--box-logo__big 
								img.ibe-banner-layers--box-image-big(src="images/general/group-5.png", alt="")
			figure.ibe-banner-layers__cover-fig
				picture
					source(media="(min-width: 1280px)", srcset="images/general/B77A77E4-F72E-4252-81BB-50AD4D74D870.png")
					source(media="(min-width: 1024px)", srcset="images/general/imagen_1024.png")
					//-source(media="(min-width: 1024px)", srcset="images/general/7DFFAA1D-2507-4EBD-A3FB-30503F7F6FF4_1024-768.png")
					source(media="(min-width: 768px)", srcset="images/general/7DFFAA1D-2507-4EBD-A3FB-30503F7F6FF4_1024-768.png")
					source(media="(min-width: 480px)", srcset="images/general/herobanner_1precio_es-fr_210619_es_480.jpg")
					source(media="(min-width: 0px)", srcset="images/general/herobanner_1precio_es-fr_210619_es_320_1x.png")
					img(src="images/general/B77A77E4-F72E-4252-81BB-50AD4D74D870.png", class="ibe-search-flights__cover-img css-js", alt="Disfruta de Roma")
			

			
