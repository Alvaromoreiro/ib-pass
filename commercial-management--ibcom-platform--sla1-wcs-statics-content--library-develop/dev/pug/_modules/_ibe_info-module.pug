mixin m-info-module()
	.ibe-info-box(data-slick="info-box")
		.ibe-info-box__container(data-resize='info-box')
			figure.ibe-info-box__fig
				img.ibe-info-box__img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src='./images/content/info-module/idiomas-web.svg' alt="icon mundo")
			p.ibe-info-box__txt Realiza una parada en Madrid en vuelos de largo o medio recorrido
		.ibe-info-box__container(data-resize='info-box')
			figure.ibe-info-box__fig
				img.ibe-info-box__img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src='./images/content/info-module/transferencia.svg' alt="flechas")
			p.ibe-info-box__txt Elige cuando hacer tu parada: en la ida o en la vuelta
		.ibe-info-box__container(data-resize='info-box')
			figure.ibe-info-box__fig
				img.ibe-info-box__img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src='./images/content/info-module/reserva-de-hoteles.svg' alt="cama")
			p.ibe-info-box__txt Selecciona las noches de estancia en Madrid y prepárate para disfrutarla
		.ibe-info-box__container(data-resize='info-box')
			figure.ibe-info-box__fig
				img.ibe-info-box__img(src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src='./images/content/info-module/satisfaccion-cliente.svg' alt="corazon")
			p.ibe-info-box__txt Gastronomía, arte, museos, hoteles… con Mad About Madrid no te perderás nada
