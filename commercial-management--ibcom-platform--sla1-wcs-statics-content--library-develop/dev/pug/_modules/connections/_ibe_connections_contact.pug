mixin m-connections-contact()
  div.container
    div.col-xs-12
      h3.title.title__h3!="Contacta con nosotros"
      div.ibe-box-divided
        .row
          .col-lg-4.col-sm-12
            .ibe-box-divided__content
              h4.title.title__h4(data-fc-box-title-height)!="Oficinas de Iberia"
              p.paragraph.paragraph__regular(data-fc-box-height)!="Estamos a tu disposición en la amplia red de oficinas. "
              p.paragraph.paragraph__regular
                a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"
          .col-lg-4.col-sm-12.border
            .ibe-box-divided__content
              h4.title.title__h4(data-fc-box-title-height)!="WhatsApp"
              p.paragraph.paragraph__regular(data-fc-box-height)!="Haz check-in, consulta el estado de tu vuelo y más. ¡Rápido y cómodo!"
              p.paragraph.paragraph__regular
                a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"
          .col-lg-4.col-sm-12
            .ibe-box-divided__content.no-border
              h4.title.title__h4(data-fc-box-title-height)!="Redes sociales"
              p.paragraph.paragraph__regular(data-fc-box-height)!="Visítalas; nos encantará ayudarte desde ellas. "
              p.paragraph.paragraph__regular
                a.link.link__regular.link__regular--important.link__regular--arrow(href="#" title="Más Información")!="M&aacute;s Informaci&oacute;n"
