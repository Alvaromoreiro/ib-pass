mixin m-connections-table-mobile(params)
    h2.title__h2!="¿Cuánto se tarda en ir de una puerta a otra?"
    p.paragraph.paragraph__regular
        span.paragraph--bold!="Los tiempos variarán si tu conexión se produce dentro del edificio de la T4 o en el edificio satélite T4S;"
        span!=" también de la distancia que haya entre las puertas. Consulta aquí el tiempo aproximado que se tarda en llegar de una puerta a otra."

    div.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop.ibe-form__group--m-mobile(data-selectmenu_claim)
        label.ibe_form__selectize--label.ibe_form__selectize--label02.ibe-form__connections-label.ibe-form__connections-label--arrival(style="text-transform: none;" for="llegadas") Terminal de llegada
        select(id="llegadas" class="ibe-select ibe_form__input-text" name="llegadas" data-selectmenu="")
            option(value="HJK", selected) T4: Puertas HJK
            option(value="M") T4S: Puerta M
            option(value="S") T4S: Puerta S

    div.ibe_form__group.fc_form_group.ibe__form__group--select.ibe_form__group--select-new.ibe_form__group--nomargintop.ibe-form__group--m-mobile(data-selectmenu_claim)
        label.ibe_form__selectize--label.ibe_form__selectize--label02.ibe-form__connections-label.ibe-form__connections-label--departure(style="text-transform: none;" for="salidas") Terminal de salida
        select(id="salidas" class="ibe-select ibe_form__input-text" name="salidas" data-selectmenu="")
            option(value="HJK", selected) T4: Puertas HJK
            option(value="M") T4S: Puerta M
            option(value="S") T4S: Puerta S

    div.ibe-table-mobile-container
        table.ibe-table-mobile
            tr.ibe-table__tr(scope="row")
                th.ibe-table__th!="Terminal de llegada"
                td.ibe-table__td
                    div.ibe-flex.ibe-flex--gap-small.ibe-flex--align-center
                        div.icon-terminal.icon-terminal--type-1
                            p.icon-terminal__p!="T4S"
                        span!="Puerta M"
            tr.ibe-table__tr(scope="row")
                th.ibe-table__th!="Terminal de Salida"
                td.ibe-table__td
                    div.ibe-flex.ibe-flex--gap-small.ibe-flex--align-center
                        div.icon-terminal.icon-terminal--type-2
                            p.icon-terminal__p!="T4S"
                        span!="Puertas HJK"
            tr.ibe-table__tr(scope="row")
                th.ibe-table__th!="Información de conexión"
                td.ibe-table__td!="No cambia de terminal"
            tr.ibe-table__tr(scope="row")
                th.ibe-table__th!="Tiempo necesario para la conexión"
                td.ibe-table__td
                    div.ibe-flex.ibe-flex__row.ibe-flex--align-center
                        span.ibe-table__td-icon.icon-circle-check
                        p.ibe-table__tbody-td-p!="20 a 30 minutos"
            tr.ibe-table__tr(scope="row")
                th.ibe-table__th
                    div.ibe-flex.ibe-flex--align-center
                        p.ibe-table__th-p!="Origen/Destino"
                        //- span.ibe-table__th-icon.icon-informacion_2
                td.ibe-table__td
                    div
                        p!="Origen: No Schengen"
                        p!="Destino: Schengen"
