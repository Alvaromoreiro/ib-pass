mixin m-ibe-connections_card-50-50(params)
    div.ibe-connections-card-50-50
        if (params.left && params.type === '1')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img1
        if (params.left && params.type === '2')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img2
        if (params.left && params.type === 'equipaje-1')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img-equipaje-1
        if (params.left && params.type === 'equipaje-2')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img-equipaje-2
        div.ibe-connections-card-50-50__text
            div.ibe-connections-card-50-50__text-title
                p.link!=params.title
            p.ibe-connections-card-50-50__text-info!=params.info
            if(params.link)
                div.ibe-flex
                    a.link.link__regular.link__regular--important.link__regular--underline!=params.linkText
                    span.ibe-card-guides__footer-arrow
        if (params.right && params.type === '1')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img1
        if (params.right && params.type === '2')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img2
        if (params.right && params.type === 'equipaje-1')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img-equipaje-1
        if (params.right && params.type === 'equipaje-2')
            img.ibe-connections-card-50-50--img.ibe-connections-card-50-50--img-equipaje-2
