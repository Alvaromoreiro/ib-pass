mixin m-info-panel-madrid()
  div.ibe-connection-madrid-info-panel
    span.icon-movilidad-reducida.ibe-connection-madrid-info-panel__icon
    h2.ibe-connection-madrid-info-panel__title Accesibilidad en el aeropuerto
    p.ibe-connection-madrid-info-panel__description El aeropuerto Adolfo Suárez Madrid-Barajas dispone de un servicio de asistencia para personas con movilidad reducida o discapacidad.
    a.ibe-connection-madrid-info-panel__link(href="#" target="_blank")
      p Servicio de asistencia sin barreras
      span.icon-flecha_1_derecha
