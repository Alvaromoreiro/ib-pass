mixin m-connections-other-airports-card(params)
	div.ibe-connections-other-airports-card
		figure
			img.ibe-connections-other-airports-card__img(src=globals.imgPath + "/modules/connections/other/other_airport_1_1024.png" alt="airport image")
		div.ibe-connections-other-airports-card__info
			h2.ibe-connections-other-airports-card__title!="Dallas Fort Worth International Airport"
			ul.ibe-connections-other-airports-card__list
				li.ibe-flex.ibe-flex--align-center
					span.icon-senalizacion_mapas
					p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Ver mapa interactivo"
				li.ibe-flex.ibe-flex--align-center
					span.icon-informacion_de_vuelos
					p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Cómo hacer la conexión"
				li.ibe-flex.ibe-flex--align-center
					span.icon-wifi
					p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Wifi free"
				li.ibe-flex.ibe-flex--align-center
					span.icon-llegadas
					p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Llegada al aeropuerto"
				li.ibe-flex.ibe-flex--align-center
					span.icon-movilidad-reducida
					p.paragraph.paragraph__regular.paragraph__regular--no-margin!="Accesibilidad"
			div.ibe-connections-other-airports-card__links
				div.ibe-card-guides__footer--icon
					a.link.link__regular.link__regular--important.link__regular--underline(href="#" data-modal="button" data-modal-view=".fc-dialog-connections-info-other-airports")!="Aduana y equipajes"
					span.ibe-card-guides__footer-arrow
				div.ibe-card-guides__footer--icon
					a.link.link__regular.link__regular--important.link__regular--underline(href="https://https://www.dfwairport.com/")!="Más información"
					span.ibe-card-guides__footer-arrow
