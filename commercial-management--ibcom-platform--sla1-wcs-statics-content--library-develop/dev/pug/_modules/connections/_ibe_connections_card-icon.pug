mixin m-connections-card-icon()
  div.ibe-connections-other-airports-card.ibe-connections-card-icon
    figure
      img.ibe-connections-other-airports-card__img(src=globals.imgPath + "/modules/connections/mostradores/airport-card-icon.png" alt="airport image")
    div.ibe-connections-card
      div.ibe-connections-card-icon__info
        div.ibe-connections-card-icon__info__icon.ibe-connections-card-icon__info__icon--t4s
          p.ibe-connections-card-icon__info__icon__p!="T4S"
        div.ibe-connections-card-icon__info__text
          p
          | Localización: 
          b Planta 1
          | , junto a 
          b puerta K68
          | . 
          a.ibe-connections-card-icon__info__text-link(href="#")!="Ver mapa"
      div.ibe-connections-card-icon__info__time
        span.icon-circle-check
        p Horario: 
          b 06:00h a 21:00h
