mixin m-bob-opinions-cards(params)
	link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css")
	div(class="ibe-card-guides "+params.guide.cssClass, data-card-guides="group-"+params.guide.group, data-type=params.guide.type, id=params.id ? params.id : '')
		div.ibe-card-guides__body
			div.ibe-card-guides__header.ibe-card-guides__pb-none.ibe-bob--opinions-cards-xl
				div.ibe-bob--opi-cards-header
					div.ibe-bob--opi-cards-header-1 Vuelo de:
					div.ibe-bob--opi-cards-header-1 Maletas transportadas:
				div.ibe-bob--opi-cards-header
					p.ibe-bob--opi-cards-header-2.icon-despegue!=params.flightDetails
					div.ibe-bob--opi-cards-header-2.icon-e_equipaje!=params.flightBags
			div.ibe-card-guides__header.ibe-card-guides__pb-none.ibe-bob--opinions-cards-xs
				div.ibe-bob--opi-cards-header
					div.ibe-bob--opi-cards-header-1-xs Vuelo de:
					p.ibe-bob--opi-cards-header-2-xs-no-border.icon-despegue!=params.flightDetails
				div.ibe-bob--opi-cards-header
					div.ibe-bob--opi-cards-header-1-xs Maletas transportadas:
					div.ibe-bob--opi-cards-header-2-xs.icon-e_equipaje!=params.flightBags
			div.ibe-card-guides__info(class=params.cssClass)
				p.paragraph.paragraph__regular.paragraph__regular--grey(class=params.pClass)!=params.info
			div.ibe-card-guides__info.ibe-bob--opi-cards-valorations.ibe-bob--cards--guides__info
				span!=params.flightStars
				div.ibe-bob--opi-cards-valorations-stars
					div.ibe-bob--opi-cards-valorations-star-container
						div.ibe-bob--opi-cards-valorations-star-stroke
							div.ibe-bob--opi-cards-valorations-star-fill
					div.ibe-bob--opi-cards-valorations-star-container
						div.ibe-bob--opi-cards-valorations-star-stroke
							div.ibe-bob--opi-cards-valorations-star-fill
					div.ibe-bob--opi-cards-valorations-star-container
						div.ibe-bob--opi-cards-valorations-star-stroke
							div.ibe-bob--opi-cards-valorations-star-fill
					div.ibe-bob--opi-cards-valorations-star-container
						div.ibe-bob--opi-cards-valorations-star-stroke
							div.ibe-bob--opi-cards-valorations-star-fill
					div.ibe-bob--opi-cards-valorations-star-container
						div.ibe-bob--opi-cards-valorations-star-stroke-2
							div.ibe-bob--opi-cards-valorations-star-fill-2
			