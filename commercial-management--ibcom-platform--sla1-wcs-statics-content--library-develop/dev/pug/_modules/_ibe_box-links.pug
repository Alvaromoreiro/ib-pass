mixin m-ibe-box-links(params)
    div.ibe-box-links
        div.ibe-box-links__cols.ibe-box-links__cols--extra-links.ibe-box-links__cols--big
            ul.ibe-box-links__list
                li.ibe-box-links__list-item
                    a.link.link__regular.link__regular--small.link__regular--important.link__regular--underline(href="#" title="Destino Berlín")!="Berlín"
                li.ibe-box-links__list-item
                    a.link.link__regular.link__regular--small.link__regular--important.link__regular--underline(href="#" title="Destino Roma")!="Roma"
                li.ibe-box-links__list-item
                    a.link.link__regular.link__regular--small.link__regular--important.link__regular--underline(href="#" title="Destino Nueva York")!="Nueva York"
                li.ibe-box-links__list-item
                    a.link.link__regular.link__regular--small.link__regular--important.link__regular--underline(href="#" title="Destino Chicago")!="Chicago"
                li.ibe-box-links__list-item.hidden-l
                    a.link.link__regular.link__regular--small.link__regular--important.link__regular--underline(href="#" title="Destino Barcelona")!="Barcelona"
        div.ibe-box-links__cols.ibe-box-links__cols--medium
            button.link.link__regular.link__regular--small.link__regular--important(type="button", title="Ver todos los destinos", data-modal="button", data-modal-view=".fc-dialog-all-destinations", id="dialog-destinations")
                span.ibe-box-links__icon.icon-senalizacion_mapas
                !="Ver todos los destinos "
