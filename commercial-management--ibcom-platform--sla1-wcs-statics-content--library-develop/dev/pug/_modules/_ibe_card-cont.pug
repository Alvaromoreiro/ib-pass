mixin m-card-cont(params)
    article.ibe-card-cont(class=params.highlight+" "+params.autoHeight)
        .ibe-card-cont__container
            h3.title__h3.ibe-card-cont__title(class=params.title.icon)!=params.title.name
            case params.typeContent
                when "paragraph"
                    p.paragraph.paragraph__regular!="P&oacute;ngase en contacto con nosotros para cualquier duda, cambio o reembolso en reservas que contengan un hotel, un alquiler de coche o una actividad tur&iacute;stica."
                    p.paragraph.paragraph__regular
                        span.paragraph.paragraph--bold!="Importante: "
                        !="En este tel&eacute;fono no se realizan reservas"
                    .ibe-card-cont__footer
                        span.paragraph.paragraph--highlight!="911776310"
                when "list"
                    ol.ibe-list.ibe-list--normal
                        li.ibe-list__item
                            p.paragraph.paragraph__regular!="Obt&eacute;n Avios adicionales a los Avios obtenidos por tu vuelo (solo desde iberia.com Espa&ntilde;a)"
                        li.ibe-list__item
                            p.paragraph.paragraph__regular!="Reserva tu vuelo+hotel para beneficiarte de un mayor ahorro"
                        li.ibe-list__item
                            p.paragraph.paragraph__regular!="Flexibilidad de pago. Reserva abonando un dep&oacute;sito m&iacute;nimo y paga el resto en c&oacute;modos plazos cuando t&uacute; decidas."
                        li.ibe-list__item
                            p.paragraph.paragraph__regular!="Nuevos aviones y servicios sumados a la cantidad de los hoteles cuidadosamente seleccionados en todos nuestros destinos."
                when "link"
                    p.paragraph.paragraph__regular!="Ahora puedes adapatar el pago de tus vacaciones a tus necesidades. Reserva abonando solo un dep&oacute;sito m&iacute;nimo y paga el resto en c&oacute;modos plazos cuando tu decidas."
                    .ibe-card-cont__footer
                        a.link.link__regular.link__regular--underline(href="#" title="Más información")!="M&aacute;s informaci&oacute;n"