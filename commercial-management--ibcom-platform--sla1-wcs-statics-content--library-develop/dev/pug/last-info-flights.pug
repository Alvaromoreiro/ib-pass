												tr.ibe-table__tbody-tr
													td.ibe-table__tbody-td.ibe-table__tbody--th-left
														span.ibe-table__thead-text.paragraph.paragraph__regular--bold Nueva York. Oficina aeropuerto
													td.ibe-table__tbody-td.ibe-table__tbody--td-right
														span.ibe-table__tbody-text JFK International Airport Terminal - 7 Jamaica, NY 11430
												tr.ibe-table__tbody-tr
													td.ibe-table__tbody-td.ibe-table__tbody--th-left
														span.ibe-table__thead-text.paragraph.paragraph__regular--bold Los Angeles. Oficina aeropuerto
