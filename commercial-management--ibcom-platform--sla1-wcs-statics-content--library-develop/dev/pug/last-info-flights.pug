														span.ibe-table__tbody-text Los Angeles International Airport - 380 World Way Suite 3337B Los Angeles, CA 90045
												tr.ibe-table__tbody-tr
													td.ibe-table__tbody-td.ibe-table__tbody--th-left
														span.ibe-table__thead-text.paragraph.paragraph__regular--bold.paragraph__regular--medium Centro de Atención Iberia Equipaje
													td.ibe-table__tbody-td.ibe-table__tbody--td-right
