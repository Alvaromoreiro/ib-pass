extends _general/layout__primary
include _modules/_ibe_ask-us
//- include _modules/_ibe_card-box

block title
	title!="IBERIA - &Uacute;ltima hora vuelos"
block body

	// Inicio nuevo header 
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login":false
	})
	main
		+m-ibe-breadcrumbs({
			"menu": "advSearch"
		}) 
		section.container
			div.row
				div.col-xl-12
					h1.title.title__h1.title--center.title--grey.title--padding-bottom-short.title--paddT-smaller!="Última hora de nuestros vuelos"
					h2.title.title__h5.title.title__h5--small.title--center.title--p-top-0.title--light.title--p-bottom-24!="Información actualizada minuto a minuto"
			div.row
				div.col-xl-9.col-lg-9.col-md-12.col-sm-12.col-xs-12
					h2.hideAccessible Listado de avisos 
					section.ibe-box-landing
						article.ibe-box-landing__terciary
							h3.title__h3.ibe-card-cont__title.ibe-card-cont__title--black Huelga general convocada en Francia para el 22 de mayo 2018
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium Con motivo del anuncio de la huelga general en Francia convocada para el 22 de mayo, algunos de nuestros vuelos europeos pueden verse afectados.
								p.paragraph.paragraph__regular.paragraph__regular--medium Ante esta situación ajena a Iberia, si vuela estos d&iacute;as con orígenes/destinos europeos en vuelos operados por Iberia, Iberia Express e Iberia Regional Air Nostrum y ha comprado su billete directamente en nuestras webs o en Serviberia hasta el 18 de mayo, tiene la posibilidad de reservar en cualquier vuelo en la misma ruta hasta el 28 de mayo de 2018. Si ha comprado su billete para viajar con nosotros en una agencia de viajes, debe dirigirse a ella para modificar su reserva.
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Si tiene reservado un vuelo que pueda estar afectado, facilítenos sus datos de contacto en " 
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Gesti&oacute;n de reservas"
									span!=" para que le podamos informar de cualquier novedad relevante sobre su viaje a trav&eacute;s del servicio "
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Iberia Conecta." 
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Para responder a cualquier consulta que desees efectuarnos en relaci&oacute;n con su viaje, le atenderemos en:"
								ul.ibe-list.ibe-list--normal.ibe-list--noMargin-bottom.ibe-list--m-left
									li.ibe-list__item.ibe-list__item--smaller-padding
										span.paragraph.paragraph__regular--bold.paragraph__regular--medium!="España: "
										span!="Serviberia " 
										a.link.link__regular--red.paragraph.paragraph__regular--bold.paragraph__regular--medium(href="#", title="Ir a Serviberia", data-focusin)!="901 111 500 "
										span!=" durante las 24 horas del día"
									li.ibe-list__item.ibe-list__item--smaller-padding
										span.paragraph.paragraph__regular--bold.paragraph__regular--medium!="Desde otro país: "
										a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia" , data-focusin)!="Consulte aquí"
							div.ibe-box__primary--no-separator
								h4.title__h5.title__h5--small.title__h5--small-pb!="Informaci&oacute;n llegadas y salidas vuelos"
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Le recomendamos consultar el estado de los vuelos desde "
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia")!="Llegadas y salidas"
									span!=" antes de ir al aeropuerto."
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Le pedimos disculpas por los inconvenientes que esta circunstancia ajena a Iberia pueda ocasionarle y le agradecemos especialmente su paciencia y comprensi&oacute;n."
						
						article.ibe-box-landing__terciary
							h3.title__h3.ibe-card-cont__title.ibe-card-cont__title--black Huelga general convocada en Francia para el 22 de mayo 2018
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium Con motivo del anuncio de la huelga general en Francia convocada para el 22 de mayo, algunos de nuestros vuelos europeos pueden verse afectados.
								p.paragraph.paragraph__regular.paragraph__regular--medium Ante esta situaci&oacute;n ajena a Iberia, si vuela estos días con orígenes/destinos europeos en vuelos operados por Iberia, Iberia Express e Iberia Regional Air Nostrum y ha comprado su billete directamente en nuestras webs o en Serviberia hasta el 18 de mayo, tiene la posibilidad de reservar en cualquier vuelo en la misma ruta hasta el 28 de mayo de 2018. Si ha comprado su billete para viajar con nosotros en una agencia de viajes, debe dirigirse a ella para modificar su reserva.
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Si tiene reservado un vuelo que pueda estar afectado, facilítenos sus datos de contacto en " 
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Gestión de reservas"
									span!=" para que le podamos informar de cualquier novedad relevante sobre su viaje a trav&eacute;s del servicio "
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Iberia Conecta." 
							div.ibe-box__primary--separator
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Para responder a cualquier consulta que desees efectuarnos en relación con su viaje, le atenderemos en:"
								ul.ibe-list.ibe-list--normal.ibe-list--noMargin-bottom.ibe-list--m-left
									li.ibe-list__item.ibe-list__item--smaller-padding
										span.paragraph.paragraph__regular--bold.paragraph__regular--medium!="España: "
										span!="Serviberia " 
										a.link.link__regular--red.paragraph.paragraph__regular--bold.paragraph__regular--medium(href="#", title="Ir a Serviberia")!="901 111 500 "
										span!=" durante las 24 horas del día"
									li.ibe-list__item.ibe-list__item--smaller-padding
										span.paragraph.paragraph__regular--bold.paragraph__regular--medium!="Desde otro país: "
										a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Consulte aquí"
							div.ibe-box__primary--no-separator
								h4.title__h5.title__h5--small.title__h5--small-pb!="Información llegadas y salidas vuelos"
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Le recomendamos consultar el estado de los vuelos desde "
									a.link.link__regular--underline.link__regular--red(href="#", title="Ir a Serviberia", data-focusin)!="Llegadas y salidas"
									span!=" antes de ir al aeropuerto."
								p.paragraph.paragraph__regular.paragraph__regular--medium!="Le pedimos disculpas por los inconvenientes que esta circunstancia ajena a Iberia pueda ocasionarle y le agradecemos especialmente su paciencia y comprensión."
												
				div.col-xl-3.col-lg-3.col-md-12.col-sm-12.col-xs-12
					+m-ask-us({ 
						"search": true 
					})
					
												
					
					div
