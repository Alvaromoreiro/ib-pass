														p.ibe-table__tbody-text (español e ingl&eacute;s) de 08:00 a 24:00 (lunes a domingo).
														p.ibe-table__tbody-text.paragraph.paragraph__regular--bold.paragraph__regular--medium Apdo. Correos 62033 28080 MADRID
														p.ibe-table__tbody-text (Sólo v&aacute;lida como dirección postal)
														p.ibe-table__tbody-text.paragraph.paragraph__regular--bold.paragraph__regular--medium Fax:(+34) 913742418
														p.ibe-table__tbody-text.paragraph.paragraph__regular--bold.paragraph__regular--medium Correo electrónico: clasica@iberia.es
														p.ibe-table__tbody-text Indicar en el asunto del e-mail el n&uacute;mero de su tarjeta Iberia Plus. Solo se atender&aacute;n solicitudes en español o ingl&eacute;s.
												tr.ibe-table__tbody-tr
													td.ibe-table__tbody-td.ibe-table__tbody--th-left
														span.ibe-table__thead-text.paragraph.paragraph__regular--bold.paragraph__regular--medium Boston. Oficina aeropuerto
													td.ibe-table__tbody-td.ibe-table__tbody--td-right
														span.ibe-table__tbody-text Chicago O´Hare International Airport - Terminal-3, West Mezzanine Level Chicago, Illinois 60666
												tr.ibe-table__tbody-tr
													td.ibe-table__tbody-td.ibe-table__tbody--th-left
