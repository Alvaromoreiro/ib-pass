extends _general/layout__primary
block title
	title!="IBERIA - Prepara tu equipaje"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main
		+m-ibe-breadcrumbs({
			"menu": "checkin"
		})
		section.container
			div.row
				.col-xs-12
					.ibe-prepare-baggage
						header.ibe-prepare-baggage__header
							h1.title.title__h1.title--center.ibe-prepare-baggage__header-title!="Prepara tu equipaje"
							p.paragraph.paragraph__regular!="Con toda la informaci&oacute;n necesaria para que tus maletas y articulos puedan acompa&ntilde;arte durante el viaje"
						article.ibe-prepare-baggage__box
							.row.no-gutters
								.col-lg-8.col-md-6.col-sm-12.col-xs-12
									.col-lg-6.col-md-12.ibe-prepare-baggage__box-column(data-function="prepare-baggage")
										div.ibe-prepare-baggage__box-wrapper(data-function="prepare-baggage-child")
											h2.title__h3.ibe-prepare-baggage__box-title!="Equipaje de mano"
											p.paragraph.paragraph__regular!="Con toda la informaci&oacute;n necesaria para que tus maletas y art&iacute;culos puedan acompa&ntilde;arte durante el viaje"
											figure.ibe-prepare-baggage__box-figure
												img.ibe-prepare-baggage__box-image(src=globals.imgPath + "/general/equipaje_mano_max.jpg" alt="Equipaje de mano")
										button.ibe-button.ibe-button--grey.ibe-button--block.ibe-button--small(type="button")!="M&aacute;s informaci&oacute;n"
									.col-lg-6.col-md-12.ibe-prepare-baggage__box-column(data-function="prepare-baggage")
										div.ibe-prepare-baggage__box-wrapper(data-function="prepare-baggage-child")
											h2.title__h3.ibe-prepare-baggage__box-title!="Equipaje facturable"
											p.paragraph.paragraph__regular!="Inf&oacute;rmate de las condiciones para saber qu&eacute; tipo de art&iacute;culos son gratuitos"
											p.paragraph.ibe-prepare-baggage__box-paragraph-sep
												span.ibe-prepare-baggage__features-baggage!="23 kg"
												span.ibe-prepare-baggage__features-baggage.ibe-prepare-baggage__features-baggage--small!="(m&aacute;ximo 32 kg)"
												span.ibe-prepare-baggage__features-baggage!="158 cm"
												span.ibe-prepare-baggage__features-baggage.ibe-prepare-baggage__features-baggage--small!="(alto+ancho+largo)"
											figure.ibe-prepare-baggage__box-figure
												img.ibe-prepare-baggage__box-image(src=globals.imgPath + "/general/equip_fact_max_es.jpg" alt="Equipaje facturable")
										button.ibe-button.ibe-button--grey.ibe-button--block.ibe-button--small(type="button")!="M&aacute;s informaci&oacute;n"
								.col-lg-4.col-md-6.col-sm-12.col-xs-12
									ul.ibe-prepare-baggage__list(data-function="prepare-baggage")
										li.ibe-prepare-baggage__list-item
											a.ibe-prepare-baggage__list-link.ibe-prepare-baggage__list-link--first(href="#" title="Contratar equipaje adicional")
												h3.title__h6.ibe-prepare-baggage__list-link__title!="Contratar equipaje adicional"
												p.paragraph.paragraph__regular!="El extra que muchas veces necesitas pero con hasta un 25% de descuento."
										li.ibe-prepare-baggage__list-item
											a.ibe-prepare-baggage__list-link.ibe-prepare-baggage__list-link--second(href="#" title="Dispositivos electrónicos")
												h3.title__h6.ibe-prepare-baggage__list-link__title!="Dispositivos electr&oacute;nicos"
												p.paragraph.paragraph__regular!="Descubre cu&aacute;les pueden utilizarse en cabina o s&oacute;lo transportarse durante el vuelo."
										li.ibe-prepare-baggage__list-item
											a.ibe-prepare-baggage__list-link.ibe-prepare-baggage__list-link--third(href="#" title="Contratar equipaje adicional")
												h3.title__h6.ibe-prepare-baggage__list-link__title!="Contratar equipaje adicional"
												p.paragraph.paragraph__regular!="Transporta todos los objetos y bultos de condiciones especiales preparados el material adecuado."
										li.ibe-prepare-baggage__list-item
											a.ibe-prepare-baggage__list-link.ibe-prepare-baggage__list-link--fourth(href="#" title="Equipaje peligroso")
												h3.title__h6.ibe-prepare-baggage__list-link__title!="Equipaje peligroso"
												p.paragraph.paragraph__regular!="Evita llevar contigo objetos que por la seguridad de todos no pueden facturarse."
										li.ibe-prepare-baggage__list-item
											a.ibe-prepare-baggage__list-link.ibe-prepare-baggage__list-link--fifth(href="#" title="Equipaje de valor declarado")
												h3.title__h6.ibe-prepare-baggage__list-link__title!="Equipaje de valor declarado"
												p.paragraph.paragraph__regular!="Los bultos de un valor elevado puedes declararlos y subirlos al avi&oacute;n con un plus de tranquilidad."
			.row
				.col-xs-12
					h3.title.title__h3!="Mira c&oacute;mo se aplica en vuelos operados por"
					div.ibe-infocheckin__box.ibe-infocheckin__box--small.ibe-infocheckin__box--no-title
						div.ibe-modal_body-logos
							ul.ibe-modal_body-logos_container.clearfix
								li.ibe-modal_body-logos_container-item
									a(href="#" title="Finnair")
										figure.ibe-modal_body-logos_container-item-figure
											img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/finnair.png" alt="Logo Finnair")
								li.ibe-modal_body-logos_container-item
									a(href="#" title="British Airways")
										figure.ibe-modal_body-logos_container-item-figure
											img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/british_airways.png" alt="Logo British Airways")
								li.ibe-modal_body-logos_container-item
									a(href="#" title="American Airlines")
										figure.ibe-modal_body-logos_container-item-figure
											img.ibe-modal_body-logos_container-item-figure-img(src=globals.imgPath + "/general/american_airlines.png" alt="Logo American Airlines")
	+m-footer()
