extends _general/layout__primary
include _modules/_ibe_header-new
include _modules/_ibe_menu-new
block title
	title!="IBERIA - Error pwa"
block body
	div.ibe-alert.ibe-alert--alert.ibe-alert--pwa
		div.container
			div.row
				div.col-xs-12
					p.ibe-alert__text Est&aacute;s navegando sin conexi&oacute;n a Internet

	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-error.ibe-main__footer--without-margin
		div.ibe-background.ibe-background--responsive.ibe-background--responsive-error
			//picture
			//	source(media="(min-width: 1280px)", srcset="images/content/error404/error-pwa_1280_1x.jpg 1x, images/content/error404/error-pwa_1280_2x.jpg 2x, images/content/error404/error-pwa_1280_3x.jpg 3x")
			//	source(media="(min-width: 1024px) and (max-width: 1279px)", srcset="images/content/error404/error-pwa_1024_1x.jpg 1x, images/content/error404/error-pwa_1024_2x.jpg 2x, images/content/error404/error-pwa_1024_3x.jpg 3x")
			//	source(media="(min-width: 768px) and (max-width: 1023px)", srcset="images/content/error404/error-pwa_768_1x.jpg 1x, images/content/error404/error-pwa_768_2x.jpg 2x, images/content/error404/error-pwa_768_3x.jpg 3x")
			//	source(media="(min-width: 480px) and (max-width: 767px)", srcset="images/content/error404/error-pwa_480_1x.jpg 1x, images/content/error404/error-pwa_480_2x.jpg 2x, images/content/error404/error-pwa_480_3x.jpg 3x")
			//	source(media="(min-width: 0px) and (max-width: 479px)", srcset="images/content/error404/error-pwa_320_1x.jpg 1x, images/content/error404/error-pwa_320_2x.jpg 2x, , images/content/error404/error-pwa_320_3x.jpg 3x")
			//	img( src="images/content/error404/error-pwa_1280_1x.jpg", class="ibe-background__img", alt="Error PWA")
			div.ibe-background__banner-image(data-background="images/content/error404/error-pwa", data-background-format="jpg")
			section.container
				div.row
					div.col-xs-12 
						section.ibe-box-error.ibe-box-error--center.ibe-box-error--wrapper
							div.ibe-box-error__line-spacing.ibe-box-error__line-spacing--small
								h1
									span.ibe-box-error__title Lo sentimos, no puedes acceder a esta página sin conexión a Internet.
							div.ibe-box-error__line-spacing.ibe-box-error__line-spacing--small
								h2.ibe-box-error__subtitle Sigue navegando por iberia.com o inténtalo de nuevo revisando tu conexión.
							div.ibe-box-error__buttons--return-main
								a.ibe-button.ibe-button--red.ibe-button--small.ibe-button--one-third-container(href="#", tabindex="0")
									span.ibe-button__txt Ir a la p&aacute;gina de inicio
							div.ibe-box-error__buttons.ibe-box-error__buttons--margins
								a.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container.ibe-button--one-third-icons.icon-vuelos.ibe-button--icon-rotate(href="#", tabindex="0")
									span.ibe-button__txt Buscar un vuelo
								a.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container.ibe-button--one-third-icons.icon-checking_online(href="#", tabindex="0")
									span.ibe-button__txt Hacer Check-in
								a.ibe-button.ibe-button--inline-block.ibe-button--white.ibe-button--white-border.ibe-button--small.ibe-button--one-third-container.ibe-button--one-third-icons.icon-gestion_de_reservas(href="#", tabindex="0")
									span.ibe-button__txt Gestionar una reserva
	+m-footer({
		"full": true
	})
