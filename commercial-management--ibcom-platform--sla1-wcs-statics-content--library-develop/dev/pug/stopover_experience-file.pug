extends _general/layout__primary
include _modules/_modals/_ibe-modal-login-stopover-simple
include _modules/stopover/_ibe_stopover_experience-file
include _modules/stopover/_ibe_stopover_experience-gallery
include _modules/stopover/_ibe_stopover_experience-location
include _modules/stopover/_ibe_stopover_top-banner
include _modules/stopover/_ibe_stopover_other-experiences
include _modules/stopover/_ibe_stopover_recommendation-card

block title
    title!='IBERIA - Stopover banner'
block body
    // Inicio nuevo header
    +m-header-new({
        "login": false
    })

    // Inicio nuevo menu
    +m-menu-new({
        "login": false
    })
    // End wrapper
    main
        // Main content
        +m-ibe-stopover_top-banner(
            {
                "dataBackground" : 'images/modules/stopover/exp-file-banner',
                "type" : "empty"
            })
        div.container.ibe-exp-file--card
            +m-ibe-stopover-experience-file({"ibplus": true})
            +m-ibe-stopover_experience-gallery()
            +m-ibe-stopover_experience-location()
            +m-ibe-stopover_top-banner(
                {
                    "dataBackground" : 'images/modules/stopover/img-call-to-action-conocer-madrid',
                    "isSearcher" : true,
                    "classBanner" : "ibe-static-banner--m-t",
                    "classSearcher" : "ibe-search-collapse-stopover-position__secondary",
                    "type" : "action"
                })
            +m-ibe-stopover_other-experiences()
            +m-ibe-stopover_recommendation-card({
                "single" : false
            })
    +m-footer({
		"full": true  
	})
