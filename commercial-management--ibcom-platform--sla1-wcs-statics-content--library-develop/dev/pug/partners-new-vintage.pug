                    div.row
                        div.col-xs-12
                            //- Mostrar en caso de buscador vintage
                            div.ibe-search-flights__search-box(data-validate-searcher)
                                +m-searcher({
                                    "tab1": true,
                                    "tab2": true,
                                    "tab3": true,
                                    "tab4": true,
                                    "tab5": true,
                                })
            div.ibe-search-flights__cover.ibe-search-flights__cover--no-search2.ibe-search-flights__cover--carousel
                div.ibe-search-flights__buttons-slick.ibe-search-flights__buttons-slick--left
                    button(data-focusin, type="button" class="slick-prev slick-arrow")
                        span.hideAccessible Anterior
                div.ibe-search-flights__buttons-slick.ibe-search-flights__buttons-slick--right
                    button(data-focusin, type="button" class="slick-next slick-arrow")
                        span.hideAccessible Siguiente

                div.slick-menu.slick-full-window(data-slick="full-window-menu")
                    a.row(href="#" title="Los destinos más interesantes")
                        div.ibe-search-flights__cover-img-container
