extends _general/layout__primary
include _modules/_ibe_searcher
include _modules/_ibe_menu-icons
include _modules/_ibe_card-box
block title
    title!="IBERIA - Partners"
block body

    // Inicio nuevo header
    +m-header-new({
        "login": false
    })

    // Inicio nuevo menu
    +m-menu-new({
        "login":false
    })

    // End wrapper
    main.ibe-partners
        h1.hideAccessible Partners
        div.ibe-search-flights
