                                    figure.figure_logo
                                        img(src="images/general/logo-avis-vertical-rojo.svg" alt="Logo")
                                div.row
                                    div.col-xs-12
                                        h2.title.title__h2!="Los destinos m&aacute;s interesantes"
                                        p.ibe-search-flights__cover-box__txt.ibe-search-flights__cover-box__txt--padding-bottom!="No te pierdas ninguna de nuestras promos"
                    a.row(href="#" title="Los destinos más interesantes")
                        div.ibe-search-flights__cover-img-container
                            figure.ibe-search-flights__cover-fig
                                img.ibe-search-flights__cover-img(src="images/content/carousel/01_herobanner_1_precio_1280_.jpg" alt="Par&iacute;s")
                        div.container
                            div.ibe-search-flights__cover-box.ibe-search-flights__cover-box--center.ibe-search-flights__cover-box--padding


                                div.row
                                    div.col-xs-12
                                        h2.title.title__h2!="Los sssssssssssssssssssssss m&aacute;s interesantes"
                                        p.ibe-search-flights__cover-box__txt.ibe-search-flights__cover-box__txt--padding-bottom!="No te pierdas ninguna de nuestras promos No te pierdas"

        div.container
            div.row
                div.col-xs-12
                    +m-menu-icons({
