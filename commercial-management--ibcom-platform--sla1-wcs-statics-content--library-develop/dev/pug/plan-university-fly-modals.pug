extends _general/layout__primary
include _modules/_modals/_ibe_modal-plan-university-fly
include _modules/_modals/_ibe_modal-plan-university-fly-activated

block title
	title!='IBERIA - Modales'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.container
		// Main content
		div.row
			.col-xs-6
				.row
					div
						a(href="#" title="Login" data-modal="button" data-modal-view=".fc-dialog-plan-university-fly")!="Plan University Fly"
					div
						a(href="#" title="Login" data-modal="button" data-modal-view=".fc-dialog-plan-university-fly-activated")!="Plan University Fly Activated"
	+m-ibe-modal-plan-university-fly()
	+m-ibe-modal-plan-university-fly-activated()

	+m-footer({
		full: true
	}) 
