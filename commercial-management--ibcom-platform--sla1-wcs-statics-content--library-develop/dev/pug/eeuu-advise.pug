extends _general/layout__primary
block title
	title!='IBERIA - Aviso EEUU Modal'
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.container
		// Main content
		div.row
			.col-xs-12
				h1.title.title__h1.title--grey EEUU Aviso

			.col-xs-12(data-ng-controller="modalcontroller")
				.row
					.col-xs-12
						div
							a.link.link__regular(href="#" title="EEUU Aviso" data-modal="button" data-modal-view=".fc-dialog-advise" data-css-class="")!="EEUU Aviso"
	// Modal
	div.ibe-dialog.fc-dialog-advise
		div.modal-dialog
			div.modal-content
				div.ibe-modal.ibe-modal--content-centered
					header.modal-header
						h2.title.title__h1.ibe-modal__title-primary!="Nueva normativa de seguridad en vuelos a EEUU"
						h3.title.ibe-modal__title-secondary.ibe-modal__title-secondary--medium.ibe-modal__title-secondary--black!="Uso de dispositivos electr&oacute;nicos en cabina"
						div.ibe-modal__options
							button(data-focusin, type="button" data-dialog="close" class="ibe-button--reset ibe-modal__options-icon ibe-modal__options-icon--close")
								span.hideAccessible!="Cerrar"
					div.modal-body
						div.ibe-modal_body
							p.paragraph.paragraph__regular Le informamos de que la nueva normativa de seguridad de los vuelos con destino EEUU ha cambiado. A partir de ahora&nbsp;
								span.paragraph.paragraph__regular.paragraph.paragraph__regular--bold est&aacute; prohibido el uso en cabina de todos los dispositivos electr&oacute;nicos de tama&ntilde;o superior a 16cm x 9.3cm x 1.5 cm
								!=" tales como ordenadores port&aacute;tiles, tabletas, E-Readers, c&aacute;maras y dispositivos de juego."
							figure.ibe-modal__figure.ibe-modal__figure--devices
								img.ibe-modal__image(src=globals.imgPath + "/general/dispositivos-elect.png" alt="Dispositivos Electrónicos")
							p.paragraph.paragraph__regular Sabemos que esta medida puede causarle inconvenientes. Por eso y pese a ser una circunstancia ajena a Iberia, hemos reforzado nuestros recursos para ofrecerle soluciones alternativas.
							p.paragraph.paragraph__regular En este sentido, le sugerimos facturar sus dispositivos electr&oacute;nicos que excedan estas medidas.
							p.paragraph.paragraph__regular Asimismo y por motivos de seguridad, le recomendamos presentarse en facturaci&oacute;n 3 horas antes de la hora programada de salida de su vuelo.
							p.paragraph.paragraph__regular Aprovechamos para pedirle disculpas por adelantado si es que en alg&uacute;n momento -debido al elevado volumen de clientes, no podemos atenderle con toda la agilidad que nos gustar&iacute;a.
							p.paragraph.paragraph__regular Muchas gracias por su confianza.
							div.ibe-modal__content-txt
								h4.paragraph.paragraph__regular.paragraph.paragraph__regular--bold &iquest;Tiene alguna duda?
								p.paragraph.paragraph__regular Ll&aacute;menos al&nbsp;
									span.paragraph.paragraph__regular.paragraph.paragraph__regular--bold 901 111 500,
									!=" consulte a nuestro personal de aeropuerto o escr&iacute;banos en redes sociales. Le ayudaremos en lo que necesite."
							div.ibe-modal__buttons
								div.ibe-modal__col.ibe-modal__col--right
									button.ibe-button.ibe-button--red.ibe-button--medium-large(type="button") Entendido
								div.ibe-modal__col.ibe-modal__col--left
									a.link.link__regular.link__regular--underline(href="#" title="Cancelar") Cancelar
