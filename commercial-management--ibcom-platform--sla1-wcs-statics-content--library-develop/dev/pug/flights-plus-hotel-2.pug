extends _general/layout__primary
block title
	title!="IBERIA - Vuelo m&aacute;s hotel"
block body
	// Inicio nuevo header
	+m-header-new({
		"login": false
	})

	// Inicio nuevo menu
	+m-menu-new({
		"login": false
	})
	// End wrapper
	main.ibe-flights-plus-hotel
		+m-ibe-breadcrumbs({
			menu: "checkin"
		})
		div.ibe-search-flights
			div.ibe-search-flights__search.ibe-search-flights__search--overlay
				div.container
					div.row
						div.col-xs-12
							h1.title.title__h1.ibe-search-flights__search-title!="Vuelo m&aacute;s hotel"
							div.ibe-search-flights__search-box.hidden-md.hidden-sm.hidden-xs(data-validate-searcher, data-function="data-focus-searcher")
								+m-searcher-accordion()
							div.ibe-search-flights__search-box.hidden-lg.hidden-xl(data-validate-searcher, data-function="data-focus-searcher-mobile")
								+m-searcher-accordion-mobile()
			div.ibe-search-flights__cover
				figure.ibe-search-flights__cover-fig
					img.ibe-search-flights__cover-img(src="images/content/paris.jpg" alt="París")
				div.container
					div.row
						div.col-xs-12
							a.ibe-search-flights__cover-box.ibe-search-flights__cover-box--center(href="#" title="Los destinos más interesantes")
								div.row
									div.col-xs-12
										h2.title.title__h2!="Los destinos m&aacute;s interesantes"
										p.ibe-search-flights__cover-box__txt!="No te pierdas ninguna de nuestras promos"
		div.container
			div.row
				div.col-lg-9.col-xs-12.col-lg-push-3
					section.ibe-flights-plus-hotel__container
						div.row
							div.col-lg-12.ibe-card-box--type-link.ibe-card-box--lg
								h2.title__h3.ibe-flights-plus-hotel!="Ofertas destacadas"
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": "Hoteles desde",
									"link": {
										"name": "Lorem ipsum"
									},
									"image": {
										"src": "/content/grecia.jpg",
										"alt": "Ofeta Disneyland"
									},
									"title": "Grecia",
									"text": "Alójate en el centro de la ciudad y descubre sus encantos de noche y de día. Alójate en el centro de la ciudad y descubre.",
									"price": true
								})
						div.row
							div.col-md-4.ibe-card-box--type-link.ibe-card-box--sm
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": "Hoteles desde",
									"autoHeight": "ibe-card-box__content--auto-height",
									"link": {
										"name": "Lorem ipsum"
									},
									"image": {
										"src": "/modules/ibe-card-box/352x198.png",
										"alt": "Ofeta Disneyland"
									},
									"title": "Grecia",
									"text": "Alójate en el centro de la ciudad y descubre sus encantos de noche y de día. Alójate en el centro de la ciudad y descubre.",
									"price": true
								})
							div.col-md-4.ibe-card-box--type-link.ibe-card-box--sm
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": "Hoteles desde",
									"autoHeight": "ibe-card-box__content--auto-height",
									"link": {
										"name": "Lorem ipsum"
									},
									"image": {
										"src": "/modules/ibe-card-box/352x198.png",
										"alt": "Ofeta Disneyland"
									},
									"title": "Grecia",
									"text": "Alójate en el centro de la ciudad y descubre sus encantos de noche y de día. Alójate en el centro de la ciudad y descubre.",
									"price": true
								})
							div.col-md-4.ibe-card-box--type-link.ibe-card-box--sm
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"autoHeight": "ibe-card-box__content--auto-height",
									"link": {
										"name": "Lorem ipsum"
									},
									"image": {
										"src": "/modules/ibe-card-box/352x198.png",
										"alt": "Ofeta Disneyland"
									},
									"title": "Grecia",
									"text": "Alójate en el centro de la ciudad y descubre sus encantos de noche y de día. Prueba de texto",
									"exampleText": false,
									"price": true
								})
						div.row
							div.col-md-6.ibe-card-box--md.ibe-card-box--vertical
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": "Hoteles desde",
									"link": {
										"name": "Grecia"
									},
									"autoHeight": "ibe-card-box__content--auto-height",
									"titleAutoHeight": "ibe-card-box__title--auto-height",
									"image": {
										"src": "/modules/ibe-card-box/160x266.png",
										"alt": "Grecia"
									},
									"title": "Grecia",
									"text": "Alójate en el centro de la ciudad y descubre sus encantos de noche y de día. Prueba prueba.",
									"price": true
								})
							div.col-md-6.ibe-card-box--md.ibe-card-box--vertical
								+m-card-box({
									"isLink": true,
									"zoom": true,
									"exampleText": false,
									"link": {
										"name": "Grecia"
									},
									"autoHeight": "ibe-card-box__content--auto-height",
									"titleAutoHeight": "ibe-card-box__title--auto-height",
									"image": {
										"src": "/modules/ibe-card-box/160x266.png",
										"alt": "Grecia"
									},
									"title": "Grecia Grecia",
									"price": true
								})

					section.ibe-flights-plus-hotel__container
						div.row
							div.col-xs-12
								h2.title__h3.ibe-flights-plus-hotel!="Informaci&oacute;n de inter&eacute;s"
								.ibe-flights-plus-hotel__box
									+m-card-cont({
										"title": {
											"name": "Atenci&oacute;n al cliente",
											"icon": "ibe-card-cont__title--icon icon-atencion_telefonica"
										},
										"mainClass": "",
										"autoHeight": "",
										"typeContent": "paragraph"
									})
						div.row
							div.col-xs-12
								.ibe-flights-plus-hotel__box
									+m-accordion({
										"id": "info_price_1",
										"target": "#info_price_1",
										"title": {
											"text": "Informaci&oacute;n sobre precios",
											"title": "Información sobre precios",
											"href": "#"
										},
										"collapse": "Todos los precios mostrado en iberia-com est&aacute;n en euros y se basan en coches del Grupo A. Se aplican los t&eacute;rminos y condiciones est&aacute;ndar de Iberia. Ver t&eacute;rminos y condiciones. Todos los precios de los planes de vacaciones si se muestran, son por persona, est&aacute;n expresados en euros..."
									})
				div.col-lg-3.col-xs-12.col-lg-pull-9
					+m-lat-menu({
						items: [
							{
								link: "Vuelos",
								title: "Vuelos",
								cssClass: "ibe-lat-menu__item--active"
							},
							{
								link: "Puente A&eacute;reo",
								title: "Puente Aéreo"
							},
							{
								link: "Vuelos + Hotel",
								title: "Vuelos + Hotel"
							},
							{
								link: "Hoteles",
								title: "Hoteles"
							},
							{
								link: "Vuelo + Coche / Coche",
								title: "Vuelo + Coche / Coche"
							},
							{
								link: "Tour y Actividades",
								title: "Tour y Actividades"
							},
							{
								link: "Seguros de viaje",
								title: "Seguros de viaje"
							},
							{
								link: "Completa tu viaje",
								title: "Completa tu viaje"
							},
							{
								link: "Parking en aeropuerto",
								title: "Parking en aeropuerto"
							}
						]
					})
					.ibe-flights-plus-hotel__box.hidden-md
						+m-card-link({
							"isLink": false,
							"mainClass": "sm",
							"autoHeight": "",
							"title": {
								"name": "Disneyland Par&iacute;s &iexcl;3x2!",
								"icon": false
							},
							"image": {
								"src": "/content/disney.jpg",
								"alt": "Ofeta Disneyland"
							},
							"logo": {
								"bool": false
							},
							"typeContent": "paragraph",
							"highlight": true
						})
	+m-footer()
	div.ibe-overlay
