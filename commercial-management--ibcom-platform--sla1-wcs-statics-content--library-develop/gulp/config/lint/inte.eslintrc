{
  "globals": {
		//"workbox": "readonly",
		//"self": "readonly",
		"$": "readonly"
	},
	"rules":{
		"linebreak-style": 0
	},
  "extends": ["airbnb-base"],
  "parserOptions": { 
	"ecmaVersion": 8 
	},
  "env": {
	"browser": true,
	"amd": true,
	//"node": true, It is in airbnb already
	"serviceworker": false,
	"worker": false
	}
}
