{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "src",
  "projects": {
    "ib-menus": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "prefix": "",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "src/ng-package.json",
            "tsConfig": "./tsconfig.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "./tsconfig.prod.json"
            },
            "development": {
              "tsConfig": "./tsconfig.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-builders/custom-webpack:karma",
          "options": {
            "customWebpackConfig": {
              "path": "./config/angular/extra-webpack.config.ts"
            },
            "codeCoverageExclude": [
              "test/mocks/**/*.ts"
            ],
            "main": "./test/unit/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "./tsconfig.spec.json",
            "karmaConfig": "./config/karma/karma.conf.cjs",
            "codeCoverage": true
          }
        }
      }
    }
  },
  "defaultProject": "ib-menus"
}
