/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./build-typescript/spec",
    "types": [
      "jasmine", "node", "webpack-env"
    ],
    "paths": {
      "ib-web-commons/*": [
        "./test/mocks/ib-web-commons/*"
      ]
    }
  },
  "files": [
    "src/polyfills.ts",
    "test/unit/test.ts"
  ],
  "include": [
    "test/mocks/**/*.ts",
    "test/unit/**/*.spec.ts",
    "test/unit/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
