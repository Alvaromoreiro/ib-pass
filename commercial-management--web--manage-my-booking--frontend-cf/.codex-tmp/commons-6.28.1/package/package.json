    "test:contract": "echo contract test",
    "test:unit": "ng test --browsers ChromeHeadlessCI --watch=false --source-map=false",
    "check:format": "echo nothing to check",
    "format": "echo nothing to format",
    "check:lint": "npm run eslint && npm run stylelint",
    "lint": "echo nothing to lint"
  },
