      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2015/ib-web-commons.mjs"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2015/ib-web-commons.mjs"
    }
