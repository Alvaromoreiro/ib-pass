{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": [
    "../../src/app/core/**/*.service.ts",
    "../../src/app/core/**/*.model.ts",
    "../../src/app/core/**/*.models.ts",
    "../../src/app/core/**/*.component.ts",
    "../../src/app/core/**/*.pipe.ts",
    "../../src/app/core/**/*.module.ts",
    "../../src/app/core/**/*.directive.ts"
  ],
  "exclude": [
    "node_modules",
    "../../src/app/core/ui-components/ib-ui-banners/**",
    "../../src/app/core/ui-components/ib-ui-carousel/**",
    "../../src/app/core/ui-components/ib-ui-timer/**"
  ]
}
