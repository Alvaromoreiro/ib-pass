{
    "extends": "./tsconfig.base.json",

    "compilerOptions": {
       "rootDirs": ["src"],
    },
    "files": [
        "./src/main.ts",
        "./src/polyfills.ts",
        "./src/global.d.ts",
        "./src/decorators.ts"
    ],
    "include": [
        "./src/**/*.ts",
        "./src/**/*.d.ts"
    ],
    "exclude": [
        "./src/app/core/workers/**/*.ts",
        "./src/test.ts",
        "./src/**/*.spec.ts"
    ]
}