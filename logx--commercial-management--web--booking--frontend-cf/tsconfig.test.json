{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDirs": ["src", "test"],
    "types": [
      "jasmine",
      "node",
      "webpack-env"
    ]
  },
  "files": [
    "./test/unit/testing-polyfils.ts",
    "./test/unit/test.ts"
  ],
  "include": [
    "./src/**/*.spec.ts",
    "./src/**/*.d.ts",
    "./test/helpers/**/*.ts",
    "./test/mocks/**/*.ts",
    "./test/unit/**/*.ts",
    "./test/unit/**/*.spec.ts",
    "./test/unit/**/*.d.ts"
  ]
}
