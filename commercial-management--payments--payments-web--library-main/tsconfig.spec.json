/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./build-typescript/spec",
    "types": [
      "jasmine", "node", "webpack-env"
    ]
  },
  "files": [
    "src/polyfills.ts",
    "test/unit/test.ts"
  ],
  "include": [
    "test/unit/**/*.spec.ts",
    "test/unit/**/*-test.ts",
    "test/unit/**/*.d.ts",
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
  ]
}
