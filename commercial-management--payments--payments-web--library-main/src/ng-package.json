{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../dist",
  "lib": {
    "entryFile": "./main.ts",
    "styleIncludePaths": [
      "./styles"
    ]
  },
  "inlineStyleLanguage": "css",
  "assets": [
    "./**/!(*.component).html",
    "./styles/**/*.css"
  ],
  "allowedNonPeerDependencies": [
    "ng-bootstrap/ng-bootstrap",
    "@popperjs/core",
    "angular",
    "angular-aria",
    "angular-cookies",
    "angular-local-storage",
    "angular-messages",
    "angular-translate",
    "bodymovin",
    "bootstrap",
    "bootstrap-tabdrop",
    "components-jqueryui",
    "jquery",
    "jquery.ioslist",
    "lodash",
    "lodash-es",
    "rxjs",
    "zone.js"
  ]
}